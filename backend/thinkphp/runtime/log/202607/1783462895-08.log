[2026-07-08T01:19:18+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 13 , `seq` = 13 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_04_2xv3R9R8EKnOIghWBQHV7235\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n6\\tuse app\\\\common\\\\model\\\\Document;\\n7\\tuse app\\\\common\\\\model\\\\MajorSchool;\\n8\\tuse Exception;\\n9\\tuse think\\\\Db;\\n10\\tuse yjxkSubjectMap;\\n11\\t\\n12\\t\\/**\\n13\\t * app专业接口\\n14\\t *\\/\\n15\\tclass AppMajor extends ApiAuth\\n16\\t{\\n17\\t    protected $noNeedLogin = [];\\n18\\t    protected $noNeedRight = [];\\n19\\t\\n20\\t    protected $majorSchoolModel = null;\\n21\\t    protected $userSchoolMajorTargetModel = null;\\n22\\t    protected $uid;\\n23\\t    public function _initialize()\\n24\\t    {\\n25\\t        parent::_initialize();\\n26\\t        $this->uid = session(\'uid\') ?? 0;\\n27\\t        $this->majorSchoolModel = new MajorSchool();\\n28\\t        $this->userSchoolMajorTargetModel = model(\'UserSchoolMajorTarget\');\\n29\\t    }\\n30\\t\\n31\\t    \\/**\\n32\\t     * Function targetIndex [院校规划首页]\\n33\\t     * @author erdong\\n34\\t     * @date 2023-03-08\\n35\\t     *\\/\\n36\\t    public function targetIndex()\\n37\\t    {\\n38\\t        $redis = redis();\\n39\\t        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid;\\n40\\t        $cache = $redis->get($cacheKey);\\n41\\t        if ($cache) {\\n42\\t            $data = json_decode($cache, true);\\n43\\t        } else {\\n44\\t            \\/\\/获取目标院校\\n45\\t            $where = [\\n46\\t                \'user_id\' => $this->uid,\\n47\\t            ];\\n48\\t            $data = [];\\n49\\t            $list = $this->userSchoolMajorTargetModel\\n50\\t                ->where($where)\\n51\\t                ->order(\'id desc\')\\n52\\t                ->select();\\n53\\t            if ($list) {\\n54\\t                $isDefault = false;\\n55\\t                foreach ($list as $lt) {\\n56\\t                    if ($lt[\'is_default\']) {\\n57\\t                        $targetSchoolMajor = $lt;\\n58\\t                        $isDefault = true;\\n59\\t                        break;\\n60\\t                    }\\n61\\t                }\\n62\\t                if (!$isDefault) {\\n63\\t                    $targetSchoolMajor = $list[0];\\n64\\t                }\\n65\\t                $targetSchoolMajor = Db::connect(\'database.yx_db_config\')\\n66\\t                    ->name(\'cl_major_school\')\\n67\\t                    ->alias(\'cms\')\\n68\\t                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n69\\t                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n70\\t                    ->where(\'cms.id\', $targetSchoolMajor[\'school_major_id\'])\\n71\\t                    ->field(\'cms.id as school_major_id, sch.id as school_id, sch.name as school_name, sch.logo as school_logo, ma.id as major_id, ma.name as major_name, ma.code, ma.yjxk_id\')\\n72\\t                    ->find();\\n73\\t                $data[\'target_school_major\'] = $targetSchoolMajor;\\n74\\t\\n75\\t                \\/\\/专业映射的三级学科\\n76\\t                $yjxkSubject = yjxkSubjectMap::getMajorSubject();\\n77\\t                $subjectIds = $yjxkSubject[$targetSchoolMajor[\'yjxk_id\']] ?? [];\\n78\\t                if($subjectIds){\\n79\\t                    $subjectIds = array_merge($subjectIds,$this->_getSubjectIdsByPids(yjxkSubjectMap::SECOND_SUBJECT_QK));\\n80\\t                }else{\\n81\\t                    $subjectIds = [yjxkSubjectMap::THIRD_SUBJECT_QK];\\n82\\t                }\\n83\\t\\n84\\t                \\/\\/是否包含真题资料、经验小课、学长学姐\\n85\\t                $documentModel = new Document();\\n86\\t                $majorId = $targetSchoolMajor[\'major_id\'];\\n87\\t                $schoolId = $targetSchoolMajor[\'school_id\'];\\n88\\t                $tabs = [];\\n89\\t                if ($documentModel->ifHasDocsOrTalk($majorId, 0, $schoolId)) {\\n90\\t                    $tabs[] = [\\n91\\t                        \'typeId\' => 1,\\n92\\t                        \'title\' => \'专业资料\'\\n93\\t                    ];\\n94\\t                } \\/\\/真题资料\\n95\\t                if ($documentModel->ifHasDocsOrTalk($majorId, 1, $schoolId)) {\\n96\\t                    $tabs[] = [\\n97\\t                        \'typeId\' => 2,\\n98\\t                        \'title\' => \'上岸经验\'\\n99\\t                    ];\\n100\\t                } \\/\\/经验小课\\n101\\t                if ($documentModel->ifHasSenior($majorId, $schoolId)) {\\n102\\t                    $tabs[] = [\\n103\\t                        \'typeId\' => 3,\\n104\\t                        \'title\' => \'学长学姐\'\\n105\\t                    ];\\n106\\t                } \\/\\/学长学姐\\n107\\t                $tabs[] = [\\n108\\t                    \'typeId\' => 21,\\n109\\t                    \'title\' => \'1V1辅导\'\\n110\\t                ];\\n111\\t                $data[\'tabs\'] = $tabs;\\n112\\t            } else {\\n113\\t                $subjectIds = $this->_getSubjectIdsByPids([yjxkSubjectMap::SECOND_SUBJECT_ZYK, yjxkSubjectMap::SECOND_SUBJECT_QK]);\\n114\\t            }\\n115\\t            $data[\'subject_ids\'] = $subjectIds;\\n116\\t            $redis->setex($cacheKey, 300, json_encode($data));\\n117\\t        }\\n118\\t        \\/\\/获取金刚位数据\\n119\\t        $findTools = json_decode($redis->get(\'otm_display_userIds\'), true);\\n120\\t        $ftools = [];\\n121\\t        foreach ($findTools as $tool) {\\n122\\t            if (!empty($tool[\'oldurl\'])) {\\n123\\t                unset($tool[\'oldurl\']);\\n124\\t            }\\n125\\t            $tool[\'findId\'] = $tool[\'type\'];\\n126\\t            $tool[\'type\'] = 4;\\n127\\t            $ftools[$tool[\'findId\']] = $tool;\\n128\\t        }\\n129\\t        unset($findTools);\\n130\\t\\n131\\t        $data[\'navigation\'] = [];\\n132\\t        $findIndex = [28, 22, 14, 23];\\n133\\t        foreach ($findIndex as $ind) {\\n134\\t            if (!empty($ftools[$ind])) {\\n135\\t                $data[\'navigation\'][] = $ftools[$ind];\\n136\\t            }\\n137\\t        }\\n138\\t        $this->success(\'success\', $data);\\n139\\t    }\\n140\\t\\n141\\t    \\/**\\n142\\t     * Function list [目标院校专业列表]\\n143\\t     * @author erdong\\n144\\t     * @date 2023-03-07\\n145\\t     *\\/\\n146\\t    public function targetList()\\n147\\t    {\\n148\\t        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid;\\n149\\t        $cache = redis()->get($cacheKey);\\n150\\t        if ($cache) {\\n151\\t            $list = json_decode($cache, true);\\n152\\t        } else {\\n153\\t            $list = $this->userSchoolMajorTargetModel\\n154\\t                ->alias(\'usmt\')\\n155\\t                ->where(\'user_id\', $this->uid)\\n156\\t                ->order(\'id desc\')\\n157\\t                ->field(\'school_major_id,is_default\')\\n158\\t                ->limit(3)\\n159\\t                ->select();\\n160\\t            if ($list) {\\n161\\t                $schoolMajorIds = array_column($list, \'school_major_id\');\\n162\\t                $schoolMajorInfo = Db::connect(\'database.yx_db_config\')\\n163\\t                    ->name(\'cl_major_school\')\\n164\\t                    ->alias(\'cms\')\\n165\\t                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n166\\t                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n167\\t                    ->whereIn(\'cms.id\', $schoolMajorIds)\\n168\\t                    ->column(\'cms.id, sch.id as school_id, sch.logo as school_logo, sch.name as school_name, ma.id as major_id, ma.name as major_name\');\\n169\\t                $hasDefault = false;\\n170\\t                foreach ($list as &$lt) {\\n171\\t                    if ($lt[\'is_default\']) {\\n172\\t                        $hasDefault = true;\\n173\\t                    }\\n174\\t                    $lt[\'school_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_name\'];\\n175\\t                    $lt[\'major_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_name\'];\\n176\\t                    $lt[\'school_logo\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_logo\'];\\n177\\t                    $lt[\'school_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_id\'];\\n178\\t                    $lt[\'major_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_id\'];\\n179\\t                }\\n180\\t                if (!$hasDefault) {\\n181\\t                    $list[0][\'is_default\'] = 1;\\n182\\t                }\\n183\\t                redis()->setex($cacheKey, 86400, json_encode($list));\\n184\\t            }\\n185\\t        }\\n186\\t        $this->success(\'success\', $list);\\n187\\t    }\\n188\\t\\n189\\t    \\/**\\n190\\t     * Function addOrDelTarget [添加\\/删除目标专业]\\n191\\t     * @author erdong\\n192\\t     * @date 2023-03-07\\n193\\t     *\\/\\n194\\t    public function addOrDelTarget()\\n195\\t    {\\n196\\t        $schoolId = input(\'school_id\\/d\', 0);\\n197\\t        $majorId = input(\'major_id\\/d\', 0);\\n198\\t        $action = input(\'action\\/d\', 0); \\/\\/操作 0 新增 1 删除 2 编辑\\n199\\t        $oldschoolMajorId = input(\'school_major_id\\/d\', 0);\\n200\\t        if ($action > 0 && !$oldschoolMajorId) {\\n201\\t            $this->error(\\\"参数错误【school_major_id】\\\");\\n202\\t        }\\n203\\t        try {\\n204\\t            Db::startTrans();\\n205\\t            $where[\'user_id\'] = $this->uid;\\n206\\t            if ($action == 1) { \\/\\/删除\\n207\\t                $this->userSchoolMajorTargetModel\\n208\\t                    ->where($where)\\n209\\t                    ->where(\'school_major_id\', $oldschoolMajorId)\\n2
40\\t            $controllername = Loader::parseName(request()->controller());\\n41\\t            $actionname = strtolower(request()->action());\\n42\\t            $path = str_replace(\'.\', \'\\/\', $controllername) . \'\\/\' . $actionname;\\n43\\t            if (in_array($path, $allowPath)) {\\n44\\t                $limit = request()->get(\\\"limit\\/d\\\", 0);\\n45\\t                if (($path == \'year_detail\\/index\' || $path == \'t_cl_roster\\/index\') && request()->isAjax()) {\\n46\\t                    if ($limit == 0) {\\n47\\t                        $type = 2;\\n48\\t                    } else {\\n49\\t                        $type = 1;\\n50\\t                    }\\n51\\t                }\\n52\\t                if ($path == \'t_cl_roster\\/export\' || $path == \'year_detail\\/export\') {\\n53\\t                    $type = 2;\\n54\\t                }\\n55\\t                if ($type == 2) {\\n56\\t                    $startTime = strtotime(date(\'Y-m-d\', time()) . \' 00:00:00\');\\n57\\t                    $endTime = time();\\n58\\t                    $where = [];\\n59\\t                    $where[\'admin_id\'] = $auth->uid;\\n60\\t                    $where[\'path\'] = $path;\\n61\\t                    $where[\'type\'] = 2;\\n62\\t                    $where[\'createtime\'] = [\'between\', [$startTime, $endTime]];\\n63\\t                    $num = Db::name(\'admin_log\')->where($where)->count();\\n64\\t                    if ($num > config(\'export_time\')) {\\n65\\t                        echo json_encode_cus(return_format(0, [], \'导出次数超出限制，请明天尝试\'));\\n66\\t                        exit;\\n67\\t                    }\\n68\\t                }\\n69\\t                $title = \'\';\\n70\\t                switch ($path){\\n71\\t                    case \'year_detail\\/index\':\\n72\\t                        $title = \'招录信息查询\';\\n73\\t                        break;\\n74\\t                    case \\\"t_cl_roster\\/export\\\":\\n75\\t                        $title = \'复试调剂名单导出\';\\n76\\t                        break;\\n77\\t                    case \\\"t_cl_roster\\/index\\\":\\n78\\t                        $title = \'复试调剂名单查询\';\\n79\\t                        break;\\n80\\t                    case \\\"year_detail\\/export\\\":\\n81\\t                        $title = \'招录信息导出\';\\n82\\t                        break;\\n83\\t                }\\n84\\t                \\\\app\\\\admin\\\\model\\\\AdminLog::record($title, \'\', $type);\\n85\\t            }\\n86\\t        }\\n87\\t    }\\n88\\t}\\n89\\t\"}]},\"parent_tool_use_id\":\"call_00_PIw8yQqGecc9OjEQ4yQK7431\",\"session_id\":\"eedec3bf-a4f2-4c62-9cdd-51437516f832\",\"uuid\":\"cc31e2dd-012a-40ad-98bf-ac754148d343\",\"timestamp\":\"2026-07-07T17:13:54.802Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Explore project structure\"}' , `created_at` = '2026-07-08 01:13:54' [ RunTime:0.001543s ]

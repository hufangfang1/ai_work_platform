\'000\');\\n284\\t        $this->success(\'success\', $return);\\n285\\t    }\\n286\\t\\n287\\t    \\/**\\n288\\t     * Function wxIndex [获取配置信息]\\n289\\t     * Auther: Changzd\\n290\\t     * Date: 2023\\/11\\/20\\n291\\t     *\\/\\n292\\t    public function wxIndex()\\n293\\t    {\\n294\\t        $data = [];\\n295\\t        $errno = 0;\\n296\\t        $msg = \'\';\\n297\\t        $uid = session(\'uid\');\\n298\\t        $userExtend = [];\\n299\\t        if (!empty($uid)) {\\n300\\t            $userExtend = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n301\\t                ->where(\'uid\', $uid)\\n302\\t                ->field(\'exam_period, fix_school, fix_major\')\\n303\\t                ->find();\\n304\\t        }\\n305\\t\\n306\\t        do {\\n307\\t            if ($this->request->isPost()) {\\n308\\t                $examPeriod = input(\'exam_period\\/d\', 0);\\n309\\t                $fixSchool = input(\'fix_school\\/d\', 0);\\n310\\t                $fixMajor = input(\'fix_major\\/d\', 0);\\n311\\t                if (empty($examPeriod)) {\\n312\\t                    $msg = \'请选择考研时间\';\\n313\\t                    $errno = ComErrorDescs::EC_INVALID_PARAM;\\n314\\t                    break;\\n315\\t                }\\n316\\t                if (empty($uid)) {\\n317\\t                    $msg = ComErrorDescs::errmsg(ComErrorDescs::APP_LOGIN_INVALID);\\n318\\t                    $errno = ComErrorDescs::APP_LOGIN_INVALID;\\n319\\t                    break;\\n320\\t                }\\n321\\t                $now = time();\\n322\\t                $data[\'target\'] = [];\\n323\\t                if (!empty($uid)) {\\n324\\t                    if (empty($userExtend)) {\\n325\\t                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')->insert([\\n326\\t                            \'uid\' => $uid,\\n327\\t                            \'exam_period\' => $examPeriod,\\n328\\t                            \'fix_school\' => $fixSchool,\\n329\\t                            \'fix_major\' => $fixMajor,\\n330\\t                            \'created_at\' => $now,\\n331\\t                            \'updated_at\' => $now\\n332\\t                        ]);\\n333\\t                    } else {\\n334\\t                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n335\\t                            ->where(\'uid\', $uid)\\n336\\t                            ->update([\\n337\\t                                \'exam_period\' => $examPeriod,\\n338\\t                                \'fix_school\' => $fixSchool,\\n339\\t                                \'fix_major\' => $fixMajor,\\n340\\t                                \'updated_at\' => $now\\n341\\t                            ]);\\n342\\t                    }\\n343\\t                    try {\\n344\\t                        \\/\\/ 同步用户中心\\n345\\t                        Helpers::ucenterCurl([\\n346\\t                            \'uid\' => $uid,\\n347\\t                            \'exam_period\' => $examPeriod,\\n348\\t                        ], \'put_exam_period\');\\n349\\t                    } catch (\\\\Exception $e) {\\n350\\t                    }\\n351\\t                    redis()->del(\\\\app\\\\api\\\\logic\\\\User::KY_TARGET_KEY . $uid);\\n352\\t                    $data[\'target\'] = (new \\\\app\\\\api\\\\logic\\\\User())->getKyTarget($uid);\\n353\\t                }\\n354\\t            } else {\\n355\\t                $examPeriod = !empty($userExtend[\'exam_period\']) ? $userExtend[\'exam_period\'] : \'\';\\n356\\t                $examLabel = (new ClappLogic())->getClassifyLabelByFirstSubject();\\n357\\t                $data = [\\n358\\t                    [\\n359\\t                        \'type\' => \'exam\',\\n360\\t                        \'selected\' => $examPeriod,\\n361\\t                        \'title\' => \'你的考研时间\',\\n362\\t                        \'options\' => $examLabel,\\n363\\t                    ],\\n364\\t                    [\\n365\\t                        \'type\' => \'school\',\\n366\\t                        \'selected\' => $userExtend[\'fix_school\'] ?? \'\',\\n367\\t                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>院校<\\/span>是否已明确？\\\",\\n368\\t                        \'options\' => [\\n369\\t                            [\\n370\\t                                \'value\' => \'1\',\\n371\\t                                \'title\' => \'已明确|考研院校\',\\n372\\t                            ],\\n373\\t                            [\\n374\\t                                \'value\' => \'2\',\\n375\\t                                \'title\' => \'还没想好|考哪个学校\',\\n376\\t                            ],\\n377\\t                        ]\\n378\\t                    ],\\n379\\t                    [\\n380\\t                        \'type\' => \'major\',\\n381\\t                        \'selected\' => $userExtend[\'fix_major\'] ?? \'\',\\n382\\t                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>专业<\\/span>是否已明确？\\\",\\n383\\t                        \'options\' => [\\n384\\t                            [\\n385\\t                                \'value\' => \'1\',\\n386\\t                                \'title\' => \'已明确|考研专业\',\\n387\\t                            ],\\n388\\t                            [\\n389\\t                                \'value\' => \'2\',\\n390\\t                                \'title\' => \'还没想好|考哪个专业\',\\n391\\t                            ],\\n392\\t                        ]\\n393\\t                    ]\\n394\\t                ];\\n395\\t            }\\n396\\t        } while (false);\\n397\\t\\n398\\t        $this->result($msg, $data, $errno);\\n399\\t    }\\n400\\t\\n401\\t    public function getBuyQrcode()\\n402\\t    {\\n403\\t        $id = input(\'id\\/d\', 0);\\n404\\t        $unid = input(\'unionid\', \'\');\\n405\\t        $uid = session(\'uid\');\\n406\\t        $catchKey = \'yxk:wxmini:buyqrcode:catch:init:\' . date(\'Ymd\', time());\\n407\\t        $init = redis()->get($catchKey);\\n408\\t        if (empty($init)) {\\n409\\t            Db::name(\'buy_qrcode\')->where(\'id\', \'>\', 0)->update([\'day_refresh\' => 0]);\\n410\\t            redis()->setex($catchKey, 3600 * 24, 1);\\n411\\t        }\\n412\\t        $qrcodeList = Db::name(\'buy_qrcode\')\\n413\\t            ->where(\'status\', 0)\\n414\\t            ->field(\'id,qrcode,mobile\')\\n415\\t            ->select();\\n416\\t        $qrcodeList = array_column($qrcodeList, null, \'id\');\\n417\\t        if (!empty($id)) {\\n418\\t            $info = Db::name(\'buy_qrcode\')\\n419\\t                ->where(\'id\', $id)\\n420\\t                ->find();\\n421\\t            $times = $info[\'day_refresh\'];\\n422\\t            $mobile = $info[\'mobile\'];\\n423\\t            if ($times >= 10) {\\n424\\t                $sendKey = \'yxk:wxmini:buyqrcode:catch:send:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n425\\t                $sendValue = redis()->get($sendKey);\\n426\\t                if (empty($sendValue)) {\\n427\\t                    redis()->setex($sendKey, 3600 * 24, 1);\\n428\\t                    sendFeishu($mobile . \\\"二维码单日刷新次数已经超过10次，请排查“加好友”功能是否封禁，点击链接处理（确定解封地址不变）\\\\n\\\" . config(\'self_website_url\') . \'yxAdmin.php\\/buy_qrcode\\/edit1?ids=\' . $info[\'id\'], $mobile);\\n429\\t                }\\n430\\t            }\\n431\\t            $historyId = (new Common())->getHistoryId($unid,$qrcodeList,$id);\\n432\\t            if (!empty($historyId)) {\\n433\\t                if (isset($qrcodeList[$historyId])) {\\n434\\t                    $qrcodeInfo = $qrcodeList[$historyId];\\n435\\t                } else {\\n436\\t                    unset($qrcodeList[$id]);\\n437\\t                    if (!empty($qrcodeList)) {\\n438\\t                        $num = count($qrcodeList);\\n439\\t                        $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n440\\t                    }\\n441\\t                }\\n442\\t            } else {\\n443\\t                unset($qrcodeList[$id]);\\n444\\t                if (!empty($qrcodeList)) {\\n445\\t                    $num = count($qrcodeList);\\n446\\t                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n447\\t                }\\n448\\t            }\\n449\\t            if (!empty($qrcodeInfo)) {\\n450\\t                $freshKey = \'yxk:wxmini:buyqrcode:catch:fresh:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n451\\t                $freshValue = redis()->get($freshKey);\\n452\\t                $refresh = $info[\'refresh\'];\\n453\\t                $dayRefresh = $info[\'day_refresh\'];\\n454\\t                if (empty($freshValue)) {\\n455\\t                    redis()->setex($freshKey, 3600 * 24, 1);\\n456\\t                    Db::name(\'buy_qrcode\')\\n457\\t                        ->where(\'id\', $id)\\n458\\t                        ->update([\\n459\\t                            \'refresh\' => $refresh + 1,\\n460\\t                            \'day_refresh\' => $dayRefresh + 1,\\n461\\t                            \'updatetime\' => time()\\n462\\t                        ]);\\n463\\t                }\\n464\\t            } elseif ($info[\'status\'] == 0) {\\n465\\t                $qrcodeInfo = $info;\\n466\\t            }\\n467\\t            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n468\\t            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n469\\t        } else {\\n470\\t            $myId = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n471\\t                ->where(\'uid\', $uid)\\n472\\t                ->value(\'buy_qrcode_id\');\\n473\\t            trace(\'myId:\'.$myId);\\n474\\t            if (empty($myId)) {\\n475\\t                if (!empty($qrcodeList)) {\\n476\\t                    $num = count($qrcodeList);\\n477\\t                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n478\\t                }\\n479\\t            } else {\\n480\\t                $qrcodeInfo = $qrcodeList[$myId] ?? [];\\n481\\t                if (empty($qrcodeInfo)) {\\n482\\t                    $historyId = (new Common())->getHistoryId($unid,$qrcodeList);\\n483\\t                    if (!empty($historyId)) {\\n484\\t                        $qrcodeInfo = $qrcodeList[$historyId] ?? [];\\n485\\t                        if (empty($qrcodeInfo)) {\\n486\\t                            if (!empty($qrcodeList)) {\\n487\\t                                $num = count($qrcodeList);\\n488\\t                                $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n489\\t                            }\\n490\\t                        }\\n491\\t                    } else {\\n492\\t                        if (!empty($qrcodeList)) {\\n493\\t                            $num = count($qrcodeList);\\n494\\t                            $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n495\\t                        }\\n496\\t                    }\\n497\\t                }\\n498\\t            }\\n499\\t            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n500\\t            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n501\\t        }\\n502\\t        if (!empty($id)) {\\n503\\t            Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n504\\t                ->where(\'uid\', $uid)\\n505\\t                ->update([\'buy_qrcode_id\' => $id]);\\n506\\t        }\\n507\\t        $this->success(\'success\', [\'qrcode\' => $qrcode, \'id\' => $id]);\\n508\\t    }\\n509\\t\\n510\\t    \\/*\\n511\\t    ** SPA任务列表\\n512\\t    *\\/\\n513\\t    public function coursetask()\\n514\\t    {\\n515\\t        $uid = session(\'uid\') ?? 0;\\n516\\t        $data = (new Course)->getSpaAllSubject($uid, true);\\n517\\t        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n518\\t        $this->result($data[\'msg\'], $data[\'data\'], $errNo);\\n519\\t    }\\n520\\t    \\/**\\n521\\t     * 确认到课\\n522\\t     *\\/\\n523\\t    public function cfmdaoke($uid=0,$batch_id=0,$unid=\'\'){\\n524\\t        if($uid ==0){\\/\\/正式\\n525\\t            $uid = session(\'uid\') ?? 0;\\n526\\t            $unid = input(\'unionid\', \'\');\\n527\\t            $batch_id = input(\'batch_id\', \'\');\\n528\\t        }\\n529\\t        $res = (new Course)->workdaoke($uid,$unid,$batch_id);\\n530\\t        if($res) \\n531\\t            $this->result(\'确认成功\', 1, 0);\\n532\\t        else\\n533\\t            $this->result(\'确认失败，稍后重试\', 0,4110);\\n534\\t    }\\n535\\t    \\/**\\n536\\t     * 考研规划报告第三步课程信息\\n537\\t     *\\/\\n538\\t    public function getcourse($uid=0,$batch_id=0,$unid=\'\',$cousre_id=0,$f_type=0){\\n539\\t        if($uid ==0){\\/\\/正式\\n540\\t            $uid = session(\'uid\') ?? 0;\\n541\\t            $unid = input(\'unionid\', \'\');\\n542\\t            $cousre_id = input(\'cousre_id\', \'\');\\n543\\t            $batch_id = input(\'batch_id\', \'\');\\n544\\t            $f_type = input(\'f_type\', 0); \\/\\/暂时用不着，1是上一步的请求。\\n545\\t        }\\n546\\t        $res = (new Course)->getKaoYanSubject($uid,$batch_id,$unid,2,$cousre_id);\\n547\\t        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n548\\t        if($f_type == 1){\\n549\\t            $res[\'data\'][\'focus_qrcode\'] = Env::get(\'kygh_focus.qrcode\');\\n550\\t            $res[\'data\'][\'qrnews\'] = Env::get(\'kygh_focus.qrnews\');\\n551\\t            $key1 = \\\"yxk:gzhgz:{$uid}:\\\" . Env::get(\'kygh_focus.appid\');\\n552\\t            $val = redis()->get($key1);\\n553\\t            if($val){\\n554\\t                $res[\'data\'][\'is_focus\'] = intval($val);\\n555\\t            } else {\\n556\\t                $res1 = Helpers::clphpCurl([\'uid\' => $uid, \'appid\' => Env::get(\'kygh_focus.appid\'), \'tp\' => 2], \'is_followed\');\\n557\\t                $res[\'data\'][\'is_focus\'] = intval($res1[\'data\'][\'is_follow\']) ?? 0;\\n558\\t                if($res[\'data\'][\'is_focus\']){\\n559\\t                    redis()->setex($key1,comsetextime(7200),$res[\'data\'][\'is_focus\']);\\n560\\t                }\\n561\\t            }\\n562\\t            \\/\\/是否确认到课过\\n563\\t            $res[\'data\'][\'is_daoke\'] = (new Course)->workdaoke($uid,$unid,$batch_id,1);\\n564\\t        }\\n565\\t        $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n566\\t    }\\n567\\t    \\/**\\n568\\t     * 获取资料\\n569\\t     *\\/\\n570\\t    public function getfiles(){\\n571\\t        $uid = session(\'uid\') ?? 0;\\n572\\t        $unid = input(\'unionid\', \'\');\\n573\\t        $batch_id = input(\'batch_id\', \'\');\\n574\\t        $type = input(\'type\', 0);\\n575\\t        $n = input(\'n\', 0);\\n576\\t        $res = (new Course)->getdocs($type,$batch_id,$unid,$n);\\n577\\t        $errNo = empty($res[\'errNo\']) ? (empty($res[\'msg\']) ? 0 : 4033) : $res[\'errNo\'];\\n578\\t        $data = [];\\n579\\t        if(!empty($res[\'data\'])){\\n580\\t            $data[\'data\'] = $res[\'data\'];\\n581\\t            $data[\'title\'] = (new Course)->getfilename($type,$n);\\n582\\t        }\\n583\\t        $this->result($res[\'msg\'], $data, $errNo);\\n584\\t    }\\n585\\t    public function test(){\\n586\\t        $type =  input(\'type\', \'\');\\n587\\t        $uid = 9539711;\\n588\\t        $batch_id = 10950;\\n589\\t        $unid =\'oLVvc0kcW_kUh5-svF6D5LdweL1U\';\\n590\\t        if($type == 1){\\n591\\t            $this->getcourse($uid,$batch_id,$unid,0,1);\\n592\\t            \\/\\/ $res = (new Course)->getKaoYanSubject(1,1,1,$type,1);\\n593\\t            \\/\\/ $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n594\\t            \\/\\/ $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n595\\t        }\\n596\\t        if($type == 2){\\n597\\t            $this->cfmdaoke($uid,$batch_id,$unid);\\n598\\t        }\\n599\\t        $pid = input(\'
           \\/\\/地区\\n            $area = Db::connect(\'database.yx_db_config\')\\n                ->name(\'area\')\\n                ->field(\'id,name\')\\n                ->where(\'pid\', \'>\', 0)\\n                ->select();\\n            $filter[\'area\'] = array_merge([[\'id\' => 0, \'name\' => \'全部\']], $area);\\n            \\/\\/院校属性\\n            $adminSchoolModel = new ModelSchool();\\n            $filter[\'attr\'] = array_values($adminSchoolModel->getSchoolAttr());\\n            \\/\\/院校类型\\n            $type = $adminSchoolModel->getType();\\n            array_unshift($type, \'全部\');\\n            $filter[\'type\'] = array_values($type);\\n            \\/\\/院校隶属\\n            $lishu = $adminSchoolModel->getLishu();\\n            array_unshift($lishu, \'全部\');\\n            $filter[\'lishu\'] = array_values($lishu);\\n            $redis->setex($key, 86400 * 30, json_encode($filter));\\n        }\\n        $this->success(\'success\', $filter);\\n    }\\n\\n    \\/**\\n     * Function list [院校列表]\\n     * @author erdong\\n     * @date 2022-09-29\\n     *\\/\\n    public function list()\\n    {\\n        $areaId = input(\'area_id\\/d\', 0);\\n        $keyword = input(\'keyword\\/s\', \'\', \'strip_tags,trim\');\\n        $attr = input(\'attr\\/s\', \'全部\');\\n        $type = input(\'type\\/s\', \'全部\');\\n        $lishu = input(\'lishu\\/s\', \'全部\');\\n        $majorId = input(\'major_id\\/d\', 0);\\n        $isFull = input(\'is_full\', \'全部\');\\n        $page = input(\'page\\/d\', 1);\\n        $pageSize = input(\'pagesize\', 15);\\n        $isRepeat = input(\'is_repeat\\/d\', 0);\\n        $where = [];\\n        \\/\\/关键词搜索\\n        if (!empty($keyword)) {\\n            if($isRepeat == -1){\\n                $where[\'sch.name\'] = [\'like\', $keyword . \'%\'];\\n            }else{\\n                $where[\'name\'] = [\'like\', $keyword . \'%\'];\\n            }\\n        }\\n        \\/\\/地区\\n        if ($areaId) {\\n            $where[\'area_id\'] = $areaId;\\n        }\\n        \\/\\/类型\\n        if ($type != \'全部\') {\\n            $where[\'type\'] = $type;\\n        }\\n        \\/\\/隶属\\n        if ($lishu != \'全部\') {\\n            $where[\'lishu\'] = $lishu;\\n        }\\n        if ($attr != \'全部\') {\\n            $where[] = [\'EXP\', Db::raw(\'FIND_IN_SET(\\\"\' . $attr . \'\\\",school_attr)\')];\\n        }\\n        $data[\'list\'] = [];\\n        if ($majorId) { \\/\\/专业院校列表\\n            $where[\'ms.major_id\'] = $majorId;\\n            if ($isFull != \'全部\') {\\n                $where[\'ms.is_full\'] = $isFull;\\n            }\\n            if($isRepeat == -1){\\n                $total = $this->majorSchoolModel\\n                    ->alias(\'ms\')\\n                    ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                    ->where($where)\\n                    ->group(\'ms.school_id\')\\n                    ->count();\\n            }else{\\n                $total = $this->majorSchoolModel\\n                    ->alias(\'ms\')\\n                    ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                    ->where($where)\\n                    ->count();\\n            }\\n\\n\\n            if ($total) {\\n                $offset = ($page - 1) * $pageSize;\\n                if($isRepeat == -1){\\n                    $list = $this->majorSchoolModel\\n                        ->alias(\'ms\')\\n                        ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                        ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n                        ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n                        ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n                        ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n                        ->field(\'ms.id as major_school_id, ms.school_id, sch.name as school_name, ms.is_full, yx.name as yuanxi_name, yjxk.name as yjxk_name, IFNULL(subject_assessment,100) as subject_assessment\')\\n                        ->where($where)\\n                        ->group(\'ms.school_id\')\\n                        ->limit($offset, $pageSize)\\n                        ->select();\\n                }else{\\n                    $list = $this->majorSchoolModel\\n                        ->alias(\'ms\')\\n                        ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                        ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n                        ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n                        ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n                        ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n                        ->field(\'ms.id as major_school_id, ms.school_id, sch.name as school_name, ms.is_full, yx.name as yuanxi_name, yjxk.name as yjxk_name, IFNULL(subject_assessment,100) as subject_assessment\')\\n                        ->where($where)\\n                        ->limit($offset, $pageSize)\\n                        ->select();\\n                }\\n\\n                if ($list) {\\n                    $adminSchoolMajor = new SchoolMajor();\\n                    foreach ($list as &$item) {\\n                        $item[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n                    }\\n                }\\n                $data[\'list\'] = $list;\\n            }\\n        } else {\\n            $total = $this->model\\n                ->where($where)\\n                ->count();\\n\\n            if ($total) {\\n                $offset = ($page - 1) * $pageSize;\\n                $list = $this->model\\n                    ->where($where)\\n                    ->field(\'id as school_id,code,name as school_name,logo as school_logo\')\\n                    ->order(\'id asc\')\\n                    ->limit($offset, $pageSize)\\n                    ->select();\\n                if ($list) foreach ($list as &$item) {\\n                    $item[\'school_logo\'] = CommonModelSchool::schoolLogo($item[\'school_logo\']);\\n                }\\n\\n                $data[\'list\'] = $list;\\n            }\\n        }\\n        $data[\'total_page\'] = ceil($total \\/ $pageSize);\\n        $data[\'total\'] = $total;\\n        $data[\'page_size\'] = $pageSize;\\n\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function index [院校主页]\\n     * @author erdong\\n     * @date 2022-09-29\\n     *\\/\\n    public function index()\\n    {\\n        $schoolId = input(\'school_id\\/d\', 0);\\n        if (!$schoolId) {\\n            $this->error(\'参数错误\');\\n        }\\n        \\/\\/基本信息\\n        $data = $this->model\\n            ->where(\'id\', $schoolId)\\n            ->field(\'id as school_id,name as school_name,logo as school_logo,school_attr,type,lishu,tel,email\')\\n            ->find();\\n\\n        $data[\'school_logo\'] = CommonModelSchool::schoolLogo($data[\'school_logo\']);\\n        \\n        \\/\\/优势专业\\n        $where = [\\n            \'ms.school_id\' => $schoolId,\\n        ];\\n\\n        $majorList = $this->majorModel\\n            ->alias(\'m\')\\n            ->join(\'cl_major_school ms\', \'m.id = ms.major_id\', \'LEFT\')\\n            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n            ->field(\'m.name as major_name, m.id as major_id, ms.id as major_school_id, m.code, ms.is_full, IFNULL(subject_assessment,100) as subject_assessment, yx.name as yx_name, yjxk.name as yjxk_name\')\\n            ->where($where)\\n            ->order(\'subject_assessment asc,m.id asc\')\\n            ->select();\\n        $majors = array_slice($majorList, 0, 3);\\n\\n        if ($majors) {\\n            $adminSchoolMajor = new SchoolMajor();\\n            $topCount = 0;\\n            foreach ($majors as &$item) {\\n                $subjectAssessment = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n                if ($subjectAssessment != \'无\') {\\n                    $topCount++;\\n                }\\n                $item[\'subject_assessment\'] = $subjectAssessment;\\n            }\\n        }\\n        $data[\'major_title\'] = $topCount >= 3 ? \'优势专业\' : \'专业目录\';\\n        $data[\'major_count\'] = count($majorList);\\n        $data[\'majors\'] = $majors;\\n\\n        \\/\\/招生简章\\n        $admissionModel = new Admission();\\n        $data[\'zsjz\'] = $admissionModel->getListBySchool($schoolId);\\n\\n        \\/\\/学院\\n        $data[\'yuanxi\'] = Db::connect(\'database.yx_db_config\')\\n            ->name(\'cl_major_school\')\\n            ->alias(\'cms\')\\n            ->join(\'cl_yuanxi cy\', \'cms.yuanxi_id = cy.id\', \'LEFT\')\\n            ->field(\'cy.id as yuanxi_id,cy.name as yuanxi_name,COUNT(cms.id) as major_count\')\\n            ->where(\'cms.school_id\', $schoolId)\\n            ->group(\'cms.yuanxi_id\')\\n            ->select();\\n\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function introduce [院校介绍]\\n     * @author erdong\\n     * @date 2022-10-10\\n     *\\/\\n    public function introduce()\\n    {\\n        $schoolId = input(\'school_id\\/d\', 0);\\n        if (!$schoolId) {\\n            $this->error(\'参数错误\');\\n        }\\n        $data = [];\\n        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n        if ($schoolInfo) {\\n            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n            $data[\'school_name\'] = $schoolInfo[\'school_name\'];\\n            $data[\'address\'] = $schoolInfo[\'address\'];\\n            $data[\'introduce\'] = $schoolInfo[\'xxjs\'];\\n        }\\n        $data[\'school_logo\'] = CommonModelSchool::schoolLogo($data[\'school_logo\']);\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function zsjzList [招生简章列表]\\n     * @author erdong\\n     * @date 2022-10-11\\n     *\\/\\n    public function zsjzList()\\n    {\\n        $schoolId = input(\'school_id\\/d\', 0);\\n        if (!$schoolId) {\\n            $this->error(\'参数错误\');\\n        }\\n        $data = [];\\n        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n        if ($schoolInfo) {\\n            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n            $data[\'school_name\'] = $schoolInfo[\'school_name\'];\\n            $admissionModel = new Admission();\\n            $field = \'year,title,zsjz as content\';\\n            $data[\'zsjz_list\'] = $admissionModel->getListBySchool($schoolId, $field, 100);\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n}\\n\",\"numLines\":311,\"startLine\":1,\"totalLines\":311}}}' , `created_at` = '2026-07-07 21:35:27' [ RunTime:0.002801s ]

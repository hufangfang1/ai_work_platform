\'000\');\\n284\\t        $this->success(\'success\', $return);\\n285\\t    }\\n286\\t\\n287\\t    \\/**\\n288\\t     * Function wxIndex [获取配置信息]\\n289\\t     * Auther: Changzd\\n290\\t     * Date: 2023\\/11\\/20\\n291\\t     *\\/\\n292\\t    public function wxIndex()\\n293\\t    {\\n294\\t        $data = [];\\n295\\t        $errno = 0;\\n296\\t        $msg = \'\';\\n297\\t        $uid = session(\'uid\');\\n298\\t        $userExtend = [];\\n299\\t        if (!empty($uid)) {\\n300\\t            $userExtend = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n301\\t                ->where(\'uid\', $uid)\\n302\\t                ->field(\'exam_period, fix_school, fix_major\')\\n303\\t                ->find();\\n304\\t        }\\n305\\t\\n306\\t        do {\\n307\\t            if ($this->request->isPost()) {\\n308\\t                $examPeriod = input(\'exam_period\\/d\', 0);\\n309\\t                $fixSchool = input(\'fix_school\\/d\', 0);\\n310\\t                $fixMajor = input(\'fix_major\\/d\', 0);\\n311\\t                if (empty($examPeriod)) {\\n312\\t                    $msg = \'请选择考研时间\';\\n313\\t                    $errno = ComErrorDescs::EC_INVALID_PARAM;\\n314\\t                    break;\\n315\\t                }\\n316\\t                if (empty($uid)) {\\n317\\t                    $msg = ComErrorDescs::errmsg(ComErrorDescs::APP_LOGIN_INVALID);\\n318\\t                    $errno = ComErrorDescs::APP_LOGIN_INVALID;\\n319\\t                    break;\\n320\\t                }\\n321\\t                $now = time();\\n322\\t                $data[\'target\'] = [];\\n323\\t                if (!empty($uid)) {\\n324\\t                    if (empty($userExtend)) {\\n325\\t                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')->insert([\\n326\\t                            \'uid\' => $uid,\\n327\\t                            \'exam_period\' => $examPeriod,\\n328\\t                            \'fix_school\' => $fixSchool,\\n329\\t                            \'fix_major\' => $fixMajor,\\n330\\t                            \'created_at\' => $now,\\n331\\t                            \'updated_at\' => $now\\n332\\t                        ]);\\n333\\t                    } else {\\n334\\t                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n335\\t                            ->where(\'uid\', $uid)\\n336\\t                            ->update([\\n337\\t                                \'exam_period\' => $examPeriod,\\n338\\t                                \'fix_school\' => $fixSchool,\\n339\\t                                \'fix_major\' => $fixMajor,\\n340\\t                                \'updated_at\' => $now\\n341\\t                            ]);\\n342\\t                    }\\n343\\t                    try {\\n344\\t                        \\/\\/ 同步用户中心\\n345\\t                        Helpers::ucenterCurl([\\n346\\t                            \'uid\' => $uid,\\n347\\t                            \'exam_period\' => $examPeriod,\\n348\\t                        ], \'put_exam_period\');\\n349\\t                    } catch (\\\\Exception $e) {\\n350\\t                    }\\n351\\t                    redis()->del(\\\\app\\\\api\\\\logic\\\\User::KY_TARGET_KEY . $uid);\\n352\\t                    $data[\'target\'] = (new \\\\app\\\\api\\\\logic\\\\User())->getKyTarget($uid);\\n353\\t                }\\n354\\t            } else {\\n355\\t                $examPeriod = !empty($userExtend[\'exam_period\']) ? $userExtend[\'exam_period\'] : \'\';\\n356\\t                $examLabel = (new ClappLogic())->getClassifyLabelByFirstSubject();\\n357\\t                $data = [\\n358\\t                    [\\n359\\t                        \'type\' => \'exam\',\\n360\\t                        \'selected\' => $examPeriod,\\n361\\t                        \'title\' => \'你的考研时间\',\\n362\\t                        \'options\' => $examLabel,\\n363\\t                    ],\\n364\\t                    [\\n365\\t                        \'type\' => \'school\',\\n366\\t                        \'selected\' => $userExtend[\'fix_school\'] ?? \'\',\\n367\\t                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>院校<\\/span>是否已明确？\\\",\\n368\\t                        \'options\' => [\\n369\\t                            [\\n370\\t                                \'value\' => \'1\',\\n371\\t                                \'title\' => \'已明确|考研院校\',\\n372\\t                            ],\\n373\\t                            [\\n374\\t                                \'value\' => \'2\',\\n375\\t                                \'title\' => \'还没想好|考哪个学校\',\\n376\\t                            ],\\n377\\t                        ]\\n378\\t                    ],\\n379\\t                    [\\n380\\t                        \'type\' => \'major\',\\n381\\t                        \'selected\' => $userExtend[\'fix_major\'] ?? \'\',\\n382\\t                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>专业<\\/span>是否已明确？\\\",\\n383\\t                        \'options\' => [\\n384\\t                            [\\n385\\t                                \'value\' => \'1\',\\n386\\t                                \'title\' => \'已明确|考研专业\',\\n387\\t                            ],\\n388\\t                            [\\n389\\t                                \'value\' => \'2\',\\n390\\t                                \'title\' => \'还没想好|考哪个专业\',\\n391\\t                            ],\\n392\\t                        ]\\n393\\t                    ]\\n394\\t                ];\\n395\\t            }\\n396\\t        } while (false);\\n397\\t\\n398\\t        $this->result($msg, $data, $errno);\\n399\\t    }\\n400\\t\\n401\\t    public function getBuyQrcode()\\n402\\t    {\\n403\\t        $id = input(\'id\\/d\', 0);\\n404\\t        $unid = input(\'unionid\', \'\');\\n405\\t        $uid = session(\'uid\');\\n406\\t        $catchKey = \'yxk:wxmini:buyqrcode:catch:init:\' . date(\'Ymd\', time());\\n407\\t        $init = redis()->get($catchKey);\\n408\\t        if (empty($init)) {\\n409\\t            Db::name(\'buy_qrcode\')->where(\'id\', \'>\', 0)->update([\'day_refresh\' => 0]);\\n410\\t            redis()->setex($catchKey, 3600 * 24, 1);\\n411\\t        }\\n412\\t        $qrcodeList = Db::name(\'buy_qrcode\')\\n413\\t            ->where(\'status\', 0)\\n414\\t            ->field(\'id,qrcode,mobile\')\\n415\\t            ->select();\\n416\\t        $qrcodeList = array_column($qrcodeList, null, \'id\');\\n417\\t        if (!empty($id)) {\\n418\\t            $info = Db::name(\'buy_qrcode\')\\n419\\t                ->where(\'id\', $id)\\n420\\t                ->find();\\n421\\t            $times = $info[\'day_refresh\'];\\n422\\t            $mobile = $info[\'mobile\'];\\n423\\t            if ($times >= 10) {\\n424\\t                $sendKey = \'yxk:wxmini:buyqrcode:catch:send:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n425\\t                $sendValue = redis()->get($sendKey);\\n426\\t                if (empty($sendValue)) {\\n427\\t                    redis()->setex($sendKey, 3600 * 24, 1);\\n428\\t                    sendFeishu($mobile . \\\"二维码单日刷新次数已经超过10次，请排查“加好友”功能是否封禁，点击链接处理（确定解封地址不变）\\\\n\\\" . config(\'self_website_url\') . \'yxAdmin.php\\/buy_qrcode\\/edit1?ids=\' . $info[\'id\'], $mobile);\\n429\\t                }\\n430\\t            }\\n431\\t            $historyId = (new Common())->getHistoryId($unid,$qrcodeList,$id);\\n432\\t            if (!empty($historyId)) {\\n433\\t                if (isset($qrcodeList[$historyId])) {\\n434\\t                    $qrcodeInfo = $qrcodeList[$historyId];\\n435\\t                } else {\\n436\\t                    unset($qrcodeList[$id]);\\n437\\t                    if (!empty($qrcodeList)) {\\n438\\t                        $num = count($qrcodeList);\\n439\\t                        $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n440\\t                    }\\n441\\t                }\\n442\\t            } else {\\n443\\t                unset($qrcodeList[$id]);\\n444\\t                if (!empty($qrcodeList)) {\\n445\\t                    $num = count($qrcodeList);\\n446\\t                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n447\\t                }\\n448\\t            }\\n449\\t            if (!empty($qrcodeInfo)) {\\n450\\t                $freshKey = \'yxk:wxmini:buyqrcode:catch:fresh:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n451\\t                $freshValue = redis()->get($freshKey);\\n452\\t                $refresh = $info[\'refresh\'];\\n453\\t                $dayRefresh = $info[\'day_refresh\'];\\n454\\t                if (empty($freshValue)) {\\n455\\t                    redis()->setex($freshKey, 3600 * 24, 1);\\n456\\t                    Db::name(\'buy_qrcode\')\\n457\\t                        ->where(\'id\', $id)\\n458\\t                        ->update([\\n459\\t                            \'refresh\' => $refresh + 1,\\n460\\t                            \'day_refresh\' => $dayRefresh + 1,\\n461\\t                            \'updatetime\' => time()\\n462\\t                        ]);\\n463\\t                }\\n464\\t            } elseif ($info[\'status\'] == 0) {\\n465\\t                $qrcodeInfo = $info;\\n466\\t            }\\n467\\t            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n468\\t            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n469\\t        } else {\\n470\\t            $myId = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n471\\t                ->where(\'uid\', $uid)\\n472\\t                ->value(\'buy_qrcode_id\');\\n473\\t            trace(\'myId:\'.$myId);\\n474\\t            if (empty($myId)) {\\n475\\t                if (!empty($qrcodeList)) {\\n476\\t                    $num = count($qrcodeList);\\n477\\t                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n478\\t                }\\n479\\t            } else {\\n480\\t                $qrcodeInfo = $qrcodeList[$myId] ?? [];\\n481\\t                if (empty($qrcodeInfo)) {\\n482\\t                    $historyId = (new Common())->getHistoryId($unid,$qrcodeList);\\n483\\t                    if (!empty($historyId)) {\\n484\\t                        $qrcodeInfo = $qrcodeList[$historyId] ?? [];\\n485\\t                        if (empty($qrcodeInfo)) {\\n486\\t                            if (!empty($qrcodeList)) {\\n487\\t                                $num = count($qrcodeList);\\n488\\t                                $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n489\\t                            }\\n490\\t                        }\\n491\\t                    } else {\\n492\\t                        if (!empty($qrcodeList)) {\\n493\\t                            $num = count($qrcodeList);\\n494\\t                            $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n495\\t                        }\\n496\\t                    }\\n497\\t                }\\n498\\t            }\\n499\\t            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n500\\t            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n501\\t        }\\n502\\t        if (!empty($id)) {\\n503\\t            Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n504\\t                ->where(\'uid\', $uid)\\n505\\t                ->update([\'buy_qrcode_id\' => $id]);\\n506\\t        }\\n507\\t        $this->success(\'success\', [\'qrcode\' => $qrcode, \'id\' => $id]);\\n508\\t    }\\n509\\t\\n510\\t    \\/*\\n511\\t    ** SPA任务列表\\n512\\t    *\\/\\n513\\t    public function coursetask()\\n514\\t    {\\n515\\t        $uid = session(\'uid\') ?? 0;\\n516\\t        $data = (new Course)->getSpaAllSubject($uid, true);\\n517\\t        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n518\\t        $this->result($data[\'msg\'], $data[\'data\'], $errNo);\\n519\\t    }\\n520\\t    \\/**\\n521\\t     * 确认到课\\n522\\t     *\\/\\n523\\t    public function cfmdaoke($uid=0,$batch_id=0,$unid=\'\'){\\n524\\t        if($uid ==0){\\/\\/正式\\n525\\t            $uid = session(\'uid\') ?? 0;\\n526\\t            $unid = input(\'unionid\', \'\');\\n527\\t            $batch_id = input(\'batch_id\', \'\');\\n528\\t        }\\n529\\t        $res = (new Course)->workdaoke($uid,$unid,$batch_id);\\n530\\t        if($res) \\n531\\t            $this->result(\'确认成功\', 1, 0);\\n532\\t        else\\n533\\t            $this->result(\'确认失败，稍后重试\', 0,4110);\\n534\\t    }\\n535\\t    \\/**\\n536\\t     * 考研规划报告第三步课程信息\\n537\\t     *\\/\\n538\\t    public function getcourse($uid=0,$batch_id=0,$unid=\'\',$cousre_id=0,$f_type=0){\\n539\\t        if($uid ==0){\\/\\/正式\\n540\\t            $uid = session(\'uid\') ?? 0;\\n541\\t            $unid = input(\'unionid\', \'\');\\n542\\t            $cousre_id = input(\'cousre_id\', \'\');\\n543\\t            $batch_id = input(\'batch_id\', \'\');\\n544\\t            $f_type = input(\'f_type\', 0); \\/\\/暂时用不着，1是上一步的请求。\\n545\\t        }\\n546\\t        $res = (new Course)->getKaoYanSubject($uid,$batch_id,$unid,2,$cousre_id);\\n547\\t        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n548\\t        if($f_type == 1){\\n549\\t            $res[\'data\'][\'focus_qrcode\'] = Env::get(\'kygh_focus.qrcode\');\\n550\\t            $res[\'data\'][\'qrnews\'] = Env::get(\'kygh_focus.qrnews\');\\n551\\t            $key1 = \\\"yxk:gzhgz:{$uid}:\\\" . Env::get(\'kygh_focus.appid\');\\n552\\t            $val = redis()->get($key1);\\n553\\t            if($val){\\n554\\t                $res[\'data\'][\'is_focus\'] = intval($val);\\n555\\t            } else {\\n556\\t                $res1 = Helpers::clphpCurl([\'uid\' => $uid, \'appid\' => Env::get(\'kygh_focus.appid\'), \'tp\' => 2], \'is_followed\');\\n557\\t                $res[\'data\'][\'is_focus\'] = intval($res1[\'data\'][\'is_follow\']) ?? 0;\\n558\\t                if($res[\'data\'][\'is_focus\']){\\n559\\t                    redis()->setex($key1,comsetextime(7200),$res[\'data\'][\'is_focus\']);\\n560\\t                }\\n561\\t            }\\n562\\t            \\/\\/是否确认到课过\\n563\\t            $res[\'data\'][\'is_daoke\'] = (new Course)->workdaoke($uid,$unid,$batch_id,1);\\n564\\t        }\\n565\\t        $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n566\\t    }\\n567\\t    \\/**\\n568\\t     * 获取资料\\n569\\t     *\\/\\n570\\t    public function getfiles(){\\n571\\t        $uid = session(\'uid\') ?? 0;\\n572\\t        $unid = input(\'unionid\', \'\');\\n573\\t        $batch_id = input(\'batch_id\', \'\');\\n574\\t        $type = input(\'type\', 0);\\n575\\t        $n = input(\'n\', 0);\\n576\\t        $res = (new Course)->getdocs($type,$batch_id,$unid,$n);\\n577\\t        $errNo = empty($res[\'errNo\']) ? (empty($res[\'msg\']) ? 0 : 4033) : $res[\'errNo\'];\\n578\\t        $data = [];\\n579\\t        if(!empty($res[\'data\'])){\\n580\\t            $data[\'data\'] = $res[\'data\'];\\n581\\t            $data[\'title\'] = (new Course)->getfilename($type,$n);\\n582\\t        }\\n583\\t        $this->result($res[\'msg\'], $data, $errNo);\\n584\\t    }\\n585\\t    public function test(){\\n586\\t        $type =  input(\'type\', \'\');\\n587\\t        $uid = 9539711;\\n588\\t        $batch_id = 10950;\\n589\\t        $unid =\'oLVvc0kcW_kUh5-svF6D5LdweL1U\';\\n590\\t        if($type == 1){\\n591\\t            $this->getcourse($uid,$batch_id,$unid,0,1);\\n592\\t            \\/\\/ $res = (new Course)->getKaoYanSubject(1,1,1,$type,1);\\n593\\t            \\/\\/ $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n594\\t            \\/\\/ $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n595\\t        }\\n596\\t        if($type == 2){\\n597\\t            $this->cfmdaoke($uid,$batch_id,$unid);\\n598\\t        }\\n599\\t        $pid = input(\'pid\', 0);\\n600\\t        if($pid){\\n601\\t            $res = Helpers::clappCurl([\\n602\\t                \'periodIds\' => $pid\\n603\\t            ], \'get_period_info_live_status\');\\n604\\t            ddp($res);exit;\\n605\\t        }\\n606\\t        $cid = input(\'cid\', 0);\\n607\\t        $res = Helpers::clappCurl([\\n608\\t            \'courseIds\' => $cid,\\n609\\t            \'fileType\' => 9\\n610\\t        ], \'get_course_and_period_info\');\\n611\\t        \\/\\/ $res = Helpers::openapiCurl([\\n612\\t        \\/\\/     \'ids\'=>[$cid]\\n613\\t        \\/\\/ ],\'get_bch_csids\');\\n614\\t        \\/\\/ $res = (new Course)->getcoursebatchs($cid );\\n615\\t        ddp($res);exit;\\n616\\t    }\\n617\\t}\\n618\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"709785dc-e16e-484f-9922-07c4f799ccb4\",\"uuid\":\"f6f8cfe7-3762-4887-9c89-28756b2716e9\",\"timestamp\":\"2026-07-07T17:11:24.758Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/yuanxiao\\/application\\/api\\/controller\\/Index.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\api\\\\library\\\\ComErrorDescs;\\nuse app\\\\api\\\\logic\\\\Common;\\nuse app\\\\api\\\\logic\\\\Course;\\nuse app\\\\api\\\\logic\\\\Document;\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\common\\\\library\\\\Helpers;\\nuse app\\\\common\\\\logic\\\\ClappLogic;\\nuse app\\\\common\\\\logic\\\\Conf;\\nuse fast\\\\ImageBuild;\\nuse fast\\\\Random;\\nuse org\\\\Es;\\nuse think\\\\Cookie;\\nuse think\\\\Db;\\nuse think\\\\Exception;\\nuse think\\\\Env;\\n\\n\\/**\\n * 首页接口\\n *\\/\\nclass Index extends ApiAuth\\n{\\n    protected $noNeedLogin = [\'getbuyqrcode\', \'getnotice\', \'index\', \'wxindex\', \'indexv40\'];\\n    protected $noNeedRight = [\'getbuyqrcode\', \'getnotice\', \'applypage\', \'index\', \'wxindex\', \'indexv40\', \'coursetask\', \'recordqrcode\',\'getcourse\',\'getfiles\',\'test\',\'cfmdaoke\'];\\n\\n    \\/**\\n     * Function indexV40 [考研星球V4.0首页改版]\\n     * Auther: Changzd\\n     * Date: 2023\\/11\\/20\\n     *\\/\\n    public function indexV40()\\n    {\\n        $data = [];\\n        $uid = session(\'uid\') ?? 0;\\n        trace(\\\"indexV40:uid:{$uid};ip:\\\" . $_SERVER[\'SERVER_ADDR\'], \\\"info\\\");\\n        if (!empty($uid)) {\\n            $data[\'target\'] = (new \\\\app\\\\api\\\\logic\\\\User())->getKyTarget($uid);\\n        } else {\\n            $data[\'target\'] = [];\\n        }\\n        $data[\'is_set_target\'] = !empty($data[\'target\']) && !empty($data[\'target\'][\'school_id\']) ? 1 : 0;\\n        $data[\'is_set_fix\'] = !empty($data[\'target\']) && !empty($data[\'target\'][\'exam_period\']) ? 1 : 0;\\n        \\/\\/ 长难句二维码路径\\n        $data[\'sentence_qrcode\'] = \'https:\\/\\/fc.orangevip.com\\/qrcode\\/202311\\/28\\/1044529zi2n0ekms6e1ufo.png\';\\n        \\/\\/ 赠送橙币数量\\n        $data[\'give_cb_num\'] = \\\\app\\\\api\\\\logic\\\\User::KY_TARGET_GIVE_CB;\\n        \\/\\/ 赠送资料券数量\\n        $data[\'give_doccoupon_num\'] = \\\\app\\\\api\\\\logic\\\\User::KY_TARGET_GIVE_DOCCOUPON;\\n        \\/\\/ spa全科规划\\n        $data[\'spa_all_subject\'] = ($data[\'is_set_fix\']) ? (new Course)->getSpaAllSubject($uid) : [];\\n        $document = (new Document())->docIndexV40();\\n        \\/\\/ 学长带学\\n        $data[\'senior_teach\'] = $document[\'senior\'] ?? [];\\n        \\/\\/ 备考经验\\n        $data[\'experience\'] = $document[\'experience\'] ?? [];\\n        $data[\'exam_subject_id\'] = 0;\\n        $data[\'exam_subject_name\'] = \'\';\\n        if(!empty($data[\'target\'][\'major_code\'])){\\n            $data[\'exam_subject_id\'] = (new Course)->getExamSubject($data[\'target\'][\'major_code\']);\\n            if(!empty($data[\'exam_subject_id\'])){\\n                $data[\'exam_subject_name\'] = (new Course)->getExamSubjectName($data[\'exam_subject_id\']);\\n            }\\n        }\\n        trace(\\\"indexV40:---{$uid}---end\\\", \\\"info\\\");\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * 首页\\n     *\\n     *\\/\\n    public function index()\\n    {\\n        $orders = Db::connect(\'database.cl_db_config\')->name(\'otm_order\')->alias(\'a\')\\n            ->join(\'otm_order_detail b\', \'a.main_order_no=b.main_order_no\', \'left\')\\n            ->join(\'otm_course_model_extend e\', \'b.course_model_id=e.course_model_id\', \'left\')\\n            ->whereIn(\'b.user_id\', [1, 2])\\n            ->whereIn(\'b.order_stauts\', [\'2\', \'11\'])\\n            ->where(\'a.pay_price\', \'>\', 9.9)\\n            ->where(\'e.first_subject\', 1)\\n            ->field(\'b.user_id,sum(a.pay_price) as price\')\\n            ->group(\'b.user_id\')->buildSql();\\n        ddp($orders, 1);\\n\\n        $str = \',  ,2\';\\n        ddp(explode(\',\', $str));\\n        $uidArr = array_filter(explode(\',\', $str), function ($a) {\\n            return empty(trim($a)) ? false : true;\\n        });\\n        ddp($uidArr);\\n        $res = array_chunk($uidArr, 3);\\n        ddp(array_unique($uidArr));\\n        ddp($res, 1);\\n        $chooseSchoolLogic = new \\\\app\\\\api\\\\logic\\\\ChooseSchool();\\n        $res = $chooseSchoolLogic->getUserLevelScore(\\n            \'大学数学优秀（80以上）\',\\n            \'排名前10%\',\\n            \'一年以上\',\\n            \'未过四级\',\\n            \'否\',\\n            \'否\',\\n            \'数学一\',\\n            \'1\'\\n\\n        );\\n        dd($res);\\n        $this->success(\'Welcome to 橙啦！\');\\n    }\\n\\n    \\/**\\n     * desc:获取小程序滚动提示语\\n     * author:hufangfang\\n     * data:2023\\/2\\/10 14:12\\n     * @return void\\n     *\\/\\n    public function getNotice()\\n    {\\n        $key = \\\"yxk:wxmini:index:notice:\\\" . date(\'Ymd\', time());\\n        $val = redis()->get($key);\\n        $notice = [];\\n        if (!$val) {\\n            $randUid = mt_rand(100000, 12785000);\\n            $userInfo = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n                ->where(\'uid\', \'>\', $randUid)\\n                ->whereNotLike(\'username\', \'小橙子%\')\\n                ->limit(7)\\n                ->column(\'username\');\\n            foreach ($userInfo as $k => $username) {\\n                $username = mb_substr($username, 0, 1);\\n                $username = $username . \'**\';\\n                $notice[] = $username . \'刚开通了择校VIP\';\\n            }\\n            $now = time();\\n            $h = intval(date(\'H\', $now));\\n            $diff = $now - strtotime(date(\'Y-m-d\', $now) . \\\" 00:00:00\\\");\\n            $diff = empty($diff) ? 1 : $diff;\\n            if ($h <= 7) {\\n                $inItMinNum = ceil($diff \\/ 10);\\n                $inItMaxNum = 4 * ceil($diff \\/ 10);\\n                $addMinNum = 1;\\n                $addMaxNum = 4;\\n                $del = 100;\\n            } else {\\n                $inItMinNum = ceil($diff \\/ 10);\\n                $inItMaxNum = 4 * ceil($diff \\/ 15);\\n                $addMinNum = 3;\\n                $addMaxNum = 12;\\n                $del = 100;\\n            }\\n            $num = $this->getRandNum(\'xxx\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n            $notice[] = \'今天有\' . $num . \'人使用院校库功能\';\\n            \\/\\/            $notice[] = \'今天有\' . $num . \'人使用院校库功能\';\\n            if ($h <= 7) {\\n                $inItMinNum = 0;\\n                $inItMaxNum = 50;\\n                $addMinNum = 3;\\n                $addMaxNum = 15;\\n                $del = 1000;\\n            } else {\\n                $inItMinNum = 50;\\n                $inItMaxNum = 500;\\n                $addMinNum = 60;\\n                $addMaxNum = 300;\\n                $del = 10000;\\n            }\\n            $num = $this->getRandNum(\'yyy\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n            $notice[] = \'今天有\' . $num . \'人兑换了资料库内容\';\\n            \\/\\/            $notice[] = \'今天有\' . $num . \'人兑换了资料库内容\';\\n            if ($h <= 7) {\\n                $inItMinNum = 0;\\n                $inItMaxNum = 100;\\n                $addMinNum = 3;\\n                $addMaxNum = 15;\\n                $del = 1000;\\n            } else {\\n                $inItMinNum = 100;\\n                $inItMaxNum = 500;\\n                $addMinNum = 60;\\n                $addMaxNum = 300;\\n                $del = 10000;\\n            }\\n            $num = $this->getRandNum(\'zzz\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n            $notice[] = \'今天新增了\' . $num . \'份真题资料\';\\n            redis()->setex($key, 5 * 60, json_encode_cus($notice));\\n        } else {\\n            $notice = json_decode($val, true);\\n        }\\n        shuffle($notice);\\n        $this->success(\'success\', $notice);\\n    }\\n\\n    private function getRandNum($type, $diffTime = [], $addNum = [], $initNum = [], $del = 1)\\n    {\\n        $randTimekey = \\\"yxk:wxmini:index:notice:rand:time:\\\" . date(\'Ymd\', time()) . \\\":\\\" . $type;\\n        $randval = redis()->get($randTimekey);\\n        $randDiffTime = mt_rand($diffTime[0], $diffTime[1]);\\n        if (!empty($randval)) {\\n            $randval = json_decode($randval, true);\\n            $time = $randval[\'time\'] ?? \'\';\\n            $lastTime = $randval[\'lastTime\'] ?? time();\\n            $num = $randval[\'num\'] ?? 0;\\n            $now = time();\\n            $diffTime = floor(($now - $lastTime) \\/ 60);\\n            if ($diffTime > $time) {\\n                $randval[\'time\'] = $randDiffTime;\\n                $randval[\'lastTime\'] = time();\\n                $num += ceil((mt_rand($addNum[0], $addNum[1]) \\/ $del) * $diffTime);\\n                $randval[\'num\'] = $num;\\n            }\\n        } else {\\n            $randval = [];\\n            $randval[\'time\'] = $randDiffTime;\\n            $randval[\'lastTime\'] = time();\\n            $num = mt_rand($initNum[0], $initNum[1]);\\n            $randval[\'num\'] = $num;\\n        }\\n        redis()->setex($randTimekey, 3600 * 24, json_encode_cus($randval));\\n        return $num;\\n    }\\n\\n    public function applyPage()\\n    {\\n        $type = input(\'type\', 1);\\n        if ($type == 1) {\\n            $img = [\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_1.png\',\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_2.png\',\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_3.png\'\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/20261.png\',\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/2.png\',\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/3.png\'\\n            ];\\n        } else {\\n            $img = [\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_1.png\',\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_2.png\',\\n                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_3.png\',\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/20261.png\',\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/2_end.png\',\\n                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/3_end.png\'\\n            ];\\n        }\\n\\n        $uid = session(\'uid\');\\n        $status = 0;\\n        if (!empty($uid)) {\\n            $userScore = Db::name(\'user_score\')->where(\'uid\', $uid)->find();\\n            $seniorInfo = Db::connect(\'database.docs_db_config\')->name(\'users\')\\n                ->where(\'uid\', $uid)\\n                ->find();\\n            if (!empty($userScore) && $userScore[\'type\'] > 0) {\\n                $status = 1;\\n                if (!empty($seniorInfo)) {\\n                    switch ($seniorInfo[\'verify\']) {\\n                        case 0:\\n                            $status = 1; \\/\\/已填写未入住\\n                            break;\\n                        case 1:\\n                        case 4:\\n                            $status = 2; \\/\\/已填写入驻审核中\\n                            break;\\n                        case 2:\\n                            $status = 3; \\/\\/已填写入驻申请通过\\n                            break;\\n                        case 3:\\n                            $status = 4; \\/\\/已填写入驻申请审核失败\\n                            break;\\n                        default:\\n                            break;\\n                    }\\n                }\\n            }\\n        }\\n        $return[\'image\'] = $img;\\n        $return[\'status\'] = $status;\\n        \\/\\/ $time = \'2024-04-25 00:00:00\';\\n        \\/\\/ $return[\'end_time_text\'] = \'报名截止时间为4月24日24:00\';\\n        $time = \'2026-04-15 00:00:00\';\\n        $return[\'end_time_text\'] = \'报名截止时间为4月14日24:00\';\\n        $return[\'end_time\'] = intval(strtotime($time) . \'000\');\\n        $this->success(\'success\', $return);\\n    }\\n\\n    \\/**\\n     * Function wxIndex [获取配置信息]\\n     * Auther: Changzd\\n     * Date: 2023\\/11\\/20\\n     *\\/\\n    public function wxIndex()\\n    {\\n        $data = [];\\n        $errno = 0;\\n        $msg = \'\';\\n        $uid = session(\'uid\');\\n        $userExtend = [];\\n        if (!empty($uid)) {\\n            $userExtend = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n                ->where(\'uid\', $uid)\\n                ->field(\'exam_period, fix_school, fix_major\')\\n                ->find();\\n        }\\n\\n        do {\\n            if ($this->request->isPost()) {\\n                $examPeriod = input(\'exam_period\\/d\', 0);\\n                $fixSchool = input(\'fix_school\\/d\', 0);\\n                $fixMajor = input(\'fix_major\\/d\', 0);\\n                if (empty($examPeriod)) {\\n                    $msg = \'请选择考研时间\';\\n                    $errno = ComErrorDescs::EC_INVALID_PARAM;\\n                    break;\\n                }\\n                if (empty($uid)) {\\n                    $msg = ComErrorDescs::errmsg(ComErrorDescs::APP_LOGIN_INVALID);\\n                    $errno = ComErrorDescs::APP_LOGIN_INVALID;\\n                    break;\\n                }\\n                $now = time();\\n                $data[\'target\'] = [];\\n                if (!empty($uid)) {\\n                    if (empty($userExtend)) {\\n                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')->insert([\\n                            \'uid\' => $uid,\\n                            \'exam_period\' => $examPeriod,\\n                            \'fix_school\' => $fixSchool,\\n                            \'fix_major\' => $fixMajor,\\n                            \'created_at\' => $now,\\n                            \'updated_at\' => $now\\n                        ]);\\n                    } else {\\n                        Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n                            ->where(\'uid\', $uid)\\n                            ->update([\\n                                \'exam_period\' => $examPeriod,\\n                                \'fix_school\' => $fixSchool,\\n                                \'fix_major\' => $fixMajor,\\n                                \'updated_at\' => $now\\n                            ]);\\n                    }\\n                    try {\\n                        \\/\\/ 同步用户中心\\n                        Helpers::ucenterCurl([\\n                            \'uid\' => $uid,\\n                            \'exam_period\' => $examPeriod,\\n                        ], \'put_exam_period\');\\n                    } catch (\\\\Exception $e) {\\n                    }\\n                    redis()->del(\\\\app\\\\api\\\\logic\\\\User::KY_TARGET_KEY . $uid);\\n                    $data[\'target\'] = (new \\\\app\\\\api\\\\logic\\\\User())->getKyTarget($uid);\\n                }\\n            } else {\\n                $examPeriod = !empty($userExtend[\'exam_period\']) ? $userExtend[\'exam_period\'] : \'\';\\n                $examLabel = (new ClappLogic())->getClassifyLabelByFirstSubject();\\n                $data = [\\n                    [\\n                        \'type\' => \'exam\',\\n                        \'selected\' => $examPeriod,\\n                        \'title\' => \'你的考研时间\',\\n                        \'options\' => $examLabel,\\n                    ],\\n                    [\\n                        \'type\' => \'school\',\\n                        \'selected\' => $userExtend[\'fix_school\'] ?? \'\',\\n                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>院校<\\/span>是否已明确？\\\",\\n                        \'options\' => [\\n                            [\\n                                \'value\' => \'1\',\\n                                \'title\' => \'已明确|考研院校\',\\n                            ],\\n                            [\\n                                \'value\' => \'2\',\\n                                \'title\' => \'还没想好|考哪个学校\',\\n                            ],\\n                        ]\\n                    ],\\n                    [\\n                        \'type\' => \'major\',\\n                        \'selected\' => $userExtend[\'fix_major\'] ?? \'\',\\n                        \'title\' => \\\"考研目标<span style=\'color:#FD5C09\'>专业<\\/span>是否已明确？\\\",\\n                        \'options\' => [\\n                            [\\n                                \'value\' => \'1\',\\n                                \'title\' => \'已明确|考研专业\',\\n                            ],\\n                            [\\n                                \'value\' => \'2\',\\n                                \'title\' => \'还没想好|考哪个专业\',\\n                            ],\\n                        ]\\n                    ]\\n                ];\\n            }\\n        } while (false);\\n\\n        $this->result($msg, $data, $errno);\\n    }\\n\\n    public function getBuyQrcode()\\n    {\\n        $id = input(\'id\\/d\', 0);\\n        $unid = input(\'unionid\', \'\');\\n        $uid = session(\'uid\');\\n        $catchKey = \'yxk:wxmini:buyqrcode:catch:init:\' . date(\'Ymd\', time());\\n        $init = redis()->get($catchKey);\\n        if (empty($init)) {\\n            Db::name(\'buy_qrcode\')->where(\'id\', \'>\', 0)->update([\'day_refresh\' => 0]);\\n            redis()->setex($catchKey, 3600 * 24, 1);\\n        }\\n        $qrcodeList = Db::name(\'buy_qrcode\')\\n            ->where(\'status\', 0)\\n            ->field(\'id,qrcode,mobile\')\\n            ->select();\\n        $qrcodeList = array_column($qrcodeList, null, \'id\');\\n        if (!empty($id)) {\\n            $info = Db::name(\'buy_qrcode\')\\n                ->where(\'id\', $id)\\n                ->find();\\n            $times = $info[\'day_refresh\'];\\n            $mobile = $info[\'mobile\'];\\n            if ($times >= 10) {\\n                $sendKey = \'yxk:wxmini:buyqrcode:catch:send:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n                $sendValue = redis()->get($sendKey);\\n                if (empty($sendValue)) {\\n                    redis()->setex($sendKey, 3600 * 24, 1);\\n                    sendFeishu($mobile . \\\"二维码单日刷新次数已经超过10次，请排查“加好友”功能是否封禁，点击链接处理（确定解封地址不变）\\\\n\\\" . config(\'self_website_url\') . \'yxAdmin.php\\/buy_qrcode\\/edit1?ids=\' . $info[\'id\'], $mobile);\\n                }\\n            }\\n            $historyId = (new Common())->getHistoryId($unid,$qrcodeList,$id);\\n            if (!empty($historyId)) {\\n                if (isset($qrcodeList[$historyId])) {\\n                    $qrcodeInfo = $qrcodeList[$historyId];\\n                } else {\\n                    unset($qrcodeList[$id]);\\n                    if (!empty($qrcodeList)) {\\n                        $num = count($qrcodeList);\\n                        $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n                    }\\n                }\\n            } else {\\n                unset($qrcodeList[$id]);\\n                if (!empty($qrcodeList)) {\\n                    $num = count($qrcodeList);\\n                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n                }\\n            }\\n            if (!empty($qrcodeInfo)) {\\n                $freshKey = \'yxk:wxmini:buyqrcode:catch:fresh:\' . $uid . \':\' . $id . \':\' . date(\'Ymd\', time());\\n                $freshValue = redis()->get($freshKey);\\n                $refresh = $info[\'refresh\'];\\n                $dayRefresh = $info[\'day_refresh\'];\\n                if (empty($freshValue)) {\\n                    redis()->setex($freshKey, 3600 * 24, 1);\\n                    Db::name(\'buy_qrcode\')\\n                        ->where(\'id\', $id)\\n                        ->update([\\n                            \'refresh\' => $refresh + 1,\\n                            \'day_refresh\' => $dayRefresh + 1,\\n                            \'updatetime\' => time()\\n                        ]);\\n                }\\n            } elseif ($info[\'status\'] == 0) {\\n                $qrcodeInfo = $info;\\n            }\\n            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n        } else {\\n            $myId = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n                ->where(\'uid\', $uid)\\n                ->value(\'buy_qrcode_id\');\\n            trace(\'myId:\'.$myId);\\n            if (empty($myId)) {\\n                if (!empty($qrcodeList)) {\\n                    $num = count($qrcodeList);\\n                    $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n                }\\n            } else {\\n                $qrcodeInfo = $qrcodeList[$myId] ?? [];\\n                if (empty($qrcodeInfo)) {\\n                    $historyId = (new Common())->getHistoryId($unid,$qrcodeList);\\n                    if (!empty($historyId)) {\\n                        $qrcodeInfo = $qrcodeList[$historyId] ?? [];\\n                        if (empty($qrcodeInfo)) {\\n                            if (!empty($qrcodeList)) {\\n                                $num = count($qrcodeList);\\n                                $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n                            }\\n                        }\\n                    } else {\\n                        if (!empty($qrcodeList)) {\\n                            $num = count($qrcodeList);\\n                            $qrcodeInfo = array_values($qrcodeList)[mt_rand(0, $num - 1)];\\n                        }\\n                    }\\n                }\\n            }\\n            $qrcode = $qrcodeInfo[\'qrcode\'] ?? \'\';\\n            $id = $qrcodeInfo[\'id\'] ?? \'\';\\n        }\\n        if (!empty($id)) {\\n            Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n                ->where(\'uid\', $uid)\\n                ->update([\'buy_qrcode_id\' => $id]);\\n        }\\n        $this->success(\'success\', [\'qrcode\' => $qrcode, \'id\' => $id]);\\n    }\\n\\n    \\/*\\n    ** SPA任务列表\\n    *\\/\\n    public function coursetask()\\n    {\\n        $uid = session(\'uid\') ?? 0;\\n        $data = (new Course)->getSpaAllSubject($uid, true);\\n        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n        $this->result($data[\'msg\'], $data[\'data\'], $errNo);\\n    }\\n    \\/**\\n     * 确认到课\\n     *\\/\\n    public function cfmdaoke($uid=0,$batch_id=0,$unid=\'\'){\\n        if($uid ==0){\\/\\/正式\\n            $uid = session(\'uid\') ?? 0;\\n            $unid = input(\'unionid\', \'\');\\n            $batch_id = input(\'batch_id\', \'\');\\n        }\\n        $res = (new Course)->workdaoke($uid,$unid,$batch_id);\\n        if($res) \\n            $this->result(\'确认成功\', 1, 0);\\n        else\\n            $this->result(\'确认失败，稍后重试\', 0,4110);\\n    }\\n    \\/**\\n     * 考研规划报告第三步课程信息\\n     *\\/\\n    public function getcourse($uid=0,$batch_id=0,$unid=\'\',$cousre_id=0,$f_type=0){\\n        if($uid ==0){\\/\\/正式\\n            $uid = session(\'uid\') ?? 0;\\n            $unid = input(\'unionid\', \'\');\\n            $cousre_id = input(\'cousre_id\', \'\');\\n            $batch_id = input(\'batch_id\', \'\');\\n            $f_type = input(\'f_type\', 0); \\/\\/暂时用不着，1是上一步的请求。\\n        }\\n        $res = (new Course)->getKaoYanSubject($uid,$batch_id,$unid,2,$cousre_id);\\n        $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n        if($f_type == 1){\\n            $res[\'data\'][\'focus_qrcode\'] = Env::get(\'kygh_focus.qrcode\');\\n            $res[\'data\'][\'qrnews\'] = Env::get(\'kygh_focus.qrnews\');\\n            $key1 = \\\"yxk:gzhgz:{$uid}:\\\" . Env::get(\'kygh_focus.appid\');\\n            $val = redis()->get($key1);\\n            if($val){\\n                $res[\'data\'][\'is_focus\'] = intval($val);\\n            } else {\\n                $res1 = Helpers::clphpCurl([\'uid\' => $uid, \'appid\' => Env::get(\'kygh_focus.appid\'), \'tp\' => 2], \'is_followed\');\\n                $res[\'data\'][\'is_focus\'] = intval($res1[\'data\'][\'is_follow\']) ?? 0;\\n                if($res[\'data\'][\'is_focus\']){\\n                    redis()->setex($key1,comsetextime(7200),$res[\'data\'][\'is_focus\']);\\n                }\\n            }\\n            \\/\\/是否确认到课过\\n            $res[\'data\'][\'is_daoke\'] = (new Course)->workdaoke($uid,$unid,$batch_id,1);\\n        }\\n        $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n    }\\n    \\/**\\n     * 获取资料\\n     *\\/\\n    public function getfiles(){\\n        $uid = session(\'uid\') ?? 0;\\n        $unid = input(\'unionid\', \'\');\\n        $batch_id = input(\'batch_id\', \'\');\\n        $type = input(\'type\', 0);\\n        $n = input(\'n\', 0);\\n        $res = (new Course)->getdocs($type,$batch_id,$unid,$n);\\n        $errNo = empty($res[\'errNo\']) ? (empty($res[\'msg\']) ? 0 : 4033) : $res[\'errNo\'];\\n        $data = [];\\n        if(!empty($res[\'data\'])){\\n            $data[\'data\'] = $res[\'data\'];\\n            $data[\'title\'] = (new Course)->getfilename($type,$n);\\n        }\\n        $this->result($res[\'msg\'], $data, $errNo);\\n    }\\n    public function test(){\\n        $type =  input(\'type\', \'\');\\n        $uid = 9539711;\\n        $batch_id = 10950;\\n        $unid =\'oLVvc0kcW_kUh5-svF6D5LdweL1U\';\\n        if($type == 1){\\n            $this->getcourse($uid,$batch_id,$unid,0,1);\\n            \\/\\/ $res = (new Course)->getKaoYanSubject(1,1,1,$type,1);\\n            \\/\\/ $errNo = empty($data[\'errNo\']) ? (empty($data[\'msg\']) ? 0 : 4033) : $data[\'errNo\'];\\n            \\/\\/ $this->result($res[\'msg\'], $res[\'data\'], $errNo);\\n        }\\n        if($type == 2){\\n            $this->cfmdaoke($uid,$batch_id,$unid);\\n        }\\n        $pid = input(\'pid\', 0);\\n        if($pid){\\n            $res = Helpers::clappCurl([\\n                \'periodIds\' => $pid\\n            ], \'get_period_info_live_status\');\\n            ddp($res);exit;\\n        }\\n        $cid = input(\'cid\', 0);\\n        $res = Helpers::clappCurl([\\n            \'courseIds\' => $cid,\\n            \'fileType\' => 9\\n        ], \'get_course_and_period_info\');\\n        \\/\\/ $res = Helpers::openapiCurl([\\n        \\/\\/     \'ids\'=>[$cid]\\n        \\/\\/ ],\'get_bch_csids\');\\n        \\/\\/ $res = (new Course)->getcoursebatchs($cid );\\n        ddp($res);exit;\\n    }\\n}\\n\",\"numLines\":618,\"startLine\":1,\"totalLines\":618}}}' , `created_at` = '2026-07-08 01:11:24' [ RunTime:0.006169s ]

的身份\');\\n39\\t    }\\n40\\t    public function checkEducationStading($value){\\n41\\t        return $this->checkParam($value,\'getEducationStading\',\'学历层次\');\\n42\\t    }\\n43\\t    public function checkCet($value){\\n44\\t        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n45\\t    }\\n46\\t    public function checkDiffMajor($value){\\n47\\t        return $this->checkParam($value,\'getDiffMajor\',\'是否跨专业考研\');\\n48\\t    }\\n49\\t    public function checkExamYear($value){\\n50\\t        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n51\\t    }\\n52\\t    public function checkDetermination($value){\\n53\\t        return $this->checkParam($value,\'getDetermination\',\'考研决心\');\\n54\\t    }\\n55\\t    private function checkParam($value,$action,$word){\\n56\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n57\\t        $list = $model->$action();\\n58\\t        if(in_array($value,array_keys($list))){\\n59\\t            return true;\\n60\\t        }\\n61\\t        return ComErrorDescs::EC_INVALID_PARAM . \',\'.$word;\\n62\\t    }\\n63\\t\\n64\\t}\"}]},\"parent_tool_use_id\":null,\"session_id\":\"49e1de3d-2301-4da8-8d9e-fd26cb867151\",\"uuid\":\"09fa31c0-64ee-491d-b17a-1f9e40eea93e\",\"timestamp\":\"2026-07-07T14:00:07.609Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/hufangfang/www/local/wt-task-1/application/api/validate/Ai.php\",\"content\":\"<?php\\nnamespace app\\\\api\\\\validate;\\n\\nuse app\\\\api\\\\library\\\\ComErrorDescs;\\nuse think\\\\Validate;\\n\\n/**\\n * Class Auth [接口header验证类]\\n * Auther Changzd\\n * @package app\\\\api\\\\validate\\n */\\nclass Ai extends Validate\\n{\\n    protected $rule = [\\n        \'now_standing\'  => \'require|checkNowStanding\',\\n        \'school_id\'    => \'require\',\\n        \'education_stading\'   => \'require|checkEducationStading\',\\n        \'cet\'     => \'require|checkCet\',\\n        \'area_id\'     => \'require\',\\n        \'major_id\'      => \'require\',\\n        \'diff_major\'      => \'require|checkDiffMajor\',\\n        \'exam_year\'      => \'require|checkExamYear\',\\n        \'determination\'      => \'require|checkDetermination\',\\n    ];\\n\\n    protected $message = [\\n        \'now_standing\'  => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'您的身份\',\\n        \'school_id\'     => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'就读院校\',\\n        \'education_stading\'     => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'学历层次\',\\n        \'cet\'   => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'四六级学习情况\',\\n        \'area_id\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'期望报考地区\',\\n        \'major_id\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'期望报考专业\',\\n        \'diff_major\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'是否跨专业考研\',\\n        \'exam_year\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'报考年份\',\\n        \'determination\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'考研决心\',\\n    ];\\n    public function checkNowStanding($value){\\n        return $this->checkParam($value,\'getNowStanding\',\'您的身份\');\\n    }\\n    public function checkEducationStading($value){\\n        return $this->checkParam($value,\'getEducationStading\',\'学历层次\');\\n    }\\n    public function checkCet($value){\\n        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n    }\\n    public function checkDiffMajor($value){\\n        return $this->checkParam($value,\'getDiffMajor\',\'是否跨专业考研\');\\n    }\\n    public function checkExamYear($value){\\n        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n    }\\n    public function checkDetermination($value){\\n        return $this->checkParam($value,\'getDetermination\',\'考研决心\');\\n    }\\n    private function checkParam($value,$action,$word){\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $list = $model->$action();\\n        if(in_array($value,array_keys($list))){\\n            return true;\\n        }\\n        return ComErrorDescs::EC_INVALID_PARAM . \',\'.$word;\\n    }\\n\\n}\",\"numLines\":64,\"startLine\":1,\"totalLines\":64}}}

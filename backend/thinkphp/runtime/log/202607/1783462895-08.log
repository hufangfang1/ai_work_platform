AM.\',\'.\'学习方式\',\\n37\\t        \'school_grades\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'在校成绩\',\\n38\\t    ];\\n39\\t    \\/**\\n40\\t     * 验证场景\\n41\\t     *\\/\\n42\\t    protected $scene = [\\n43\\t        \'get_score\'  => [\'now_standing\', \'school_id\', \'major_name\', \'cet\', \'area_id\', \'major_id\', \'exam_year\', \'school_attr\', \'school_grades\', \'is_full\'],\\n44\\t        \'get_count\' => [\'area_id\', \'school_attr\', \'major_id\', \'is_full\'],\\n45\\t    ];\\n46\\t    public function checkNowStanding($value){\\n47\\t        return $this->checkParam($value,\'getNowStanding\',\'您的身份\');\\n48\\t    }\\n49\\t    public function checkSchoolAttr($value){\\n50\\t        return $this->checkParam($value,\'getSchoolAttr\',\'院校层次\');\\n51\\t    }\\n52\\t    public function checkSchoolGrades($value){\\n53\\t        return $this->checkParam($value,\'getSchoolGrades\',\'院校层次\');\\n54\\t    }\\n55\\t    public function checkCet($value){\\n56\\t        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n57\\t    }\\n58\\t    public function checkExamYear($value){\\n59\\t        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n60\\t    }\\n61\\t    public function checkIsFull($value){\\n62\\t        if(in_array($value,[1,2])){\\n63\\t            return true;\\n64\\t        }else{\\n65\\t            return ComErrorDescs::EC_INVALID_PARAM . \',is_full\';\\n66\\t        }\\n67\\t    }\\n68\\t    private function checkParam($value,$action,$word){\\n69\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n70\\t        $list = $model->$action(1);\\n71\\t        if($action != \'getExamYear\'){\\n72\\t            $item = [];\\n73\\t            foreach ($list as $k => $v) {\\n74\\t                $item[] = $k+1;\\n75\\t            }\\n76\\t            $keys = array_values($item);\\n77\\t        }else{\\n78\\t            $keys = array_keys($list);\\n79\\t        }\\n80\\t        if(in_array($value,$keys)){\\n81\\t            ret
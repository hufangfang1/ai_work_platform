{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_04_7epL6voDLEfD0y9bwmpx9447\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n6\\tuse app\\\\api\\\\library\\\\ComErrorDescs;\\n7\\tuse app\\\\common\\\\library\\\\Helpers;\\n8\\tuse think\\\\Db;\\n9\\tuse think\\\\Exception;\\n10\\tuse app\\\\admin\\\\model\\\\SchoolMajor;\\n11\\tuse app\\\\common\\\\model\\\\Document;\\n12\\tuse app\\\\common\\\\model\\\\Major as ModelMajor;\\n13\\tuse app\\\\common\\\\model\\\\MajorSchool;\\n14\\tuse app\\\\common\\\\model\\\\School;\\n15\\tuse app\\\\common\\\\model\\\\SchoolMajorCollect;\\n16\\tuse think\\\\Config;\\n17\\t\\n18\\t/**\\n19\\t * 首页接口\\n20\\t */\\n21\\tclass Ai extends ApiAuth\\n22\\t{\\n23\\t    protected $noNeedLogin = [\'schoolorder\', \'majorexamsubject\'];\\n24\\t    protected $noNeedRight = [\'schoolorder\', \'info\', \'start\', \'index\', \'getselect\', \'schoollist\', \'history\', \'feishumessage\', \'recorddetail\', \'majorexamsubject\', \'testqrcode\'];\\n25\\t    protected $majorModel = null;\\n26\\t    protected $majorSchoolModel = null;\\n27\\t    public function _initialize()\\n28\\t    {\\n29\\t        parent::_initialize();\\n30\\t        $this->majorModel = new ModelMajor();\\n31\\t        $this->majorSchoolModel = new MajorSchool();\\n32\\t    }\\n33\\t    public function index()\\n34\\t    {\\n35\\t        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n36\\t            ->where(\'uid\', session(\'uid\'))\\n37\\t            ->order(\'createtime\', \'desc\')\\n38\\t            ->find();\\n39\\t        if (!empty($record)) {\\n40\\t            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n41\\t            $year = $model->getExamYear();\\n42\\t            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n43\\t                ->where(\'pid\', \'>\', 0)\\n44\\t                ->column(\'name\', \'id\');\\n45\\t            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n46\\t                ->column(\'name\', \'id\');\\n47\\t            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n48\\t                ->where(\'is_hidden\', 0)\\n49\\t                ->column(\'school_name\', \'school_id\');\\n50\\t            $nowStanding = $model->getNowStanding();\\n51\\t            $educationStading = $model->getEducationStading();\\n52\\t            $cet = $model->getCet();\\n53\\t            $diff_major = $model->getDiffMajor();\\n54\\t            $school_attr = $model->getSchoolAttr();\\n55\\t            $school_grades = $model->getSchoolGrades();\\n56\\t            $math_status = $model->getMathStatus();\\n57\\t            $determination = $model->getDetermination();\\n58\\t            $item = [];\\n59\\t            $item[\'key\'] = array_search($record[\'exam_year\'], $year);\\n60\\t            $item[\'value\'] = $record[\'exam_year\'];\\n61\\t            $record[\'exam_year\'] = $item;\\n62\\t            $record[\'result\'] = json_decode($record[\'result\'], true);\\n63\\t            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n64\\t            $item = [];\\n65\\t            $record[\'area_id\'] = [];\\n66\\t            foreach ($record[\'area\'] as $kk => $vv) {\\n67\\t                $item[\'key\'] = (int)$vv;\\n68\\t                $item[\'value\'] = $areaList[$vv] ?? \'\';\\n69\\t                $record[\'area_id\'][] = $item;\\n70\\t            }\\n71\\t            unset($record[\'area\']);\\n72\\t            $item = [];\\n73\\t            $item[\'key\'] = $record[\'now_standing\'];\\n74\\t            $item[\'value\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n75\\t            $record[\'now_standing\'] = $item;\\n76\\t            $item = [];\\n77\\t            $item[\'key\'] = $record[\'school_id\'];\\n78\\t            $item[\'value\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n79\\t            $record[\'school_id\'] = $item;\\n80\\t            $item = [];\\n81\\t            $item[\'key\'] = $record[\'diff_major\'];\\n82\\t            $item[\'value\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n83\\t            $record[\'diff_major\'] = $item;\\n84\\t            $item = [];\\n85\\t            $item[\'key\'] = $record[\'school_attr\'];\\n86\\t            $item[\'value\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n87\\t            if (empty($record[\'school_attr\'])) {\\n88\\t                $item[\'value\'] = \'\';\\n89\\t            }\\n90\\t            $record[\'school_attr\'] = $item;\\n91\\t\\n92\\t            $item = [];\\n93\\t            $item[\'key\'] = $record[\'school_grades\'];\\n94\\t            $item[\'value\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n95\\t            if (empty($record[\'school_grades\'])) {\\n96\\t                $item[\'value\'] = \'\';\\n97\\t            }\\n98\\t            $record[\'school_grades\'] = $item;\\n99\\t            $item = [];\\n100\\t            $item[\'key\'] = $record[\'cet\'];\\n101\\t            $item[\'value\'] = $cet[$record[\'cet\']] ?? \'\';\\n102\\t            if (empty($record[\'cet\'])) {\\n103\\t                $item[\'value\'] = \'\';\\n104\\t            }\\n105\\t            $record[\'cet\'] = $item;\\n106\\t            $item = [];\\n107\\t            $item[\'key\'] = $record[\'math_status\'];\\n108\\t            $item[\'value\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n109\\t            if (empty($record[\'math_status\'])) {\\n110\\t                $item[\'value\'] = \'\';\\n111\\t            }\\n112\\t            $record[\'math_status\'] = $item;\\n113\\t            $item = [];\\n114\\t            $item[\'key\'] = $record[\'major_id\'];\\n115\\t            $item[\'value\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n116\\t            $record[\'major_id\'] = $item;\\n117\\t            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n118\\t            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n119\\t            $item = [];\\n120\\t            $item[\'key\'] = $record[\'education_stading\'];\\n121\\t            $item[\'value\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n122\\t            $record[\'education_stading\'] = $item;\\n123\\t        } else {\\n124\\t            $record = [];\\n125\\t        }\\n126\\t        $this->success(\'success\', $record);\\n127\\t    }\\n128\\t    /**\\n129\\t     * 首页\\n130\\t     *\\n131\\t     */\\n132\\t    public function start()\\n133\\t    {\\n134\\t        $input = input();\\n135\\t        foreach ($input as $k => $v) {\\n136\\t            if (!in_array($k, [\'now_standing\', \'school_id\', \'education_stading\', \'cet\', \'area_id\', \'major_id\', \'diff_major\', \'school_attr\', \'school_grades\', \'math_status\', \'exam_year\', \'determination\'])) {\\n137\\t                unset($input[$k]);\\n138\\t            }\\n139\\t        }\\n140\\t        $input = array_filter($input);\\n141\\t        $validate = validate(\\\"Ai\\\");\\n142\\t        if (!$validate->check($input)) {\\n143\\t            $result = (string)$validate->getError();\\n144\\t            if (false !== strpos($result, \',\')) {\\n145\\t                list($errNo, $msg) = explode(\',\', $result);\\n146\\t            } else {\\n147\\t                $errNo = ComErrorDescs::EC_UNKNOWN;\\n148\\t                $msg = \'\';\\n149\\t            }\\n150\\t            $this->result(ComErrorDescs::errmsg($errNo, $msg), [], $errNo);\\n151\\t        }\\n152\\t        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'diff_major\'] == 3)) {\\n153\\t            if (empty($input[\'school_grades\'])) {\\n154\\t                $this->error(\'在校成绩不能为空\');\\n155\\t            }\\n156\\t        }\\n157\\t        $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n158\\t            ->where(\'uc_school_id\', $input[\'school_id\'])\\n159\\t            ->value(\'id\');\\n160\\t        if (empty($school_id)) {\\n161\\t            $school_id = 0;\\n162\\t        }\\n163\\t        $examSubject = Db::connect(\'database.yx_db_config\')\\n164\\t            ->name(\'cl_major\')\\n165\\t            ->where(\'id\', $input[\'major_id\'])\\n166\\t            ->value(\'exam_subject\');\\n167\\t        if (!empty($examSubject)) {\\n168\\t            $examSubject = explode(\',\', $examSubject);\\n169\\t            $examSubject = array_intersect($examSubject, [\'数学一\', \'数学二\', \'数学三\']);\\n170\\t            if (!empty($examSubject) && empty($input[\'math_status\'])) {\\n171\\t                $this->error(\'高等数学学习情况不能为空\');\\n172\\t            }\\n173\\t        }\\n174\\t        $area_num = count(explode(\',\', $input[\'area_id\']));\\n175\\t        if ($area_num > 5) {\\n176\\t            $this->error(\'期望报考地区最多选择5个\');\\n177\\t        }\\n178\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n179\\t        $year = $model->getExamYear();\\n180\\t        $input[\'exam_year\'] = $year[$input[\'exam_year\']];\\n181\\t        $input[\'createtime\'] = time();\\n182\\t        $input[\'updatetime\'] = time();\\n183\\t        $input[\'uid\'] = session(\'uid\');\\n184\\t        $id = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n185\\t            ->insertGetId($input);\\n186\\t        $input[\'school_id\'] = $school_id;\\n187\\t        $result = $this->chooseSchool($input);\\n188\\t        Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n189\\t            ->where(\'id\', $id)\\n190\\t            ->update([\\n191\\t                \'result\' => json_encode_cus($result),\\n192\\t                \'status\' => 1,\\n193\\t                \'updatetime\' => time()\\n194\\t            ]);\\n195\\t        $result[\'id\'] = $id;\\n196\\t        $result[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n197\\t        $this->success(\'success\', $result);\\n198\\t    }\\n199\\t    private function chooseSchool($input)\\n200\\t    {\\n201\\t        if (empty($input[\'school_attr\'])) {\\n202\\t            $input[\'school_attr\'] = \'\';\\n203\\t        }\\n204\\t        if (empty($input[\'math_status\'])) {\\n205\\t            $input[\'math_status\'] = 0;\\n206\\t        }\\n207\\t        if (empty($input[\'school_grades\'])) {\\n208\\t            $input[\'school_grades\'] = 0;\\n209\\t        }\\n210\\t        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'math_status\'] == 2) || ($input[\'diff_major\'] == 3) || ($input[\'school_grades\'] == 4) || ($input[\'determination\'] == 1)) {\\n211\\t            $f = -1;\\n212\\t        } else {\\n213\\t            $f = 0;\\n214\\t        }\\n215\\t        if ($input[\'exam_year\'] == \'其他\') {\\n216\\t            $q = 1;\\n217\\t        } else {\\n218\\t            $chooseYear = strtotime(((int)$input[\'exam_year\']) . \'-12-25\');\\n219\\t            $preChooseYear = strtotime(\'-1 yaar\', $chooseYear);\\n220\\t            $nowYear = strtotime(date(\'Y\') . \'-12-25\');\\n221\\t            if ($preChooseYear > $nowYear) {\\n222\\t                $q = 1;\\n223\\t            } else {\\n224\\t                $q = 0;\\n225\\t            }\\n226\\t        }\\n227\\t        if (($input[\'school_grades\'] == 1) || ($input[\'determination\'] == 5) || in_array($input[\'now_standing\'], [1, 2, 3, 4, 5]) || $q == 1) {\\n228\\t            $k = 1;\\n229\\t        } else {\\n230\\t            $k = 0;\\n231\\t        }\\n232\\t        switch ($input[\'education_stading\']) {\\n233\\t            case 1:\\n234\\t                $k = 5;\\n235\\t                break;\\n236\\t            case 2:\\n237\\t                $k = 4;\\n238\\t                break;\\n239\\t            case 3:\\n240\\t                $k = 3;\\n241\\t                break;\\n242\\t            case 4:\\n243\\t                $k = 2;\\n244\\t                break;\\n245\\t            case 5:\\n246\\t                $k = 1;\\n247\\t                break;\\n248\\t            case 6:\\n249\\t                $k = 1;\\n250\\t                break;\\n251\\t            case 7:\\n252\\t                $k = 1;\\n253\\t                break;\\n254\\t        }\\n255\\t        $r = $f + $q + $k;\\n256\\t        if ($r < 1) {\\n257\\t            $r = 1;\\n258\\t        }\\n259\\t        if ($r > 5) {\\n260\\t            $r = 5;\\n261\\t        }\\n262\\t        $topWhere = $middleWhereMix = $middleWhereMajor = $lowerWhereMix = $lowerWhereMajor = [];\\n263\\t        $menlei = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n264\\t            ->join(\'t_cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n265\\t            ->where(\'a.id\', $input[\'major_id\'])\\n266\\t            ->value(\'b.menlei\');\\n267\\t        $schoolModel = new \\\\app\\\\admin\\\\model\\\\School();\\n268\\t        $typeToMenlei = $schoolModel->typeToMenlei();\\n269\\t        foreach ($typeToMenlei as $k => $v) {\\n270\\t            if (in_array($menlei, $v)) {\\n271\\t                $type = $k;\\n272\\t            }\\n273\\t        }\\n274\\t        $diffMajor = $input[\'diff_major\'];\\n275\\t        if ($diffMajor > 1) {\\n276\\t            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n277\\t                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n278\\t                ->join(\'cl_major_school_detail c\', \'b.id=c.major_school_id\', \'left\')\\n279\\t                ->where(\'b.major_id\', $input[\'major_id\'])\\n280\\t                ->where(\'c.year\', \'2022\')\\n281\\t                ->where(\'c.kzybk\', 1)\\n282\\t                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n283\\t                ->column(\'a.school_attr\', \'a.id\');\\n284\\t        } else {\\n285\\t            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n286\\t                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n287\\t                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n288\\t                ->where(\'b.major_id\', $input[\'major_id\'])\\n289\\t                ->column(\'a.school_attr\', \'a.id\');\\n290\\t        }\\n291\\t        $nomalSchoolId = [];\\n292\\t        $schoolId985 = [];\\n293\\t        $schoolId211 = [];\\n294\\t        $schoolIdone = [];\\n295\\t        $expSchoolId = [];\\n296\\t        $assessmentSchoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school_yjxk\')\\n297\\t            ->field(\'school_id,min(subject_assessment) subject_assessment\')\\n298\\t            ->group(\'school_id\')\\n299\\t            ->select();\\n300\\t        $lowAssessment = [];\\n301\\t        $lowAssessment1 = [];\\n302\\t        foreach ($assessmentSchoolList as $k => $v) {\\n303\\t            if ($v[\'subject_assessment\'] > 3 || $v[\'subject_assessment\'] == 0) {\\n304\\t                $lowAssessment[] = $v[\'school_id\'];\\n305\\t            }\\n306\\t            if ($v[\'subject_assessment\'] > 1 || $v[\'subject_assessment\'] == 0) {\\n307\\t                $lowAssessment1[] = $v[\'school_id\'];\\n308\\t            }\\n309\\t        }\\n310\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n311\\t        $attrList = $model->getSchoolAttr();\\n312\\t        $schoolAttrChoose = $attrList[$input[\'school_attr\']] ?? \'\';\\n313\\t        foreach ($schoolList as $k => $v) {\\n314\\t            $schoolAttr = explode(\',\', $v);\\n315\\t            if ($v == \'普通院校\') {\\n316\\t                $nomalSchoolId[] = $k;\\n317\\t            }\\n318\\t            if (in_array(\'985\', $schoolAttr)) {\\n319\\t                $schoolId985[] = $k;\\n320\\t            }\\n321\\t            if (in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n322\\t                $schoolId211[] = $k;\\n323\\t            }\\n324\\t            if (in_array(\'双一流\', $schoolAttr) && !in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n325\\t                $schoolIdone[] = $k;\\n326\\t            }\\n327\\t            if (in_array($schoolAttrChoose, $schoolAttr)) {\\n328\\t                $expSchoolId[] = $k;\\n329\\t            }\\n330\\t        }\\n331\\t        if(empty($input[\'school_id\'])){\\n332\\t            $selfMajorSort = 1000000;\\n333\\t            $selfComprehensiveRanking = 10000;\\n334\\t        }else{\\n335\\t            $selfMajorSort = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n336\\t                ->where(\'school_id\', $input[\'school_id\'])\\n337\\t                ->where(\'major_id\', $input[\'major_id\'])\\n338\\t                ->value(\'sort\');\\n339\\t            $selfComprehensiveRanking = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n340\\t                ->where(\'id\', $input[\'school_id\'])\\n341\\t                ->value(\'comprehensive_ranking\');\\n342\\t        }\\n343\\t        $V = 0;\\n344\\t        if (!empty($input[\'school_attr\'])) {\\n345\\t            switch ($input[\'school_attr\']) {\\n346\\t                case 1:\\n347\\t                    $s = 5;\\n348\\t                    break;\\n349\\t                case 2:\\n350\\t                    $s = 4;\\n351\\t                    break;\\n352\\t                case 3:\\n353\\t                    $s = 3;\\n354\\t                    break;\\n355\\t                case 4:\\n356\\t                    $s = 2;\\n357\\t                    break;\\n358\\t            }\\n359\\t            $V = $s - $r;\\n360\\t        }\\n361\\t        //综合推荐\\n362\\t        switch ($r) {\\n363\\t            case 1:\\n364\\t                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n365\\t                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n366\\t                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n367\\t                $middleWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n368\\t                $middleWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n369\\t                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n370\\t                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n371\\t                if (!empty($type)) {\\n372\\t                    $middleWhereMix[\'type\'] = $type;\\n373\\t                }\\n374\\t                $topSort = \'desc\';\\n375\\t                $middleMajorSort = \'asc\';\\n376\\t                $middleMixSort = \'asc\';\\n377\\t                $lowerMajorSort = \'desc\';\\n378\\t                $lowerMixSort = \'desc\';\\n379\\t                $expSort = \'desc\';\\n380\\t                $topStar = 2;\\n381\\t                $middleMajorStar = 3;\\n382\\t                $middleMixStar = 3;\\n383\\t                $lowerMajorStar = 4;\\n384\\t                $lowerMixStar = 4;\\n385\\t                $expStar = 5 - $V;\\n386\\t                break;\\n387\\t            case 2:\\n388\\t                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n389\\t                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n390\\t                $schoolId = array_unique(array_merge($schoolId211, $schoolIdone));\\n391\\t                $schoolId = array_intersect($schoolId, $lowAssessment);\\n392\\t                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n393\\t                $middleWhereMix[\'id\'] = [\'in\', $schoolId];\\n394\\t                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n395\\t                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n396\\t                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n397\\t                if (!empty($type)) {\\n398\\t                    $topWhere[\'type\'] = $type;\\n399\\t                    $lowerWhereMajor[\'type\'] = $type;\\n400\\t                }\\n401\\t                $topSort = \'asc\';\\n402\\t                $middleMajorSort = \'desc\';\\n403\\t                $middleMixSort = \'desc\';\\n404\\t                $lowerMajorSort = \'asc\';\\n405\\t                $lowerMixSort = \'asc\';\\n406\\t                if ($V > 0) {\\n407\\t                    $expSort = \'desc\';\\n408\\t                } else {\\n409\\t                    $expSort = \'asc\';\\n410\\t                }\\n411\\t                $topStar = 2;\\n412\\t                $middleMajorStar = 4;\\n413\\t                $middleMixStar = 4;\\n414\\t                $lowerMajorStar = 3;\\n415\\t                $lowerMixStar = 3;\\n416\\t                if ($V == 3) {\\n417\\t                    $expStar = 2;\\n418\\t                } else {\\n419\\t                    $expStar = 4;\\n420\\t                }\\n421\\t                break;\\n422\\t            case 3:\\n423\\t                $schoolId985 = array_intersect($schoolId985, $lowAssessment1);\\n424\\t                $topWhere[\'id\'] = [\'in\', $schoolId985];\\n425\\t                $schoolId211 = array_intersect($schoolId211, $lowAssessment1);\\n426\\t                $middleWhereMix[\'id\'] = [\'in\', $schoolId211];\\n427\\t                $middleWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n428\\t                $schoolId = array_unique(array_merge($nomalSchoolId, $schoolIdone));\\n429\\t                $schoolId = array_intersect($schoolId, $lowAssessment1);\\n430\\t                $lowerWhereMix[\'id\'] = [\'in\', $schoolId];\\n431\\t                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n432\\t                if (!empty($type)) {\\n433\\t                    $lowerWhereMajor[\'type\'] = $type;\\n434\\t                }\\n435\\t                $topSort = \'desc\';\\n436\\t                $middleMajorSort = \'desc\';\\n437\\t                $middleMixSort = \'desc\';\\n438\\t                $lowerMajorSort = \'asc\';\\n439\\t                $lowerMixSort = \'asc\';\\n440\\t                if ($V > 0) {\\n441\\t                    $expSort = \'desc\';\\n442\\t                } else {\\n443\\t                    $expSort = \'asc\';\\n444\\t                }\\n445\\t                $topStar = 3;\\n446\\t                $middleMajorStar = 4;\\n447\\t                $middleMixStar = 4;\\n448\\t                $lowerMajorStar = 3;\\n449\\t                $lowerMixStar = 3;\\n450\\t                if ($V == 2) {\\n451\\t                    $expStar = 3;\\n452\\t                } else {\\n453\\t                    $expStar = 4;\\n454\\t                }\\n455\\t                break;\\n456\\t            case 4:\\n457\\t                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n458\\t                $topWhere[\'id\'] = [\'in\', $schoolId];\\n459\\t                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n460\\t                $middleWhereMajor[\'id\'] = [\'in\', $schoolId985];\\n461\\t                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n462\\t                $topSort = \'asc\';\\n463\\t                $middleMajorSort = \'desc\';\\n464\\t                $middleMixSort = \'desc\';\\n465\\t                $lowerMajorSort = \'desc\';\\n466\\t                $lowerMixSort = \'asc\';\\n467\\t                if ($V >= 0) {\\n468\\t                    $expSort = \'desc\';\\n469\\t                } else {\\n470\\t                    $expSort = \'asc\';\\n471\\t                }\\n472\\t                $topStar = 2;\\n473\\t                $middleMajorStar = 4;\\n474\\t                $middleMixStar = 4;\\n475\\t                $lowerMajorStar = 3;\\n476\\t                $lowerMixStar = 3;\\n477\\t                $expStar = 4;\\n478\\t                break;\\n479\\t            case 5:\\n480\\t                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n481\\t                $topWhere[\'id\'] = [\'in\', $schoolId];\\n482\\t                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n483\\t                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n484\\t                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n485\\t                if (!empty($type)) {\\n486\\t                    $topWhere[\'type\'] = $type;\\n487\\t                }\\n488\\t                $topSort = \'asc\';\\n489\\t                $middleMajorSort = \'asc\';\\n490\\t                $middleMixSort = \'desc\';\\n491\\t                $lowerMajorSort = \'desc\';\\n492\\t                $lowerMixSort = \'asc\';\\n493\\t                if ($V >= 0) {\\n494\\t                    $expSort = \'desc\';\\n495\\t                } else {\\n496\\t                    $expSort = \'asc\';\\n497\\t                }\\n498\\t                $topStar = 3;\\n499\\t                $middleMajorStar = 4;\\n500\\t                $middleMixStar = 4;\\n501\\t                $lowerMajorStar = 4;\\n502\\t                $lowerMixStar = 4;\\n503\\t                $expStar = 4;\\n504\\t                break;\\n505\\t        }\\n506\\t        if (!empty($input[\'school_attr\'])) {\\n507\\t            $expSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n508\\t                ->join(\'t_cl_school b\', \'a.school_id=b.id\', \'left\')\\n509\\t                ->whereIn(\'a.school_id\', $expSchoolId)\\n510\\t                ->where(\'a.major_id\', $input[\'major_id\'])\\n511\\t                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n512\\t                ->order(\'comprehensive_ranking\', $expSort)\\n513\\t                ->value(\'a.school_Id\');\\n514\\t        }\\n515\\t        $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n516\\t            ->where($topWhere)\\n517\\t            ->column(\'id\');\\n518\\t        if ($r == 2) {\\n519\\t            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n520\\t                ->whereIn(\'id\', $topSchoolId)\\n521\\t                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n522\\t                ->order(\'comprehensive_ranking\', $topSort)\\n523\\t                ->value(\'id\');\\n524\\t        } else {\\n525\\t            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n526\\t                ->whereIn(\'school_id\', $topSchoolId)\\n527\\t                ->where(\'sort\', \'<\', $selfMajorSort)\\n528\\t                ->order(\'sort\', $topSort)\\n529\\t                ->value(\'school_id\');\\n530\\t        }\\n531\\t        $middleSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n532\\t            ->where($middleWhereMajor)\\n533\\t            ->column(\'id\');\\n534\\t        $middleMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n535\\t            ->whereIn(\'school_id\', $middleSchoolIdMajor)\\n536\\t            ->where(\'sort\', \'<\', $selfMajorSort)\\n537\\t            ->order(\'sort\', $middleMajorSort)\\n538\\t            ->value(\'school_id\');\\n539\\t\\n540\\t        $middleSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n541\\t            ->where($middleWhereMix)\\n542\\t            ->column(\'id\');\\n543\\t        $middleMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n544\\t            ->whereIn(\'id\', $middleSchoolIdMix)\\n545\\t            ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n546\\t            ->order(\'comprehensive_ranking\', $middleMixSort)\\n547\\t            ->value(\'id\');\\n548\\t\\n549\\t        $lowerSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n550\\t            ->where($lowerWhereMajor)\\n551\\t            ->column(\'id\');\\n552\\t        $lowerMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n553\\t            ->whereIn(\'school_id\', $lowerSchoolIdMajor)\\n554\\t            ->where(\'sort\', \'<\', $selfMajorSort)\\n555\\t            ->order(\'sort\', $lowerMajorSort)\\n556\\t            ->value(\'school_id\');\\n557\\t        //判断就读院校有没有期望专业信息\\n558\\t        if(empty($input[\'school_id\'])){\\n559\\t            $hasInfo = false;\\n560\\t        }else{\\n561\\t            $hasInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n562\\t                ->where(\'school_id\', $input[\'school_id\'])\\n563\\t                ->where(\'major_id\', $input[\'major_id\'])\\n564\\t                ->count();\\n565\\t        }\\n566\\t\\n567\\t        if (in_array($r, [4, 5])) {\\n568\\t            if ($hasInfo) {\\n569\\t                $lowerMixSchoolId = $input[\'school_id\'];\\n570\\t            } else {\\n571\\t                $lowerMixSchoolId = [];\\n572\\t            }\\n573\\t        } else {\\n574\\t            $lowerSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n575\\t                ->where($lowerWhereMix)\\n576\\t                ->column(\'id\');\\n577\\t            $lowerMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n578\\t                ->whereIn(\'id\', $lowerSchoolIdMix)\\n579\\t                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n580\\t                ->order(\'comprehensive_ranking\', $lowerMixSort)\\n581\\t                ->value(\'id\');\\n582\\t        }\\n583\\t        $recommend = [];\\n584\\t        $recommend[\'mix\'][\'top\'][\'school_id\'] = (int)$topSchoolId;\\n585\\t        $recommend[\'mix\'][\'top\'][\'major_id\'] = (int)$input[\'major_id\'];\\n586\\t        $recommend[\'mix\'][\'top\'][\'star\'] = (int)$topStar;\\n587\\t        $recommend[\'mix\'][\'midMajor\'][\'school_id\'] = (int)$middleMajorSchoolId;\\n588\\t        $recommend[\'mix\'][\'midMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n589\\t        $recommend[\'mix\'][\'midMajor\'][\'star\'] = (int)$middleMajorStar;\\n590\\t        $recommend[\'mix\'][\'midMix\'][\'school_id\'] = (int)$middleMixSchoolId;\\n591\\t        $recommend[\'mix\'][\'midMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n592\\t        $recommend[\'mix\'][\'midMix\'][\'star\'] = $middleMixStar;\\n593\\t        $recommend[\'mix\'][\'lowMajor\'][\'school_id\'] = (int)$lowerMajorSchoolId;\\n594\\t        $recommend[\'mix\'][\'lowMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n595\\t        $recommend[\'mix\'][\'lowMajor\'][\'star\'] = (int)$lowerMajorStar;\\n596\\t        $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$lowerMixSchoolId;\\n597\\t        $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n598\\t        $recommend[\'mix\'][\'lowMix\'][\'star\'] = (int)$lowerMixStar;\\n599\\t        if (!empty($topSchoolId)) {\\n600\\t            if ($topSchoolId == $middleMajorSchoolId || $topSchoolId == $middleMixSchoolId || $topSchoolId == $lowerMajorSchoolId || $topSchoolId == $lowerMixSchoolId) {\\n601\\t                $recommend[\'mix\'][\'top\'] = [];\\n602\\t            }\\n603\\t        } else {\\n604\\t            $recommend[\'mix\'][\'top\'] = [];\\n605\\t        }\\n606\\t        if (!empty($middleMajorSchoolId)) {\\n607\\t            if ($middleMajorSchoolId == $middleMixSchoolId || $middleMajorSchoolId == $lowerMajorSchoolId || $middleMajorSchoolId == $lowerMixSchoolId) {\\n608\\t                $recommend[\'mix\'][\'midMajor\'] = [];\\n609\\t            }\\n610\\t        } else {\\n611\\t            $recommend[\'mix\'][\'midMajor\'] = [];\\n612\\t        }\\n613\\t        if (!empty($middleMixSchoolId)) {\\n614\\t            if ($middleMixSchoolId == $lowerMajorSchoolId || $middleMixSchoolId == $lowerMixSchoolId) {\\n615\\t                $recommend[\'mix\'][\'midMix\'] = [];\\n616\\t            }\\n617\\t        } else {\\n618\\t            $recommend[\'mix\'][\'midMix\'] = [];\\n619\\t        }\\n620\\t        if (!empty($lowerMajorSchoolId)) {\\n621\\t            if ($lowerMajorSchoolId == $lowerMixSchoolId) {\\n622\\t                $recommend[\'mix\'][\'lowMajor\'] = [];\\n623\\t            }\\n624\\t        } else {\\n625\\t            $recommend[\'mix\'][\'lowMajor\'] = [];\\n626\\t        }\\n627\\t        if (empty($lowerMixSchoolId)) {\\n628\\t            $recommend[\'mix\'][\'lowMix\'] = [];\\n629\\t        }\\n630\\t        if (empty($topSchoolId) && empty($middleMajorSchoolId) && empty($middleMixSchoolId) && empty($lowerMajorSchoolId) && empty($lowerMixSchoolId)) {\\n631\\t            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, 1);\\n632\\t            if ($school_id) {\\n633\\t                $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$school_id;\\n634\\t                $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n635\\t                $recommend[\'mix\'][\'lowMix\'][\'star\'] = 3;\\n636\\t            } else {\\n637\\t                $recommend[\'mix\'][\'lowMix\'] = [];\\n638\\t            }\\n639\\t        }\\n640\\t        //期望推荐\\n641\\t        if (!empty($expSchoolId)) {\\n642\\t            $recommend[\'exp\'][\'school_id\'] = $expSchoolId;\\n643\\t            $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n644\\t            $recommend[\'exp\'][\'star\'] = $expStar;\\n645\\t        } else {\\n646\\t            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking);\\n647\\t            if ($school_id) {\\n648\\t                $recommend[\'exp\'][\'school_id\'] = $school_id;\\n649\\t                $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n650\\t                $recommend[\'exp\'][\'star\'] = 3;\\n651\\t            } else {\\n652\\t                $recommend[\'exp\'] = [];\\n653\\t            }\\n654\\t        }\\n655\\t        return $recommend;\\n656\\t    }\\n657\\t    /**\\n658\\t     * desc:保底推荐规则\\n659\\t     * author:hufangfang\\n660\\t     * data:2023/1/7 15:09\\n661\\t     * @param $input\\n662\\t     * @param $schoolAttrChoose\\n663\\t     * @param $selfComprehensiveRanking\\n664\\t     * @return float|int|mixed|string\\n665\\t     * @throws Exception\\n666\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n667\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n668\\t     * @throws \\\\think\\\\exception\\\\DbException\\n669\\t     */\\n670\\t    private function baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, $type = 0)\\n671\\t    {\\n672\\t        $school_id = 0;\\n673\\t        $where[\'a.area_id\'] = [\'in\', $input[\'area_id\']];\\n674\\t        $where[\'b.major_id\'] = $input[\'major_id\'];\\n675\\t        $where[\'a.id\'] = [\'<>\', $input[\'school_id\']];\\n676\\t        if ($type) {\\n677\\t            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n678\\t                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n679\\t                ->where($where)\\n680\\t                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n681\\t                ->order(\'a.comprehensive_ranking\', \'desc\')\\n682\\t                ->value(\'a.id\');\\n683\\t            if (empty($school_id)) {\\n684\\t                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n685\\t                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n686\\t                    ->where($where)\\n687\\t                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n688\\t                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n689\\t                    ->value(\'a.id\');\\n690\\t            }\\n691\\t            return $school_id;\\n692\\t        }\\n693\\t        $baodiSchool = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n694\\t            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n695\\t            ->where($where)\\n696\\t            ->field(\'a.id,a.school_attr,a.comprehensive_ranking\')\\n697\\t            ->select();\\n698\\t        if (empty($baodiSchool)) {\\n699\\t            return $school_id;\\n700\\t        }\\n701\\t        $attrSchoolList = [];\\n702\\t        foreach ($baodiSchool as $school) {\\n703\\t            $attr = explode(\',\', $school[\'school_attr\']);\\n704\\t            if (!empty($attr)) {\\n705\\t                foreach ($attr as $k => $v) {\\n706\\t                    $attrSchoolList[$v][] = $school[\'id\'];\\n707\\t                }\\n708\\t            }\\n709\\t        }\\n710\\t        if (!empty($schoolAttrChoose)) {\\n711\\t            if (!empty($attrSchoolList[$schoolAttrChoose])) {\\n712\\t                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n713\\t                    ->whereIn(\'id\', $attrSchoolList[$schoolAttrChoose])\\n714\\t                    ->order(\'comprehensive_ranking\', \'asc\')\\n715\\t                    ->value(\'id\');\\n716\\t            } else {\\n717\\t                switch ($schoolAttrChoose) {\\n718\\t                    case \'985\':\\n719\\t                        if (!empty($attrSchoolList[\'211\'])) {\\n720\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n721\\t                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n722\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n723\\t                                ->value(\'id\');\\n724\\t                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n725\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n726\\t                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n727\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n728\\t                                ->value(\'id\');\\n729\\t                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n730\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n731\\t                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n732\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n733\\t                                ->value(\'id\');\\n734\\t                        }\\n735\\t                        break;\\n736\\t                    case \'211\':\\n737\\t                        if (!empty($attrSchoolList[\'985\'])) {\\n738\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n739\\t                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n740\\t                                ->order(\'comprehensive_ranking\', \'desc\')\\n741\\t                                ->value(\'id\');\\n742\\t                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n743\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n744\\t                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n745\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n746\\t                                ->value(\'id\');\\n747\\t                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n748\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n749\\t                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n750\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n751\\t                                ->value(\'id\');\\n752\\t                        }\\n753\\t                        break;\\n754\\t                    case \'双一流\':\\n755\\t                        if (!empty($attrSchoolList[\'211\'])) {\\n756\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n757\\t                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n758\\t                                ->order(\'comprehensive_ranking\', \'desc\')\\n759\\t                                ->value(\'id\');\\n760\\t                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n761\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n762\\t                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n763\\t                                ->order(\'comprehensive_ranking\', \'desc\')\\n764\\t                                ->value(\'id\');\\n765\\t                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n766\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n767\\t                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n768\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n769\\t                                ->value(\'id\');\\n770\\t                        }\\n771\\t                        break;\\n772\\t                    case \'普通院校\':\\n773\\t                        if (!empty($attrSchoolList[\'双一流\'])) {\\n774\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n775\\t                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n776\\t                                ->order(\'comprehensive_ranking\', \'desc\')\\n777\\t                                ->value(\'id\');\\n778\\t                        } elseif (!empty($attrSchoolList[\'211\'])) {\\n779\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n780\\t                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n781\\t                                ->order(\'comprehensive_ranking\', \'desc\')\\n782\\t                                ->value(\'id\');\\n783\\t                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n784\\t                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n785\\t                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n786\\t                                ->order(\'comprehensive_ranking\', \'asc\')\\n787\\t                                ->value(\'id\');\\n788\\t                        }\\n789\\t                        break;\\n790\\t                }\\n791\\t            }\\n792\\t        } else {\\n793\\t            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n794\\t                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n795\\t                ->where($where)\\n796\\t                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n797\\t                ->order(\'a.comprehensive_ranking\', \'desc\')\\n798\\t                ->value(\'a.id\');\\n799\\t            if (empty($school_id)) {\\n800\\t                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n801\\t                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n802\\t                    ->where($where)\\n803\\t                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n804\\t                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n805\\t                    ->value(\'a.id\');\\n806\\t            }\\n807\\t        }\\n808\\t        return $school_id;\\n809\\t    }\\n810\\t    /**\\n811\\t     * desc:择校选项列表\\n812\\t     * author:hufangfang\\n813\\t     * data:2022/12/6 17:51\\n814\\t     * @return void\\n815\\t     * @throws Exception\\n816\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n817\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n818\\t     * @throws \\\\think\\\\exception\\\\DbException\\n819\\t     */\\n820\\t    public function getSelect()\\n821\\t    {\\n822\\t        $list = [];\\n823\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n824\\t        $nowStanding = $model->getNowStanding();\\n825\\t        $data = [];\\n826\\t        foreach ($nowStanding as $k => $v) {\\n827\\t            $item = [];\\n828\\t            $item[\'key\'] = $k;\\n829\\t            $item[\'value\'] = $v;\\n830\\t            $data[] = $item;\\n831\\t        }\\n832\\t        array_shift($data);\\n833\\t        $list[\'now_standing\'] = $data;\\n834\\t        $educationStading = $model->getEducationStading();\\n835\\t        $data = [];\\n836\\t        foreach ($educationStading as $k => $v) {\\n837\\t            $item = [];\\n838\\t            $item[\'key\'] = $k;\\n839\\t            $item[\'value\'] = $v;\\n840\\t            $data[] = $item;\\n841\\t        }\\n842\\t        array_shift($data);\\n843\\t        $list[\'education_stading\'] = $data;\\n844\\t\\n845\\t        $cet = $model->getCet();\\n846\\t        $data = [];\\n847\\t        foreach ($cet as $k => $v) {\\n848\\t            $item = [];\\n849\\t            $item[\'key\'] = $k;\\n850\\t            $item[\'value\'] = $v;\\n851\\t            $data[] = $item;\\n852\\t        }\\n853\\t        array_shift($data);\\n854\\t        $list[\'cet\'] = $data;\\n855\\t        $diff_major = $model->getDiffMajor();\\n856\\t        $data = [];\\n857\\t        foreach ($diff_major as $k => $v) {\\n858\\t            $item = [];\\n859\\t            $item[\'key\'] = $k;\\n860\\t            $item[\'value\'] = $v;\\n861\\t            $data[] = $item;\\n862\\t        }\\n863\\t        array_shift($data);\\n864\\t        $list[\'diff_major\'] = $data;\\n865\\t        $school_attr = $model->getSchoolAttr();\\n866\\t        $data = [];\\n867\\t        foreach ($school_attr as $k => $v) {\\n868\\t            $item = [];\\n869\\t            $item[\'key\'] = $k;\\n870\\t            if ($v === \'普通院校\') {\\n871\\t                $item[\'value\'] = $v;\\n872\\t            } else {\\n873\\t                $item[\'value\'] = $v . \'院校\';\\n874\\t            }\\n875\\t            $data[] = $item;\\n876\\t        }\\n877\\t        array_shift($data);\\n878\\t        $list[\'school_attr\'] = $data;\\n879\\t        $school_grades = $model->getSchoolGrades();\\n880\\t        $data = [];\\n881\\t        foreach ($school_grades as $k => $v) {\\n882\\t            $item = [];\\n883\\t            $item[\'key\'] = $k;\\n884\\t            $item[\'value\'] = $v;\\n885\\t            $data[] = $item;\\n886\\t        }\\n887\\t        array_shift($data);\\n888\\t        $list[\'school_grades\'] = $data;\\n889\\t        $math_status = $model->getMathStatus();\\n890\\t        $data = [];\\n891\\t        foreach ($math_status as $k => $v) {\\n892\\t            $item = [];\\n893\\t            $item[\'key\'] = $k;\\n894\\t            $item[\'value\'] = $v;\\n895\\t            $data[] = $item;\\n896\\t        }\\n897\\t        array_shift($data);\\n898\\t        $list[\'math_status\'] = $data;\\n899\\t        $exam_year = $model->getExamYear();\\n900\\t        $data = [];\\n901\\t        foreach ($exam_year as $k => $v) {\\n902\\t            $item = [];\\n903\\t            $item[\'key\'] = $k;\\n904\\t            $item[\'value\'] = $v;\\n905\\t            $data[] = $item;\\n906\\t        }\\n907\\t        array_shift($data);\\n908\\t        $list[\'exam_year\'] = $data;\\n909\\t        $determination = $model->getDetermination();\\n910\\t        $data = [];\\n911\\t        foreach ($determination as $k => $v) {\\n912\\t            $item = [];\\n913\\t            $item[\'key\'] = $k;\\n914\\t            $item[\'value\'] = $v;\\n915\\t            $ps = \'\';\\n916\\t            switch (intval($v)){\\n917\\t                case 1:\\n918\\t                    $ps = \'随缘考试\';\\n919\\t                    break;\\n920\\t                case 2:\\n921\\t                    $ps = \'稍稍准备\';\\n922\\t                    break;\\n923\\t                case 3:\\n924\\t                    $ps = \'严肃对待\';\\n925\\t                    break;\\n926\\t                case 4:\\n927\\t                    $ps = \'全力备考\';\\n928\\t                    break;\\n929\\t                case 5:\\n930\\t                    $ps = \'势必成硕\';\\n931\\t                    break;\\n932\\t            }\\n933\\t            $item[\'ps\'] = $ps;\\n934\\t            $data[] = $item;\\n935\\t        }\\n936\\t        array_shift($data);\\n937\\t        $list[\'determination\'] = $data;\\n938\\t        $area = Db::connect(\'database.yx_db_config\')\\n939\\t            ->name(\'area\')\\n940\\t            ->where(\'pid\', \'>\', 0)\\n941\\t            ->field(\'id as `key`,name as value\')\\n942\\t            ->select();\\n943\\t        $list[\'area\'] = $area;\\n944\\t        $this->success(\'success\', $list);\\n945\\t    }\\n946\\t    /**\\n947\\t     * desc:学校列表\\n948\\t     * author:hufangfang\\n949\\t     * data:2022/12/6 17:51\\n950\\t     * @return void\\n951\\t     * @throws Exception\\n952\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n953\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n954\\t     * @throws \\\\think\\\\exception\\\\DbException\\n955\\t     */\\n956\\t    public function schoolList()\\n957\\t    {\\n958\\t        $schoolName = input(\'school_name\', \'\');\\n959\\t        $isApp = input(\'is_app\', 0);\\n960\\t        $where = [];\\n961\\t        $where[\'a.is_hidden\'] = 0;\\n962\\t        if (!empty($schoolName)) {\\n963\\t            $where[\'a.school_name\'] = [\'like\', $schoolName . \'%\'];\\n964\\t        }\\n965\\t        $schoolList = Db::connect(\'database.uc_db_config\')\\n966\\t            ->name(\'school\')->alias(\'a\')\\n967\\t            ->join(\'cl_area b\', \'a.province_id=b.id\')\\n968\\t            ->where($where)\\n969\\t            ->field(\'a.school_id as id,a.school_name as name,a.first_pinyin,b.name as province_name\')\\n970\\t            ->order(\'first_pinyin asc,name asc\')\\n971\\t            ->select();\\n972\\t        $data = [];\\n973\\t        foreach ($schoolList as $k => $v) {\\n974\\t            $item[\'id\'] = $v[\'id\'];\\n975\\t            $item[\'name\'] = $v[\'name\'];\\n976\\t            $item[\'area_name\'] = $v[\'province_name\'];\\n977\\t            if (!empty($schoolName)) {\\n978\\t                $data[] = $item;\\n979\\t            } else {\\n980\\t                $data[$v[\'first_pinyin\']][] = $item;\\n981\\t            }\\n982\\t        }\\n983\\t        if ($isApp && empty($schoolName)) {\\n984\\t            $return = [];\\n985\\t            foreach ($data as $k => $v) {\\n986\\t                $item = [];\\n987\\t                $item[\'key\'] = (string)$k;\\n988\\t                $item[\'list\'] = $v;\\n989\\t                $return[] = $item;\\n990\\t            }\\n991\\t            $data = $return;\\n992\\t        }\\n993\\t        $this->success(\'success\', $data);\\n994\\t    }\\n995\\t    /**\\n996\\t     * desc:择校档案列表\\n997\\t     * author:hufangfang\\n998\\t     * data:2022/12/26 19:45\\n999\\t     * @return void\\n1000\\t     * @throws Exception\\n1001\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1002\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1003\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1004\\t     */\\n1005\\t    public function history()\\n1006\\t    {\\n1007\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n1008\\t            ->where(\'uid\', session(\'uid\'))\\n1009\\t            ->order(\'createtime\', \'desc\')\\n1010\\t            ->limit(10)\\n1011\\t            ->select();\\n1012\\t        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n1013\\t            ->where(\'pid\', \'>\', 0)\\n1014\\t            ->column(\'name\', \'id\');\\n1015\\t        $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n1016\\t            ->column(\'name\', \'id\');\\n1017\\t        $return = [];\\n1018\\t        if (!empty($list)) {\\n1019\\t            $item = [];\\n1020\\t            foreach ($list as $k => $v) {\\n1021\\t                $item[\'area\'] = explode(\',\', $v[\'area_id\']);\\n1022\\t                foreach ($item[\'area\'] as $kk => $vv) {\\n1023\\t                    $item[\'area\'][$kk] = $areaList[$vv] ?? \'\';\\n1024\\t                }\\n1025\\t                $item[\'id\'] = $v[\'id\'];\\n1026\\t                $item[\'area\'] = implode(\',\', $item[\'area\']);\\n1027\\t                $item[\'major_name\'] = $majorList[$v[\'major_id\']] ?? \'\';\\n1028\\t                $item[\'createtime\'] = date(\'Y-m-d H:i:s\', $v[\'createtime\']);\\n1029\\t                $return[$k] = $item;\\n1030\\t            }\\n1031\\t        }\\n1032\\t        $this->success(\'success\', $return);\\n1033\\t    }\\n1034\\t    /**\\n1035\\t     * desc:档案详情\\n1036\\t     * author:hufangfang\\n1037\\t     * data:2022/12/26 19:52\\n1038\\t     * @return void\\n1039\\t     * @throws Exception\\n1040\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1041\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1042\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1043\\t     */\\n1044\\t    public function recordDetail()\\n1045\\t    {\\n1046\\t        $id = input(\'id\', 0);\\n1047\\t        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n1048\\t            ->where(\'id\', $id)\\n1049\\t            ->order(\'createtime\', \'desc\')\\n1050\\t            ->find();\\n1051\\t        if (!empty($record)) {\\n1052\\t            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n1053\\t            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n1054\\t                ->where(\'pid\', \'>\', 0)\\n1055\\t                ->column(\'name\', \'id\');\\n1056\\t            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n1057\\t                ->column(\'name\', \'id\');\\n1058\\t            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n1059\\t                ->where(\'is_hidden\', 0)\\n1060\\t                ->column(\'school_name\', \'school_id\');\\n1061\\t            $nowStanding = $model->getNowStanding();\\n1062\\t            $educationStading = $model->getEducationStading();\\n1063\\t            $cet = $model->getCet();\\n1064\\t            $diff_major = $model->getDiffMajor();\\n1065\\t            $school_attr = $model->getSchoolAttr();\\n1066\\t            $school_grades = $model->getSchoolGrades();\\n1067\\t            $math_status = $model->getMathStatus();\\n1068\\t            $determination = $model->getDetermination();\\n1069\\t            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n1070\\t            $record[\'area_id\'] = [];\\n1071\\t            foreach ($record[\'area\'] as $kk => $vv) {\\n1072\\t                $record[\'area_id\'][] = $areaList[$vv] ?? \'\';\\n1073\\t            }\\n1074\\t            unset($record[\'area\']);\\n1075\\t            $record[\'area_id\'] = implode(\',\', $record[\'area_id\']);\\n1076\\t            $record[\'now_standing\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n1077\\t            $record[\'school_id\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n1078\\t            $record[\'diff_major\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n1079\\t\\n1080\\t            if (empty($record[\'school_attr\'])) {\\n1081\\t                $record[\'school_attr\'] = \'\';\\n1082\\t            } else {\\n1083\\t                $record[\'school_attr\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n1084\\t            }\\n1085\\t            if (empty($record[\'school_grades\'])) {\\n1086\\t                $record[\'school_grades\'] = \'\';\\n1087\\t            } else {\\n1088\\t                $record[\'school_grades\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n1089\\t            }\\n1090\\t            $record[\'cet\'] = $cet[$record[\'cet\']] ?? \'\';\\n1091\\t            if (empty($record[\'cet\'])) {\\n1092\\t                $record[\'cet\'] = \'\';\\n1093\\t            }\\n1094\\t            if (empty($record[\'math_status\'])) {\\n1095\\t                $record[\'math_status\'] = \'\';\\n1096\\t            } else {\\n1097\\t                $record[\'math_status\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n1098\\t            }\\n1099\\t            $record[\'major_id\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n1100\\t            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n1101\\t            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n1102\\t            $record[\'education_stading\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n1103\\t        } else {\\n1104\\t            $record = [];\\n1105\\t        }\\n1106\\t        $uid = $record[\'uid\'];\\n1107\\t        $userInfo = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1108\\t            ->where(\'uid\', $uid)\\n1109\\t            ->field(\'uid,username,mobile\')\\n1110\\t            ->find();\\n1111\\t        $userInfo[\'createtime\'] = $record[\'createtime\'];\\n1112\\t        $return = [];\\n1113\\t        $return[\'userInfo\'] = $userInfo;\\n1114\\t        $return[\'detail\'] = $record;\\n1115\\t        $return[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n1116\\t        $this->success(\'success\', $return);\\n1117\\t    }\\n1118\\t    /**\\n1119\\t     * desc:\\n1120\\t     * author:hufangfang\\n1121\\t     * data:2022/12/8 16:03\\n1122\\t     * @return void\\n1123\\t     * @throws Exception\\n1124\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1125\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1126\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1127\\t     */\\n1128\\t    public function info()\\n1129\\t    {\\n1130\\t        $id = input(\'id\', 0);\\n1131\\t        $type = input(\'type\', 0);\\n1132\\t        $isfeishu = input(\'isfeishu\', 0);\\n1133\\t        $info = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n1134\\t            ->where(\'id\', $id)\\n1135\\t            ->find();\\n1136\\t        $result = $info[\'result\'];\\n1137\\t        $return = [];\\n1138\\t        $intentMajorInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n1139\\t            ->join(\'cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n1140\\t            ->where(\'a.id\', $info[\'major_id\'])\\n1141\\t            ->field(\'a.name,a.code,b.menlei,b.type\')\\n1142\\t            ->find();\\n1143\\t        $area = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n1144\\t            ->where(\'pid\', \'>\', 0)\\n1145\\t            ->column(\'name\', \'id\');\\n1146\\t        $intent[\'major_name\'] = $intentMajorInfo[\'name\'] ?? \'\';\\n1147\\t        $intent[\'major_code\'] = $intentMajorInfo[\'code\'] ?? \'\';\\n1148\\t        $intent[\'major_id\'] = $info[\'major_id\'];\\n1149\\t        $intent[\'menlei\'] = $intentMajorInfo[\'menlei\'];\\n1150\\t        $intent[\'type\'] = $intentMajorInfo[\'type\'];\\n1151\\t        $intentAreaId = $info[\'area_id\'];\\n1152\\t        $areaName = [];\\n1153\\t        if (!empty($intentAreaId)) {\\n1154\\t            $intentAreaId = explode(\',\', $intentAreaId);\\n1155\\t            foreach ($intentAreaId as $K => $v) {\\n1156\\t                $areaName[] = $area[$v] ?? \'\';\\n1157\\t            }\\n1158\\t        }\\n1159\\t        $intent[\'area\'] = implode(\'、\', $areaName);\\n1160\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n1161\\t        $school_attr = $model->getSchoolAttr();\\n1162\\t        if (!empty($info[\'school_attr\'])) {\\n1163\\t            $intent[\'school_attr\'] = $school_attr[$info[\'school_attr\']] ?? \'\';\\n1164\\t        } else {\\n1165\\t            $intent[\'school_attr\'] = \'\';\\n1166\\t        }\\n1167\\t        $where = [];\\n1168\\t        $where[\'a.area_id\'] = [\'in\', $info[\'area_id\']];\\n1169\\t        $where[\'b.major_id\'] = $info[\'major_id\'];\\n1170\\t        $schoolNum = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n1171\\t            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n1172\\t            ->where($where)\\n1173\\t            ->group(\'a.id\')\\n1174\\t            ->count();\\n1175\\t        $area_school_info = \'当前地区符合您意向专业的院校共有\' . $schoolNum . \'所\';\\n1176\\t        $intent[\'area_school_info\'] = $area_school_info;\\n1177\\t        $return[\'intent\'] = $intent;\\n1178\\t        $result = json_decode($result, \'true\');\\n1179\\t        $return[\'ai_result\'] = $result;\\n1180\\t        $majorInfo = $this->getMajorInfo($result, $type, $info[\'uid\'], $isfeishu, $area);\\n1181\\t        $status = accessControl(1,$majorInfo[\'major_school_id\']);\\n1182\\t        if(!$status){\\n1183\\t            if($status===0){\\n1184\\t                $this->error(\'您操作过于频繁，请稍后再试\');\\n1185\\t            }else{\\n1186\\t                $this->error(\'您的账号存在异常，请联系客服\');\\n1187\\t            }\\n1188\\t        }\\n1189\\t        if (empty($majorInfo)) {\\n1190\\t            $this->success(\'success\', $return);\\n1191\\t        }\\n1192\\t        //综合推荐\\n1193\\t        $return[\'mix\'] = $majorInfo;\\n1194\\t        //期望院校推荐\\n1195\\t        if (!empty($result[\'exp\'])) {\\n1196\\t            $majorId = $result[\'exp\'][\'major_id\'] ?? 0;\\n1197\\t            $schoolId = $result[\'exp\'][\'school_id\'] ?? 0;\\n1198\\t            $star = $result[\'exp\'][\'star\'] ?? 0;\\n1199\\t            $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n1200\\t                ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n1201\\t                ->where(\'a.major_id\', $majorId)\\n1202\\t                ->where(\'a.school_id\', $schoolId)\\n1203\\t                ->order(\'b.first_pinyin\', \'asc\')\\n1204\\t                ->value(\'a.id\');\\n1205\\t            $majorInfo = $this->majorSchoolModel\\n1206\\t                ->alias(\'ms\')\\n1207\\t                ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n1208\\t                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n1209\\t                ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n1210\\t                ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n1211\\t                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n1212\\t                ->field(\'sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n1213\\t                ->where(\'ms.id\', $majorSchoolId)\\n1214\\t                ->find();\\n1215\\t            if (!empty($majorInfo)) {\\n1216\\t                $adminSchoolMajor = new SchoolMajor();\\n1217\\t                $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n1218\\t                $majorInfo[\'star\'] = $star;\\n1219\\t                $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n1220\\t                $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n1221\\t                $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n1222\\t                $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n1223\\t                if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n1224\\t                    $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n1225\\t                }\\n1226\\t                $return[\'exp\'] = $majorInfo;\\n1227\\t            } else {\\n1228\\t                $return[\'exp\'] = [];\\n1229\\t            }\\n1230\\t        } else {\\n1231\\t            $return[\'exp\'] = [];\\n1232\\t        }\\n1233\\t        $this->success(\'success\', $return);\\n1234\\t    }\\n1235\\t    /**\\n1236\\t     * desc:综合推荐专业详情\\n1237\\t     * author:hufangfang\\n1238\\t     * data:2022/12/21 11:25\\n1239\\t     * @param $result\\n1240\\t     * @param $type\\n1241\\t     * @param $isfeishu\\n1242\\t     * @return mixed\\n1243\\t     * @throws Exception\\n1244\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1245\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1246\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1247\\t     */\\n1248\\t    private function getMajorInfo($result, $type, $uid, $isfeishu, $area)\\n1249\\t    {\\n1250\\t        $majorId = 0;\\n1251\\t        $schoolId = 0;\\n1252\\t        $star = 0;\\n1253\\t        if (empty($result)) {\\n1254\\t            return false;\\n1255\\t        }\\n1256\\t        if (empty($type)) {\\n1257\\t            foreach ($result[\'mix\'] as $k => $v) {\\n1258\\t                $majorId = $v[\'major_id\'] ?? 0;\\n1259\\t                $schoolId = $v[\'school_id\'] ?? 0;\\n1260\\t                $star = $v[\'star\'] ?? 0;\\n1261\\t                if ($k == \'midMajor\' && !empty($v)) {\\n1262\\t                    $type = 1;\\n1263\\t                    break;\\n1264\\t                }\\n1265\\t                if ($k == \'midMix\' && !empty($v)) {\\n1266\\t                    $type = 2;\\n1267\\t                    break;\\n1268\\t                }\\n1269\\t                if ($k == \'top\' && !empty($v)) {\\n1270\\t                    $type = 3;\\n1271\\t                    break;\\n1272\\t                }\\n1273\\t                if ($k == \'lowMajor\' && !empty($v)) {\\n1274\\t                    $type = 4;\\n1275\\t                    break;\\n1276\\t                }\\n1277\\t                if ($k == \'lowMix\' && !empty($v)) {\\n1278\\t                    $type = 5;\\n1279\\t                    break;\\n1280\\t                }\\n1281\\t            }\\n1282\\t        } else {\\n1283\\t            switch ($type) {\\n1284\\t                case 1:\\n1285\\t                    $majorId = $result[\'mix\'][\'midMajor\'][\'major_id\'] ?? 0;\\n1286\\t                    $schoolId = $result[\'mix\'][\'midMajor\'][\'school_id\'] ?? 0;\\n1287\\t                    $star = $result[\'mix\'][\'midMajor\'][\'star\'] ?? 0;\\n1288\\t                    break;\\n1289\\t                case 2:\\n1290\\t                    $majorId = $result[\'mix\'][\'midMix\'][\'major_id\'] ?? 0;\\n1291\\t                    $schoolId = $result[\'mix\'][\'midMix\'][\'school_id\'] ?? 0;\\n1292\\t                    $star = $result[\'mix\'][\'midMix\'][\'star\'] ?? 0;\\n1293\\t                    break;\\n1294\\t                case 3:\\n1295\\t                    $majorId = $result[\'mix\'][\'top\'][\'major_id\'] ?? 0;\\n1296\\t                    $schoolId = $result[\'mix\'][\'top\'][\'school_id\'] ?? 0;\\n1297\\t                    $star = $result[\'mix\'][\'top\'][\'star\'] ?? 0;\\n1298\\t                    break;\\n1299\\t                case 4:\\n1300\\t                    $majorId = $result[\'mix\'][\'lowMajor\'][\'major_id\'] ?? 0;\\n1301\\t                    $schoolId = $result[\'mix\'][\'lowMajor\'][\'school_id\'] ?? 0;\\n1302\\t                    $star = $result[\'mix\'][\'lowMajor\'][\'star\'] ?? 0;\\n1303\\t                    break;\\n1304\\t                case 5:\\n1305\\t                    $majorId = $result[\'mix\'][\'lowMix\'][\'major_id\'] ?? 0;\\n1306\\t                    $schoolId = $result[\'mix\'][\'lowMix\'][\'school_id\'] ?? 0;\\n1307\\t                    $star = $result[\'mix\'][\'lowMix\'][\'star\'] ?? 0;\\n1308\\t                    break;\\n1309\\t            }\\n1310\\t        }\\n1311\\t        if (empty($majorId) || empty($schoolId)) {\\n1312\\t            return false;\\n1313\\t        }\\n1314\\t        $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n1315\\t            ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n1316\\t            ->where(\'a.major_id\', $majorId)\\n1317\\t            ->where(\'a.school_id\', $schoolId)\\n1318\\t            ->order(\'b.first_pinyin\', \'asc\')\\n1319\\t            ->value(\'a.id\');\\n1320\\t        if (!$majorSchoolId) {\\n1321\\t            return false;\\n1322\\t        }\\n1323\\t        $majorInfo = $this->majorSchoolModel\\n1324\\t            ->alias(\'ms\')\\n1325\\t            ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n1326\\t            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n1327\\t            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n1328\\t            ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n1329\\t            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n1330\\t            ->field(\'yx.intro,sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n1331\\t            ->where(\'ms.id\', $majorSchoolId)\\n1332\\t            ->find();\\n1333\\t        if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n1334\\t            $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n1335\\t        }\\n1336\\t        $school_name = $majorInfo[\'school_name\'];\\n1337\\t        $school_attr = $majorInfo[\'school_attr\'];\\n1338\\t        $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n1339\\t        $sort = $majorInfo[\'comprehensive_ranking\'];\\n1340\\t        $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n1341\\t        $juge = $subjectAssessMent[$majorInfo[\'subject_assessment\']] ?? \'\';\\n1342\\t        $xueke = \'\';\\n1343\\t        if (!empty($juge)) {\\n1344\\t            $xueke = \'，学科评估为\' . $juge;\\n1345\\t        }\\n1346\\t        switch ($type) {\\n1347\\t            case 1:\\n1348\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，更具有专业竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n1349\\t                break;\\n1350\\t            case 2:\\n1351\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，院校更具有竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n1352\\t                break;\\n1353\\t            case 3:\\n1354\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，学历含金量很高，建议尝试报考。虽然面临一定考试难度，相信经过我们的指导后，通过您的100%对学些的投入，还是有机会考取该院校的，联系学习规划老师获取详细方案。\';\\n1355\\t                break;\\n1356\\t            case 4:\\n1357\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n1358\\t                break;\\n1359\\t            case 5:\\n1360\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n1361\\t                break;\\n1362\\t        }\\n1363\\t        if ($majorInfo) {\\n1364\\t            $adminSchoolMajor = new SchoolMajor();\\n1365\\t            $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n1366\\t            $majorInfo[\'introReason\'] = $introReason;\\n1367\\t            $majorInfo[\'star\'] = $star;\\n1368\\t            $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n1369\\t            if ($uid) {\\n1370\\t                $teacherInfo = getQrcode($uid, $isfeishu);\\n1371\\t            }\\n1372\\t            $lqxx = (new \\\\app\\\\api\\\\logic\\\\Pic())->getLqxx($majorSchoolId, $majorInfo, $uid);\\n1373\\t            $majorInfo[\'zlrsUrl\'] = $lqxx[\'zlrsUrl\'];\\n1374\\t            $majorInfo[\'fushi\'] = $lqxx[\'fushi\'];\\n1375\\t            $majorInfo[\'year_vs_score\'] = $lqxx[\'year_vs_score\'];\\n1376\\t            $majorInfo[\'has_year_vs_score\'] = $lqxx[\'has_year_vs_score\'];\\n1377\\t            $majorInfo[\'is_vip\'] = $lqxx[\'is_vip\'];\\n1378\\t            $majorInfo[\'analysis\'] = $lqxx[\'analysis\'];\\n1379\\t            if (!empty($teacherInfo)) {\\n1380\\t                $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1381\\t                    ->where(\'uid\', $uid)\\n1382\\t                    ->value(\'username\');\\n1383\\t                $teacherInfo[\'nickname\'] = $nickname;\\n1384\\t                $teacherInfo[\'head_url\'] = Config(\'fc_website_url\') . \'/proxy/\' . get_avatar_path($uid);\\n1385\\t            } else {\\n1386\\t                $teacherInfo = [];\\n1387\\t            }\\n1388\\t            $majorInfo[\'teacher\'] = $teacherInfo;\\n1389\\t            $majorInfo[\'type\'] = $type;\\n1390\\t            $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n1391\\t            //院校默认图\\n1392\\t            $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n1393\\t        }\\n1394\\t        return $majorInfo;\\n1395\\t    }\\n1396\\t    /**\\n1397\\t     * desc:根据专业获取学校排名\\n1398\\t     * author:hufangfang\\n1399\\t     * data:2022/12/21 11:26\\n1400\\t     * @return void\\n1401\\t     * @throws Exception\\n1402\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1403\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1404\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1405\\t     */\\n1406\\t    public function schoolOrder()\\n1407\\t    {\\n1408\\t        $majorId = input(\'major_id/d\', 0);\\n1409\\t        $p = input(\'p/d\', 1);\\n1410\\t        $limit = input(\'limit/d\', 10);\\n1411\\t        if ($p < 1) {\\n1412\\t            $p = 1;\\n1413\\t        }\\n1414\\t        if ($limit < 1) {\\n1415\\t            $limit = 10;\\n1416\\t        }\\n1417\\t        if (empty($majorId)) {\\n1418\\t            $this->success(\'success\');\\n1419\\t        }\\n1420\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n1421\\t            ->join(\'cl_school b\', \'a.school_id=b.id\', \'left\')\\n1422\\t            ->join(\'cl_yuanxi c\', \'a.yuanxi_id=c.id\', \'left\')\\n1423\\t            ->join(\'cl_major e\', \'a.major_id=e.id\', \'left\')\\n1424\\t            ->join(\'cl_school_yjxk d\', \'a.school_id=d.school_id and d.yjxk_id=e.yjxk_id\', \'left\')\\n1425\\t            ->field(\'a.school_id,a.major_id,b.name school_name,e.name major_name,b.area_id,b.school_attr,b.comprehensive_ranking,c.name yuanxi_name,d.subject_assessment,b.logo\')\\n1426\\t            ->where(\'a.major_id\', $majorId)\\n1427\\t            ->order(\'comprehensive_ranking,c.first_pinyin\')\\n1428\\t            ->limit(50)\\n1429\\t            ->select();\\n1430\\t        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n1431\\t            ->where(\'pid\', \'>\', 0)\\n1432\\t            ->column(\'name\', \'id\');\\n1433\\t        $return = [];\\n1434\\t        $adminSchoolMajor = new SchoolMajor();\\n1435\\t        foreach ($list as $k => $v) {\\n1436\\t            $v[\'area_name\'] = $areaList[$v[\'area_id\']] ?? \'\';\\n1437\\t            $v[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($v[\'subject_assessment\']);\\n1438\\t            if (!empty($v[\'school_attr\'])) {\\n1439\\t                $v[\'school_attr\'] = explode(\',\', $v[\'school_attr\']);\\n1440\\t            } else {\\n1441\\t                $v[\'school_attr\'] = [];\\n1442\\t            }\\n1443\\t            $v[\'logo\'] = School::schoolLogo($v[\'logo\']);\\n1444\\t            if (empty($return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']])) {\\n1445\\t                $return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']] = $v;\\n1446\\t            }\\n1447\\t            if ($v[\'comprehensive_ranking\'] == 10000) {\\n1448\\t                $v[\'comprehensive_ranking\'] = \'暂无\';\\n1449\\t            }\\n1450\\t        }\\n1451\\t        $this->success(\'success\', array_values($return));\\n1452\\t    }\\n1453\\t    //发送飞书消息\\n1454\\t    public function feishuMessage()\\n1455\\t    {\\n1456\\t        $tutorId = input(\'tutor_id\', \'\');\\n1457\\t        $id = input(\'id\', 0);\\n1458\\t        if (empty($tutorId) || empty($id)) {\\n1459\\t            $this->error(\'参数错误\');\\n1460\\t        }\\n1461\\t        $mobile = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1462\\t            ->where(\'uid\', $tutorId)\\n1463\\t            ->value(\'mobile\');\\n1464\\t        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n1465\\t            ->where(\'id\', $id)\\n1466\\t            ->find();\\n1467\\t        if (empty($record)) {\\n1468\\t            $this->error(\'id错误\');\\n1469\\t        }\\n1470\\t        $key = \'yuanxiao:feishu:tutor:notice:\' . $tutorId . \':\' . $id;\\n1471\\t        $cache = redis()->get($key);\\n1472\\t        if ($cache) {\\n1473\\t            $this->success(\'success\', []);\\n1474\\t        }\\n1475\\t        $uid = $record[\'uid\'];\\n1476\\t        $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1477\\t            ->where(\'uid\', $uid)\\n1478\\t            ->value(\'username\');\\n1479\\t        $url = config(\'feishu_jump_url\') . \'?refresh=1&refer=\' . urlencode(\'https://wxapp.orangevip.com/choice-record?id=\' . $id . \'&isfeishu=1\');\\n1480\\t        $message = \'您的学员\' . $nickname . \'，进行了AI择校。点击连接，查看学生择校信息：\' . $url;\\n1481\\t        $data[\'type\'] = \'post\';\\n1482\\t        $data[\'message\'][\'title\'] = \\\"AI择校消息通知\\\";\\n1483\\t        $text1 = $message;\\n1484\\t        $content1[] = [\'tag\' => \'text\', \'un_escape\' => true, \'text\' => $text1];\\n1485\\t        $data[\'message\'][\'content\'][] = $content1;\\n1486\\t        $data[\'mobile\'] = $mobile;\\n1487\\t        $res = Helpers::clphpCurl($data);\\n1488\\t        redis()->set($key, 1);\\n1489\\t        $this->success(\'success\', $res);\\n1490\\t    }\\n1491\\t    /**\\n1492\\t     * desc:判断科目是否考数一数二or数三\\n1493\\t     * author:hufangfang\\n1494\\t     * data:2023/1/4 10:13\\n1495\\t     * @return void\\n1496\\t     * @throws Exception\\n1497\\t     */\\n1498\\t    public function majorExamSubject()\\n1499\\t    {\\n1500\\t        $majorId = input(\'major_id\', 0);\\n1501\\t        $examSubject = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n1502\\t            ->where(\'id\', $majorId)\\n1503\\t            ->value(\'exam_subject\');\\n1504\\t        $hasMath = false;\\n1505\\t        if (!empty($examSubject)) {\\n1506\\t            $examSubject = explode(\',\', $examSubject);\\n1507\\t            foreach ($examSubject as $k => $v) {\\n1508\\t                if (in_array($v, [\'数学一\', \'数学二\', \'数学三\'])) {\\n1509\\t                    $hasMath = true;\\n1510\\t                    break;\\n1511\\t                }\\n1512\\t            }\\n1513\\t        }\\n1514\\t        $this->success(\'success\', [\'has_math\' => $hasMath]);\\n1515\\t    }\\n1516\\t\\n1517\\t    public function testQrcode()\\n1518\\t    {\\n1519\\t        $res = getQrcode(1, 0);\\n1520\\t    }\\n1521\\t}\\n1522\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"64a3dfe2-2ce8-4685-94e7-849d0265f79d\",\"uuid\":\"a7d5028f-5eb5-4b3f-b8de-e7c1cdf1dd82\",\"timestamp\":\"2026-07-07T13:57:43.075Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/hufangfang/www/local/wt-task-1/application/api/controller/Ai.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\api\\\\library\\\\ComErrorDescs;\\nuse app\\\\common\\\\library\\\\Helpers;\\nuse think\\\\Db;\\nuse think\\\\Exception;\\nuse app\\\\admin\\\\model\\\\SchoolMajor;\\nuse app\\\\common\\\\model\\\\Document;\\nuse app\\\\common\\\\model\\\\Major as ModelMajor;\\nuse app\\\\common\\\\model\\\\MajorSchool;\\nuse app\\\\common\\\\model\\\\School;\\nuse app\\\\common\\\\model\\\\SchoolMajorCollect;\\nuse think\\\\Config;\\n\\n/**\\n * 首页接口\\n */\\nclass Ai extends ApiAuth\\n{\\n    protected $noNeedLogin = [\'schoolorder\', \'majorexamsubject\'];\\n    protected $noNeedRight = [\'schoolorder\', \'info\', \'start\', \'index\', \'getselect\', \'schoollist\', \'history\', \'feishumessage\', \'recorddetail\', \'majorexamsubject\', \'testqrcode\'];\\n    protected $majorModel = null;\\n    protected $majorSchoolModel = null;\\n    public function _initialize()\\n    {\\n        parent::_initialize();\\n        $this->majorModel = new ModelMajor();\\n        $this->majorSchoolModel = new MajorSchool();\\n    }\\n    public function index()\\n    {\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'uid\', session(\'uid\'))\\n            ->order(\'createtime\', \'desc\')\\n            ->find();\\n        if (!empty($record)) {\\n            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n            $year = $model->getExamYear();\\n            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n                ->where(\'pid\', \'>\', 0)\\n                ->column(\'name\', \'id\');\\n            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n                ->column(\'name\', \'id\');\\n            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n                ->where(\'is_hidden\', 0)\\n                ->column(\'school_name\', \'school_id\');\\n            $nowStanding = $model->getNowStanding();\\n            $educationStading = $model->getEducationStading();\\n            $cet = $model->getCet();\\n            $diff_major = $model->getDiffMajor();\\n            $school_attr = $model->getSchoolAttr();\\n            $school_grades = $model->getSchoolGrades();\\n            $math_status = $model->getMathStatus();\\n            $determination = $model->getDetermination();\\n            $item = [];\\n            $item[\'key\'] = array_search($record[\'exam_year\'], $year);\\n            $item[\'value\'] = $record[\'exam_year\'];\\n            $record[\'exam_year\'] = $item;\\n            $record[\'result\'] = json_decode($record[\'result\'], true);\\n            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n            $item = [];\\n            $record[\'area_id\'] = [];\\n            foreach ($record[\'area\'] as $kk => $vv) {\\n                $item[\'key\'] = (int)$vv;\\n                $item[\'value\'] = $areaList[$vv] ?? \'\';\\n                $record[\'area_id\'][] = $item;\\n            }\\n            unset($record[\'area\']);\\n            $item = [];\\n            $item[\'key\'] = $record[\'now_standing\'];\\n            $item[\'value\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n            $record[\'now_standing\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_id\'];\\n            $item[\'value\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n            $record[\'school_id\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'diff_major\'];\\n            $item[\'value\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n            $record[\'diff_major\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_attr\'];\\n            $item[\'value\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n            if (empty($record[\'school_attr\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'school_attr\'] = $item;\\n\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_grades\'];\\n            $item[\'value\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n            if (empty($record[\'school_grades\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'school_grades\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'cet\'];\\n            $item[\'value\'] = $cet[$record[\'cet\']] ?? \'\';\\n            if (empty($record[\'cet\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'cet\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'math_status\'];\\n            $item[\'value\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n            if (empty($record[\'math_status\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'math_status\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'major_id\'];\\n            $item[\'value\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n            $record[\'major_id\'] = $item;\\n            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n            $item = [];\\n            $item[\'key\'] = $record[\'education_stading\'];\\n            $item[\'value\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n            $record[\'education_stading\'] = $item;\\n        } else {\\n            $record = [];\\n        }\\n        $this->success(\'success\', $record);\\n    }\\n    /**\\n     * 首页\\n     *\\n     */\\n    public function start()\\n    {\\n        $input = input();\\n        foreach ($input as $k => $v) {\\n            if (!in_array($k, [\'now_standing\', \'school_id\', \'education_stading\', \'cet\', \'area_id\', \'major_id\', \'diff_major\', \'school_attr\', \'school_grades\', \'math_status\', \'exam_year\', \'determination\'])) {\\n                unset($input[$k]);\\n            }\\n        }\\n        $input = array_filter($input);\\n        $validate = validate(\\\"Ai\\\");\\n        if (!$validate->check($input)) {\\n            $result = (string)$validate->getError();\\n            if (false !== strpos($result, \',\')) {\\n                list($errNo, $msg) = explode(\',\', $result);\\n            } else {\\n                $errNo = ComErrorDescs::EC_UNKNOWN;\\n                $msg = \'\';\\n            }\\n            $this->result(ComErrorDescs::errmsg($errNo, $msg), [], $errNo);\\n        }\\n        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'diff_major\'] == 3)) {\\n            if (empty($input[\'school_grades\'])) {\\n                $this->error(\'在校成绩不能为空\');\\n            }\\n        }\\n        $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where(\'uc_school_id\', $input[\'school_id\'])\\n            ->value(\'id\');\\n        if (empty($school_id)) {\\n            $school_id = 0;\\n        }\\n        $examSubject = Db::connect(\'database.yx_db_config\')\\n            ->name(\'cl_major\')\\n            ->where(\'id\', $input[\'major_id\'])\\n            ->value(\'exam_subject\');\\n        if (!empty($examSubject)) {\\n            $examSubject = explode(\',\', $examSubject);\\n            $examSubject = array_intersect($examSubject, [\'数学一\', \'数学二\', \'数学三\']);\\n            if (!empty($examSubject) && empty($input[\'math_status\'])) {\\n                $this->error(\'高等数学学习情况不能为空\');\\n            }\\n        }\\n        $area_num = count(explode(\',\', $input[\'area_id\']));\\n        if ($area_num > 5) {\\n            $this->error(\'期望报考地区最多选择5个\');\\n        }\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $year = $model->getExamYear();\\n        $input[\'exam_year\'] = $year[$input[\'exam_year\']];\\n        $input[\'createtime\'] = time();\\n        $input[\'updatetime\'] = time();\\n        $input[\'uid\'] = session(\'uid\');\\n        $id = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->insertGetId($input);\\n        $input[\'school_id\'] = $school_id;\\n        $result = $this->chooseSchool($input);\\n        Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->update([\\n                \'result\' => json_encode_cus($result),\\n                \'status\' => 1,\\n                \'updatetime\' => time()\\n            ]);\\n        $result[\'id\'] = $id;\\n        $result[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n        $this->success(\'success\', $result);\\n    }\\n    private function chooseSchool($input)\\n    {\\n        if (empty($input[\'school_attr\'])) {\\n            $input[\'school_attr\'] = \'\';\\n        }\\n        if (empty($input[\'math_status\'])) {\\n            $input[\'math_status\'] = 0;\\n        }\\n        if (empty($input[\'school_grades\'])) {\\n            $input[\'school_grades\'] = 0;\\n        }\\n        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'math_status\'] == 2) || ($input[\'diff_major\'] == 3) || ($input[\'school_grades\'] == 4) || ($input[\'determination\'] == 1)) {\\n            $f = -1;\\n        } else {\\n            $f = 0;\\n        }\\n        if ($input[\'exam_year\'] == \'其他\') {\\n            $q = 1;\\n        } else {\\n            $chooseYear = strtotime(((int)$input[\'exam_year\']) . \'-12-25\');\\n            $preChooseYear = strtotime(\'-1 yaar\', $chooseYear);\\n            $nowYear = strtotime(date(\'Y\') . \'-12-25\');\\n            if ($preChooseYear > $nowYear) {\\n                $q = 1;\\n            } else {\\n                $q = 0;\\n            }\\n        }\\n        if (($input[\'school_grades\'] == 1) || ($input[\'determination\'] == 5) || in_array($input[\'now_standing\'], [1, 2, 3, 4, 5]) || $q == 1) {\\n            $k = 1;\\n        } else {\\n            $k = 0;\\n        }\\n        switch ($input[\'education_stading\']) {\\n            case 1:\\n                $k = 5;\\n                break;\\n            case 2:\\n                $k = 4;\\n                break;\\n            case 3:\\n                $k = 3;\\n                break;\\n            case 4:\\n                $k = 2;\\n                break;\\n            case 5:\\n                $k = 1;\\n                break;\\n            case 6:\\n                $k = 1;\\n                break;\\n            case 7:\\n                $k = 1;\\n                break;\\n        }\\n        $r = $f + $q + $k;\\n        if ($r < 1) {\\n            $r = 1;\\n        }\\n        if ($r > 5) {\\n            $r = 5;\\n        }\\n        $topWhere = $middleWhereMix = $middleWhereMajor = $lowerWhereMix = $lowerWhereMajor = [];\\n        $menlei = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n            ->join(\'t_cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n            ->where(\'a.id\', $input[\'major_id\'])\\n            ->value(\'b.menlei\');\\n        $schoolModel = new \\\\app\\\\admin\\\\model\\\\School();\\n        $typeToMenlei = $schoolModel->typeToMenlei();\\n        foreach ($typeToMenlei as $k => $v) {\\n            if (in_array($menlei, $v)) {\\n                $type = $k;\\n            }\\n        }\\n        $diffMajor = $input[\'diff_major\'];\\n        if ($diffMajor > 1) {\\n            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->join(\'cl_major_school_detail c\', \'b.id=c.major_school_id\', \'left\')\\n                ->where(\'b.major_id\', $input[\'major_id\'])\\n                ->where(\'c.year\', \'2022\')\\n                ->where(\'c.kzybk\', 1)\\n                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n                ->column(\'a.school_attr\', \'a.id\');\\n        } else {\\n            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n                ->where(\'b.major_id\', $input[\'major_id\'])\\n                ->column(\'a.school_attr\', \'a.id\');\\n        }\\n        $nomalSchoolId = [];\\n        $schoolId985 = [];\\n        $schoolId211 = [];\\n        $schoolIdone = [];\\n        $expSchoolId = [];\\n        $assessmentSchoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school_yjxk\')\\n            ->field(\'school_id,min(subject_assessment) subject_assessment\')\\n            ->group(\'school_id\')\\n            ->select();\\n        $lowAssessment = [];\\n        $lowAssessment1 = [];\\n        foreach ($assessmentSchoolList as $k => $v) {\\n            if ($v[\'subject_assessment\'] > 3 || $v[\'subject_assessment\'] == 0) {\\n                $lowAssessment[] = $v[\'school_id\'];\\n            }\\n            if ($v[\'subject_assessment\'] > 1 || $v[\'subject_assessment\'] == 0) {\\n                $lowAssessment1[] = $v[\'school_id\'];\\n            }\\n        }\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $attrList = $model->getSchoolAttr();\\n        $schoolAttrChoose = $attrList[$input[\'school_attr\']] ?? \'\';\\n        foreach ($schoolList as $k => $v) {\\n            $schoolAttr = explode(\',\', $v);\\n            if ($v == \'普通院校\') {\\n                $nomalSchoolId[] = $k;\\n            }\\n            if (in_array(\'985\', $schoolAttr)) {\\n                $schoolId985[] = $k;\\n            }\\n            if (in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n                $schoolId211[] = $k;\\n            }\\n            if (in_array(\'双一流\', $schoolAttr) && !in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n                $schoolIdone[] = $k;\\n            }\\n            if (in_array($schoolAttrChoose, $schoolAttr)) {\\n                $expSchoolId[] = $k;\\n            }\\n        }\\n        if(empty($input[\'school_id\'])){\\n            $selfMajorSort = 1000000;\\n            $selfComprehensiveRanking = 10000;\\n        }else{\\n            $selfMajorSort = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->where(\'school_id\', $input[\'school_id\'])\\n                ->where(\'major_id\', $input[\'major_id\'])\\n                ->value(\'sort\');\\n            $selfComprehensiveRanking = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->where(\'id\', $input[\'school_id\'])\\n                ->value(\'comprehensive_ranking\');\\n        }\\n        $V = 0;\\n        if (!empty($input[\'school_attr\'])) {\\n            switch ($input[\'school_attr\']) {\\n                case 1:\\n                    $s = 5;\\n                    break;\\n                case 2:\\n                    $s = 4;\\n                    break;\\n                case 3:\\n                    $s = 3;\\n                    break;\\n                case 4:\\n                    $s = 2;\\n                    break;\\n            }\\n            $V = $s - $r;\\n        }\\n        //综合推荐\\n        switch ($r) {\\n            case 1:\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n                $middleWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                if (!empty($type)) {\\n                    $middleWhereMix[\'type\'] = $type;\\n                }\\n                $topSort = \'desc\';\\n                $middleMajorSort = \'asc\';\\n                $middleMixSort = \'asc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'desc\';\\n                $expSort = \'desc\';\\n                $topStar = 2;\\n                $middleMajorStar = 3;\\n                $middleMixStar = 3;\\n                $lowerMajorStar = 4;\\n                $lowerMixStar = 4;\\n                $expStar = 5 - $V;\\n                break;\\n            case 2:\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n                $schoolId = array_unique(array_merge($schoolId211, $schoolIdone));\\n                $schoolId = array_intersect($schoolId, $lowAssessment);\\n                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                if (!empty($type)) {\\n                    $topWhere[\'type\'] = $type;\\n                    $lowerWhereMajor[\'type\'] = $type;\\n                }\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'asc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V > 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 2;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                if ($V == 3) {\\n                    $expStar = 2;\\n                } else {\\n                    $expStar = 4;\\n                }\\n                break;\\n            case 3:\\n                $schoolId985 = array_intersect($schoolId985, $lowAssessment1);\\n                $topWhere[\'id\'] = [\'in\', $schoolId985];\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment1);\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId211];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n                $schoolId = array_unique(array_merge($nomalSchoolId, $schoolIdone));\\n                $schoolId = array_intersect($schoolId, $lowAssessment1);\\n                $lowerWhereMix[\'id\'] = [\'in\', $schoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                if (!empty($type)) {\\n                    $lowerWhereMajor[\'type\'] = $type;\\n                }\\n                $topSort = \'desc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'asc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V > 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 3;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                if ($V == 2) {\\n                    $expStar = 3;\\n                } else {\\n                    $expStar = 4;\\n                }\\n                break;\\n            case 4:\\n                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n                $topWhere[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId985];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V >= 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 2;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                $expStar = 4;\\n                break;\\n            case 5:\\n                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n                $topWhere[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                if (!empty($type)) {\\n                    $topWhere[\'type\'] = $type;\\n                }\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'asc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V >= 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 3;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 4;\\n                $lowerMixStar = 4;\\n                $expStar = 4;\\n                break;\\n        }\\n        if (!empty($input[\'school_attr\'])) {\\n            $expSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n                ->join(\'t_cl_school b\', \'a.school_id=b.id\', \'left\')\\n                ->whereIn(\'a.school_id\', $expSchoolId)\\n                ->where(\'a.major_id\', $input[\'major_id\'])\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $expSort)\\n                ->value(\'a.school_Id\');\\n        }\\n        $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($topWhere)\\n            ->column(\'id\');\\n        if ($r == 2) {\\n            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->whereIn(\'id\', $topSchoolId)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $topSort)\\n                ->value(\'id\');\\n        } else {\\n            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->whereIn(\'school_id\', $topSchoolId)\\n                ->where(\'sort\', \'<\', $selfMajorSort)\\n                ->order(\'sort\', $topSort)\\n                ->value(\'school_id\');\\n        }\\n        $middleSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($middleWhereMajor)\\n            ->column(\'id\');\\n        $middleMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n            ->whereIn(\'school_id\', $middleSchoolIdMajor)\\n            ->where(\'sort\', \'<\', $selfMajorSort)\\n            ->order(\'sort\', $middleMajorSort)\\n            ->value(\'school_id\');\\n\\n        $middleSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($middleWhereMix)\\n            ->column(\'id\');\\n        $middleMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->whereIn(\'id\', $middleSchoolIdMix)\\n            ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n            ->order(\'comprehensive_ranking\', $middleMixSort)\\n            ->value(\'id\');\\n\\n        $lowerSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($lowerWhereMajor)\\n            ->column(\'id\');\\n        $lowerMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n            ->whereIn(\'school_id\', $lowerSchoolIdMajor)\\n            ->where(\'sort\', \'<\', $selfMajorSort)\\n            ->order(\'sort\', $lowerMajorSort)\\n            ->value(\'school_id\');\\n        //判断就读院校有没有期望专业信息\\n        if(empty($input[\'school_id\'])){\\n            $hasInfo = false;\\n        }else{\\n            $hasInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->where(\'school_id\', $input[\'school_id\'])\\n                ->where(\'major_id\', $input[\'major_id\'])\\n                ->count();\\n        }\\n\\n        if (in_array($r, [4, 5])) {\\n            if ($hasInfo) {\\n                $lowerMixSchoolId = $input[\'school_id\'];\\n            } else {\\n                $lowerMixSchoolId = [];\\n            }\\n        } else {\\n            $lowerSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->where($lowerWhereMix)\\n                ->column(\'id\');\\n            $lowerMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->whereIn(\'id\', $lowerSchoolIdMix)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $lowerMixSort)\\n                ->value(\'id\');\\n        }\\n        $recommend = [];\\n        $recommend[\'mix\'][\'top\'][\'school_id\'] = (int)$topSchoolId;\\n        $recommend[\'mix\'][\'top\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'top\'][\'star\'] = (int)$topStar;\\n        $recommend[\'mix\'][\'midMajor\'][\'school_id\'] = (int)$middleMajorSchoolId;\\n        $recommend[\'mix\'][\'midMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'midMajor\'][\'star\'] = (int)$middleMajorStar;\\n        $recommend[\'mix\'][\'midMix\'][\'school_id\'] = (int)$middleMixSchoolId;\\n        $recommend[\'mix\'][\'midMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'midMix\'][\'star\'] = $middleMixStar;\\n        $recommend[\'mix\'][\'lowMajor\'][\'school_id\'] = (int)$lowerMajorSchoolId;\\n        $recommend[\'mix\'][\'lowMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'lowMajor\'][\'star\'] = (int)$lowerMajorStar;\\n        $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$lowerMixSchoolId;\\n        $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'lowMix\'][\'star\'] = (int)$lowerMixStar;\\n        if (!empty($topSchoolId)) {\\n            if ($topSchoolId == $middleMajorSchoolId || $topSchoolId == $middleMixSchoolId || $topSchoolId == $lowerMajorSchoolId || $topSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'top\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'top\'] = [];\\n        }\\n        if (!empty($middleMajorSchoolId)) {\\n            if ($middleMajorSchoolId == $middleMixSchoolId || $middleMajorSchoolId == $lowerMajorSchoolId || $middleMajorSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'midMajor\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'midMajor\'] = [];\\n        }\\n        if (!empty($middleMixSchoolId)) {\\n            if ($middleMixSchoolId == $lowerMajorSchoolId || $middleMixSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'midMix\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'midMix\'] = [];\\n        }\\n        if (!empty($lowerMajorSchoolId)) {\\n            if ($lowerMajorSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'lowMajor\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'lowMajor\'] = [];\\n        }\\n        if (empty($lowerMixSchoolId)) {\\n            $recommend[\'mix\'][\'lowMix\'] = [];\\n        }\\n        if (empty($topSchoolId) && empty($middleMajorSchoolId) && empty($middleMixSchoolId) && empty($lowerMajorSchoolId) && empty($lowerMixSchoolId)) {\\n            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, 1);\\n            if ($school_id) {\\n                $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$school_id;\\n                $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n                $recommend[\'mix\'][\'lowMix\'][\'star\'] = 3;\\n            } else {\\n                $recommend[\'mix\'][\'lowMix\'] = [];\\n            }\\n        }\\n        //期望推荐\\n        if (!empty($expSchoolId)) {\\n            $recommend[\'exp\'][\'school_id\'] = $expSchoolId;\\n            $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n            $recommend[\'exp\'][\'star\'] = $expStar;\\n        } else {\\n            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking);\\n            if ($school_id) {\\n                $recommend[\'exp\'][\'school_id\'] = $school_id;\\n                $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n                $recommend[\'exp\'][\'star\'] = 3;\\n            } else {\\n                $recommend[\'exp\'] = [];\\n            }\\n        }\\n        return $recommend;\\n    }\\n    /**\\n     * desc:保底推荐规则\\n     * author:hufangfang\\n     * data:2023/1/7 15:09\\n     * @param $input\\n     * @param $schoolAttrChoose\\n     * @param $selfComprehensiveRanking\\n     * @return float|int|mixed|string\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    private function baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, $type = 0)\\n    {\\n        $school_id = 0;\\n        $where[\'a.area_id\'] = [\'in\', $input[\'area_id\']];\\n        $where[\'b.major_id\'] = $input[\'major_id\'];\\n        $where[\'a.id\'] = [\'<>\', $input[\'school_id\']];\\n        if ($type) {\\n            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->where($where)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'a.comprehensive_ranking\', \'desc\')\\n                ->value(\'a.id\');\\n            if (empty($school_id)) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                    ->where($where)\\n                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n                    ->value(\'a.id\');\\n            }\\n            return $school_id;\\n        }\\n        $baodiSchool = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n            ->where($where)\\n            ->field(\'a.id,a.school_attr,a.comprehensive_ranking\')\\n            ->select();\\n        if (empty($baodiSchool)) {\\n            return $school_id;\\n        }\\n        $attrSchoolList = [];\\n        foreach ($baodiSchool as $school) {\\n            $attr = explode(\',\', $school[\'school_attr\']);\\n            if (!empty($attr)) {\\n                foreach ($attr as $k => $v) {\\n                    $attrSchoolList[$v][] = $school[\'id\'];\\n                }\\n            }\\n        }\\n        if (!empty($schoolAttrChoose)) {\\n            if (!empty($attrSchoolList[$schoolAttrChoose])) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                    ->whereIn(\'id\', $attrSchoolList[$schoolAttrChoose])\\n                    ->order(\'comprehensive_ranking\', \'asc\')\\n                    ->value(\'id\');\\n            } else {\\n                switch ($schoolAttrChoose) {\\n                    case \'985\':\\n                        if (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'211\':\\n                        if (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'双一流\':\\n                        if (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'普通院校\':\\n                        if (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                }\\n            }\\n        } else {\\n            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->where($where)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'a.comprehensive_ranking\', \'desc\')\\n                ->value(\'a.id\');\\n            if (empty($school_id)) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                    ->where($where)\\n                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n                    ->value(\'a.id\');\\n            }\\n        }\\n        return $school_id;\\n    }\\n    /**\\n     * desc:择校选项列表\\n     * author:hufangfang\\n     * data:2022/12/6 17:51\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function getSelect()\\n    {\\n        $list = [];\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $nowStanding = $model->getNowStanding();\\n        $data = [];\\n        foreach ($nowStanding as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'now_standing\'] = $data;\\n        $educationStading = $model->getEducationStading();\\n        $data = [];\\n        foreach ($educationStading as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'education_stading\'] = $data;\\n\\n        $cet = $model->getCet();\\n        $data = [];\\n        foreach ($cet as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'cet\'] = $data;\\n        $diff_major = $model->getDiffMajor();\\n        $data = [];\\n        foreach ($diff_major as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'diff_major\'] = $data;\\n        $school_attr = $model->getSchoolAttr();\\n        $data = [];\\n        foreach ($school_attr as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            if ($v === \'普通院校\') {\\n                $item[\'value\'] = $v;\\n            } else {\\n                $item[\'value\'] = $v . \'院校\';\\n            }\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'school_attr\'] = $data;\\n        $school_grades = $model->getSchoolGrades();\\n        $data = [];\\n        foreach ($school_grades as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'school_grades\'] = $data;\\n        $math_status = $model->getMathStatus();\\n        $data = [];\\n        foreach ($math_status as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'math_status\'] = $data;\\n        $exam_year = $model->getExamYear();\\n        $data = [];\\n        foreach ($exam_year as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'exam_year\'] = $data;\\n        $determination = $model->getDetermination();\\n        $data = [];\\n        foreach ($determination as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $ps = \'\';\\n            switch (intval($v)){\\n                case 1:\\n                    $ps = \'随缘考试\';\\n                    break;\\n                case 2:\\n                    $ps = \'稍稍准备\';\\n                    break;\\n                case 3:\\n                    $ps = \'严肃对待\';\\n                    break;\\n                case 4:\\n                    $ps = \'全力备考\';\\n                    break;\\n                case 5:\\n                    $ps = \'势必成硕\';\\n                    break;\\n            }\\n            $item[\'ps\'] = $ps;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'determination\'] = $data;\\n        $area = Db::connect(\'database.yx_db_config\')\\n            ->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->field(\'id as `key`,name as value\')\\n            ->select();\\n        $list[\'area\'] = $area;\\n        $this->success(\'success\', $list);\\n    }\\n    /**\\n     * desc:学校列表\\n     * author:hufangfang\\n     * data:2022/12/6 17:51\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function schoolList()\\n    {\\n        $schoolName = input(\'school_name\', \'\');\\n        $isApp = input(\'is_app\', 0);\\n        $where = [];\\n        $where[\'a.is_hidden\'] = 0;\\n        if (!empty($schoolName)) {\\n            $where[\'a.school_name\'] = [\'like\', $schoolName . \'%\'];\\n        }\\n        $schoolList = Db::connect(\'database.uc_db_config\')\\n            ->name(\'school\')->alias(\'a\')\\n            ->join(\'cl_area b\', \'a.province_id=b.id\')\\n            ->where($where)\\n            ->field(\'a.school_id as id,a.school_name as name,a.first_pinyin,b.name as province_name\')\\n            ->order(\'first_pinyin asc,name asc\')\\n            ->select();\\n        $data = [];\\n        foreach ($schoolList as $k => $v) {\\n            $item[\'id\'] = $v[\'id\'];\\n            $item[\'name\'] = $v[\'name\'];\\n            $item[\'area_name\'] = $v[\'province_name\'];\\n            if (!empty($schoolName)) {\\n                $data[] = $item;\\n            } else {\\n                $data[$v[\'first_pinyin\']][] = $item;\\n            }\\n        }\\n        if ($isApp && empty($schoolName)) {\\n            $return = [];\\n            foreach ($data as $k => $v) {\\n                $item = [];\\n                $item[\'key\'] = (string)$k;\\n                $item[\'list\'] = $v;\\n                $return[] = $item;\\n            }\\n            $data = $return;\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n    /**\\n     * desc:择校档案列表\\n     * author:hufangfang\\n     * data:2022/12/26 19:45\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function history()\\n    {\\n        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'uid\', session(\'uid\'))\\n            ->order(\'createtime\', \'desc\')\\n            ->limit(10)\\n            ->select();\\n        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n            ->column(\'name\', \'id\');\\n        $return = [];\\n        if (!empty($list)) {\\n            $item = [];\\n            foreach ($list as $k => $v) {\\n                $item[\'area\'] = explode(\',\', $v[\'area_id\']);\\n                foreach ($item[\'area\'] as $kk => $vv) {\\n                    $item[\'area\'][$kk] = $areaList[$vv] ?? \'\';\\n                }\\n                $item[\'id\'] = $v[\'id\'];\\n                $item[\'area\'] = implode(\',\', $item[\'area\']);\\n                $item[\'major_name\'] = $majorList[$v[\'major_id\']] ?? \'\';\\n                $item[\'createtime\'] = date(\'Y-m-d H:i:s\', $v[\'createtime\']);\\n                $return[$k] = $item;\\n            }\\n        }\\n        $this->success(\'success\', $return);\\n    }\\n    /**\\n     * desc:档案详情\\n     * author:hufangfang\\n     * data:2022/12/26 19:52\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function recordDetail()\\n    {\\n        $id = input(\'id\', 0);\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->order(\'createtime\', \'desc\')\\n            ->find();\\n        if (!empty($record)) {\\n            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n                ->where(\'pid\', \'>\', 0)\\n                ->column(\'name\', \'id\');\\n            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n                ->column(\'name\', \'id\');\\n            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n                ->where(\'is_hidden\', 0)\\n                ->column(\'school_name\', \'school_id\');\\n            $nowStanding = $model->getNowStanding();\\n            $educationStading = $model->getEducationStading();\\n            $cet = $model->getCet();\\n            $diff_major = $model->getDiffMajor();\\n            $school_attr = $model->getSchoolAttr();\\n            $school_grades = $model->getSchoolGrades();\\n            $math_status = $model->getMathStatus();\\n            $determination = $model->getDetermination();\\n            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n            $record[\'area_id\'] = [];\\n            foreach ($record[\'area\'] as $kk => $vv) {\\n                $record[\'area_id\'][] = $areaList[$vv] ?? \'\';\\n            }\\n            unset($record[\'area\']);\\n            $record[\'area_id\'] = implode(\',\', $record[\'area_id\']);\\n            $record[\'now_standing\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n            $record[\'school_id\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n            $record[\'diff_major\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n\\n            if (empty($record[\'school_attr\'])) {\\n                $record[\'school_attr\'] = \'\';\\n            } else {\\n                $record[\'school_attr\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n            }\\n            if (empty($record[\'school_grades\'])) {\\n                $record[\'school_grades\'] = \'\';\\n            } else {\\n                $record[\'school_grades\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n            }\\n            $record[\'cet\'] = $cet[$record[\'cet\']] ?? \'\';\\n            if (empty($record[\'cet\'])) {\\n                $record[\'cet\'] = \'\';\\n            }\\n            if (empty($record[\'math_status\'])) {\\n                $record[\'math_status\'] = \'\';\\n            } else {\\n                $record[\'math_status\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n            }\\n            $record[\'major_id\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n            $record[\'education_stading\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n        } else {\\n            $record = [];\\n        }\\n        $uid = $record[\'uid\'];\\n        $userInfo = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $uid)\\n            ->field(\'uid,username,mobile\')\\n            ->find();\\n        $userInfo[\'createtime\'] = $record[\'createtime\'];\\n        $return = [];\\n        $return[\'userInfo\'] = $userInfo;\\n        $return[\'detail\'] = $record;\\n        $return[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n        $this->success(\'success\', $return);\\n    }\\n    /**\\n     * desc:\\n     * author:hufangfang\\n     * data:2022/12/8 16:03\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function info()\\n    {\\n        $id = input(\'id\', 0);\\n        $type = input(\'type\', 0);\\n        $isfeishu = input(\'isfeishu\', 0);\\n        $info = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->find();\\n        $result = $info[\'result\'];\\n        $return = [];\\n        $intentMajorInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n            ->join(\'cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n            ->where(\'a.id\', $info[\'major_id\'])\\n            ->field(\'a.name,a.code,b.menlei,b.type\')\\n            ->find();\\n        $area = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $intent[\'major_name\'] = $intentMajorInfo[\'name\'] ?? \'\';\\n        $intent[\'major_code\'] = $intentMajorInfo[\'code\'] ?? \'\';\\n        $intent[\'major_id\'] = $info[\'major_id\'];\\n        $intent[\'menlei\'] = $intentMajorInfo[\'menlei\'];\\n        $intent[\'type\'] = $intentMajorInfo[\'type\'];\\n        $intentAreaId = $info[\'area_id\'];\\n        $areaName = [];\\n        if (!empty($intentAreaId)) {\\n            $intentAreaId = explode(\',\', $intentAreaId);\\n            foreach ($intentAreaId as $K => $v) {\\n                $areaName[] = $area[$v] ?? \'\';\\n            }\\n        }\\n        $intent[\'area\'] = implode(\'、\', $areaName);\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $school_attr = $model->getSchoolAttr();\\n        if (!empty($info[\'school_attr\'])) {\\n            $intent[\'school_attr\'] = $school_attr[$info[\'school_attr\']] ?? \'\';\\n        } else {\\n            $intent[\'school_attr\'] = \'\';\\n        }\\n        $where = [];\\n        $where[\'a.area_id\'] = [\'in\', $info[\'area_id\']];\\n        $where[\'b.major_id\'] = $info[\'major_id\'];\\n        $schoolNum = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n            ->where($where)\\n            ->group(\'a.id\')\\n            ->count();\\n        $area_school_info = \'当前地区符合您意向专业的院校共有\' . $schoolNum . \'所\';\\n        $intent[\'area_school_info\'] = $area_school_info;\\n        $return[\'intent\'] = $intent;\\n        $result = json_decode($result, \'true\');\\n        $return[\'ai_result\'] = $result;\\n        $majorInfo = $this->getMajorInfo($result, $type, $info[\'uid\'], $isfeishu, $area);\\n        $status = accessControl(1,$majorInfo[\'major_school_id\']);\\n        if(!$status){\\n            if($status===0){\\n                $this->error(\'您操作过于频繁，请稍后再试\');\\n            }else{\\n                $this->error(\'您的账号存在异常，请联系客服\');\\n            }\\n        }\\n        if (empty($majorInfo)) {\\n            $this->success(\'success\', $return);\\n        }\\n        //综合推荐\\n        $return[\'mix\'] = $majorInfo;\\n        //期望院校推荐\\n        if (!empty($result[\'exp\'])) {\\n            $majorId = $result[\'exp\'][\'major_id\'] ?? 0;\\n            $schoolId = $result[\'exp\'][\'school_id\'] ?? 0;\\n            $star = $result[\'exp\'][\'star\'] ?? 0;\\n            $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n                ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n                ->where(\'a.major_id\', $majorId)\\n                ->where(\'a.school_id\', $schoolId)\\n                ->order(\'b.first_pinyin\', \'asc\')\\n                ->value(\'a.id\');\\n            $majorInfo = $this->majorSchoolModel\\n                ->alias(\'ms\')\\n                ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n                ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n                ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n                ->field(\'sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n                ->where(\'ms.id\', $majorSchoolId)\\n                ->find();\\n            if (!empty($majorInfo)) {\\n                $adminSchoolMajor = new SchoolMajor();\\n                $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n                $majorInfo[\'star\'] = $star;\\n                $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n                $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n                $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n                $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n                if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n                    $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n                }\\n                $return[\'exp\'] = $majorInfo;\\n            } else {\\n                $return[\'exp\'] = [];\\n            }\\n        } else {\\n            $return[\'exp\'] = [];\\n        }\\n        $this->success(\'success\', $return);\\n    }\\n    /**\\n     * desc:综合推荐专业详情\\n     * author:hufangfang\\n     * data:2022/12/21 11:25\\n     * @param $result\\n     * @param $type\\n     * @param $isfeishu\\n     * @return mixed\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    private function getMajorInfo($result, $type, $uid, $isfeishu, $area)\\n    {\\n        $majorId = 0;\\n        $schoolId = 0;\\n        $star = 0;\\n        if (empty($result)) {\\n            return false;\\n        }\\n        if (empty($type)) {\\n            foreach ($result[\'mix\'] as $k => $v) {\\n                $majorId = $v[\'major_id\'] ?? 0;\\n                $schoolId = $v[\'school_id\'] ?? 0;\\n                $star = $v[\'star\'] ?? 0;\\n                if ($k == \'midMajor\' && !empty($v)) {\\n                    $type = 1;\\n                    break;\\n                }\\n                if ($k == \'midMix\' && !empty($v)) {\\n                    $type = 2;\\n                    break;\\n                }\\n                if ($k == \'top\' && !empty($v)) {\\n                    $type = 3;\\n                    break;\\n                }\\n                if ($k == \'lowMajor\' && !empty($v)) {\\n                    $type = 4;\\n                    break;\\n                }\\n                if ($k == \'lowMix\' && !empty($v)) {\\n                    $type = 5;\\n                    break;\\n                }\\n            }\\n        } else {\\n            switch ($type) {\\n                case 1:\\n                    $majorId = $result[\'mix\'][\'midMajor\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'midMajor\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'midMajor\'][\'star\'] ?? 0;\\n                    break;\\n                case 2:\\n                    $majorId = $result[\'mix\'][\'midMix\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'midMix\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'midMix\'][\'star\'] ?? 0;\\n                    break;\\n                case 3:\\n                    $majorId = $result[\'mix\'][\'top\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'top\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'top\'][\'star\'] ?? 0;\\n                    break;\\n                case 4:\\n                    $majorId = $result[\'mix\'][\'lowMajor\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'lowMajor\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'lowMajor\'][\'star\'] ?? 0;\\n                    break;\\n                case 5:\\n                    $majorId = $result[\'mix\'][\'lowMix\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'lowMix\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'lowMix\'][\'star\'] ?? 0;\\n                    break;\\n            }\\n        }\\n        if (empty($majorId) || empty($schoolId)) {\\n            return false;\\n        }\\n        $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n            ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n            ->where(\'a.major_id\', $majorId)\\n            ->where(\'a.school_id\', $schoolId)\\n            ->order(\'b.first_pinyin\', \'asc\')\\n            ->value(\'a.id\');\\n        if (!$majorSchoolId) {\\n            return false;\\n        }\\n        $majorInfo = $this->majorSchoolModel\\n            ->alias(\'ms\')\\n            ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n            ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n            ->field(\'yx.intro,sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n            ->where(\'ms.id\', $majorSchoolId)\\n            ->find();\\n        if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n            $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n        }\\n        $school_name = $majorInfo[\'school_name\'];\\n        $school_attr = $majorInfo[\'school_attr\'];\\n        $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n        $sort = $majorInfo[\'comprehensive_ranking\'];\\n        $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n        $juge = $subjectAssessMent[$majorInfo[\'subject_assessment\']] ?? \'\';\\n        $xueke = \'\';\\n        if (!empty($juge)) {\\n            $xueke = \'，学科评估为\' . $juge;\\n        }\\n        switch ($type) {\\n            case 1:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，更具有专业竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n                break;\\n            case 2:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，院校更具有竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n                break;\\n            case 3:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，学历含金量很高，建议尝试报考。虽然面临一定考试难度，相信经过我们的指导后，通过您的100%对学些的投入，还是有机会考取该院校的，联系学习规划老师获取详细方案。\';\\n                break;\\n            case 4:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n                break;\\n            case 5:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n                break;\\n        }\\n        if ($majorInfo) {\\n            $adminSchoolMajor = new SchoolMajor();\\n            $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n            $majorInfo[\'introReason\'] = $introReason;\\n            $majorInfo[\'star\'] = $star;\\n            $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n            if ($uid) {\\n                $teacherInfo = getQrcode($uid, $isfeishu);\\n            }\\n            $lqxx = (new \\\\app\\\\api\\\\logic\\\\Pic())->getLqxx($majorSchoolId, $majorInfo, $uid);\\n            $majorInfo[\'zlrsUrl\'] = $lqxx[\'zlrsUrl\'];\\n            $majorInfo[\'fushi\'] = $lqxx[\'fushi\'];\\n            $majorInfo[\'year_vs_score\'] = $lqxx[\'year_vs_score\'];\\n            $majorInfo[\'has_year_vs_score\'] = $lqxx[\'has_year_vs_score\'];\\n            $majorInfo[\'is_vip\'] = $lqxx[\'is_vip\'];\\n            $majorInfo[\'analysis\'] = $lqxx[\'analysis\'];\\n            if (!empty($teacherInfo)) {\\n                $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n                    ->where(\'uid\', $uid)\\n                    ->value(\'username\');\\n                $teacherInfo[\'nickname\'] = $nickname;\\n                $teacherInfo[\'head_url\'] = Config(\'fc_website_url\') . \'/proxy/\' . get_avatar_path($uid);\\n            } else {\\n                $teacherInfo = [];\\n            }\\n            $majorInfo[\'teacher\'] = $teacherInfo;\\n            $majorInfo[\'type\'] = $type;\\n            $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n            //院校默认图\\n            $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n        }\\n        return $majorInfo;\\n    }\\n    /**\\n     * desc:根据专业获取学校排名\\n     * author:hufangfang\\n     * data:2022/12/21 11:26\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     */\\n    public function schoolOrder()\\n    {\\n        $majorId = input(\'major_id/d\', 0);\\n        $p = input(\'p/d\', 1);\\n        $limit = input(\'limit/d\', 10);\\n        if ($p < 1) {\\n            $p = 1;\\n        }\\n        if ($limit < 1) {\\n            $limit = 10;\\n        }\\n        if (empty($majorId)) {\\n            $this->success(\'success\');\\n        }\\n        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n            ->join(\'cl_school b\', \'a.school_id=b.id\', \'left\')\\n            ->join(\'cl_yuanxi c\', \'a.yuanxi_id=c.id\', \'left\')\\n            ->join(\'cl_major e\', \'a.major_id=e.id\', \'left\')\\n            ->join(\'cl_school_yjxk d\', \'a.school_id=d.school_id and d.yjxk_id=e.yjxk_id\', \'left\')\\n            ->field(\'a.school_id,a.major_id,b.name school_name,e.name major_name,b.area_id,b.school_attr,b.comprehensive_ranking,c.name yuanxi_name,d.subject_assessment,b.logo\')\\n            ->where(\'a.major_id\', $majorId)\\n            ->order(\'comprehensive_ranking,c.first_pinyin\')\\n            ->limit(50)\\n            ->select();\\n        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $return = [];\\n        $adminSchoolMajor = new SchoolMajor();\\n        foreach ($list as $k => $v) {\\n            $v[\'area_name\'] = $areaList[$v[\'area_id\']] ?? \'\';\\n            $v[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($v[\'subject_assessment\']);\\n            if (!empty($v[\'school_attr\'])) {\\n                $v[\'school_attr\'] = explode(\',\', $v[\'school_attr\']);\\n            } else {\\n                $v[\'school_attr\'] = [];\\n            }\\n            $v[\'logo\'] = School::schoolLogo($v[\'logo\']);\\n            if (empty($return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']])) {\\n                $return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']] = $v;\\n            }\\n            if ($v[\'comprehensive_ranking\'] == 10000) {\\n                $v[\'comprehensive_ranking\'] = \'暂无\';\\n            }\\n        }\\n        $this->success(\'success\', array_values($return));\\n    }\\n    //发送飞书消息\\n    public function feishuMessage()\\n    {\\n        $tutorId = input(\'tutor_id\', \'\');\\n        $id = input(\'id\', 0);\\n        if (empty($tutorId) || empty($id)) {\\n            $this->error(\'参数错误\');\\n        }\\n        $mobile = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $tutorId)\\n            ->value(\'mobile\');\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->find();\\n        if (empty($record)) {\\n            $this->error(\'id错误\');\\n        }\\n        $key = \'yuanxiao:feishu:tutor:notice:\' . $tutorId . \':\' . $id;\\n        $cache = redis()->get($key);\\n        if ($cache) {\\n            $this->success(\'success\', []);\\n        }\\n        $uid = $record[\'uid\'];\\n        $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $uid)\\n            ->value(\'username\');\\n        $url = config(\'feishu_jump_url\') . \'?refresh=1&refer=\' . urlencode(\'https://wxapp.orangevip.com/choice-record?id=\' . $id . \'&isfeishu=1\');\\n        $message = \'您的学员\' . $nickname . \'，进行了AI择校。点击连接，查看学生择校信息：\' . $url;\\n        $data[\'type\'] = \'post\';\\n        $data[\'message\'][\'title\'] = \\\"AI择校消息通知\\\";\\n        $text1 = $message;\\n        $content1[] = [\'tag\' => \'text\', \'un_escape\' => true, \'text\' => $text1];\\n        $data[\'message\'][\'content\'][] = $content1;\\n        $data[\'mobile\'] = $mobile;\\n        $res = Helpers::clphpCurl($data);\\n        redis()->set($key, 1);\\n        $this->success(\'success\', $res);\\n    }\\n    /**\\n     * desc:判断科目是否考数一数二or数三\\n     * author:hufangfang\\n     * data:2023/1/4 10:13\\n     * @return void\\n     * @throws Exception\\n     */\\n    public function majorExamSubject()\\n    {\\n        $majorId = input(\'major_id\', 0);\\n        $examSubject = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n            ->where(\'id\', $majorId)\\n            ->value(\'exam_subject\');\\n        $hasMath = false;\\n        if (!empty($examSubject)) {\\n            $examSubject = explode(\',\', $examSubject);\\n            foreach ($examSubject as $k => $v) {\\n                if (in_array($v, [\'数学一\', \'数学二\', \'数学三\'])) {\\n                    $hasMath = true;\\n                    break;\\n                }\\n            }\\n        }\\n        $this->success(\'success\', [\'has_math\' => $hasMath]);\\n    }\\n\\n    public function testQrcode()\\n    {\\n        $res = getQrcode(1, 0);\\n    }\\n}\\n\",\"numLines\":1522,\"startLine\":1,\"totalLines\":1522}}}

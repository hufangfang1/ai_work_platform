+<?php
+
+namespace app\\api\\controller;
+
+use app\\common\\controller\\ApiAuth;
+use Exception;
+
+/**
+ * 冒泡排序接口
+ */
+class BubbleSort extends ApiAuth
+{
+    protected $noNeedLogin = [\'*\'];
+    protected $noNeedRight = [\'*\'];
+
+    /**
+     * 冒泡排序
+     * POST /api/bubble-sort
+     * @param array nums 整数数组
+     */
+    public function sort()
+    {
+        try {
+            $nums = input(\'post.nums/a\', []);
+
+            // 参数校验
+            $validate = new \\app\\api\\validate\\BubbleSort();
+            if (!$validate->scene(\'sort\')->check([\'nums\' => $nums])) {
+                $this->error($validate->getError());
+            }
+
+            // 调用逻辑层排序
+            $logic = new \\app\\api\\logic\\BubbleSort();
+            $result = $logic->sort($nums);
+
+            $this->success(\'排序成功\', $result);
+        } catch (Exception $e) {
+            $this->error($e->getMessage());
+        }
+    }
+}
diff --git a/application/api/logic/BubbleSort.php b/application/api/logic/BubbleSort.php
new file mode 100644
index 00000000..2fe7984f
--- /dev/null
+++ b/application/api/logic/BubbleSort.php
@@ -0,0 +1,42 @@
+<?php
+
+namespace app\\api\\logic;
+
+/**
+ * 冒泡排序核心算法
+ */
+class BubbleSort
+{
+    /**
+     * 冒泡排序（优化版：若某轮无交换则提前终止）
+     * @param array $nums 待排序的整数数组
+     * @return array [\'sorted_nums\' => array, \'rounds\' => int]
+     */
+    public function sort(array $nums): array
+    {
+        $arr = $nums;
+        $n = count($arr);
+        $rounds = 0;
+
+        for ($i = 0; $i < $n; $i++) {
+            $swapped = false;
+            for ($j = 0; $j < $n - 1 - $i; $j++) {
+                if ($arr[$j] > $arr[$j + 1]) {
+                    $temp = $arr[$j];
+                    $arr[$j] = $arr[$j + 1];
+                    $arr[$j + 1] = $temp;
+                    $swapped = true;
+                }
+            }
+            $rounds++;
+            if (!$swapped) {
+                break;
+            }
+        }
+
+        return [
+            \'sorted_nums\' => $arr,
+            \'rounds\'      => $rounds,
+        ];
+    }
+}
diff --git a/application/api/validate/BubbleSort.php b/application/api/validate/BubbleSort.php
new file mode 100644
index 00000000..f88031ab
--- /dev/null
+++ b/application/api/validate/BubbleSort.php
@@ -0,0 +1,47 @@
+<?php
+
+namespace app\\api\\validate;
+
+use app\\api\\library\\ComErrorDescs;
+use think\\Validate;
+
+/**
+ * 冒泡排序接口验证器
+ */
+class BubbleSort extends Validate
+{
+    protected $rule = [
+        \'nums\' => \'require|array|checkNotEmptyArray\',
+    ];
+
+    protected $message = [
+        \'nums.require\' => ComErrorDescs::EC_MISSING_PARAM . \',nums\',
+        \'nums.array\'   => ComErrorDescs::EC_INVALID_PARAM . \',nums\',
+        \'nums.checkNotEmptyArray\' => ComErrorDescs::EC_EMPTY_PARAM . \',nums\',
+    ];
+
+    /**
+     * 验证场景
+     */
+    protected $scene = [
+        \'sort\' => [\'nums\'],
+    ];
+
+    /**
+     * 校验数组非空且所有元素为整数
+     * @param mixed $value
+     * @return bool|string
+     */
+    public function checkNotEmptyArray($value)
+    {
+        if (!is_array($value) || count($value) == 0) {
+            return ComErrorDescs::EC_EMPTY_PARAM . \',nums\';
+        }
+        foreach ($value as $v) {
+            if (!is_int($v)) {
+                return ComErrorDescs::EC_INVALID_PARAM . \',nums\';
+            }
+        }
+        return true;
+    }
+}

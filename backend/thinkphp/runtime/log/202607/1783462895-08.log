    $where[\'user_id\'] = $this->uid;\\n            if ($action == 1) { \\/\\/删除\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->where(\'school_major_id\', $oldschoolMajorId)\\n                    ->delete();\\n            } else {\\n                $newSchoolMajorId = $this->majorSchoolModel\\n                    ->where(\'school_id\', $schoolId)\\n                    ->where(\'major_id\', $majorId)\\n                    ->value(\'id\');\\n                if (!$newSchoolMajorId) {\\n                    $this->error(\'不存在的院校专业\');\\n                }\\n                $insertData = [\\n                    \'user_id\' => $this->uid,\\n                    \'school_major_id\' => $newSchoolMajorId,\\n                    \'is_default\' => 1,\\n                    \'create_time\' => time()\\n                ];\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->update([\'is_default\' => 0]);\\n                if (!$action) { \\/\\/新增\\n                    $list = $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->column(\'school_major_id\');\\n                    if (count($list) >= 3) {\\n                        $this->error(\'不要贪多，最多可以添加3个目标院校哦\');\\n                    } else {\\n                        if (!empty($list) && in_array($newSchoolMajorId, $list)) {\\n                            $this->error(\'请勿重复设置\');\\n                        } else {\\n                            $this->userSchoolMajorTargetModel->insert($insertData);\\n                        }\\n                    }\\n                } else {\\n                    $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->where(\'school_major_id\', $oldschoolMajorId)\\n                        ->delete();\\n                    $this->userSchoolMajorTargetModel->insert($insertData);\\n                }\\n            }\\n            Db::commit();\\n        } catch (Exception $e) {\\n            Db::rollback();\\n            $this->error(\'fail\');\\n        }\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function majorTargetSetDefault [设置默认目标院校专业]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetSetDefault()\\n    {\\n        $schoolMajorId = input(\'school_major_id\\/d\', 0);\\n        try {\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $this->userSchoolMajorTargetModel->startTrans();\\n            \\/\\/取消默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->update([\'is_default\' => 0]);\\n            \\/\\/设置默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->where(\'school_major_id\', $schoolMajorId)\\n                ->update([\'is_default\' => 1]);\\n            $this->userSchoolMajorTargetModel->commit();\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        } catch (Exception $e) {\\n            $this->userSchoolMajorTargetModel->roolback();\\n            $this->error(\'fail\');\\n        }\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function target1v1 [1v1辅导]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function target1v1()\\n    {\\n        $data = [\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/02.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022c
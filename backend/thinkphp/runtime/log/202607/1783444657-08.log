[2026-07-08T01:11:24+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 10 , `seq` = 121 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_04_x3Rt7CRM9NrN0JTsyzx17640\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\api\\\\logic\\\\Common;\\n6\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n7\\tuse app\\\\admin\\\\model\\\\SchoolMajor;\\n8\\tuse app\\\\common\\\\model\\\\Document;\\n9\\tuse app\\\\common\\\\model\\\\Major as ModelMajor;\\n10\\tuse app\\\\common\\\\model\\\\MajorSchool;\\n11\\tuse app\\\\common\\\\model\\\\School;\\n12\\tuse app\\\\common\\\\model\\\\SchoolMajorCollect;\\n13\\tuse think\\\\Config;\\n14\\tuse think\\\\Db;\\n15\\t\\n16\\t\\/**\\n17\\t * 专业接口\\n18\\t *\\/\\n19\\tclass Major extends ApiAuth\\n20\\t{\\n21\\t    protected $noNeedLogin = [\'yxfind\', \'yxlist\', \'filter\', \'list\', \'info\', \'index\', \'introduce\', \'schoollist\', \'collect\', \'mycollect\', \'mycollectsort\'];\\n22\\t    protected $noNeedRight = [\'*\'];\\n23\\t\\n24\\t    protected $majorModel = null;\\n25\\t    protected $majorSchoolModel = null;\\n26\\t\\n27\\t    public function _initialize()\\n28\\t    {\\n29\\t        parent::_initialize();\\n30\\t        $this->majorModel = new ModelMajor();\\n31\\t        $this->majorSchoolModel = new MajorSchool();\\n32\\t    }\\n33\\t\\n34\\t    \\/**\\n35\\t     * Function yxFind [APP发现页院校专业]\\n36\\t     * @author erdong\\n37\\t     * @date 2022-11-23\\n38\\t     *\\/\\n39\\t    public function yxFind()\\n40\\t    {\\n41\\t        $uid = session(\'uid\') ?? 0;\\n42\\t        $schoolId = input(\'school_id\', 0);\\n43\\t        $majorId = input(\'major_id\', 0);\\n44\\t        $majorSchoolModel = new MajorSchool();\\n45\\t        $bSearch = false;\\n46\\t        $data = [];\\n47\\t        if ($schoolId || $majorId) {\\n48\\t            $bSearch = true;\\n49\\t            $data = $majorSchoolModel->eduMajorSchool($schoolId, $majorId);\\n50\\t        } else {\\n51\\t            if ($uid) {\\n52\\t                \\/\\/ 查询用户意向院校和专业\\n53\\t                $edu = Db::connect(\'database.uc_db_config\')->name(\'user_education\')\\n54\\t                    ->where(\'uid\', $uid)\\n55\\t                    ->field(\'intent_school_id, intent_major_id, edu_user_grade, edu_school_id, edu_major_id\')\\n56\\t                    ->find();\\n57\\t                $schoolId = $majorId = 0;\\n58\\t                if ($edu) {\\n59\\t                    if (in_array($edu[\'edu_user_grade\'], [2, 4])) {\\n60\\t                        $schoolId = $edu[\'intent_school_id\'];\\n61\\t                        $majorId = $edu[\'intent_major_id\'];\\n62\\t                    } else {\\n63\\t                        if (3 == $edu[\'edu_user_grade\']) {\\n64\\t                            $schoolId = $edu[\'edu_school_id\'];\\n65\\t                            $majorId = $edu[\'edu_major_id\'];\\n66\\t                        }\\n67\\t                    }\\n68\\t                }\\n69\\t\\n70\\t                if ($schoolId || $majorId) {\\n71\\t                    $data = $majorSchoolModel->eduMajorSchool($schoolId, $majorId);\\n72\\t                }\\n73\\t            }\\n74\\t        }\\n75\\t        if (!$bSearch && !$data) {\\n76\\t            $key = \'yuanxiao:find:yx:v3\';\\n77\\t            $cache = redis()->get($key);\\n78\\t            if ($cache) {\\n79\\t                $data = json_decode($cache, true);\\n80\\t            } else {\\n81\\t                $data = $majorSchoolModel->eduMajorSchool($schoolId, $majorId);\\n82\\t                redis()->setex($key, 86400, json_encode_cus($data));\\n83\\t            }\\n84\\t        }\\n85\\t        $this->success(\'success\', $data);\\n86\\t    }\\n87\\t\\n88\\t    \\/**\\n89\\t     * Function yxFind [APP发现页院校-更多]\\n90\\t     * @author erdong\\n91\\t     * @date 2022-11-23\\n92\\t     *\\/\\n93\\t    public function yxList()\\n94\\t    {\\n95\\t        $schoolId = input(\'school_id\', 0);\\n96\\t        $majorId = input(\'major_id\', 0);\\n97\\t        $page = input(\'p\\/d\', 1);\\n98\\t        $limit = input(\'listRows\\/d\', 10);\\n99\\t        $majorSchoolModel = new MajorSchool();\\n100\\t\\n101\\t        if ($schoolId || $majorId) {\\n102\\t            $data = $majorSchoolModel->eduMajorSchool($schoolId, $majorId, $page, $limit);\\n103\\t        } else {\\n104\\t            $cacheKey = \'yuanxiao::find::major::school::more\';\\n105\\t            $redis = redis();\\n106\\t            $cache = $redis->get($cacheKey);\\n107\\t            if ($cache) {\\n108\\t                $list = json_decode($cache, true);\\n109\\t            } else {\\n110\\t                $list = $majorSchoolModel->eduMajorSchool($schoolId, $majorId, $page, 50);\\n111\\t                $redis->setex($cacheKey, 86400, json_encode($list));\\n112\\t            }\\n113\\t            $offset = ($page - 1) * $limit;\\n114\\t            $data = array_slice($list, $offset, $limit);\\n115\\t        }\\n116\\t\\n117\\t        $this->success(\'success\', $data);\\n118\\t    }\\n119\\t\\n120\\t    \\/**\\n121\\t     * Function filter [专业筛选项]\\n122\\t     * @author erdong\\n123\\t     * @date 2022-10-11\\n124\\t     *\\/\\n125\\t    public function filter()\\n126\\t    {\\n127\\t        $schoolId = input(\'school_id\\/d\', 0);\\n128\\t        $where = [];\\n129\\t        if ($schoolId) {\\n130\\t            $where[\'ms.school_id\'] = $schoolId;\\n131\\t        }\\n132\\t\\n133\\t        $redis = redis();\\n134\\t        $key = \\\"yuanxiao::major::filter::\\\" . $schoolId;\\n135\\t        $cache = $redis->get($key);\\n136\\t        if ($cache) {\\n137\\t            $data = json_decode($cache, true);\\n138\\t        } else {\\n139\\t            $list = $this->majorModel\\n140\\t                ->alias(\'m\')\\n141\\t                ->join(\'cl_major_school ms\', \'m.id = ms.major_id\', \'LEFT\')\\n142\\t                ->join(\'cl_yjxk y\', \'m.yjxk_id = y.id\', \'LEFT\')\\n143\\t                ->where($where)\\n144\\t                ->where(\'y.type\', \'not null\')\\n145\\t                ->order(\'y.code asc\')\\n146\\t                ->field(\'y.type, y.menlei, y.id\')\\n147\\t                ->group(\'y.type, y.menlei\')\\n148\\t                ->select();\\n149\\t\\n150\\t            $data = [];\\n151\\t            if ($list) {\\n152\\t                foreach ($list as $dt) {\\n153\\t                    if (empty($data[$dt[\'type\']])) {\\n154\\t                        $data[$dt[\'type\']] = [\\n155\\t                            \'type\' => $dt[\'type\'],\\n156\\t                            \'menlei\' => []\\n157\\t                        ];\\n158\\t                    }\\n159\\t                    $data[$dt[\'type\']][\'menlei\'][] = $dt[\'menlei\'];\\n160\\t                }\\n161\\t                foreach ($data as &$lt) {\\n162\\t                    $lt[\'menlei\'] = array_values($lt[\'menlei\']);\\n163\\t                }\\n164\\t            }\\n165\\t            $data = array_values($data);\\n166\\t            $redis->setex($key, 24 * 3600, json_encode_cus($data));\\n167\\t        }\\n168\\t\\n169\\t\\n170\\t        $this->success(\'success\', $data);\\n171\\t    }\\n172\\t\\n173\\t    \\/**\\n174\\t     * Function list [专业列表]\\n175\\t     * @author erdong\\n176\\t     * @date 2022-10-12\\n177\\t     *\\/\\n178\\t    public function list()\\n179\\t    {\\n180\\t        $schoolId = input(\'school_id\\/d\', 0);\\n181\\t        $type = input(\'type\', \'\');\\n182\\t        $menlei = input(\'menlei\', \'\');\\n183\\t        $isFull = input(\'is_full\', \'\');\\n184\\t        $keyword = input(\'keyword\\/s\', \'\', \'strip_tags,trim\');\\n185\\t        $isRepeat = input(\'is_repeat\\/d\', 0);\\n186\\t        $where = [];\\n187\\t        \\/\\/关键词搜索\\n188\\t        if (!empty($keyword)) {\\n189\\t            $where[\'m.name\'] = [\'like\', \'%\' . $keyword . \'%\'];\\n190\\t        }\\n191\\t        if ($schoolId) {\\n192\\t            $where[\'ms.school_id\'] = $schoolId;\\n193\\t        }\\n194\\t        if (!empty($type) && $type != \'全部\') {\\n195\\t            $where[\'y.type\'] = $type;\\n196\\t        }\\n197\\t        if (!empty($menlei) && $menlei != \'全部\') {\\n198\\t            $where[\'y.menlei\'] = $menlei;\\n199\\t        }\\n200\\t        if (!empty($isFull) && $isFull != \'全部\') {\\n201\\t            $where[\'ms.is_full\'] = $isFull;\\n202\\t        }\\n203\\t        if ($schoolId) {\\n204\\t            $sql = $this->majorModel\\n205\\t                ->alias(\'m\')\\n206\\t                ->join(\'cl_major_school ms\', \'m.id = ms.major_id\', \'LEFT\')\\n207\\t                ->join(\'cl_yjxk y\', \'m.yjxk_id = y.id\', \'LEFT\')\\n208\\t                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n209\\t                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n210\\t                ->field(\'m.id as major_id, m.code, m.name as major_name, ms.id as major_school_id, ms.is_full, IFNULL(subject_assessment,100) as subject_assessment, yx.name as yx_name, y.name as yjxk_name\')\\n211\\t                ->where($where);\\n212\\t            if ($isRepeat == 1) {\\n213\\t                $list = $sql\\n214\\t                    ->order(\'subject_assessment asc,m.code asc\')\\n215\\t                    ->select();\\n216\\t            } elseif ($isRepeat == -1) {\\n217\\t                $list = $sql\\n218\\t                    ->order(\'subject_assessment asc,m.code asc\')\\n219\\t                    ->group(\'m.code\')\\n220\\t                    ->select();\\n221\\t            } else {\\n222\\t                $list = $sql\\n223\\t                    ->order(\'subject_assessment asc,m.code asc\')\\n224\\t                    ->group(\'ms.yuanxi_id,m.code\')\\n225\\t                    ->select();\\n226\\t            }\\n227\\t\\n228\\t            if ($list) {\\n229\\t                $adminSchoolMajor = new SchoolMajor();\\n230\\t\\n231\\t                \\/\\/用户收藏的专业\\n232\\t                $uid = session(\'uid\');\\n233\\t                $schoolMajorCollectModel = new SchoolMajorCollect();\\n234\\t                $userCollectMajorSchoolIds = $schoolMajorCollectModel->getUserCollectMajor($uid);\\n235\\t                foreach ($list as &$item) {\\n236\\t                    $item[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n237\\t                    $item[\'is_collected\'] = in_array($item[\'major_school_id\'], $userCollectMajorSchoolIds) ? 1 : 0;\\n238\\t                }\\n239\\t            }\\n240\\t        } else {\\n241\\t            $list = $this->majorModel\\n242\\t                ->alias(\'m\')\\n243\\t                ->join(\'cl_yjxk y\', \'m.yjxk_id = y.id\', \'LEFT\')\\n244\\t                ->field(\'m.id as major_id, m.code, m.name as major_name,y.name as yjxk_name,y.type\')\\n245\\t                ->where($where)\\n246\\t                ->select();\\n247\\t        }\\n248\\t\\n249\\t        $this->success(\'success\', $list);\\n250\\t    }\\n251\\t\\n252\\t    \\/**\\n253\\t     * Function info [院校专业详情]\\n254\\t     * @author erdong\\n255\\t     * @date 2022-10-12\\n256\\t     *\\/\\n257\\t    public function info()\\n258\\t    {\\n259\\t        $this->auth->isLogin();\\n260\\t        $uid = session(\'uid\');\\n261\\t        $majorSchoolId = input(\'major_school_id\\/d\', 0);\\n262\\t        if (!$majorSchoolId) {\\n263\\t            $majorId = input(\'major_id\', 0);\\n264\\t            if (!$majorId) {\\n265\\t                $this->error(\'参数错误\');\\n266\\t            }\\n267\\t            $schoolId = input(\'school_id\', 0);\\n268\\t            $yuanxiId = input(\'yuanxi_id\', 0);\\n269\\t            $majorSchoolId = $this->majorSchoolModel\\n270\\t                ->where(\'major_id\', $majorId)\\n271\\t                ->where(\'school_id\', $schoolId)\\n272\\t                ->where(\'yuanxi_id\', $yuanxiId)\\n273\\t                ->value(\'id\');\\n274\\t        }\\n275\\t        $status = accessControl(3, $majorSchoolId);\\n276\\t        if (!$status) {\\n277\\t            if ($status === 0) {\\n278\\t                $this->error(\'您操作过于频繁，请稍后再试\');\\n279\\t            } else {\\n280\\t                $this->error(\'您的账号存在异常，请联系客服\');\\n281\\t            }\\n282\\t        }\\n283\\t        $redis = redis();\\n284\\t        $key = \\\"yuanxiao::school::major::info::v7::\\\" . $majorSchoolId;\\n285\\t        $cache = $redis->get($key);\\n286\\t        if ($cache) {\\n287\\t            $majorInfo = json_decode($cache, true);\\n288\\t        } else {\\n289\\t            $majorInfo = $this->majorSchoolModel\\n290\\t                ->alias(\'ms\')\\n291\\t                ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n292\\t                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n293\\t                ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n294\\t                ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n295\\t                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n296\\t                ->field(\'sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n297\\t                ->where(\'ms.id\', $majorSchoolId)\\n298\\t                ->find();\\n299\\t\\n300\\t            if ($majorInfo) {\\n301\\t                $adminSchoolMajor = new SchoolMajor();\\n302\\t                $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n303\\t\\n304\\t                \\/\\/招生信息\\n305\\t                $zsxxList = Db::connect(\'database.yx_db_config\')\\n306\\t                    ->name(\'cl_major_school_detail\')\\n307\\t                    ->where(\'major_school_id\', $majorSchoolId)\\n308\\t                    ->field(\'createtime,updatetime\', true)\\n309\\t                    ->order(\'year desc\')\\n310\\t                    ->select();\\n311\\t                if ($zsxxList) {\\n312\\t                    \\/\\/$zsxxList = array_column($zsxxList, null, \'year\');\\n313\\t                    foreach ($zsxxList as &$item) {\\n314\\t                        $item[\'yjfx\'] = Db::connect(\'database.yx_db_config\')\\n315\\t                            ->name(\'cl_major_school_research\')\\n316\\t                            ->where(\'major_school_detail_id\', $item[\'id\'])\\n317\\t                            ->field(\'yjfx, cskm\')\\n318\\t                            ->order(\'id\')\\n319\\t                            ->select();\\n320\\t                        $kzybk = ($item[\'kzybk\'] >= 0) ? ($item[\'kzybk\'] ? \'接受跨专业\' : \'不接受跨专业\') : \'\';\\n321\\t                        $yqxw = ($item[\'yqxw\'] >= 0) ? ($item[\'yqxw\'] ? \'要求学位\' : \'不要求学位\') : \'\';\\n322\\t                        $yqgzjy = ($item[\'yqgzjy\'] >= 0) ? ($item[\'yqgzjy\'] ? \'要求工作经验\' : \'不要求工作经验\') : \'\';\\n323\\t                        $item[\'bkyq\'] = trim($kzybk . \' \' . $yqxw . \' \' . $yqgzjy);\\n324\\t                        if ($item[\'xuefei\'] == 0 || $item[\'xuefei\'] == \'0\') {\\n325\\t                            $item[\'xuefei\'] = \'\';\\n326\\t                        }\\n327\\t                    }\\n328\\t                }\\n329\\t                $majorInfo[\'zsxx\'] = $zsxxList;\\n330\\t                $documentModel = new Document();\\n331\\t                $majorInfo[\'has_docs\'] = $documentModel->ifHasDocsOrTalk($majorInfo[\'major_id\'], 0, $majorInfo[\'school_id\']); \\/\\/真题资料\\n332\\t                $majorInfo[\'has_talk\'] = $documentModel->ifHasDocsOrTalk($majorInfo[\'major_id\'], 1, $majorInfo[\'school_id\']); \\/\\/经验小课\\n333\\t                $majorInfo[\'has_senior\'] = $documentModel->ifHasSenior($majorInfo[\'major_id\'], $majorInfo[\'school_id\']); \\/\\/学长学姐\\n334\\t\\n335\\t                \\/\\/购课优惠\\n336\\t                $majorInfo[\'discount\'] = ModelMajor::vipDiscount($majorInfo[\'code\']);\\n337\\t\\n338\\t                \\/\\/院校默认图\\n339\\t                $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n340\\t            }\\n341\\t            $redis->setex($key, 86400, json_encode($majorInfo));\\n342\\t        }\\n343\\t        if ($uid) {\\n344\\t            $teacherInfo = getQrcode($uid, false);\\n345\\t        }\\n346\\t        $lqxx = (new \\\\app\\\\api\\\\logic\\\\Pic())->getLqxx($majorSchoolId, $majorInfo, $uid);\\n347\\t        $majorInfo[\'zlrsUrl\'] = $lqxx[\'zlrsUrl\'];\\n348\\t        $majorInfo[\'fushi\'] = $lqxx[\'fushi\'];\\n349\\t        $majorInfo[\'year_vs_score\'] = $lqxx[\'year_vs_score\'];\\n350\\t        $majorInfo[\'has_year_vs_score\'] = $lqxx[\'has_year_vs_score\'];\\n351\\t        $majorInfo[\'is_vip\'] = $lqxx[\'is_vip\'];\\n352\\t        $majorInfo[\'analysis\'] = $lqxx[\'analysis\'];\\n353\\t        if (empty($teacherInfo)) {\\n354\\t            $teacherInfo = [];\\n355\\t        } else {\\n356\\t            $teacherInfo = $teacherInfo[\'data\'] ?? [];\\n357\\t        }\\n358\\t        $majorInfo[\'teacher\'] = $teacherInfo;\\n359\\t        $majorInfo[\'uid\'] = $uid;\\n360\\t        \\/\\/用户收藏的专业\\n361\\t        $uid = session(\'uid\');\\n362\\t        $schoolMajorCollectModel = new SchoolMajorCollect();\\n363\\t        $userCollectMajorSchoolIds = $schoolMajorCollectModel->getUserCollectMajor($uid);\\n364\\t        $majorInfo[\'is_collected\'] = in_array($majorSchoolId, $userCollectMajorSchoolIds) ? 1 : 0;\\n365\\t        $this->success(\'success\', $majorInfo);\\n366\\t    }\\n367\\t\\n368\\t    \\/**\\n369\\t     * Function info [院校专业详情]\\n370\\t     * @author erdong\\n371\\t     * @date 2022-10-12\\n372\\t     *\\/\\n373\\t    public function infoNew()\\n374\\t    {\\n375\\t        $uid = session(\'uid\');\\n376\\t        $majorSchoolId = input(\'major_school_id\\/d\', 0);\\n377\\t        if (empty($majorSchoolId)) {\\n378\\t            $schoolId = input(\'school_id\\/d\', 0);\\n379\\t            $majorId = input(\'major_id\\/d\', 0);\\n380\\t            $yuanxiId = input(\'yuanxi_id\\/d\', 0);\\n381\\t            $isFull = input(\'is_full\\/s\', \'\');\\n382\\t            if (!$majorId && !$schoolId && !$yuanxiId && !$isFull) {\\n383\\t                $majorSchoolId = Db::connect(\'database.yx_db_config\')\\n384\\t                    ->name(\'cl_major_school\')\\n385\\t                    ->where(\'major_id\', $majorId)\\n386\\t                    ->where(\'school_id\', $schoolId)\\n387\\t                    ->where(\'yuanxi_id\', $yuanxiId)\\n388\\t                    ->where(\'is_full\', $isFull)\\n389\\t                    ->value(\'id\');\\n390\\t            }\\n391\\t        }\\n392\\t        if (empty($majorSchoolId)) {\\n393\\t            $this->error(\'参数错误\');\\n394\\t        }\\n395\\t        $redis = redis();\\n396\\t        $key = \\\"yuanxiao::school::major::info::v5::new::\\\" . $majorSchoolId;\\n397\\t        $cache = $redis->get($key);\\n398\\t        if ($cache) {\\n399\\t            $majorInfo = json_decode($cache, true);\\n400\\t        } else {\\n401\\t            $majorInfo = $this->majorSchoolModel\\n402\\t                ->alias(\'ms\')\\n403\\t                ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n404\\t                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n405\\t                ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n406\\t                ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n407\\t                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n408\\t                ->field(\'ms.tuition,ms.is_early_interview,ms.early_interview_batch,ms.special_require,ms.tags,sch.school_attr,sch.address,sch.tel,sch.email,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n409\\t                ->where(\'ms.id\', $majorSchoolId)\\n410\\t                ->find();\\n411\\t\\n412\\t            if ($majorInfo) {\\n413\\t                $latestYear = config(\'latest_year\');\\n414\\t                $yearList = [$latestYear, $latestYear - 1, $latestYear - 2];\\n415\\t                $admitInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n416\\t                    ->where(\'major_school_id\', $majorSchoolId)\\n417\\t                    ->whereIn(\'year\', $yearList)\\n418\\t                    ->field(\'year,bkrs,lqrs,blb,jrfsrs,tj_lqrs,zongfen,max_score,min_score,mid_score,tj_out,has_care_policy\')\\n419\\t                    ->order(\'year\', \'desc\')\\n420\\t                    ->select();\\n421\\t                $detailInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_detail\')\\n422\\t                    ->where(\'major_school_id\', $majorSchoolId)\\n423\\t                    ->whereIn(\'year\', $yearList)\\n424\\t                    ->field(\'year,nzrs,tmrs\')\\n425\\t                    ->order(\'year\', \'desc\')\\n426\\t                    ->select();\\n427\\t                $detailInfo = array_column($detailInfo, null, \'year\');\\n428\\t                $admitInfo = array_column($admitInfo, null, \'year\');\\n429\\t                foreach ($admitInfo as $k => $v) {\\n430\\t                    $admitInfo[$k][\'nzrs\'] = $detailInfo[$k][\'nzrs\'] ?? 0;\\n431\\t                    $admitInfo[$k][\'tmrs\'] = $detailInfo[$k][\'tmrs\'] ?? 0;\\n432\\t                }\\n433\\t                $lqrs = false;\\n434\\t                $year = \'\';\\n435\\t                $lqScore = [];\\n436\\t                $scoreLine = [];\\n437\\t                $lineA = [];\\n438\\t                $lineB = [];\\n439\\t                $yearLine = [];\\n440\\t                foreach ($yearList as $k => $v) {\\n441\\t\\n442\\t                    if (in_array(\'自划线\', explode(\',\', $majorInfo[\'school_attr\']))) {\\n443\\t                        if (empty($admitInfo[$v][\'zongfen\']) || $admitInfo[$v][\'zongfen\'] < 0) {\\n444\\t                            continue;\\n445\\t                        }\\n446\\t                        $lineA[] = $admitInfo[$v][\'zongfen\'] ?? 0;\\n447\\t                    } else {\\n448\\t                        $nationalA = (new MajorSchool())->getNationalForSingle(3363, $majorInfo[\'major_id\'], $v);\\n449\\t                        $nationalB = (new MajorSchool())->getNationalForSingle(3397, $majorInfo[\'major_id\'], $v);\\n450\\t                        $lineA[] = $nationalA[\'total_score\'];\\n451\\t                        $lineB[] = $nationalB[\'total_score\'];\\n452\\t                    }\\n453\\t                    $yearLine[] = $v;\\n454\\t                }\\n455\\t                foreach ($yearList as $k => $v) {\\n456\\t                    if (empty($year)) {\\n457\\t                        if (!isset($admitInfo[$v])) {\\n458\\t                            continue;\\n459\\t                        }\\n460\\t                        if ($admitInfo[$v][\'lqrs\'] > 0 || $admitInfo[$v][\'max_score\'] > 0 || $admitInfo[$v][\'mid_score\'] > 0 || $admitInfo[$v][\'min_score\'] > 0) {\\n461\\t                            $year = $v;\\n462\\t                            $lqScore = [\\n463\\t                                \'max_score\' => $admitInfo[$v][\'max_score\'] < 0 ? \'-\' : floatval($admitInfo[$v][\'max_score\']),\\n464\\t                                \'mid_score\' => $admitInfo[$v][\'mid_score\'] < 0 ? \'-\' : floatval($admitInfo[$v][\'mid_score\']),\\n465\\t                                \'min_score\' => $admitInfo[$v][\'min_score\'] < 0 ? \'-\' : floatval($admitInfo[$v][\'min_score\']),\\n466\\t                                \'lqrs\' => $admitInfo[$v][\'lqrs\'] < 0 ? \'-\' : floatval($admitInfo[$v][\'lqrs\']),\\n467\\t                            ];\\n468\\t                        }\\n469\\t                    }\\n470\\t                    $lq = $admitInfo[$v][\'lqrs\'] ?? 0;\\n471\\t                    if (!empty(floatval($lq)) && $lq > 0) {\\n472\\t                        $lqrs = true;\\n473\\t                        break;\\n474\\t                    }\\n475\\t                }\\n476\\t                if (!empty($lqScore)) {\\n477\\t                    $majorInfo[\'lq_score\'] = $lqScore;\\n478\\t                    $majorInfo[\'year\'] = $year;\\n479\\t                }\\n480\\t                if (!empty($lineA)) {\\n481\\t                    $scoreLine[] = [\\n482\\t                        \'data\' => $lineA,\\n483\\t                    ];\\n484\\t                }\\n485\\t                if (!empty($lineB)) {\\n486\\t                    $scoreLine[] = [\\n487\\t                        \'data\' => $lineB,\\n488\\t                    ];\\n489\\t                }\\n490\\t                $majorInfo[\'admit_info\'] = array_values($admitInfo);\\n491\\t                $majorInfo[\'is_early_interview\'] = $majorInfo[\'is_early_interview\'] == -1 ? \'无\' : ($majorInfo[\'is_early_interview\'] == 1 ? \'是\' : \'无\');\\n492\\t                if ($majorInfo[\'is_early_interview\'] == \'是\') {\\n493\\t                    if (!empty($majorInfo[\'special_require\'])) {\\n494\\t                        $majorInfo[\'early_interview_ps\'] = $majorInfo[\'early_interview_batch\'] . \\\"\\\\n\\\" . $majorInfo[\'special_require\'];\\n495\\t                    } else {\\n496\\t                        $majorInfo[\'early_interview_ps\'] = $majorInfo[\'early_interview_batch\'];\\n497\\t                    }\\n498\\t                } else {\\n499\\t                    $majorInfo[\'early_interview_ps\'] = \'\';\\n500\\t                }\\n501\\t                $majorInfo[\'score_line\'] = $scoreLine;\\n502\\t                $majorInfo[\'year_line\'] = $yearLine;\\n503\\t                $majorInfo[\'has_diffculty\'] = false;\\n504\\t                if ($lqrs || !empty($majorInfo[\'tags\'])) {\\n505\\t                    $majorInfo[\'has_diffculty\'] = true;\\n506\\t                }\\n507\\t                $adminSchoolMajor = new SchoolMajor();\\n508\\t                $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n509\\t                if (!empty($majorInfo[\'school_attr\'])) {\\n510\\t                    $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n511\\t                } else {\\n512\\t                    $majorInfo[\'school_attr\'] = [];\\n513\\t                }\\n514\\t                $majorInfo[\'area_name\'] = Db::connect(\'database.yx_db_config\')\\n515\\t                    ->name(\'area\')\\n516\\t                    ->where(\'id\', $majorInfo[\'area_id\'])\\n517\\t                    ->value(\'name\');\\n518\\t                if (empty($year)) {\\n519\\t                    $zsxxList = Db::connect(\'database.yx_db_config\')\\n520\\t                        ->name(\'cl_major_school_detail\')\\n521\\t                        ->where(\'major_school_id\', $majorSchoolId)\\n522\\t                        ->field(\'createtime,updatetime\', true)\\n523\\t                        ->order(\'year\', \'desc\')\\n524\\t                        ->limit(1)\\n525\\t                        ->find();\\n526\\t                } else {\\n527\\t                    $zsxxList = Db::connect(\'database.yx_db_config\')\\n528\\t                        ->name(\'cl_major_school_detail\')\\n529\\t                        ->where(\'major_school_id\', $majorSchoolId)\\n530\\t                        ->where(\'year\', \'=\', $year)\\n531\\t                        ->field(\'createtime,updatetime\', true)\\n532\\t                        ->find();\\n533\\t                }\\n534\\t                \\/\\/招生信息\\n535\\t                $bkyq = [];\\n536\\t                $schoolInfo = [];\\n537\\t                if ($zsxxList) {\\n538\\t                    $kzybk = ($zsxxList[\'kzybk\'] >= 0) ? ($zsxxList[\'kzybk\'] ? \'接受跨专业\' : \'不接受跨专业\') : \'\';\\n539\\t                    $yqxw = ($zsxxList[\'yqxw\'] >= 0) ? ($zsxxList[\'yqxw\'] ? \'要求学位\' : \'不要求学位\') : \'\';\\n540\\t                    $yqgzjy = ($zsxxList[\'yqgzjy\'] >= 0) ? ($zsxxList[\'yqgzjy\'] ? \'要求工作经验\' : \'不要求工作经验\') : \'\';\\n541\\t                    if (!empty(trim($kzybk . \' \' . $yqxw . \' \' . $yqgzjy))) {\\n542\\t                        $bkyq[\'bkyq\'] = trim($kzybk . \' \' . $yqxw . \' \' . $yqgzjy);\\n543\\t                    }\\n544\\t                    if (!empty($zsxxList[\'same_demand\'])) {\\n545\\t                        $bkyq[\'same_demand\'] = $zsxxList[\'same_demand\'];\\n546\\t                    }\\n547\\t                    if (!empty($zsxxList[\'retest_demand\'])) {\\n548\\t                        $bkyq[\'retest_demand\'] = $zsxxList[\'retest_demand\'];\\n549\\t                    }\\n550\\t                    \\/\\/初始参考书\\n551\\t                    if (!empty($zsxxList[\'cksm\'])) {\\n552\\t                        $bkyq[\'cksm\'] = $zsxxList[\'cksm\'];\\n553\\t                    }\\n554\\t                    \\/\\/复试科目\\n555\\t                    if (!empty($zsxxList[\'fskm\'])) {\\n556\\t                        $bkyq[\'fskm\'] = $zsxxList[\'fskm\'];\\n557\\t                    }\\n558\\t                    \\/\\/录取成绩占比\\n559\\t                    if (!empty($zsxxList[\'lqcjzb\'])) {\\n560\\t                        $bkyq[\'lqcjzb\'] = $zsxxList[\'lqcjzb\'];\\n561\\t                    }\\n562\\t                    $yjfx = Db::connect(\'database.yx_db_config\')\\n563\\t                        ->name(\'cl_major_school_research\')\\n564\\t                        ->where(\'major_school_detail_id\', $zsxxList[\'id\'])\\n565\\t                        ->field(\'yjfx, cskm\')\\n566\\t                        ->order(\'id\')\\n567\\t                        ->select();\\n568\\t                    if (!empty($yjfx)) {\\n569\\t                        $bkyq[\'yjfx\'] = $yjfx;\\n570\\t                    }\\n571\\t                    $eduSystem = \'\';\\n572\\t                    $xuefei = \'\';\\n573\\t                    if ($majorInfo[\'tuition\'] > 0) {\\n574\\t                        $zsxxList[\'xuefei\'] = floatval($majorInfo[\'tuition\']) . \'万元\';\\n575\\t                    }\\n576\\t                    if (!empty($zsxxList[\'edu_system\'])) {\\n577\\t                        $eduSystem = \'学制：\' . mb_trim($zsxxList[\'edu_system\'], \'年\') . \'年\';\\n578\\t                        $schoolInfo[\'edu_system\'] = $zsxxList[\'edu_system\'];\\n579\\t                    }\\n580\\t                    if (!empty($zsxxList[\'xuefei\'])) {\\n581\\t                        $xuefei = \'学费：\' . mb_trim($zsxxList[\'xuefei\']);\\n582\\t                        $schoolInfo[\'xuefei\'] = $zsxxList[\'xuefei\'];\\n583\\t                    }\\n584\\t                    $xuefei_xuezhi = mb_trim($eduSystem . \' \' . $xuefei);\\n585\\t                    if (!empty($xuefei_xuezhi)) {\\n586\\t                        $schoolInfo[\'xuefei_xuezhi\'] = $xuefei_xuezhi;\\n587\\t                    }\\n588\\t                    if (!empty($zsxxList[\'jzxj\'])) {\\n589\\t                        $schoolInfo[\'jzxj\'] = $zsxxList[\'jzxj\'];\\n590\\t                    }\\n591\\t                    $majorInfo[\'kzybk\'] = $zsxxList[\'kzybk\'];\\n592\\t                }\\n593\\t                $contact_information = [];\\n594\\t\\n595\\t                if (!empty($majorInfo[\'tel\'])) {\\n596\\t                    $contact_information[] = \'院校电话：\' . $majorInfo[\'tel\'];\\n597\\t                }\\n598\\t                if (!empty($majorInfo[\'email\'])) {\\n599\\t                    $contact_information[] = \'院校邮箱：\' . $majorInfo[\'email\'];\\n600\\t                }\\n601\\t                if (!empty($majorInfo[\'address\'])) {\\n602\\t                    $contact_information[] = \'院校地址：\' . $majorInfo[\'address\'];\\n603\\t                }\\n604\\t                if (!empty($contact_information)) {\\n605\\t                    $schoolInfo[\'contact_information\'] = $contact_information;\\n606\\t                }\\n607\\t                if (!empty($schoolInfo)) {\\n608\\t                    $majorInfo[\'school_info\'] = $schoolInfo;\\n609\\t                }\\n610\\t                if (!empty($bkyq)) {\\n611\\t                    $majorInfo[\'bkyq\'] = $bkyq;\\n612\\t                } else {\\n613\\t                    $majorInfo[\'bkyq\'] = [];\\n614\\t                }\\n615\\t\\n616\\t                $documentModel = new Document();\\n617\\t                $majorInfo[\'has_docs\'] = $documentModel->ifHasDocsOrTalk($majorInfo[\'major_id\'], 0, $majorInfo[\'school_id\']); \\/\\/真题资料\\n618\\t                $majorInfo[\'has_talk\'] = $documentModel->ifHasDocsOrTalk($majorInfo[\'major_id\'], 1, $majorInfo[\'school_id\']); \\/\\/经验小课\\n619\\t                $majorInfo[\'has_senior\'] = $documentModel->ifHasSenior($majorInfo[\'major_id\'], $majorInfo[\'school_id\']); \\/\\/学长学姐\\n620\\t\\n621\\t                \\/\\/购课优惠\\n622\\t                $majorInfo[\'discount\'] = ModelMajor::vipDiscount($majorInfo[\'code\']);\\n623\\t\\n624\\t                \\/\\/院校默认图\\n625\\t                $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n626\\t            }\\n627\\t            $redis->setex($key, 86400, json_encode($majorInfo));\\n628\\t        }\\n629\\t        $majorInfo[\'uid\'] = $uid;\\n630\\t        \\/\\/用户收藏的专业\\n631\\t        $uid = session(\'uid\');\\n632\\t        $schoolMajorCollectModel = new SchoolMajorCollect();\\n633\\t        $userCollectMajorSchoolIds = $schoolMajorCollectModel->getUserCollectMajor($uid);\\n634\\t        $majorInfo[\'is_collected\'] = in_array($majorSchoolId, $userCollectMajorSchoolIds) ? 1 : 0;\\n635\\t        $res = (new \\\\app\\\\api\\\\logic\\\\Common())->getLeftScanNum($uid, 3, $majorSchoolId, 0);\\n636\\t        $data = $res[\'data\'];\\n637\\t        $coin = $data[\'coin\'];\\n638\\t        $coin_pay_price = $data[\'coin_pay_price\'];\\n639\\t        $majorInfo[\'left_num\'] = $data[\'left_num\'];\\n640\\t        $majorInfo[\'total_num\'] = $data[\'total_num\'];\\n641\\t        $majorInfo[\'coin_total_num\'] = $data[\'coin_total_num\'];\\n642\\t        $majorInfo[\'coin_left_num\'] = $data[\'coin_left_num\'];\\n643\\t        $majorInfo[\'is_vip\'] = $data[\'isvip\'];\\n644\\t        $majorInfo[\'coin_pay_price\'] = $coin_pay_price;\\n645\\t        $majorInfo[\'my_coin\'] = $coin;\\n646\\t        $majorInfo[\'direct_scan\'] = $data[\'direct_scan\'];\\n647\\t        $majorInfo[\'type\'] = $majorInfo[\'type\'] == \\\"专业硕士\\\" ? \\\"专硕\\\" : \\\"学硕\\\";\\n648\\t        list($majorInfo[\'recorment_score\'], $majorInfo[\'recorment_score_type\']) = (new Common())->getRecormentScore($majorSchoolId);\\n649\\t        $userExtend = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n650\\t            ->where(\'uid\', $uid)\\n651\\t            ->field(\'selected_school, selected_yuanxi, selected_major, selected_full, exam_period, fix_school, fix_major\')\\n652\\t            ->find();\\n653\\t        $majorInfo[\'is_target\'] = 0;\\n654\\t        if (!empty($userExtend)) {\\n655\\t            if ($majorInfo[\'school_id\'] == $userExtend[\'selected_school\'] && $majorInfo[\'yuanxi_id\'] == $userExtend[\'selected_yuanxi\'] && $majorInfo[\'major_id\'] == $userExtend[\'selected_major\'] && $majorInfo[\'is_full\'] == $userExtend[\'selected_full\']) {\\n656\\t                $majorInfo[\'is_target\'] = 1;\\n657\\t            }\\n658\\t        }\\n659\\t        $this->success(\'success\', $majorInfo);\\n660\\t    }\\n661\\t\\n662\\t    \\/**\\n663\\t     * Function index [专业主页]\\n664\\t     * @author erdong\\n665\\t     * @date 2022-10-13\\n666\\t     *\\/\\n667\\t    public function index()\\n668\\t    {\\n669\\t        $majorId = input(\'major_id\\/d\', 0);\\n670\\t        if (!$majorId) {\\n671\\t            $this->error(\'参数错误\');\\n672\\t        }\\n673\\t        $redis = redis();\\n674\\t        $key = \'yuanxiao::major::index::v4::\' . $majorId;\\n675\\t        $cache = $redis->get($key);\\n676\\t        if ($cache) {\\n677\\t            $data = json_decode($cache, true);\\n678\\t        } else {\\n679\\t            $data = $this->majorModel->getInfo($majorId);\\n680\\t            if ($data) {\\n681\\t                $data[\'school_count\'] = $this->majorSchoolModel->getMajorSchoolCount($majorId);\\n682\\t                if ($data[\'school_count\']) {\\n683\\t                    $schoolList = $this->majorSchoolModel->getMajorSchoolList($majorId, 3);\\n684\\t                    if ($schoolList) {\\n685\\t                        $topCount = 0;\\n686\\t                        $adminSchoolMajor = new SchoolMajor();\\n687\\t                        foreach ($schoolList as &$item) {\\n688\\t                            $subjectAssessment = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n689\\t                            if ($subjectAssessment != \'无\') {\\n690\\t                                $topCount++;\\n691\\t                            }\\n692\\t                            $item[\'subject_assessment\'] = $subjectAssessment;\\n693\\t                        }\\n694\\t                        $data[\'school_title\'] = $topCount >= 3 ? \'热门院校推荐\' : \'开设院校\';\\n695\\t                        $data[\'school_list\'] = $schoolList;\\n696\\t                    }\\n697\\t                }\\n698\\t            }\\n699\\t            $redis->setex($key, 86400, json_encode($data));\\n700\\t        }\\n701\\t        $documentModel = new Document();\\n702\\t        $data[\'has_docs\'] = $documentModel->ifHasDocsOrTalk($majorId); \\/\\/真题资料\\n703\\t        $data[\'has_docs_real\'] = $documentModel->ifHasDocsOrTalk($majorId, 0, 0, 1); \\/\\/真题资料\\n704\\t        $data[\'has_docs_high\'] = $documentModel->ifHasDocsOrTalk($majorId, 0, 0, 2); \\/\\/高分笔记\\n705\\t        $data[\'has_talk\'] = $documentModel->ifHasDocsOrTalk($majorId, 1); \\/\\/经验小课\\n706\\t        $data[\'has_senior\'] = $documentModel->ifHasSenior($majorId); \\/\\/学长学姐\\n707\\t        $this->success(\'success\', $data);\\n708\\t    }\\n709\\t\\n710\\t    \\/**\\n711\\t     * Function introduce [专业介绍]\\n712\\t     * @author erdong\\n713\\t     * @date 2022-10-13\\n714\\t     *\\/\\n715\\t    public function introduce()\\n716\\t    {\\n717\\t        $majorId = input(\'major_id\\/d\', 0);\\n718\\t        if (!$majorId) {\\n719\\t            $this->error(\'参数错误\');\\n720\\t        }\\n721\\t        $data = $this->majorModel->getInfo($majorId);\\n722\\t        $this->success(\'success\', $data);\\n723\\t    }\\n724\\t\\n725\\t    \\/**\\n726\\t     * Function schoolList [专业院校列表]\\n727\\t     * @author erdong\\n728\\t     * @date 2022-10-13\\n729\\t     *\\/\\n730\\t    public function schoolList()\\n731\\t    {\\n732\\t        $majorId = input(\'major_id\\/d\', 0);\\n733\\t        if (!$majorId) {\\n734\\t            $this->error(\'参数错误\');\\n735\\t        }\\n736\\t        $data = $this->majorModel->getInfo($majorId);\\n737\\t        if ($data) {\\n738\\t            $list = $this->majorSchoolModel\\n739\\t                ->alias(\'ms\')\\n740\\t                ->join(\'major m\', \'ms.major_id = m.id\', \'LEFT\')\\n741\\t                ->join(\'school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n742\\t                ->join(\'yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n743\\t                ->join(\'yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n744\\t                ->where(\'ms.major_id\', $majorId)\\n745\\t                ->field(\'sch.id as school_id,sch.name as school_name,ms.is_full,yx.name,subject_assessment\')\\n746\\t                ->group(\'ms.school_id\')\\n747\\t                ->select();\\n748\\t            $data[\'school_list\'] = $list;\\n749\\t        }\\n750\\t        $this->success(\'success\', $data);\\n751\\t    }\\n752\\t\\n753\\t    \\/**\\n754\\t     * Function collect [关注院校库专业]\\n755\\t     * @author erdong\\n756\\t     * @date 2022-11-01\\n757\\t     *\\/\\n758\\t    public function collect()\\n759\\t    {\\n760\\t        $majorSchoolId = input(\'major_school_id\', 0);\\n761\\t        if (!$majorSchoolId) {\\n762\\t            $this->error(\'参数错误【major_school_id】\');\\n763\\t        }\\n764\\t        $uid = session(\'uid\');\\n765\\t        $table = \'school_major_collect\';\\n766\\t        $row = Db::connect(\'database.yx_db_config\')\\n767\\t            ->name($table)\\n768\\t            ->where(\'uid\', $uid)\\n769\\t            ->where(\'school_major_id\', $majorSchoolId)\\n770\\t            ->find();\\n771\\t        if ($row) {\\n772\\t            Db::connect(\'database.yx_db_config\')\\n773\\t                ->name($table)\\n774\\t                ->where(\'uid\', $uid)\\n775\\t                ->where(\'school_major_id\', $majorSchoolId)\\n776\\t                ->delete();\\n777\\t        } else {\\n778\\t            $list = Db::connect(\'database.yx_db_config\')\\n779\\t                ->name($table)\\n780\\t                ->where(\'uid\', $uid)\\n781\\t                ->order(\'listorder asc\')\\n782\\t                ->select();\\n783\\t            if (count($list) >= 3) {\\n784\\t                $this->error(\'最多只能设置3个意向院校\');\\n785\\t            }\\n786\\t            $listOrder = (!empty($list)) ? $list[0][\'listorder\'] - 1 : 0;\\n787\\t            $data = [\\n788\\t                \'uid\' => $uid,\\n789\\t                \'school_major_id\' => $majorSchoolId,\\n790\\t                \'listorder\' => $listOrder,\\n791\\t                \'created_at\' => time()\\n792\\t            ];\\n793\\t            Db::connect(\'database.yx_db_config\')\\n794\\t                ->name($table)\\n795\\t                ->insert($data);\\n796\\t        }\\n797\\t\\n798\\t        \\/\\/更新缓存\\n799\\t        $redis = redis();\\n800\\t        $redis->del(SchoolMajorCollect::CACHE_KEY_USER_COLLECT_MAJOR . $uid);\\n801\\t\\n802\\t        $this->success(\'success\');\\n803\\t    }\\n804\\t\\n805\\t    \\/**\\n806\\t     * Function myCollect [院校专业-我的关注]\\n807\\t     * @author erdong\\n808\\t     * @date 2022-11-01\\n809\\t     *\\/\\n810\\t    public function myCollect()\\n811\\t    {\\n812\\t        $uid = session(\'uid\');\\n813\\t        $list = Db::connect(\'database.yx_db_config\')\\n814\\t            ->name(\'school_major_collect\')\\n815\\t            ->alias(\'smc\')\\n816\\t            ->join(\'cl_major_school ms\', \'smc.school_major_id = ms.id\', \'LEFT\')\\n817\\t            ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n818\\t            ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n819\\t            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n820\\t            ->field(\'sch.comprehensive_ranking,sch.school_attr,m.yjxk_id,ms.subject_evaluation,sch.area_id,ms.school_id,ms.major_id,smc.id as collect_id, ms.id as major_school_id, sch.logo as school_logo, sch.name as school_name, yx.name as yuanxi_name, m.code, m.name as major_name\')\\n821\\t            ->where(\'smc.uid\', $uid)\\n822\\t            ->order(\'listorder\', \'asc\')\\n823\\t            ->select();\\n824\\t        $arreaName = Db::connect(\'database.yx_db_config\')\\n825\\t            ->name(\'area\')\\n826\\t            ->column(\'name\', \'id\');\\n827\\t        $yjxkIds = array_column($list, \'yjxk_id\');\\n828\\t        $types = Db::connect(\'database.yx_db_config\')->name(\'cl_yjxk\')\\n829\\t            ->whereIn(\'id\', $yjxkIds)\\n830\\t            ->column(\'type\', \'id\');\\n831\\t        if ($list) {\\n832\\t            $adminSchoolMajor = new SchoolMajor();\\n833\\t            foreach ($list as $k => $v) {\\n834\\t                $list[$k][\'school_logo\'] = School::schoolLogo($v[\'school_logo\']);\\n835\\t                $list[$k][\'area_name\'] = $arreaName[$v[\'area_id\']];\\n836\\t                $list[$k][\'school_attr\'] = explode(\',\', $v[\'school_attr\']);\\n837\\t                $list[$k][\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($v[\'subject_evaluation\']);\\n838\\t                $list[$k][\'type\'] = $types[$v[\'yjxk_id\']] ?? \'\';\\n839\\t                if (!$v[\'major_school_id\']) {\\n840\\t                    unset($list[$k]);\\n841\\t                    Db::connect(\'database.yx_db_config\')\\n842\\t                        ->name(\'school_major_collect\')\\n843\\t                        ->where(\'uid\', $uid)\\n844\\t                        ->where(\'id\', $v[\'collect_id\'])\\n845\\t                        ->delete();\\n846\\t                }\\n847\\t            }\\n848\\t        }\\n849\\t        $this->success(\'success\', $list);\\n850\\t    }\\n851\\t\\n852\\t    \\/**\\n853\\t     * Function sortMyCollect [院校库专业-我的关注-编辑排序]\\n854\\t     * @author erdong\\n855\\t     * @date 2022-06-28\\n856\\t     *\\/\\n857\\t    public function myCollectSort()\\n858\\t    {\\n859\\t        $uid = session(\'uid\');\\n860\\t        $sortStr = input(\'sort_str\', \'\');\\n861\\t        if ($sortStr) {\\n862\\t            $sortArr = explode(\',\', $sortStr);\\n863\\t            $len = count($sortArr);\\n864\\t            if ($sortArr) {\\n865\\t                for ($i = 0; $i < $len; $i++) {\\n866\\t                    $where = [\\n867\\t                        \'uid\' => $uid,\\n868\\t                        \'school_major_id\' => $sortArr[$i]\\n869\\t                    ];\\n870\\t                    $update[\'listorder\'] = $i;\\n871\\t                    Db::connect(\'database.yx_db_config\')\\n872\\t                        ->name(\'school_major_collect\')\\n873\\t                        ->where($where)\\n874\\t                        ->update($update);\\n875\\t                }\\n876\\t            }\\n877\\t        }\\n878\\t        $this->success(\'success\');\\n879\\t    }\\n880\\t\\n881\\t    public function getDiffculty()\\n882\\t    {\\n883\\t        $chooseSchool = new \\\\app\\\\api\\\\logic\\\\ChooseSchool();\\n884\\t        $uid = session(\'uid\');\\n885\\t        $majorSchoolId = input(\'major_school_id\\/d\', 0);\\n886\\t        $is_coin_pay = input(\'is_coin_pay\\/d\', 0);\\n887\\t        if (!$majorSchoolId) {\\n888\\t            $this->error(\'参数错误\');\\n889\\t        }\\n890\\t        if (!get_redis_lock(\'major_info_new_lock_key_\' . $uid, 10)) {\\n891\\t            $this->error(\'您操作过于频繁，请稍后再试\');\\n892\\t        }\\n893\\t        $res = (new \\\\app\\\\api\\\\logic\\\\Common())->getLeftScanNum($uid, 3, $majorSchoolId, $is_coin_pay);\\n894\\t        $data = $res[\'data\'];\\n895\\t        get_redis_lock(\'major_info_new_lock_key_\' . $uid, 10, true);\\n896\\t        $coin = $data[\'coin\'];\\n897\\t        $coin_pay_price = $data[\'coin_pay_price\'];\\n898\\t        if ($is_coin_pay) {\\n899\\t            if ($res[\'errno\'] > 0) {\\n900\\t                $this->error($res[\'msg\']);\\n901\\t            }\\n902\\t        }\\n903\\t        if ($data[\'left_num\'] <= 0 && $data[\'is_notice\'] && ($is_coin_pay == 0 || ($is_coin_pay == 1 && $data[\'coin_left_num\'] <= 0))) {\\n904\\t            $this->error(\'您的\' . $data[\'total_num\'] . \'次免费查看次数已经用完<br>可通过以下方式获得更多查看次数\', [\'my_coin\' => $coin, \'left_num\' => 0, \'coin_pay_price\' => $coin_pay_price, \'is_vip\' => $data[\'isvip\'], \'total_num\' => $data[\'total_num\'], \'coin_left_num\' => $data[\'coin_left_num\'], \'coin_total_num\' => $data[\'coin_total_num\']], 10002);\\n905\\t        }\\n906\\t        $status = accessControl(3, $majorSchoolId,!$data[\'direct_scan\']);\\n907\\t        if (!$status) {\\n908\\t            if ($status === 0) {\\n909\\t                $this->error(\'您操作过于频繁，请稍后再试\');\\n910\\t            } else {\\n911\\t                $this->error(\'您的账号存在异常，请联系客服\');\\n912\\t            }\\n913\\t        } else {\\n914\\t            if (!$data[\'direct_scan\']) {\\n915\\t                $data[\'left_num\'] -= 1;\\n916\\t            }\\n917\\t        }\\n918\\t        $first_exam_score = 0;\\n919\\t        if ($uid) {\\n920\\t            $first_exam_score = Db::connect(\'database.yx_db_config\')->name(\'cl_choose_school\')\\n921\\t                ->where(\'uid\', $uid)\\n922\\t                ->value(\'first_exam_score\');\\n923\\t        }\\n924\\t        $res = $chooseSchool->get_difficulty_new($majorSchoolId, $first_exam_score);\\n925\\t        $return = [];\\n926\\t        $return[\'difficulty\'] = $res;\\n927\\t        $return[\'left_num\'] = $data[\'left_num\'];\\n928\\t        $return[\'total_num\'] = $data[\'total_num\'];\\n929\\t        $return[\'coin_total_num\'] = $data[\'coin_total_num\'];\\n930\\t        $return[\'coin_left_num\'] = $data[\'coin_left_num\'];\\n931\\t        $return[\'is_vip\'] = $data[\'isvip\'];\\n932\\t        $return[\'coin_pay_price\'] = $coin_pay_price;\\n933\\t        $return[\'my_coin\'] = $coin;\\n934\\t        $return[\'times\'] = $data[\'times\'] ?? 0;\\n935\\t        $this->success(\'success\', $return);\\n936\\t    }\\n937\\t\\n938\\t    \\/**\\n939\\t     * Function collectNew [院校收藏]\\n940\\t     * @Author yth\\n941\\t     * @DateTime 2024\\/1\\/3\\n942\\t     *\\/\\n943\\t    public function collectNew()\\n944\\t    {\\n945\\t        $uid = session(\'uid\');\\n946\\t        $majorSchoolId = input(\'major_school_id\', 0);\\n947\\t        if (!$majorSchoolId) {\\n948\\t            $this->error(\'参数错误【major_school_id】\');\\n949\\t        }\\n950\\t\\n951\\t        $row = Db::name(\'major_school_collect\')\\n952\\t            ->where(\'uid\', $uid)\\n953\\t            ->where(\'major_school_id\', $majorSchoolId)\\n954\\t            ->find();\\n955\\t\\n956\\t        $now = time();\\n957\\t        if (empty($row) || $row[\'status\'] == 2) { \\/\\/ 收藏\\n958\\t            if (empty($row)) {\\n959\\t                $res = Db::name(\'major_school_collect\')->insert([\\n960\\t                    \'uid\' => $uid,\\n961\\t                    \'major_school_id\' => $majorSchoolId,\\n962\\t                    \'collect_time\' => $now,\\n963\\t                    \'create_time\' => $now,\\n964\\t                    \'update_time\' => $now,\\n965\\t                    \'status\' => 1,\\n966\\t                ]);\\n967\\t            } else {\\n968\\t                $res = Db::name(\'major_school_collect\')\\n969\\t                    ->where(\'uid\', $uid)\\n970\\t                    ->where(\'major_school_id\', $majorSchoolId)\\n971\\t                    ->update([\\n972\\t                        \'status\' => 1,\\n973\\t                        \'collect_time\' => $now,\\n974\\t                        \'update_time\' => $now,\\n975\\t                    ]);\\n976\\t            }\\n977\\t        } else { \\/\\/ 取消收藏\\n978\\t            $res = Db::name(\'major_school_collect\')\\n979\\t                ->where(\'uid\', $uid)\\n980\\t                ->where(\'major_school_id\', $majorSchoolId)\\n981\\t                ->update([\\n982\\t                    \'status\' => 2,\\n983\\t                    \'update_time\' => $now,\\n984\\t                ]);\\n985\\t        }\\n986\\t        if (!$res) {\\n987\\t            $this->error(\'操作失败，请稍后再试\');\\n988\\t        }\\n989\\t\\n990\\t        $this->success(\'success\');\\n991\\t    }\\n992\\t}\\n993\\t\"}]},\"parent_tool_use_id\":\"call_00_aQPH51Kq0V2SHHCt5Wim9371\",\"session_id\":\"709785dc-e16e-484f-9922-07c4f799ccb4\",\"uuid\":\"65ce5671-ca91-46e7-89b0-e035e2cf9454\",\"timestamp\":\"2026-07-07T17:11:24.192Z\",\"subagent_type\"
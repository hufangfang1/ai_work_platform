n     */\\n    protected $scene = [\\n        \'get_score\'  => [\'now_standing\', \'school_id\', \'major_name\', \'cet\', \'area_id\', \'major_id\', \'exam_year\', \'school_attr\', \'school_grades\', \'is_full\'],\\n        \'get_count\' => [\'area_id\', \'school_attr\', \'major_id\', \'is_full\'],\\n    ];\\n    public function checkNowStanding($value){\\n        return $this->checkParam($value,\'getNowStanding\',\'您的身份\');\\n    }\\n    public function checkSchoolAttr($value){\\n        return $this->checkParam($value,\'getSchoolAttr\',\'院校层次\');\\n    }\\n    public function checkSchoolGrades($value){\\n        return $this->checkParam($value,\'getSchoolGrades\',\'院校层次\');\\n    }\\n    public function checkCet($value){\\n        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n    }\\n    public function checkExamYear($value){\\n        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n    }\\n    public function checkIsFull($value){\\n        if(in_array($value,[1,2])){\\n            return true;\\n        }else{\\n            return ComErrorDescs::EC_INVALID_PARAM . \',is_full\';\\n        }\\n    }\\n    private function checkParam($value,$action,$word){\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $list = $model->$action(1);\\n        if($action != \'getExamYear\'){\\n            $item = [];\\n            foreach ($list as $k => $v) {\\n                $item[] = $k+1;\\n            }\\n            $keys = array_values($item);\\n        }else{\\n            $keys = array_keys($list);\\n        }\\n        if(in_array($value,$keys)){\\n            return true;\\n        }\\n        return ComErrorDescs::EC_INVALID_PARAM . \',\'.$word;\\n    }\\n\\n}\",\"numLines\":86,\"startLine\":1,\"totalLines\":86}}}

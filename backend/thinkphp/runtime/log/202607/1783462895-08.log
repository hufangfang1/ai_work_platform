cted $noNeedLogin = [];\\n    protected $noNeedRight = [];\\n\\n    protected $majorSchoolModel = null;\\n    protected $userSchoolMajorTargetModel = null;\\n    protected $uid;\\n    public function _initialize()\\n    {\\n        parent::_initialize();\\n        $this->uid = session(\'uid\') ?? 0;\\n        $this->majorSchoolModel = new MajorSchool();\\n        $this->userSchoolMajorTargetModel = model(\'UserSchoolMajorTarget\');\\n    }\\n\\n    \\/**\\n     * Function targetIndex [院校规划首页]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function targetIndex()\\n    {\\n        $redis = redis();\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid;\\n        $cache = $redis->get($cacheKey);\\n        if ($cache) {\\n            $data = json_decode($cache, true);\\n        } else {\\n            \\/\\/获取目标院校\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $data = [];\\n            $list = $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->order(\'id desc\')\\n                ->select();\\n            if ($list) {\\n                $isDefault = false;\\n                foreach ($list as $lt) {\\n                    if ($lt[\'is_default\']) {\\n                        $targetSchoolMajor = $lt;\\n                        $isDefault = true;\\n                        break;\\n                    }\\n                }\\n                if (!$isDefault) {\\n                    $targetSchoolMajor = $list[0];\\n                }\\n                $targetSchoolMajor = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n                    ->alias(\'cms\')\\n                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n                    ->where(\'cms.id\', $targetSchoolMajor[\'school_major_id\'])\\n                    ->field(\'cms.id as school_major_id, sch.id as school_id, sch.name as school_name, sch.logo as school_logo, ma.id as major_id, ma.name as major_name, ma.code, ma.yjxk_id\')\\n                    ->find();\\n                $data[\'target_school_major\'] = $targetSchoolMajor;\\n\\n                \\/\\/专业映射的三级学科\\n                $yjxkSubject = yjxkSubjectMap::getMajorSubject();\\n                $subjectIds = $yjxkSubject[$targetSchoolMajor[\'yjxk_id\']] ?? [];\\n                if($subjectIds){\\n                    $subjectIds = array_merge($subjectIds,$this->_getSubjectIdsByPids(yjxkSubjectMap::SECOND_SUBJECT_QK));\\n                }else{\\n                    $subjectIds = [yjxkSubjectMap::THIRD_SUBJECT_QK];\\n                }\\n\\n                \\/\\/是否包含真题资料、经验小课、学长学姐\\n                $documentModel = new Document();\\n                $majorId = $targetSchoolMajor[\'major_id\'];\\n                $schoolId = $targetSchoolMajor[\'school_id\'];\\n                $tabs = [];\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 0, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 1,\\n                        \'title\' => \'专业资料\'\\n                    ];\\n                } \\/\\/真题资料\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 1, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 2,\\n                        \'title\' => \'上岸经验\'\\n                    ];\\n                } \\/\\/经验小课\\n                if ($documentModel->ifHasSenior($majorId, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 3,\\n                        \'title\' => \'学长学姐\'\\n                    ];\\n                } \\/\\/学长学姐\\n                $tabs[] = [\\n                    \'typeId\' => 21,\\n                    \'title\' => \'1V1辅导\'\\n                ];\\n                $data[\'tabs\'] = $tabs;\\n            } else {\\n                $subjectIds = $this->_getSubjectIdsByPids([yjxkSubjectMap::SECOND_SUBJECT_ZYK, yjxkSubjectMap::SECOND_SUBJECT_QK]);\\n            }\\n            $data[\'subject_ids\'] = $subjectIds;\\n            $redis->setex($cacheKey, 300, json_encode($data));\\n        }\\n        \\/\\/获取金刚位数据\\n        $findTools = json_decode($redis->get(\'otm_display_userIds\'), true);\\n        $ftools = [];\\n        foreach ($findTools as $tool) {\\n            if (!empty($tool[\'oldurl\'])) {\\n                unset($tool[\'oldurl\']);\\n            }\\n            $tool[\'findId\'] = $tool[\'type\'];\\n            $tool[\'type\'] = 4;\\n            $ftools[$tool[\'findId\']] = $tool;\\n        }\\n        unset($findTools);\\n\\n        $data[\'navigation\'] = [];\\n        $findIndex = [28, 22, 14, 23];\\n        foreach ($findIndex as $ind) {\\n            if (!empty($ftools[$ind])) {\\n                $data[\'navigation\'][] = $ftools[$ind];\\n            }\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function list [目标院校专业列表]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetList()\\n    {\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid;\\n        $cache = redis()->get($cacheKey);\\n        if ($cache) {\\n            $list = json_decode($cache, true);\\n        } else {\\n            $list = $this->userSchoolMajorTargetModel\\n                ->alias(\'usmt\')\\n                ->where(\'user_id\', $this->uid)\\n                ->order(\'id desc\')\\n                ->field(\'school_major_id,is_default\')\\n                ->limit(3)\\n                ->select();\\n            if ($list) {\\n                $schoolMajorIds = array_column($list, \'school_major_id\');\\n                $schoolMajorInfo = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n             
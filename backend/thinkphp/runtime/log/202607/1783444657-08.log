[2026-07-08T01:11:02+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 10 , `seq` = 83 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_01_h2ipAVMWSfgvSPrJC5AF7338\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\admin\\\\model\\\\Admission;\\n6\\tuse app\\\\admin\\\\model\\\\School as ModelSchool;\\n7\\tuse app\\\\admin\\\\model\\\\SchoolMajor;\\n8\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n9\\tuse app\\\\common\\\\model\\\\MajorSchool;\\n10\\tuse app\\\\common\\\\model\\\\School as CommonModelSchool;\\n11\\tuse Exception;\\n12\\tuse think\\\\Db;\\n13\\t\\n14\\t\\/**\\n15\\t * 院校接口\\n16\\t *\\/\\n17\\tclass School extends ApiAuth\\n18\\t{\\n19\\t    protected $noNeedLogin = [\'*\'];\\n20\\t    protected $noNeedRight = [\'*\'];\\n21\\t\\n22\\t    protected $model = null;\\n23\\t    protected $majorModel = null;\\n24\\t    protected $majorSchoolModel = null;\\n25\\t    public function _initialize()\\n26\\t    {\\n27\\t        parent::_initialize();\\n28\\t        $this->model = model(\'School\');\\n29\\t        $this->majorModel = model(\'Major\');\\n30\\t        $this->majorSchoolModel = model(\'MajorSchool\');\\n31\\t    }\\n32\\t\\n33\\t    \\/**\\n34\\t     * Function filter [筛选项]\\n35\\t     * @author erdong\\n36\\t     * @date 2022-10-17\\n37\\t     *\\/\\n38\\t    public function filter()\\n39\\t    {\\n40\\t        $key = \\\"yuanxiao::school::filter\\\";\\n41\\t        $redis = redis();\\n42\\t        $cache = $redis->get($key);\\n43\\t        if ($cache) {\\n44\\t            $filter = json_decode($cache, true);\\n45\\t        } else {\\n46\\t            $filter = [];\\n47\\t            \\/\\/地区\\n48\\t            $area = Db::connect(\'database.yx_db_config\')\\n49\\t                ->name(\'area\')\\n50\\t                ->field(\'id,name\')\\n51\\t                ->where(\'pid\', \'>\', 0)\\n52\\t                ->select();\\n53\\t            $filter[\'area\'] = array_merge([[\'id\' => 0, \'name\' => \'全部\']], $area);\\n54\\t            \\/\\/院校属性\\n55\\t            $adminSchoolModel = new ModelSchool();\\n56\\t            $filter[\'attr\'] = array_values($adminSchoolModel->getSchoolAttr());\\n57\\t            \\/\\/院校类型\\n58\\t            $type = $adminSchoolModel->getType();\\n59\\t            array_unshift($type, \'全部\');\\n60\\t            $filter[\'type\'] = array_values($type);\\n61\\t            \\/\\/院校隶属\\n62\\t            $lishu = $adminSchoolModel->getLishu();\\n63\\t            array_unshift($lishu, \'全部\');\\n64\\t            $filter[\'lishu\'] = array_values($lishu);\\n65\\t            $redis->setex($key, 86400 * 30, json_encode($filter));\\n66\\t        }\\n67\\t        $this->success(\'success\', $filter);\\n68\\t    }\\n69\\t\\n70\\t    \\/**\\n71\\t     * Function list [院校列表]\\n72\\t     * @author erdong\\n73\\t     * @date 2022-09-29\\n74\\t     *\\/\\n75\\t    public function list()\\n76\\t    {\\n77\\t        $areaId = input(\'area_id\\/d\', 0);\\n78\\t        $keyword = input(\'keyword\\/s\', \'\', \'strip_tags,trim\');\\n79\\t        $attr = input(\'attr\\/s\', \'全部\');\\n80\\t        $type = input(\'type\\/s\', \'全部\');\\n81\\t        $lishu = input(\'lishu\\/s\', \'全部\');\\n82\\t        $majorId = input(\'major_id\\/d\', 0);\\n83\\t        $isFull = input(\'is_full\', \'全部\');\\n84\\t        $page = input(\'page\\/d\', 1);\\n85\\t        $pageSize = input(\'pagesize\', 15);\\n86\\t        $isRepeat = input(\'is_repeat\\/d\', 0);\\n87\\t        $where = [];\\n88\\t        \\/\\/关键词搜索\\n89\\t        if (!empty($keyword)) {\\n90\\t            if($isRepeat == -1){\\n91\\t                $where[\'sch.name\'] = [\'like\', $keyword . \'%\'];\\n92\\t            }else{\\n93\\t                $where[\'name\'] = [\'like\', $keyword . \'%\'];\\n94\\t            }\\n95\\t        }\\n96\\t        \\/\\/地区\\n97\\t        if ($areaId) {\\n98\\t            $where[\'area_id\'] = $areaId;\\n99\\t        }\\n100\\t        \\/\\/类型\\n101\\t        if ($type != \'全部\') {\\n102\\t            $where[\'type\'] = $type;\\n103\\t        }\\n104\\t        \\/\\/隶属\\n105\\t        if ($lishu != \'全部\') {\\n106\\t            $where[\'lishu\'] = $lishu;\\n107\\t        }\\n108\\t        if ($attr != \'全部\') {\\n109\\t            $where[] = [\'EXP\', Db::raw(\'FIND_IN_SET(\\\"\' . $attr . \'\\\",school_attr)\')];\\n110\\t        }\\n111\\t        $data[\'list\'] = [];\\n112\\t        if ($majorId) { \\/\\/专业院校列表\\n113\\t            $where[\'ms.major_id\'] = $majorId;\\n114\\t            if ($isFull != \'全部\') {\\n115\\t                $where[\'ms.is_full\'] = $isFull;\\n116\\t            }\\n117\\t            if($isRepeat == -1){\\n118\\t                $total = $this->majorSchoolModel\\n119\\t                    ->alias(\'ms\')\\n120\\t                    ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n121\\t                    ->where($where)\\n122\\t                    ->group(\'ms.school_id\')\\n123\\t                    ->count();\\n124\\t            }else{\\n125\\t                $total = $this->majorSchoolModel\\n126\\t                    ->alias(\'ms\')\\n127\\t                    ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n128\\t                    ->where($where)\\n129\\t                    ->count();\\n130\\t            }\\n131\\t\\n132\\t\\n133\\t            if ($total) {\\n134\\t                $offset = ($page - 1) * $pageSize;\\n135\\t                if($isRepeat == -1){\\n136\\t                    $list = $this->majorSchoolModel\\n137\\t                        ->alias(\'ms\')\\n138\\t                        ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n139\\t                        ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n140\\t                        ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n141\\t                        ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n142\\t                        ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n143\\t                        ->field(\'ms.id as major_school_id, ms.school_id, sch.name as school_name, ms.is_full, yx.name as yuanxi_name, yjxk.name as yjxk_name, IFNULL(subject_assessment,100) as subject_assessment\')\\n144\\t                        ->where($where)\\n145\\t                        ->group(\'ms.school_id\')\\n146\\t                        ->limit($offset, $pageSize)\\n147\\t                        ->select();\\n148\\t                }else{\\n149\\t                    $list = $this->majorSchoolModel\\n150\\t                        ->alias(\'ms\')\\n151\\t                        ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n152\\t                        ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n153\\t                        ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n154\\t                        ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n155\\t                        ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n156\\t                        ->field(\'ms.id as major_school_id, ms.school_id, sch.name as school_name, ms.is_full, yx.name as yuanxi_name, yjxk.name as yjxk_name, IFNULL(subject_assessment,100) as subject_assessment\')\\n157\\t                        ->where($where)\\n158\\t                        ->limit($offset, $pageSize)\\n159\\t                        ->select();\\n160\\t                }\\n161\\t\\n162\\t                if ($list) {\\n163\\t                    $adminSchoolMajor = new SchoolMajor();\\n164\\t                    foreach ($list as &$item) {\\n165\\t                        $item[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n166\\t                    }\\n167\\t                }\\n168\\t                $data[\'list\'] = $list;\\n169\\t            }\\n170\\t        } else {\\n171\\t            $total = $this->model\\n172\\t                ->where($where)\\n173\\t                ->count();\\n174\\t\\n175\\t            if ($total) {\\n176\\t                $offset = ($page - 1) * $pageSize;\\n177\\t                $list = $this->model\\n178\\t                    ->where($where)\\n179\\t                    ->field(\'id as school_id,code,name as school_name,logo as school_logo\')\\n180\\t                    ->order(\'id asc\')\\n181\\t                    ->limit($offset, $pageSize)\\n182\\t                    ->select();\\n183\\t                if ($list) foreach ($list as &$item) {\\n184\\t                    $item[\'school_logo\'] = CommonModelSchool::schoolLogo($item[\'school_logo\']);\\n185\\t                }\\n186\\t\\n187\\t                $data[\'list\'] = $list;\\n188\\t            }\\n189\\t        }\\n190\\t        $data[\'total_page\'] = ceil($total \\/ $pageSize);\\n191\\t        $data[\'total\'] = $total;\\n192\\t        $data[\'page_size\'] = $pageSize;\\n193\\t\\n194\\t        $this->success(\'success\', $data);\\n195\\t    }\\n196\\t\\n197\\t    \\/**\\n198\\t     * Function index [院校主页]\\n199\\t     * @author erdong\\n200\\t     * @date 2022-09-29\\n201\\t     *\\/\\n202\\t    public function index()\\n203\\t    {\\n204\\t        $schoolId = input(\'school_id\\/d\', 0);\\n205\\t        if (!$schoolId) {\\n206\\t            $this->error(\'参数错误\');\\n207\\t        }\\n208\\t        \\/\\/基本信息\\n209\\t        $data = $this->model\\n210\\t            ->where(\'id\', $schoolId)\\n211\\t            ->field(\'id as school_id,name as school_name,logo as school_logo,school_attr,type,lishu,tel,email\')\\n212\\t            ->find();\\n213\\t\\n214\\t        $data[\'school_logo\'] = CommonModelSchool::schoolLogo($data[\'school_logo\']);\\n215\\t        \\n216\\t        \\/\\/优势专业\\n217\\t        $where = [\\n218\\t            \'ms.school_id\' => $schoolId,\\n219\\t        ];\\n220\\t\\n221\\t        $majorList = $this->majorModel\\n222\\t            ->alias(\'m\')\\n223\\t            ->join(\'cl_major_school ms\', \'m.id = ms.major_id\', \'LEFT\')\\n224\\t            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n225\\t            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n226\\t            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n227\\t            ->field(\'m.name as major_name, m.id as major_id, ms.id as major_school_id, m.code, ms.is_full, IFNULL(subject_assessment,100) as subject_assessment, yx.name as yx_name, yjxk.name as yjxk_name\')\\n228\\t            ->where($where)\\n229\\t            ->order(\'subject_assessment asc,m.id asc\')\\n230\\t            ->select();\\n231\\t        $majors = array_slice($majorList, 0, 3);\\n232\\t\\n233\\t        if ($majors) {\\n234\\t            $adminSchoolMajor = new SchoolMajor();\\n235\\t            $topCount = 0;\\n236\\t            foreach ($majors as &$item) {\\n237\\t                $subjectAssessment = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n238\\t                if ($subjectAssessment != \'无\') {\\n239\\t                    $topCount++;\\n240\\t                }\\n241\\t                $item[\'subject_assessment\'] = $subjectAssessment;\\n242\\t            }\\n243\\t        }\\n244\\t        $data[\'major_title\'] = $topCount >= 3 ? \'优势专业\' : \'专业目录\';\\n245\\t        $data[\'major_count\'] = count($majorList);\\n246\\t        $data[\'majors\'] = $majors;\\n247\\t\\n248\\t        \\/\\/招生简章\\n249\\t        $admissionModel = new Admission();\\n250\\t        $data[\'zsjz\'] = $admissionModel->getListBySchool($schoolId);\\n251\\t\\n252\\t        \\/\\/学院\\n253\\t        $data[\'yuanxi\'] = Db::connect(\'database.yx_db_config\')\\n254\\t            ->name(\'cl_major_school\')\\n255\\t            ->alias(\'cms\')\\n256\\t            ->join(\'cl_yuanxi cy\', \'cms.yuanxi_id = cy.id\', \'LEFT\')\\n257\\t            ->field(\'cy.id as yuanxi_id,cy.name as yuanxi_name,COUNT(cms.id) as major_count\')\\n258\\t            ->where(\'cms.school_id\', $schoolId)\\n259\\t            ->group(\'cms.yuanxi_id\')\\n260\\t            ->select();\\n261\\t\\n262\\t        $this->success(\'success\', $data);\\n263\\t    }\\n264\\t\\n265\\t    \\/**\\n266\\t     * Function introduce [院校介绍]\\n267\\t     * @author erdong\\n268\\t     * @date 2022-10-10\\n269\\t     *\\/\\n270\\t    public function introduce()\\n271\\t    {\\n272\\t        $schoolId = input(\'school_id\\/d\', 0);\\n273\\t        if (!$schoolId) {\\n274\\t            $this->error(\'参数错误\');\\n275\\t        }\\n276\\t        $data = [];\\n277\\t        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n278\\t        if ($schoolInfo) {\\n279\\t            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n280\\t            $data[\'school_name\'] = $schoolInfo[\'school_name\'];\\n281\\t            $data[\'address\'] = $schoolInfo[\'address\'];\\n282\\t            $data[\'introduce\'] = $schoolInfo[\'xxjs\'];\\n283\\t        }\\n284\\t        $data[\'school_logo\'] = CommonModelSchool::schoolLogo($data[\'school_logo\']);\\n285\\t        $this->success(\'success\', $data);\\n286\\t    }\\n287\\t\\n288\\t    \\/**\\n289\\t     * Function zsjzList [招生简章列表]\\n290\\t     * @author erdong\\n291\\t     * @date 2022-10-11\\n292\\t     *\\/\\n293\\t    public function zsjzList()\\n294\\t    {\\n295\\t        $schoolId = input(\'school_id\\/d\', 0);\\n296\\t        if (!$schoolId) {\\n297\\t            $this->error(\'参数错误\');\\n298\\t        }\\n299\\t        $data = [];\\n300\\t        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n301\\t        if ($schoolInfo) {\\n302\\t            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n303\\t            $data[\'school_name\'] = $schoolInfo[\'school_name\'];\\n304\\t            $admissionModel = new Admission();\\n305\\t            $field = \'year,title,zsjz as content\';\\n306\\t            $data[\'zsjz_list\'] = $admissionModel->getListBySchool($schoolId, $field, 100);\\n307\\t        }\\n308\\t        $this->success(\'success\', $data);\\n309\\t    }\\n310\\t}\\n311\\t\"}]},\"parent_tool_use_id\":\"call_00_aQPH51Kq0V2SHHCt5Wim9371\",\"session_id\":\"709785dc-e16e-484f-9922-07c4f799ccb4\",\"uuid\":\"32b8f981-eb76-4e73-81a8-991d24705101\",\"timestamp\":\"2026-07-07T17:11:02.361Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Explore project structure for API dev plan\"}' , `created_at` = '2026-07-08 01:11:02' [ RunTime:0.002805s ]

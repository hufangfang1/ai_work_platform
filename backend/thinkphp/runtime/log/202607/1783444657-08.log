 $type;\\n48\\t        }\\n49\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_yjxk\')\\n50\\t            ->where($where)\\n51\\t            ->group(\'menlei,name\')\\n52\\t            ->select();\\n53\\t        $sort = [\\n54\\t            \'哲学\',\\n55\\t            \'经济学\',\\n56\\t            \'法学\',\\n57\\t            \'教育学\',\\n58\\t            \'文学\',\\n59\\t            \'历史学\',\\n60\\t            \'理学\',\\n61\\t            \'工学\',\\n62\\t            \'农学\',\\n63\\t            \'医学\',\\n64\\t            \'军事学\',\\n65\\t            \'管理学\',\\n66\\t            \'艺术学\',\\n67\\t            \'交叉学科\'\\n68\\t        ];\\n69\\t        $list = listToTree($list, [\'menlei\', \'name\']);\\n70\\t        $sortList = [];\\n71\\t        foreach ($sort as $k => $v) {\\n72\\t            foreach ($list as $kk => $vv) {\\n73\\t                if ($v == $vv[\'name\']) {\\n74\\t                    $sortList[] = $vv;\\n75\\t                }\\n76\\t            }\\n77\\t        }\\n78\\t        $list = $sortList;\\n79\\t        $majorlist = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n80\\t            ->order(\'code\')\\n81\\t            ->column(\'id,name,code,yjxk_id\');\\n82\\t        if ($needTags) {\\n83\\t            $havTagsMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n84\\t                ->where(\'tags\', \'<>\', \'\')\\n85\\t                ->column(\'major_id\');\\n86\\t            $havTagsMajor = array_unique($havTagsMajor);\\n87\\t            foreach ($majorlist as $k => $v) {\\n88\\t                if (!in_array($v[\'id\'], $havTagsMajor)) {\\n89\\t                    unset($majorlist[$k]);\\n90\\t                }\\n91\\t            }\\n92\\t        }\\n93\\t\\n94\\t        foreach ($list as $k => $v) {\\n95\\t            foreach ($v[\'list\'] as $kk => $vv) {\\n96\\t                $item = [];\\n97\\t                $vv[\'list\'] = [];\\n98\\t                foreach ($majorlist as $kkk => $vvv) {\\n99\\t                    $item[\'name\'] = $vvv[\'name\'];\\n100\\t                    $item[\'code\'] = $vvv[\'code\'];\\n101\\t                    $item[\'value\'] = $vvv[\'id\'];\\n102\\t                    if ($vvv[\'yjxk_id\'] == $vv[\'value\']) {\\n103\\t                        $vv[\'list\'][$vvv[\'yjxk_id\']][] = $item;\\n104\\t                    }\\n105\\t                }\\n106\\t                $v[\'list\'][$kk] = $vv;\\n107\\t            }\\n108\\t            $list[$k] = $v;\\n109\\t        }\\n110\\t        foreach ($list as $k => $v) {\\n111\\t            foreach ($v[\'list\'] as $kk => $vv) {\\n112\\t                $list[$k][\'list\'][$kk][\'list\'] = array_values($vv[\'list\'])[0] ?? [];\\n113\\t                if (empty($list[$k][\'list\'][$kk][\'list\'])) {\\n114\\t                    unset($list[$k][\'list\'][$kk]);\\n115\\t                }\\n116\\t                if (empty($list[$k][\'list\'])) {\\n117\\t                    unset($list[$k]);\\n118\\t                }\\n119\\t            }\\n120\\t            if (!empty($list[$k][\'list\'])) {\\n121\\t                $list[$k][\'list\'] = array_values($list[$k][\'list\']);\\n122\\t            }\\n123\\t        }\\n124\\t        $this->success(\'success\', array_values($list));\\n125\\t    }\\n126\\t\\n127\\t    \\/**\\n128\\t     * desc:学校列表\\n129\\t     * author:hufangfang\\n130\\t     * data:2023\\/1\\/12 16:03\\n131\\t     * @return void\\n132\\t     * @throws Exception\\n133\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n134\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n135\\t     * @throws \\\\think\\\\exception\\\\DbException\\n136\\t     *\\/\\n137\\t    public function school()\\n138\\t    {\\n139\\t        $attr = input(\'attr\\/s\', \'\');\\n140\\t        $majorId = input(\'major_id\\/d\', 0);\\n141\\t        $areaId = input(\'area_id\\/d\', 0);\\n142\\t        $yjxkId = input(\'yjxk_id\\/d\', 0);\\n143\\t        $type = input(\'type\', 
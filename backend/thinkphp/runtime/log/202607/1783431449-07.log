ajor/targetList\\\");\\nRoute::rule(\\\"/api/major/user-target/add-or-del\\\", \\\"api/AppMajor/addOrDelTarget\\\");\\nRoute::rule(\\\"/api/major/user-target/index\\\", \\\"api/AppMajor/targetIndex\\\");\\nRoute::rule(\\\"/api/major/user-target/set-default\\\", \\\"api/AppMajor/targetSetDefault\\\");\\nRoute::rule(\\\"/api/major/user-target/1v1\\\", \\\"api/AppMajor/target1v1\\\");\\n// 估分\\nRoute::rule(\\\"/api/user/assessment\\\", \\\"api/User/assessmentSubject\\\");\\nRoute::rule(\\\"/api/user/set-assessment\\\", \\\"api/User/assessmentConf\\\");\\nRoute::rule(\\\"/api/user/set-assessment-tiku-score\\\", \\\"api/User/assessmentTikuScoreSet\\\");\\nRoute::rule(\\\"/api/user/set-assessment-score\\\", \\\"api/User/assessmentScoreSet\\\");\\n// 冒泡排序接口\\nRoute::rule(\\\"/api/sort/bubble\\\", \\\"api/Sort/bubble\\\");\\n\",\"numLines\":21,\"startLine\":1,\"totalLines\":21}}}

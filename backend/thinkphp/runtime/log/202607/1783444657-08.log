[2026-07-08T01:16:54+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 12 , `seq` = 23 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_00_5wv9B8ATxuDjF0tHbyeo1662\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n6\\tuse app\\\\common\\\\model\\\\Document;\\n7\\tuse app\\\\common\\\\model\\\\MajorSchool;\\n8\\tuse Exception;\\n9\\tuse think\\\\Db;\\n10\\tuse yjxkSubjectMap;\\n11\\t\\n12\\t\\/**\\n13\\t * app专业接口\\n14\\t *\\/\\n15\\tclass AppMajor extends ApiAuth\\n16\\t{\\n17\\t    protected $noNeedLogin = [];\\n18\\t    protected $noNeedRight = [];\\n19\\t\\n20\\t    protected $majorSchoolModel = null;\\n21\\t    protected $userSchoolMajorTargetModel = null;\\n22\\t    protected $uid;\\n23\\t    public function _initialize()\\n24\\t    {\\n25\\t        parent::_initialize();\\n26\\t        $this->uid = session(\'uid\') ?? 0;\\n27\\t        $this->majorSchoolModel = new MajorSchool();\\n28\\t        $this->userSchoolMajorTargetModel = model(\'UserSchoolMajorTarget\');\\n29\\t    }\\n30\\t\\n31\\t    \\/**\\n32\\t     * Function targetIndex [院校规划首页]\\n33\\t     * @author erdong\\n34\\t     * @date 2023-03-08\\n35\\t     *\\/\\n36\\t    public function targetIndex()\\n37\\t    {\\n38\\t        $redis = redis();\\n39\\t        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid;\\n40\\t        $cache = $redis->get($cacheKey);\\n41\\t        if ($cache) {\\n42\\t            $data = json_decode($cache, true);\\n43\\t        } else {\\n44\\t            \\/\\/获取目标院校\\n45\\t            $where = [\\n46\\t                \'user_id\' => $this->uid,\\n47\\t            ];\\n48\\t            $data = [];\\n49\\t            $list = $this->userSchoolMajorTargetModel\\n50\\t                ->where($where)\\n51\\t                ->order(\'id desc\')\\n52\\t                ->select();\\n53\\t            if ($list) {\\n54\\t                $isDefault = false;\\n55\\t                foreach ($list as $lt) {\\n56\\t                    if ($lt[\'is_default\']) {\\n57\\t                        $targetSchoolMajor = $lt;\\n58\\t                        $isDefault = true;\\n59\\t                        break;\\n60\\t                    }\\n61\\t                }\\n62\\t                if (!$isDefault) {\\n63\\t                    $targetSchoolMajor = $list[0];\\n64\\t                }\\n65\\t                $targetSchoolMajor = Db::connect(\'database.yx_db_config\')\\n66\\t                    ->name(\'cl_major_school\')\\n67\\t                    ->alias(\'cms\')\\n68\\t                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n69\\t                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n70\\t                    ->where(\'cms.id\', $targetSchoolMajor[\'school_major_id\'])\\n71\\t                    ->field(\'cms.id as school_major_id, sch.id as school_id, sch.name as school_name, sch.logo as school_logo, ma.id as major_id, ma.name as major_name, ma.code, ma.yjxk_id\')\\n72\\t                    ->find();\\n73\\t                $data[\'target_school_major\'] = $targetSchoolMajor;\\n74\\t\\n75\\t                \\/\\/专业映射的三级学科\\n76\\t                $yjxkSubject = yjxkSubjectMap::getMajorSubject();\\n77\\t                $subjectIds = $yjxkSubject[$targetSchoolMajor[\'yjxk_id\']] ?? [];\\n78\\t                if($subjectIds){\\n79\\t                    $subjectIds = array_merge($subjectIds,$this->_getSubjectIdsByPids(yjxkSubjectMap::SECOND_SUBJECT_QK));\\n80\\t                }else{\\n81\\t                    $subjectIds = [yjxkSubjectMap::THIRD_SUBJECT_QK];\\n82\\t                }\\n83\\t\\n84\\t                \\/\\/是否包含真题资料、经验小课、学长学姐\\n85\\t                $documentModel = new Document();\\n86\\t                $majorId = $targetSchoolMajor[\'major_id\'];\\n87\\t                $schoolId = $targetSchoolMajor[\'school_id\'];\\n88\\t                $tabs = [];\\n89\\t                if ($documentModel->ifHasDocsOrTalk($majorId, 0, $schoolId)) {\\n90\\t                    $tabs[] = [\\n91\\t                        \'typeId\' => 1,\\n92\\t                        \'title\' => \'专业资料\'\\n93\\t                    ];\\n94\\t                } \\/\\/真题资料\\n95\\t                if ($documentModel->ifHasDocsOrTalk($majorId, 1, $schoolId)) {\\n96\\t                    $tabs[] = [\\n97\\t                        \'typeId\' => 2,\\n98\\t                        \'title\' => \'上岸经验\'\\n99\\t                    ];\\n100\\t                } \\/\\/经验小课\\n101\\t                if ($documentModel->ifHasSenior($majorId, $schoolId)) {\\n102\\t                    $tabs[] = [\\n103\\t                        \'typeId\' => 3,\\n104\\t                        \'title\' => \'学长学姐\'\\n105\\t                    ];\\n106\\t                } \\/\\/学长学姐\\n107\\t                $tabs[] = [\\n108\\t                    \'typeId\' => 21,\\n109\\t                    \'title\' => \'1V1辅导\'\\n110\\t                ];\\n111\\t                $data[\'tabs\'] = $tabs;\\n112\\t            } else {\\n113\\t                $subjectIds = $this->_getSubjectIdsByPids([yjxkSubjectMap::SECOND_SUBJECT_ZYK, yjxkSubjectMap::SECOND_SUBJECT_QK]);\\n114\\t            }\\n115\\t            $data[\'subject_ids\'] = $subjectIds;\\n116\\t            $redis->setex($cacheKey, 300, json_encode($data));\\n117\\t        }\\n118\\t        \\/\\/获取金刚位数据\\n119\\t        $findTools = json_decode($redis->get(\'otm_display_userIds\'), true);\\n120\\t        $ftools = [];\\n121\\t        foreach ($findTools as $tool) {\\n122\\t            if (!empty($tool[\'oldurl\'])) {\\n123\\t                unset($tool[\'oldurl\']);\\n124\\t            }\\n125\\t            $tool[\'findId\'] = $tool[\'type\'];\\n126\\t            $tool[\'type\'] = 4;\\n127\\t            $ftools[$tool[\'findId\']] = $tool;\\n128\\t        }\\n129\\t        unset($findTools);\\n130\\t\\n131\\t        $data[\'navigation\'] = [];\\n132\\t        $findIndex = [28, 22, 14, 23];\\n133\\t        foreach ($findIndex as $ind) {\\n134\\t            if (!empty($ftools[$ind])) {\\n135\\t                $data[\'navigation\'][] = $ftools[$ind];\\n136\\t            }\\n137\\t        }\\n138\\t        $this->success(\'success\', $data);\\n139\\t    }\\n140\\t\\n141\\t    \\/**\\n142\\t     * Function list [目标院校专业列表]\\n143\\t     * @author erdong\\n144\\t     * @date 2023-03-07\\n145\\t     *\\/\\n146\\t    public function targetList()\\n147\\t    {\\n148\\t        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid;\\n149\\t        $cache = redis()->get($cacheKey);\\n150\\t        if ($cache) {\\n151\\t            $list = json_decode($cache, true);\\n152\\t        } else {\\n153\\t            $list = $this->userSchoolMajorTargetModel\\n154\\t                ->alias(\'usmt\')\\n155\\t                ->where(\'user_id\', $this->uid)\\n156\\t                ->order(\'id desc\')\\n157\\t                ->field(\'school_major_id,is_default\')\\n158\\t                ->limit(3)\\n159\\t                ->select();\\n160\\t            if ($list) {\\n161\\t                $schoolMajorIds = array_column($list, \'school_major_id\');\\n162\\t                $schoolMajorInfo = Db::connect(\'database.yx_db_config\')\\n163\\t                    ->name(\'cl_major_school\')\\n164\\t                    ->alias(\'cms\')\\n165\\t                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n166\\t                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n167\\t                    ->whereIn(\'cms.id\', $schoolMajorIds)\\n168\\t                    ->column(\'cms.id, sch.id as school_id, sch.logo as school_logo, sch.name as school_name, ma.id as major_id, ma.name as major_name\');\\n169\\t                $hasDefault = false;\\n170\\t                foreach ($list as &$lt) {\\n171\\t                    if ($lt[\'is_default\']) {\\n172\\t                        $hasDefault = true;\\n173\\t                    }\\n174\\t                    $lt[\'school_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_name\'];\\n175\\t                    $lt[\'major_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_name\'];\\n176\\t                    $lt[\'school_logo\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_logo\'];\\n177\\t                    $lt[\'school_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_id\'];\\n178\\t                    $lt[\'major_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_id\'];\\n179\\t                }\\n180\\t                if (!$hasDefault) {\\n181\\t                    $list[0][\'is_default\'] = 1;\\n182\\t                }\\n183\\t                redis()->setex($cacheKey, 86400, json_encode($list));\\n184\\t            }\\n185\\t        }\\n186\\t        $this->success(\'success\', $list);\\n187\\t    }\\n188\\t\\n189\\t    \\/**\\n190\\t     * Function addOrDelTarget [添加\\/删除目标专业]\\n191\\t     * @author erdong\\n192\\t     * @date 2023-03-07\\n193\\t     *\\/\\n194\\t    public function addOrDelTarget()\\n195\\t    {\\n196\\t        $schoolId = input(\'school_id\\/d\', 0);\\n197\\t        $majorId = input(\'major_id\\/d\', 0);\\n198\\t        $action = input(\'action\\/d\', 0); \\/\\/操作 0 新增 1 删除 2 编辑\\n199\\t        $oldschoolMajorId = input(\'school_major_id\\/d\', 0);\\n200\\t        if ($action > 0 && !$oldschoolMajorId) {\\n201\\t            $this->error(\\\"参数错误【school_major_id】\\\");\\n202\\t        }\\n203\\t        try {\\n204\\t            Db::startTrans();\\n205\\t            $where[\'user_id\'] = $this->uid;\\n206\\t            if ($action == 1) { \\/\\/删除\\n207\\t                $this->userSchoolMajorTargetModel\\n208\\t                    ->where($where)\\n209\\t                    ->where(\'school_major_id\', $oldschoolMajorId)\\n210\\t                    ->delete();\\n211\\t            } else {\\n212\\t                $newSchoolMajorId = $this->majorSchoolModel\\n213\\t                    ->where(\'school_id\', $schoolId)\\n214\\t                    ->where(\'major_id\', $majorId)\\n215\\t                    ->value(\'id\');\\n216\\t                if (!$newSchoolMajorId) {\\n217\\t                    $this->error(\'不存在的院校专业\');\\n218\\t                }\\n219\\t                $insertData = [\\n220\\t                    \'user_id\' => $this->uid,\\n221\\t                    \'school_major_id\' => $newSchoolMajorId,\\n222\\t                    \'is_default\' => 1,\\n223\\t                    \'create_time\' => time()\\n224\\t                ];\\n225\\t                $this->userSchoolMajorTargetModel\\n226\\t                    ->where($where)\\n227\\t                    ->update([\'is_default\' => 0]);\\n228\\t                if (!$action) { \\/\\/新增\\n229\\t                    $list = $this->userSchoolMajorTargetModel\\n230\\t                        ->where($where)\\n231\\t                        ->column(\'school_major_id\');\\n232\\t                    if (count($list) >= 3) {\\n233\\t                        $this->error(\'不要贪多，最多可以添加3个目标院校哦\');\\n234\\t                    } else {\\n235\\t                        if (!empty($list) && in_array($newSchoolMajorId, $list)) {\\n236\\t                            $this->error(\'请勿重复设置\');\\n237\\t                        } else {\\n238\\t                            $this->userSchoolMajorTargetModel->insert($insertData);\\n239\\t                        }\\n240\\t                    }\\n241\\t                } else {\\n242\\t                    $this->userSchoolMajorTargetModel\\n243\\t                        ->where($where)\\n244\\t                        ->where(\'school_major_id\', $oldschoolMajorId)\\n245\\t                        ->delete();\\n246\\t                    $this->userSchoolMajorTargetModel->insert($insertData);\\n247\\t                }\\n248\\t            }\\n249\\t            Db::commit();\\n250\\t        } catch (Exception $e) {\\n251\\t            Db::rollback();\\n252\\t            $this->error(\'fail\');\\n253\\t        }\\n254\\t        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n255\\t        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n256\\t        $this->success(\'success\');\\n257\\t    }\\n258\\t\\n259\\t    \\/**\\n260\\t     * Function majorTargetSetDefault [设置默认目标院校专业]\\n261\\t     * @author erdong\\n262\\t     * @date 2023-03-07\\n263\\t     *\\/\\n264\\t    public function targetSetDefault()\\n265\\t    {\\n266\\t        $schoolMajorId = input(\'school_major_id\\/d\', 0);\\n267\\t        try {\\n268\\t            $where = [\\n269\\t                \'user_id\' => $this->uid,\\n270\\t            ];\\n271\\t            $this->userSchoolMajorTargetModel->startTrans();\\n272\\t            \\/\\/取消默认\\n273\\t            $this->userSchoolMajorTargetModel\\n274\\t                ->where($where)\\n275\\t                ->update([\'is_default\' => 0]);\\n276\\t            \\/\\/设置默认\\n277\\t            $this->userSchoolMajorTargetModel\\n278\\t                ->where($where)\\n279\\t                ->where(\'school_major_id\', $schoolMajorId)\\n280\\t                ->update([\'is_default\' => 1]);\\n281\\t            $this->userSchoolMajorTargetModel->commit();\\n282\\t            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n283\\t            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n284\\t        } catch (Exception $e) {\\n285\\t            $this->userSchoolMajorTargetModel->roolback();\\n286\\t            $this->error(\'fail\');\\n287\\t        }\\n288\\t        $this->success(\'success\');\\n289\\t    }\\n290\\t\\n291\\t    \\/**\\n292\\t     * Function target1v1 [1v1辅导]\\n293\\t     * @author erdong\\n294\\t     * @date 2023-03-08\\n295\\t     *\\/\\n296\\t    public function target1v1()\\n297\\t    {\\n298\\t        $data = [\\n299\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/02.jpg\\\",\\n300\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/03.jpg\\\",\\n301\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/04.jpg\\\",\\n302\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/05.jpg\\\",\\n303\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/06.jpg\\\",\\n304\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/07.jpg\\\"\\n305\\t        ];\\n306\\t        $this->success(\'success\', $data);\\n307\\t    }\\n308\\t\\n309\\t    \\/**\\n310\\t     * Function _getSubjectIdsByPids [获取三级学科id]\\n311\\t     * @author erdong\\n312\\t     * @date 2023-03-09\\n313\\t     *\\/\\n314\\t    public function _getSubjectIdsByPids($pids)\\n315\\t    {\\n316\\t        $subjectIds = Db::connect(\'database.auth_db_config\')\\n317\\t            ->table(\'cl_subject\')\\n318\\t            ->whereIn(\'pid\', $pids)\\n319\\t            ->where(\'status\', 1)\\n320\\t            ->column(\'id\');\\n321\\t        return $subjectIds;\\n322\\t    }\\n323\\t}\\n324\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"37dc5757-0222-4939-8ad9-8622b84ce140\",\"uuid\":\"ef09d5d0-9ee8-411f-8b4e-6bc6384d96eb\",\"timestamp\":\"2026-07-07T17:16:53.989Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/wt-task-2\\/application\\/api\\/controller\\/AppMajor.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\common\\\\model\\\\Document;\\nuse app\\\\common\\\\model\\\\MajorSchool;\\nuse Exception;\\nuse think\\\\Db;\\nuse yjxkSubjectMap;\\n\\n\\/**\\n * app专业接口\\n *\\/\\nclass AppMajor extends ApiAuth\\n{\\n    protected $noNeedLogin = [];\\n    protected $noNeedRight = [];\\n\\n    protected $majorSchoolModel = null;\\n    protected $userSchoolMajorTargetModel = null;\\n    protected $uid;\\n    public function _initialize()\\n    {\\n        parent::_initialize();\\n        $this->uid = session(\'uid\') ?? 0;\\n        $this->majorSchoolModel = new MajorSchool();\\n        $this->userSchoolMajorTargetModel = model(\'UserSchoolMajorTarget\');\\n    }\\n\\n    \\/**\\n     * Function targetIndex [院校规划首页]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function targetIndex()\\n    {\\n        $redis = redis();\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid;\\n        $cache = $redis->get($cacheKey);\\n        if ($cache) {\\n            $data = json_decode($cache, true);\\n        } else {\\n            \\/\\/获取目标院校\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $data = [];\\n            $list = $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->order(\'id desc\')\\n                ->select();\\n            if ($list) {\\n                $isDefault = false;\\n                foreach ($list as $lt) {\\n                    if ($lt[\'is_default\']) {\\n                        $targetSchoolMajor = $lt;\\n                        $isDefault = true;\\n                        break;\\n                    }\\n                }\\n                if (!$isDefault) {\\n                    $targetSchoolMajor = $list[0];\\n                }\\n                $targetSchoolMajor = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n                    ->alias(\'cms\')\\n                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n                    ->where(\'cms.id\', $targetSchoolMajor[\'school_major_id\'])\\n                    ->field(\'cms.id as school_major_id, sch.id as school_id, sch.name as school_name, sch.logo as school_logo, ma.id as major_id, ma.name as major_name, ma.code, ma.yjxk_id\')\\n                    ->find();\\n                $data[\'target_school_major\'] = $targetSchoolMajor;\\n\\n                \\/\\/专业映射的三级学科\\n                $yjxkSubject = yjxkSubjectMap::getMajorSubject();\\n                $subjectIds = $yjxkSubject[$targetSchoolMajor[\'yjxk_id\']] ?? [];\\n                if($subjectIds){\\n                    $subjectIds = array_merge($subjectIds,$this->_getSubjectIdsByPids(yjxkSubjectMap::SECOND_SUBJECT_QK));\\n                }else{\\n                    $subjectIds = [yjxkSubjectMap::THIRD_SUBJECT_QK];\\n                }\\n\\n                \\/\\/是否包含真题资料、经验小课、学长学姐\\n                $documentModel = new Document();\\n                $majorId = $targetSchoolMajor[\'major_id\'];\\n                $schoolId = $targetSchoolMajor[\'school_id\'];\\n                $tabs = [];\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 0, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 1,\\n                        \'title\' => \'专业资料\'\\n                    ];\\n                } \\/\\/真题资料\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 1, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 2,\\n                        \'title\' => \'上岸经验\'\\n                    ];\\n                } \\/\\/经验小课\\n                if ($documentModel->ifHasSenior($majorId, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 3,\\n                        \'title\' => \'学长学姐\'\\n                    ];\\n                } \\/\\/学长学姐\\n                $tabs[] = [\\n                    \'typeId\' => 21,\\n                    \'title\' => \'1V1辅导\'\\n                ];\\n                $data[\'tabs\'] = $tabs;\\n            } else {\\n                $subjectIds = $this->_getSubjectIdsByPids([yjxkSubjectMap::SECOND_SUBJECT_ZYK, yjxkSubjectMap::SECOND_SUBJECT_QK]);\\n            }\\n            $data[\'subject_ids\'] = $subjectIds;\\n            $redis->setex($cacheKey, 300, json_encode($data));\\n        }\\n        \\/\\/获取金刚位数据\\n        $findTools = json_decode($redis->get(\'otm_display_userIds\'), true);\\n        $ftools = [];\\n        foreach ($findTools as $tool) {\\n            if (!empty($tool[\'oldurl\'])) {\\n                unset($tool[\'oldurl\']);\\n            }\\n            $tool[\'findId\'] = $tool[\'type\'];\\n            $tool[\'type\'] = 4;\\n            $ftools[$tool[\'findId\']] = $tool;\\n        }\\n        unset($findTools);\\n\\n        $data[\'navigation\'] = [];\\n        $findIndex = [28, 22, 14, 23];\\n        foreach ($findIndex as $ind) {\\n            if (!empty($ftools[$ind])) {\\n                $data[\'navigation\'][] = $ftools[$ind];\\n            }\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function list [目标院校专业列表]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetList()\\n    {\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid;\\n        $cache = redis()->get($cacheKey);\\n        if ($cache) {\\n            $list = json_decode($cache, true);\\n        } else {\\n            $list = $this->userSchoolMajorTargetModel\\n                ->alias(\'usmt\')\\n                ->where(\'user_id\', $this->uid)\\n                ->order(\'id desc\')\\n                ->field(\'school_major_id,is_default\')\\n                ->limit(3)\\n                ->select();\\n            if ($list) {\\n                $schoolMajorIds = array_column($list, \'school_major_id\');\\n                $schoolMajorInfo = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n                    ->alias(\'cms\')\\n                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n                    ->whereIn(\'cms.id\', $schoolMajorIds)\\n                    ->column(\'cms.id, sch.id as school_id, sch.logo as school_logo, sch.name as school_name, ma.id as major_id, ma.name as major_name\');\\n                $hasDefault = false;\\n                foreach ($list as &$lt) {\\n                    if ($lt[\'is_default\']) {\\n                        $hasDefault = true;\\n                    }\\n                    $lt[\'school_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_name\'];\\n                    $lt[\'major_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_name\'];\\n                    $lt[\'school_logo\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_logo\'];\\n                    $lt[\'school_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_id\'];\\n                    $lt[\'major_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_id\'];\\n                }\\n                if (!$hasDefault) {\\n                    $list[0][\'is_default\'] = 1;\\n                }\\n                redis()->setex($cacheKey, 86400, json_encode($list));\\n            }\\n        }\\n        $this->success(\'success\', $list);\\n    }\\n\\n    \\/**\\n     * Function addOrDelTarget [添加\\/删除目标专业]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function addOrDelTarget()\\n    {\\n        $schoolId = input(\'school_id\\/d\', 0);\\n        $majorId = input(\'major_id\\/d\', 0);\\n        $action = input(\'action\\/d\', 0); \\/\\/操作 0 新增 1 删除 2 编辑\\n        $oldschoolMajorId = input(\'school_major_id\\/d\', 0);\\n        if ($action > 0 && !$oldschoolMajorId) {\\n            $this->error(\\\"参数错误【school_major_id】\\\");\\n        }\\n        try {\\n            Db::startTrans();\\n            $where[\'user_id\'] = $this->uid;\\n            if ($action == 1) { \\/\\/删除\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->where(\'school_major_id\', $oldschoolMajorId)\\n                    ->delete();\\n            } else {\\n                $newSchoolMajorId = $this->majorSchoolModel\\n                    ->where(\'school_id\', $schoolId)\\n                    ->where(\'major_id\', $majorId)\\n                    ->value(\'id\');\\n                if (!$newSchoolMajorId) {\\n                    $this->error(\'不存在的院校专业\');\\n                }\\n                $insertData = [\\n                    \'user_id\' => $this->uid,\\n                    \'school_major_id\' => $newSchoolMajorId,\\n                    \'is_default\' => 1,\\n                    \'create_time\' => time()\\n                ];\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->update([\'is_default\' => 0]);\\n                if (!$action) { \\/\\/新增\\n                    $list = $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->column(\'school_major_id\');\\n                    if (count($list) >= 3) {\\n                        $this->error(\'不要贪多，最多可以添加3个目标院校哦\');\\n                    } else {\\n                        if (!empty($list) && in_array($newSchoolMajorId, $list)) {\\n                            $this->error(\'请勿重复设置\');\\n                        } else {\\n                            $this->userSchoolMajorTargetModel->insert($insertData);\\n                        }\\n                    }\\n                } else {\\n                    $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->where(\'school_major_id\', $oldschoolMajorId)\\n                        ->delete();\\n                    $this->userSchoolMajorTargetModel->insert($insertData);\\n                }\\n            }\\n            Db::commit();\\n        } catch (Exception $e) {\\n            Db::rollback();\\n            $this->error(\'fail\');\\n        }\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function majorTargetSetDefault [设置默认目标院校专业]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetSetDefault()\\n    {\\n        $schoolMajorId = input(\'school_major_id\\/d\', 0);\\n        try {\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $this->userSchoolMajorTargetModel->startTrans();\\n            \\/\\/取消默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->update([\'is_default\' => 0]);\\n            \\/\\/设置默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->where(\'school_major_id\', $schoolMajorId)\\n                ->update([\'is_default\' => 1]);\\n            $this->userSchoolMajorTargetModel->commit();\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        } catch (Exception $e) {\\n            $this->userSchoolMajorTargetModel->roolback();\\n            $this->error(\'fail\');\\n        }\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function target1v1 [1v1辅导]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function target1v1()\\n    {\\n        $data = [\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/02.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/03.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/04.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/05.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/06.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/07.jpg\\\"\\n        ];\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function _getSubjectIdsByPids [获取三级学科id]\\n     * @author erdong\\n     * @date 2023-03-09\\n     *\\/\\n    public function _getSubjectIdsByPids($pids)\\n    {\\n        $subjectIds = Db::connect(\'database.auth_db_config\')\\n            ->table(\'cl_subject\')\\n            ->whereIn(\'pid\', $pids)\\n            ->where(\'status\', 1)\\n            ->column(\'id\');\\n        return $subjectIds;\\n    }\\n}\\n\",\"numLines\":324,\"startLine\":1,\"totalLines\":324}}}' , `created_at` = '2026-07-08 01:16:54' [ RunTime:0.007456s ]

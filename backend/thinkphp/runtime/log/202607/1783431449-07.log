 \\/\\/优势专业\\n217\\t        $where = [\\n218\\t            \'ms.school_id\' => $schoolId,\\n219\\t        ];\\n220\\t\\n221\\t        $majorList = $this->majorModel\\n222\\t            ->alias(\'m\')\\n223\\t            ->join(\'cl_major_school ms\', \'m.id = ms.major_id\', \'LEFT\')\\n224\\t            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n225\\t            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n226\\t            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n227\\t            ->field(\'m.name as major_name, m.id as major_id, ms.id as major_school_id, m.code, ms.is_full, IFNULL(subject_assessment,100) as subject_assessment, yx.name as yx_name, yjxk.name as yjxk_name\')\\n228\\t            ->where($where)\\n229\\t            ->order(\'subject_assessment asc,m.id asc\')\\n230\\t            ->select();\\n231\\t        $majors = array_slice($majorList, 0, 3);\\n232\\t\\n233\\t        if ($majors) {\\n234\\t            $adminSchoolMajor = new SchoolMajor();\\n235\\t            $topCount = 0;\\n236\\t            foreach ($majors as &$item) {\\n237\\t                $subjectAssessment = $adminSchoolMajor->getSubjectAssessment($item[\'subject_assessment\']);\\n238\\t                if ($subjectAssessment != \'无\') {\\n239\\t                    $topCount++;\\n240\\t                }\\n241\\t                $item[\'subject_assessment\'] = $subjectAssessment;\\n242\\t            }\\n243\\t        }\\n244\\t        $data[\'major_title\'] = $topCount >= 3 ? \'优势专业\' : \'专业目录\';\\n245\\t        $data[\'major_count\'] = count($majorList);\\n246\\t        $data[\'majors\'] = $majors;\\n247\\t\\n248\\t        \\/\\/招生简章\\n249\\t        $admissionModel = new Admission();\\n250\\t        $data[\'zsjz\'] = $admissionModel->getListBySchool($schoolId);\\n251\\t\\n252\\t        \\/\\/学院\\n253\\t        $data[\'yuanxi\'] = Db::connect(\'database.yx_db_config\')\\n254\\t            ->name(\'cl_major_school\')\\n255\\t            ->alias(\'cms\')\\n256\\t            ->join(\'cl_yuanxi cy\', \'cms.yuanxi_id = cy.id\', \'LEFT\')\\n257\\t            ->field(\'cy.id as yuanxi_id,cy.name as yuanxi_name,COUNT(cms.id) as major_count\')\\n258\\t            ->where(\'cms.school_id\', $schoolId)\\n259\\t            ->group(\'cms.yuanxi_id\')\\n260\\t            ->select();\\n261\\t\\n262\\t        $this->success(\'success\', $data);\\n263\\t    }\\n264\\t\\n265\\t    \\/**\\n266\\t     * Function introduce [院校介绍]\\n267\\t     * @author erdong\\n268\\t     * @date 2022-10-10\\n269\\t     *\\/\\n270\\t    public function introduce()\\n271\\t    {\\n272\\t        $schoolId = input(\'school_id\\/d\', 0);\\n273\\t        if (!$schoolId) {\\n274\\t            $this->error(\'参数错误\');\\n275\\t        }\\n276\\t        $data = [];\\n277\\t        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n278\\t        if ($schoolInfo) {\\n279\\t            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n280\\t            $data[\'school_name\'] = $schoolInfo[\'school_name\'];\\n281\\t            $data[\'address\'] = $schoolInfo[\'address\'];\\n282\\t            $data[\'introduce\'] = $schoolInfo[\'xxjs\'];\\n283\\t        }\\n284\\t        $data[\'school_logo\'] = CommonModelSchool::schoolLogo($data[\'school_logo\']);\\n285\\t        $this->success(\'success\', $data);\\n286\\t    }\\n287\\t\\n288\\t    \\/**\\n289\\t     * Function zsjzList [招生简章列表]\\n290\\t     * @author erdong\\n291\\t     * @date 2022-10-11\\n292\\t     *\\/\\n293\\t    public function zsjzList()\\n294\\t    {\\n295\\t        $schoolId = input(\'school_id\\/d\', 0);\\n296\\t        if (!$schoolId) {\\n297\\t            $this->error(\'参数错误\');\\n298\\t        }\\n299\\t        $data = [];\\n300\\t        $schoolInfo = $this->model->getSchoolInfo($schoolId);\\n301\\t        if ($schoolInfo) {\\n302\\t            $data[\'school_logo\'] = $schoolInfo[\'school_logo\'];\\n303\\t   
0\\t                    ->delete();\\n211\\t            } else {\\n212\\t                $newSchoolMajorId = $this->majorSchoolModel\\n213\\t                    ->where(\'school_id\', $schoolId)\\n214\\t                    ->where(\'major_id\', $majorId)\\n215\\t                    ->value(\'id\');\\n216\\t                if (!$newSchoolMajorId) {\\n217\\t                    $this->error(\'不存在的院校专业\');\\n218\\t                }\\n219\\t                $insertData = [\\n220\\t                    \'user_id\' => $this->uid,\\n221\\t                    \'school_major_id\' => $newSchoolMajorId,\\n222\\t                    \'is_default\' => 1,\\n223\\t                    \'create_time\' => time()\\n224\\t                ];\\n225\\t                $this->userSchoolMajorTargetModel\\n226\\t                    ->where($where)\\n227\\t                    ->update([\'is_default\' => 0]);\\n228\\t                if (!$action) { \\/\\/新增\\n229\\t                    $list = $this->userSchoolMajorTargetModel\\n230\\t                        ->where($where)\\n231\\t                        ->column(\'school_major_id\');\\n232\\t                    if (count($list) >= 3) {\\n233\\t                        $this->error(\'不要贪多，最多可以添加3个目标院校哦\');\\n234\\t                    } else {\\n235\\t                        if (!empty($list) && in_array($newSchoolMajorId, $list)) {\\n236\\t                            $this->error(\'请勿重复设置\');\\n237\\t                        } else {\\n238\\t                            $this->userSchoolMajorTargetModel->insert($insertData);\\n239\\t                        }\\n240\\t                    }\\n241\\t                } else {\\n242\\t                    $this->userSchoolMajorTargetModel\\n243\\t                        ->where($where)\\n244\\t                        ->where(\'school_major_id\', $oldschoolMajorId)\\n245\\t                        ->delete();\\n246\\t                    $this->userSchoolMajorTargetModel->insert($insertData);\\n247\\t                }\\n248\\t            }\\n249\\t            Db::commit();\\n250\\t        } catch (Exception $e) {\\n251\\t            Db::rollback();\\n252\\t            $this->error(\'fail\');\\n253\\t        }\\n254\\t        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n255\\t        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n256\\t        $this->success(\'success\');\\n257\\t    }\\n258\\t\\n259\\t    \\/**\\n260\\t     * Function majorTargetSetDefault [设置默认目标院校专业]\\n261\\t     * @author erdong\\n262\\t     * @date 2023-03-07\\n263\\t     *\\/\\n264\\t    public function targetSetDefault()\\n265\\t    {\\n266\\t        $schoolMajorId = input(\'school_major_id\\/d\', 0);\\n267\\t        try {\\n268\\t            $where = [\\n269\\t                \'user_id\' => $this->uid,\\n270\\t            ];\\n271\\t            $this->userSchoolMajorTargetModel->startTrans();\\n272\\t            \\/\\/取消默认\\n273\\t            $this->userSchoolMajorTargetModel\\n274\\t                ->where($where)\\n275\\t                ->update([\'is_default\' => 0]);\\n276\\t            \\/\\/设置默认\\n277\\t            $this->userSchoolMajorTargetModel\\n278\\t                ->where($where)\\n279\\t                ->where(\'school_major_id\', $schoolMajorId)\\n280\\t                ->update([\'is_default\' => 1]);\\n281\\t            $this->userSchoolMajorTargetModel->commit();\\n282\\t            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n283\\t            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n284\\t        } catch (Exception $e) {\\n285\\t            $this->userSchoolMajorTargetModel->roolback();\\n286\\t            $this->error(\'fail\');\\n287\\t        }\\n288\\t        $this->success(\'success\');\\n289\\t    }\\n290\\t\\n291\\t    \\/**\\n292\\t     * Function target1v1 [1v1辅导]\\n293\\t     * @author erdong\\n294\\t     * @date 2023-03-08\\n295\\t     *\\/\\n296\\t    public function target1v1()\\n297\\t    {\\n298\\t        $data = [\\n299\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/02.jpg\\\",\\n300\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/03.jpg\\\",\\n301\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/04.jpg\\\",\\n302\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/05.jpg\\\",\\n303\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/06.jpg\\\",\\n304\\t            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/07.jpg\\\"\\n305\\t        ];\\n306\\t        $this->success(\'success\', $data);\\n307\\t    }\\n308\\t\\n309\\t    \\/**\\n310\\t     * Function _getSubjectIdsByPids [获取三级学科id]\\n311\\t     * @author erdong\\n312\\t     * @date 2023-03-09\\n313\\t     *\\/\\n314\\t    public function _getSubjectIdsByPids($pids)\\n315\\t    {\\n316\\t        $subjectIds = Db::connect(\'database.auth_db_config\')\\n317\\t            ->table(\'cl_subject\')\\n318\\t            ->whereIn(\'pid\', $pids)\\n319\\t            ->where(\'status\', 1)\\n320\\t            ->column(\'id\');\\n321\\t        return $subjectIds;\\n322\\t    }\\n323\\t}\\n324\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"29bf50d2-57df-45c0-ac5c-def2fb36f852\",\"uuid\":\"c8c17504-ad47-4306-8c81-0b984f9815dc\",\"timestamp\":\"2026-07-07T17:24:27.159Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/wt-task-2\\/application\\/api\\/controller\\/AppMajor.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\common\\\\model\\\\Document;\\nuse app\\\\common\\\\model\\\\MajorSchool;\\nuse Exception;\\nuse think\\\\Db;\\nuse yjxkSubjectMap;\\n\\n\\/**\\n * app专业接口\\n *\\/\\nclass AppMajor extends ApiAuth\\n{\\n    protected $noNeedLogin = [];\\n    protected $noNeedRight = [];\\n\\n    protected $majorSchoolModel = null;\\n    protected $userSchoolMajorTargetModel = null;\\n    protected $uid;\\n    public function _initialize()\\n    {\\n        parent::_initialize();\\n        $this->uid = session(\'uid\') ?? 0;\\n        $this->majorSchoolModel = new MajorSchool();\\n        $this->userSchoolMajorTargetModel = model(\'UserSchoolMajorTarget\');\\n    }\\n\\n    \\/**\\n     * Function targetIndex [院校规划首页]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function targetIndex()\\n    {\\n        $redis = redis();\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid;\\n        $cache = $redis->get($cacheKey);\\n        if ($cache) {\\n            $data = json_decode($cache, true);\\n        } else {\\n            \\/\\/获取目标院校\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $data = [];\\n            $list = $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->order(\'id desc\')\\n                ->select();\\n            if ($list) {\\n                $isDefault = false;\\n                foreach ($list as $lt) {\\n                    if ($lt[\'is_default\']) {\\n                        $targetSchoolMajor = $lt;\\n                        $isDefault = true;\\n                        break;\\n                    }\\n                }\\n                if (!$isDefault) {\\n                    $targetSchoolMajor = $list[0];\\n                }\\n                $targetSchoolMajor = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n                    ->alias(\'cms\')\\n                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n                    ->where(\'cms.id\', $targetSchoolMajor[\'school_major_id\'])\\n                    ->field(\'cms.id as school_major_id, sch.id as school_id, sch.name as school_name, sch.logo as school_logo, ma.id as major_id, ma.name as major_name, ma.code, ma.yjxk_id\')\\n                    ->find();\\n                $data[\'target_school_major\'] = $targetSchoolMajor;\\n\\n                \\/\\/专业映射的三级学科\\n                $yjxkSubject = yjxkSubjectMap::getMajorSubject();\\n                $subjectIds = $yjxkSubject[$targetSchoolMajor[\'yjxk_id\']] ?? [];\\n                if($subjectIds){\\n                    $subjectIds = array_merge($subjectIds,$this->_getSubjectIdsByPids(yjxkSubjectMap::SECOND_SUBJECT_QK));\\n                }else{\\n                    $subjectIds = [yjxkSubjectMap::THIRD_SUBJECT_QK];\\n                }\\n\\n                \\/\\/是否包含真题资料、经验小课、学长学姐\\n                $documentModel = new Document();\\n                $majorId = $targetSchoolMajor[\'major_id\'];\\n                $schoolId = $targetSchoolMajor[\'school_id\'];\\n                $tabs = [];\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 0, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 1,\\n                        \'title\' => \'专业资料\'\\n                    ];\\n                } \\/\\/真题资料\\n                if ($documentModel->ifHasDocsOrTalk($majorId, 1, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 2,\\n                        \'title\' => \'上岸经验\'\\n                    ];\\n                } \\/\\/经验小课\\n                if ($documentModel->ifHasSenior($majorId, $schoolId)) {\\n                    $tabs[] = [\\n                        \'typeId\' => 3,\\n                        \'title\' => \'学长学姐\'\\n                    ];\\n                } \\/\\/学长学姐\\n                $tabs[] = [\\n                    \'typeId\' => 21,\\n                    \'title\' => \'1V1辅导\'\\n                ];\\n                $data[\'tabs\'] = $tabs;\\n            } else {\\n                $subjectIds = $this->_getSubjectIdsByPids([yjxkSubjectMap::SECOND_SUBJECT_ZYK, yjxkSubjectMap::SECOND_SUBJECT_QK]);\\n            }\\n            $data[\'subject_ids\'] = $subjectIds;\\n            $redis->setex($cacheKey, 300, json_encode($data));\\n        }\\n        \\/\\/获取金刚位数据\\n        $findTools = json_decode($redis->get(\'otm_display_userIds\'), true);\\n        $ftools = [];\\n        foreach ($findTools as $tool) {\\n            if (!empty($tool[\'oldurl\'])) {\\n                unset($tool[\'oldurl\']);\\n            }\\n            $tool[\'findId\'] = $tool[\'type\'];\\n            $tool[\'type\'] = 4;\\n            $ftools[$tool[\'findId\']] = $tool;\\n        }\\n        unset($findTools);\\n\\n        $data[\'navigation\'] = [];\\n        $findIndex = [28, 22, 14, 23];\\n        foreach ($findIndex as $ind) {\\n            if (!empty($ftools[$ind])) {\\n                $data[\'navigation\'][] = $ftools[$ind];\\n            }\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function list [目标院校专业列表]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetList()\\n    {\\n        $cacheKey = $this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid;\\n        $cache = redis()->get($cacheKey);\\n        if ($cache) {\\n            $list = json_decode($cache, true);\\n        } else {\\n            $list = $this->userSchoolMajorTargetModel\\n                ->alias(\'usmt\')\\n                ->where(\'user_id\', $this->uid)\\n                ->order(\'id desc\')\\n                ->field(\'school_major_id,is_default\')\\n                ->limit(3)\\n                ->select();\\n            if ($list) {\\n                $schoolMajorIds = array_column($list, \'school_major_id\');\\n                $schoolMajorInfo = Db::connect(\'database.yx_db_config\')\\n                    ->name(\'cl_major_school\')\\n                    ->alias(\'cms\')\\n                    ->join(\'cl_school sch\', \'cms.school_id = sch.id\', \'LEFT\')\\n                    ->join(\'cl_major ma\', \'cms.major_id = ma.id\', \'LEFT\')\\n                    ->whereIn(\'cms.id\', $schoolMajorIds)\\n                    ->column(\'cms.id, sch.id as school_id, sch.logo as school_logo, sch.name as school_name, ma.id as major_id, ma.name as major_name\');\\n                $hasDefault = false;\\n                foreach ($list as &$lt) {\\n                    if ($lt[\'is_default\']) {\\n                        $hasDefault = true;\\n                    }\\n                    $lt[\'school_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_name\'];\\n                    $lt[\'major_name\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_name\'];\\n                    $lt[\'school_logo\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_logo\'];\\n                    $lt[\'school_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'school_id\'];\\n                    $lt[\'major_id\'] = $schoolMajorInfo[$lt[\'school_major_id\']][\'major_id\'];\\n                }\\n                if (!$hasDefault) {\\n                    $list[0][\'is_default\'] = 1;\\n                }\\n                redis()->setex($cacheKey, 86400, json_encode($list));\\n            }\\n        }\\n        $this->success(\'success\', $list);\\n    }\\n\\n    \\/**\\n     * Function addOrDelTarget [添加\\/删除目标专业]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function addOrDelTarget()\\n    {\\n        $schoolId = input(\'school_id\\/d\', 0);\\n        $majorId = input(\'major_id\\/d\', 0);\\n        $action = input(\'action\\/d\', 0); \\/\\/操作 0 新增 1 删除 2 编辑\\n        $oldschoolMajorId = input(\'school_major_id\\/d\', 0);\\n        if ($action > 0 && !$oldschoolMajorId) {\\n            $this->error(\\\"参数错误【school_major_id】\\\");\\n        }\\n        try {\\n            Db::startTrans();\\n            $where[\'user_id\'] = $this->uid;\\n            if ($action == 1) { \\/\\/删除\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->where(\'school_major_id\', $oldschoolMajorId)\\n                    ->delete();\\n            } else {\\n                $newSchoolMajorId = $this->majorSchoolModel\\n                    ->where(\'school_id\', $schoolId)\\n                    ->where(\'major_id\', $majorId)\\n                    ->value(\'id\');\\n                if (!$newSchoolMajorId) {\\n                    $this->error(\'不存在的院校专业\');\\n                }\\n                $insertData = [\\n                    \'user_id\' => $this->uid,\\n                    \'school_major_id\' => $newSchoolMajorId,\\n                    \'is_default\' => 1,\\n                    \'create_time\' => time()\\n                ];\\n                $this->userSchoolMajorTargetModel\\n                    ->where($where)\\n                    ->update([\'is_default\' => 0]);\\n                if (!$action) { \\/\\/新增\\n                    $list = $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->column(\'school_major_id\');\\n                    if (count($list) >= 3) {\\n                        $this->error(\'不要贪多，最多可以添加3个目标院校哦\');\\n                    } else {\\n                        if (!empty($list) && in_array($newSchoolMajorId, $list)) {\\n                            $this->error(\'请勿重复设置\');\\n                        } else {\\n                            $this->userSchoolMajorTargetModel->insert($insertData);\\n                        }\\n                    }\\n                } else {\\n                    $this->userSchoolMajorTargetModel\\n                        ->where($where)\\n                        ->where(\'school_major_id\', $oldschoolMajorId)\\n                        ->delete();\\n                    $this->userSchoolMajorTargetModel->insert($insertData);\\n                }\\n            }\\n            Db::commit();\\n        } catch (Exception $e) {\\n            Db::rollback();\\n            $this->error(\'fail\');\\n        }\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n        redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function majorTargetSetDefault [设置默认目标院校专业]\\n     * @author erdong\\n     * @date 2023-03-07\\n     *\\/\\n    public function targetSetDefault()\\n    {\\n        $schoolMajorId = input(\'school_major_id\\/d\', 0);\\n        try {\\n            $where = [\\n                \'user_id\' => $this->uid,\\n            ];\\n            $this->userSchoolMajorTargetModel->startTrans();\\n            \\/\\/取消默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->update([\'is_default\' => 0]);\\n            \\/\\/设置默认\\n            $this->userSchoolMajorTargetModel\\n                ->where($where)\\n                ->where(\'school_major_id\', $schoolMajorId)\\n                ->update([\'is_default\' => 1]);\\n            $this->userSchoolMajorTargetModel->commit();\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_USER_TARGET_MAJOR . $this->uid);\\n            redis()->del($this->userSchoolMajorTargetModel::CACHE_KEY_TARGET_MAJOR_INDEX . $this->uid);\\n        } catch (Exception $e) {\\n            $this->userSchoolMajorTargetModel->roolback();\\n            $this->error(\'fail\');\\n        }\\n        $this->success(\'success\');\\n    }\\n\\n    \\/**\\n     * Function target1v1 [1v1辅导]\\n     * @author erdong\\n     * @date 2023-03-08\\n     *\\/\\n    public function target1v1()\\n    {\\n        $data = [\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/02.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/03.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/04.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/05.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/06.jpg\\\",\\n            \\\"https:\\/\\/static.orangevip.com\\/2022clwxapp\\/1v1\\/07.jpg\\\"\\n        ];\\n        $this->success(\'success\', $data);\\n    }\\n\\n    \\/**\\n     * Function _getSubjectIdsByPids [获取三级学科id]\\n     * @author erdong\\n     * @date 2023-03-09\\n     *\\/\\n    public function _getSubjectIdsByPids($pids)\\n    {\\n        $subjectIds = Db::connect(\'database.auth_db_config\')\\n            ->table(\'cl_subject\')\\n            ->whereIn(\'pid\', $pids)\\n            ->where(\'status\', 1)\\n            ->column(\'id\');\\n        return $subjectIds;\\n    }\\n}\\n\",\"numLines\":324,\"startLine\":1,\"totalLines\":324}}}' , `created_at` = '2026-07-08 01:24:27' [ RunTime:0.001682s ]

\\n36\\t    ];\\n37\\t    public function checkNowStanding($value){\\n38\\t        return $this->checkParam($value,\'getNowStanding\',\'您的身份\');\\n39\\t    }\\n40\\t    public function checkEducationStading($value){\\n41\\t        return $this->checkParam($value,\'getEducationStading\',\'学历层次\');\\n42\\t    }\\n43\\t    public function checkCet($value){\\n44\\t        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n45\\t    }\\n46\\t    public function checkDiffMajor($value){\\n47\\t        return $this->checkParam($value,\'getDiffMajor\',\'是否跨专业考研\');\\n48\\t    }\\n49\\t    public function checkExamYear($value){\\n50\\t        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n51\\t    }\\n52\\t    public function checkDetermination($value){\\n53\\t        return $this->checkParam($value,\'getDetermination\',\'考研决心\');\\n54\\t    }\\n55\\t    private function checkParam($value,$action,$word){\\n56\\t        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n57\\t        $list = $model->$action();\\n58\\t        if(in_array($value,array_keys($list))){\\n59\\t            return true;\\n60\\t        }\\n61\\t        return ComErrorDescs::EC_INVALID_PARAM . \',\'.$word;\\n62\\t    }\\n63\\t\\n64\\t}\"}]},\"parent_tool_use_id\":null,\"session_id\":\"64a3dfe2-2ce8-4685-94e7-849d0265f79d\",\"uuid\":\"4998961c-5730-4bea-b668-f7bfbeb4eced\",\"timestamp\":\"2026-07-07T13:57:42.560Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/wt-task-1\\/application\\/api\\/validate\\/Ai.php\",\"content\":\"<?php\\nnamespace app\\\\api\\\\validate;\\n\\nuse app\\\\api\\\\library\\\\ComErrorDescs;\\nuse think\\\\Validate;\\n\\n\\/**\\n * Class Auth [接口header验证类]\\n * Auther Changzd\\n * @package app\\\\api\\\\validate\\n *\\/\\nclass Ai extends Validate\\n{\\n    protected $rule = [\\n        \'now_standing\'  => \'require|checkNowStanding\',\\n        \'school_id\'    => \'require\',\\n        \'education_s
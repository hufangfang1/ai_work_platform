+<?php
+
+namespace app\\api\\controller;
+
+use app\\common\\controller\\ApiAuth;
+use app\\api\\library\\ComErrorDescs;
+
+/**
+ * 冒泡排序算法接口
+ */
+class Sort extends ApiAuth
+{
+    /**
+     * 无需登录的方法
+     * @var array
+     */
+    protected $noNeedLogin = [\'bubble\'];
+
+    /**
+     * 无需鉴权的方法
+     * @var array
+     */
+    protected $noNeedRight = [\'bubble\'];
+
+    /**
+     * 冒泡排序算法接口
+     * @desc 接收待排序数组及排序方向，返回排序结果与统计信息（比较次数、交换次数、耗时）
+     * @author hufangfang
+     * @date 2026-07-07
+     * @param array  $array     待排序的数值数组（POST JSON: {\"array\": [3,1,2], \"direction\": \"asc\"}）
+     * @param string $direction 排序方向：asc=升序（默认）、desc=降序
+     * @return json  {errno, success, msg, data: {sorted_array, original_array, direction, stats: {comparisons, swaps, elapsed_ms}}}
+     */
+    public function bubble()
+    {
+        // 1. 获取参数
+        $array     = input(\'post.array/a\', []);
+        $direction = input(\'post.direction/s\', \'asc\');
+
+        // 2. 入参校验
+        $validate = validate(\'Sort\');
+        if (!$validate->check([\'array\' => $array, \'direction\' => $direction])) {
+            $result = (string)$validate->getError();
+            if (false !== strpos($result, \',\')) {
+                list($errNo, $msg) = explode(\',\', $result);
+            } else {
+                $errNo = ComErrorDescs::EC_UNKNOWN;
+                $msg   = \'\';
+            }
+            $this->result(ComErrorDescs::errmsg($errNo, $msg), [], $errNo);
+            return;
+        }
+
+        // 3. 保存原始数组快照（避免排序时引用传递导致原始值丢失）
+        $originalArray = $array;
+        $n = count($array);
+        $comparisons = 0;
+        $swaps       = 0;
+
+        // 4. 记录开始时间
+        $start = microtime(true);
+
+        // 5. 冒泡排序核心算法
+        for ($i = 0; $i < $n - 1; $i++) {
+            for ($j = 0; $j < $n - 1 - $i; $j++) {
+                $comparisons++;
+                if ($direction === \'asc\') {
+                    if ($array[$j] > $array[$j + 1]) {
+                        $this->swap($array, $j, $j + 1);
+                        $swaps++;
+                    }
+                } else {
+                    if ($array[$j] < $array[$j + 1]) {
+                        $this->swap($array, $j, $j + 1);
+                        $swaps++;
+                    }
+                }
+            }
+        }
+
+        // 6. 计算耗时（毫秒，保留 4 位小数）
+        $elapsed = round((microtime(true) - $start) * 1000, 4);
+
+        // 7. 返回统一 JSON 响应
+        $this->success(\'排序成功\', [
+            \'sorted_array\'   => $array,
+            \'original_array\' => $originalArray,
+            \'direction\'      => $direction,
+            \'stats\'          => [
+                \'comparisons\' => $comparisons,
+                \'swaps\'       => $swaps,
+                \'elapsed_ms\'  => $elapsed,
+            ],
+        ]);
+    }
+
+    /**
+     * 交换数组中两个位置的值
+     * @param array $arr 引用传递
+     * @param int   $i
+     * @param int   $j
+     */
+    private function swap(&$arr, $i, $j)
+    {
+        $temp    = $arr[$i];
+        $arr[$i] = $arr[$j];
+        $arr[$j] = $temp;
+    }
+}
diff --git a/application/api/validate/Sort.php b/application/api/validate/Sort.php
new file mode 100644
index 00000000..43abfb14
--- /dev/null
+++ b/application/api/validate/Sort.php
@@ -0,0 +1,41 @@
+<?php
+namespace app\\api\\validate;
+
+use app\\api\\library\\ComErrorDescs;
+use think\\Validate;
+
+/**
+ * Class Sort [冒泡排序接口参数校验]
+ * @package app\\api\\validate
+ */
+class Sort extends Validate
+{
+    protected $rule = [
+        \'array\'     => \'require|array|checkArrayElements\',
+        \'direction\' => \'in:asc,desc\',
+    ];
+
+    protected $message = [
+        \'array.require\'      => ComErrorDescs::EC_MISSING_PARAM . \',\' . \'排序数组\',
+        \'array.array\'        => ComErrorDescs::EC_INVALID_PARAM . \',\' . \'排序数组格式错误\',
+        \'direction.in\'       => ComErrorDescs::EC_INVALID_PARAM . \',\' . \'排序方向只能为asc或desc\',
+    ];
+
+    /**
+     * 校验数组元素均为数值类型
+     * @param array $value
+     * @return bool|string
+     */
+    protected function checkArrayElements($value)
+    {
+        if (empty($value)) {
+            return true;
+        }
+        foreach ($value as $item) {
+            if (!is_numeric($item)) {
+                return ComErrorDescs::EC_INVALID_PARAM . \',\' . \'数组元素必须为数值\';
+            }
+        }
+        return true;
+    }
+}

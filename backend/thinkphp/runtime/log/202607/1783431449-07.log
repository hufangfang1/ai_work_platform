ix\'][\'major_id\'] ?? 0;\\n1306\\t                    $schoolId = $result[\'mix\'][\'lowMix\'][\'school_id\'] ?? 0;\\n1307\\t                    $star = $result[\'mix\'][\'lowMix\'][\'star\'] ?? 0;\\n1308\\t                    break;\\n1309\\t            }\\n1310\\t        }\\n1311\\t        if (empty($majorId) || empty($schoolId)) {\\n1312\\t            return false;\\n1313\\t        }\\n1314\\t        $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n1315\\t            ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n1316\\t            ->where(\'a.major_id\', $majorId)\\n1317\\t            ->where(\'a.school_id\', $schoolId)\\n1318\\t            ->order(\'b.first_pinyin\', \'asc\')\\n1319\\t            ->value(\'a.id\');\\n1320\\t        if (!$majorSchoolId) {\\n1321\\t            return false;\\n1322\\t        }\\n1323\\t        $majorInfo = $this->majorSchoolModel\\n1324\\t            ->alias(\'ms\')\\n1325\\t            ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n1326\\t            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n1327\\t            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n1328\\t            ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n1329\\t            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n1330\\t            ->field(\'yx.intro,sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n1331\\t            ->where(\'ms.id\', $majorSchoolId)\\n1332\\t            ->find();\\n1333\\t        if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n1334\\t            $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n1335\\t        }\\n1336\\t        $school_name = $majorInfo[\'school_name\'];\\n1337\\t        $school_attr = $majorInfo[\'school_attr\'];\\n1338\\t        $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n1339\\t        $sort = $majorInfo[\'comprehensive_ranking\'];\\n1340\\t        $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n1341\\t        $juge = $subjectAssessMent[$majorInfo[\'subject_assessment\']] ?? \'\';\\n1342\\t        $xueke = \'\';\\n1343\\t        if (!empty($juge)) {\\n1344\\t            $xueke = \'，学科评估为\' . $juge;\\n1345\\t        }\\n1346\\t        switch ($type) {\\n1347\\t            case 1:\\n1348\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，更具有专业竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n1349\\t                break;\\n1350\\t            case 2:\\n1351\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，院校更具有竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n1352\\t                break;\\n1353\\t            case 3:\\n1354\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，学历含金量很高，建议尝试报考。虽然面临一定考试难度，相信经过我们的指导后，通过您的100%对学些的投入，还是有机会考取该院校的，联系学习规划老师获取详细方案。\';\\n1355\\t                break;\\n1356\\t            case 4:\\n1357\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n1358\\t                break;\\n1359\\t            case 5:\\n1360\\t                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n1361\\t                break;\\n1362\\t        }\\n1363\\t        if ($majorInfo) {\\n1364\\t            $adminSchoolMajor = new SchoolMajor();\\n1365\\t            $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n1366\\t            $majorInfo[\'introReason\'] = $introReason;\\n1367\\t            $majorInfo[\'star\'] = $star;\\n1368\\t            $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n1369\\t            if ($uid) {\\n1370\\t                $teacherInfo = getQrcode($uid, $isfeishu);\\n1371\\t            }\\n1372\\t            $lqxx = (new \\\\app\\\\api\\\\logic\\\\Pic())->getLqxx($majorSchoolId, $majorInfo, $uid);\\n1373\\t            $majorInfo[\'zlrsUrl\'] = $lqxx[\'zlrsUrl\'];\\n1374\\t            $majorInfo[\'fushi\'] = $lqxx[\'fushi\'];\\n1375\\t            $majorInfo[\'year_vs_score\'] = $lqxx[\'year_vs_score\'];\\n1376\\t            $majorInfo[\'has_year_vs_score\'] = $lqxx[\'has_year_vs_score\'];\\n1377\\t            $majorInfo[\'is_vip\'] = $lqxx[\'is_vip\'];\\n1378\\t            $majorInfo[\'analysis\'] = $lqxx[\'analysis\'];\\n1379\\t            if (!empty($teacherInfo)) {\\n1380\\t                $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1381\\t                    ->where(\'uid\', $uid)\\n1382\\t                    ->value(\'username\');\\n1383\\t                $teacherInfo[\'nickname\'] = $nickname;\\n1384\\t                $teacherInfo[\'head_url\'] = Config(\'fc_website_url\') . \'\\/proxy\\/\' . get_avatar_path($uid);\\n1385\\t            } else {\\n1386\\t                $teacherInfo = [];\\n1387\\t            }\\n1388\\t            $majorInfo[\'teacher\'] = $teacherInfo;\\n1389\\t            $majorInfo[\'type\'] = $type;\\n1390\\t            $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n1391\\t            \\/\\/院校默认图\\n1392\\t            $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n1393\\t        }\\n1394\\t        return $majorInfo;\\n1395\\t    }\\n1396\\t    \\/**\\n1397\\t     * desc:根据专业获取学校排名\\n1398\\t     * author:hufangfang\\n1399\\t     * data:2022\\/12\\/21 11:26\\n1400\\t     * @return void\\n1401\\t     * @throws Exception\\n1402\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1403\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1404\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1405\\t     *\\/\\n1406\\t    public function schoolOrder()\\n1407\\t    {\\n1408\\t        $majorId = input(\'major_id\\/d\', 0);\\n1409\\t        $p = input(\'p\\/d\', 1);\\n1410\\t        $limit = input(\'limit\\/d\', 10);\\n1411\\t        if ($p < 1) {\\n1412\\t            $p = 1;\\n1413\\t        }\\n1414\\t        if ($limit < 1) {\\n1415\\t            $limit = 10;\\n1416\\t        }\\n1417\\t        if (empty($majorId)) {\\n1418\\t            $this->success(\'success\');\\n1419\\t        }\\n1420\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n1421\\t            ->join(\'cl_school b\', \'a.school_id=b.id\', \'left\')\\n1422\\t            ->join(\'cl_yuanxi c\', \'a.yuanxi_id=c.id\', \'left\')\\n1423\\t            ->join(\'cl_major e\', \'a.major_id=e.id\', \'left\')\\n1424\\t            ->join(\'cl_school_yjxk d\', \'a.school_id=d.school_id and d.yjxk_id=e.yjxk_id\', \'left\')\\n1425\\t            ->field(\'a.school_id,a.major_id,b.name school_name,e.name major_name,b.area_id,b.school_attr,b.comprehensive_ranking,c.name yuanxi_name,d.subject_assessment,b.logo\')\\n1426\\t            ->where(\'a.major_id\', $majorId)\\n1427\\t            ->order(\'comprehensive_ranking,c.first_pinyin\')\\n1428\\t            ->limit(50)\\n1429\\t            ->select();\\n1430\\t        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n1431\\t            ->where(\'pid\', \'>\', 0)\\n1432\\t            ->column(\'name\', \'id\');\\n1433\\t        $return = [];\\n1434\\t        $adminSchoolMajor = new SchoolMajor();\\n1435\\t        foreach ($list as $k => $v) {\\n1436\\t            $v[\'area_name\'] = $areaList[$v[\'area_id\']] ?? \'\';\\n1437\\t            $v[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($v[\'subject_assessment\']);\\n1438\\t            if (!empty($v[\'school_attr\'])) {\\n1439\\t                $v[\'school_attr\'] = explode(\',\', $v[\'school_attr\']);\\n1440\\t            } else {\\n1441\\t                $v[\'school_attr\'] = [];\\n1442\\t            }\\n1443\\t            $v[\'logo\'] = School::schoolLogo($v[\'logo\']);\\n1444\\t            if (empty($return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']])) {\\n1445\\t                $return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']] = $v;\\n1446\\t            }\\n1447\\t            if ($v[\'comprehensive_ranking\'] == 10000) {\\n1448\\t                $v[\'comprehensive_ranking\'] = \'暂无\';\\n1449\\t            }\\n1450\\t        }\\n1451\\t        $this->success(\'success\', array_values($return));\\n1452\\t    }\\n1453\\t    \\/\\/发送飞书消息\\n1454\\t    public function feishuMessage()\\n1455\\t    {\\n1456\\t        $tutorId = input(\'tutor_id\', \'\');\\n1457\\t        $id = input(\'id\', 0);\\n1458\\t        if (empty($tutorId) || empty($id)) {\\n1459\\t            $this->error(\'参数错误\');\\n1460\\t        }\\n1461\\t        $mobile = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1462\\t            ->where(\'uid\', $tutorId)\\n1463\\t            ->value(\'mobile\');\\n1464\\t        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n1465\\t            ->where(\'id\', $id)\\n1466\\t            ->find();\\n1467\\t        if (empty($record)) {\\n1468\\t            $this->error(\'id错误\');\\n1469\\t        }\\n1470\\t        $key = \'yuanxiao:feishu:tutor:notice:\' . $tutorId . \':\' . $id;\\n1471\\t        $cache = redis()->get($key);\\n1472\\t        if ($cache) {\\n1473\\t            $this->success(\'success\', []);\\n1474\\t        }\\n1475\\t        $uid = $record[\'uid\'];\\n1476\\t        $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n1477\\t            ->where(\'uid\', $uid)\\n1478\\t            ->value(\'username\');\\n1479\\t        $url = config(\'feishu_jump_url\') . \'?refresh=1&refer=\' . urlencode(\'https:\\/\\/wxapp.orangevip.com\\/choice-record?id=\' . $id . \'&isfeishu=1\');\\n1480\\t        $message = \'您的学员\' . $nickname . \'，进行了AI择校。点击连接，查看学生择校信息：\' . $url;\\n1481\\t        $data[\'type\'] = \'post\';\\n1482\\t        $data[\'message\'][\'title\'] = \\\"AI择校消息通知\\\";\\n1483\\t        $text1 = $message;\\n1484\\t        $content1[] = [\'tag\' => \'text\', \'un_escape\' => true, \'text\' => $text1];\\n1485\\t        $data[\'message\'][\'content\'][] = $content1;\\n1486\\t        $data[\'mobile\'] = $mobile;\\n1487\\t        $res = Helpers::clphpCurl($data);\\n1488\\t        redis()->set($key, 1);\\n1489\\t        $this->success(\'success\', $res);\\n1490\\t    }\\n1491\\t    \\/**\\n1492\\t     * desc:判断科目是否考数一数二or数三\\n1493\\t     * author:hufangfang\\n1494\\t     * data:2023\\/1\\/4 10:13\\n1495\\t     * @return void\\n1496\\t     * @throws Exception\\n1497\\t     *\\/\\n1498\\t    public function majorExamSubject()\\n1499\\t    {\\n1500\\t        $majorId = input(\'major_id\', 0);\\n1501\\t        $examSubject = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n1502\\t            ->where(\'id\', $majorId)\\n1503\\t            ->value(\'exam_subject\');\\n1504\\t        $hasMath = false;\\n1505\\t        if (!empty($examSubject)) {\\n1506\\t            $examSubject = explode(\',\', $examSubject);\\n1507\\t            foreach ($examSubject as $k => $v) {\\n1508\\t                if (in_array($v, [\'数学一\', \'数学二\', \'数学三\'])) {\\n1509\\t                    $hasMath = true;\\n1510\\t                    break;\\n1511\\t                }\\n1512\\t            }\\n1513\\t        }\\n1514\\t        $this->success(\'success\', [\'has_math\' => $hasMath]);\\n1515\\t    }\\n1516\\t\\n1517\\t    public function testQrcode()\\n1518\\t    {\\n1519\\t        $res = getQrcode(1, 0);\\n1520\\t    }\\n1521\\t}\\n1522\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"2db49a63-19ff-4afa-842b-45cd58fc6c21\",\"uuid\":\"6590b032-552d-49bf-8b13-80f410775e48\",\"timestamp\":\"2026-07-07T13:36:07.306Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/wt-task-1\\/application\\/api\\/controller\\/Ai.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\api\\\\library\\\\ComErrorDescs;\\nuse app\\\\common\\\\library\\\\Helpers;\\nuse think\\\\Db;\\nuse think\\\\Exception;\\nuse app\\\\admin\\\\model\\\\SchoolMajor;\\nuse app\\\\common\\\\model\\\\Document;\\nuse app\\\\common\\\\model\\\\Major as ModelMajor;\\nuse app\\\\common\\\\model\\\\MajorSchool;\\nuse app\\\\common\\\\model\\\\School;\\nuse app\\\\common\\\\model\\\\SchoolMajorCollect;\\nuse think\\\\Config;\\n\\n\\/**\\n * 首页接口\\n *\\/\\nclass Ai extends ApiAuth\\n{\\n    protected $noNeedLogin = [\'schoolorder\', \'majorexamsubject\'];\\n    protected $noNeedRight = [\'schoolorder\', \'info\', \'start\', \'index\', \'getselect\', \'schoollist\', \'history\', \'feishumessage\', \'recorddetail\', \'majorexamsubject\', \'testqrcode\'];\\n    protected $majorModel = null;\\n    protected $majorSchoolModel = null;\\n    public function _initialize()\\n    {\\n        parent::_initialize();\\n        $this->majorModel = new ModelMajor();\\n        $this->majorSchoolModel = new MajorSchool();\\n    }\\n    public function index()\\n    {\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'uid\', session(\'uid\'))\\n            ->order(\'createtime\', \'desc\')\\n            ->find();\\n        if (!empty($record)) {\\n            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n            $year = $model->getExamYear();\\n            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n                ->where(\'pid\', \'>\', 0)\\n                ->column(\'name\', \'id\');\\n            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n                ->column(\'name\', \'id\');\\n            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n                ->where(\'is_hidden\', 0)\\n                ->column(\'school_name\', \'school_id\');\\n            $nowStanding = $model->getNowStanding();\\n            $educationStading = $model->getEducationStading();\\n            $cet = $model->getCet();\\n            $diff_major = $model->getDiffMajor();\\n            $school_attr = $model->getSchoolAttr();\\n            $school_grades = $model->getSchoolGrades();\\n            $math_status = $model->getMathStatus();\\n            $determination = $model->getDetermination();\\n            $item = [];\\n            $item[\'key\'] = array_search($record[\'exam_year\'], $year);\\n            $item[\'value\'] = $record[\'exam_year\'];\\n            $record[\'exam_year\'] = $item;\\n            $record[\'result\'] = json_decode($record[\'result\'], true);\\n            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n            $item = [];\\n            $record[\'area_id\'] = [];\\n            foreach ($record[\'area\'] as $kk => $vv) {\\n                $item[\'key\'] = (int)$vv;\\n                $item[\'value\'] = $areaList[$vv] ?? \'\';\\n                $record[\'area_id\'][] = $item;\\n            }\\n            unset($record[\'area\']);\\n            $item = [];\\n            $item[\'key\'] = $record[\'now_standing\'];\\n            $item[\'value\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n            $record[\'now_standing\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_id\'];\\n            $item[\'value\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n            $record[\'school_id\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'diff_major\'];\\n            $item[\'value\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n            $record[\'diff_major\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_attr\'];\\n            $item[\'value\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n            if (empty($record[\'school_attr\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'school_attr\'] = $item;\\n\\n            $item = [];\\n            $item[\'key\'] = $record[\'school_grades\'];\\n            $item[\'value\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n            if (empty($record[\'school_grades\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'school_grades\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'cet\'];\\n            $item[\'value\'] = $cet[$record[\'cet\']] ?? \'\';\\n            if (empty($record[\'cet\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'cet\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'math_status\'];\\n            $item[\'value\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n            if (empty($record[\'math_status\'])) {\\n                $item[\'value\'] = \'\';\\n            }\\n            $record[\'math_status\'] = $item;\\n            $item = [];\\n            $item[\'key\'] = $record[\'major_id\'];\\n            $item[\'value\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n            $record[\'major_id\'] = $item;\\n            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n            $item = [];\\n            $item[\'key\'] = $record[\'education_stading\'];\\n            $item[\'value\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n            $record[\'education_stading\'] = $item;\\n        } else {\\n            $record = [];\\n        }\\n        $this->success(\'success\', $record);\\n    }\\n    \\/**\\n     * 首页\\n     *\\n     *\\/\\n    public function start()\\n    {\\n        $input = input();\\n        foreach ($input as $k => $v) {\\n            if (!in_array($k, [\'now_standing\', \'school_id\', \'education_stading\', \'cet\', \'area_id\', \'major_id\', \'diff_major\', \'school_attr\', \'school_grades\', \'math_status\', \'exam_year\', \'determination\'])) {\\n                unset($input[$k]);\\n            }\\n        }\\n        $input = array_filter($input);\\n        $validate = validate(\\\"Ai\\\");\\n        if (!$validate->check($input)) {\\n            $result = (string)$validate->getError();\\n            if (false !== strpos($result, \',\')) {\\n                list($errNo, $msg) = explode(\',\', $result);\\n            } else {\\n                $errNo = ComErrorDescs::EC_UNKNOWN;\\n                $msg = \'\';\\n            }\\n            $this->result(ComErrorDescs::errmsg($errNo, $msg), [], $errNo);\\n        }\\n        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'diff_major\'] == 3)) {\\n            if (empty($input[\'school_grades\'])) {\\n                $this->error(\'在校成绩不能为空\');\\n            }\\n        }\\n        $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where(\'uc_school_id\', $input[\'school_id\'])\\n            ->value(\'id\');\\n        if (empty($school_id)) {\\n            $school_id = 0;\\n        }\\n        $examSubject = Db::connect(\'database.yx_db_config\')\\n            ->name(\'cl_major\')\\n            ->where(\'id\', $input[\'major_id\'])\\n            ->value(\'exam_subject\');\\n        if (!empty($examSubject)) {\\n            $examSubject = explode(\',\', $examSubject);\\n            $examSubject = array_intersect($examSubject, [\'数学一\', \'数学二\', \'数学三\']);\\n            if (!empty($examSubject) && empty($input[\'math_status\'])) {\\n                $this->error(\'高等数学学习情况不能为空\');\\n            }\\n        }\\n        $area_num = count(explode(\',\', $input[\'area_id\']));\\n        if ($area_num > 5) {\\n            $this->error(\'期望报考地区最多选择5个\');\\n        }\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $year = $model->getExamYear();\\n        $input[\'exam_year\'] = $year[$input[\'exam_year\']];\\n        $input[\'createtime\'] = time();\\n        $input[\'updatetime\'] = time();\\n        $input[\'uid\'] = session(\'uid\');\\n        $id = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->insertGetId($input);\\n        $input[\'school_id\'] = $school_id;\\n        $result = $this->chooseSchool($input);\\n        Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->update([\\n                \'result\' => json_encode_cus($result),\\n                \'status\' => 1,\\n                \'updatetime\' => time()\\n            ]);\\n        $result[\'id\'] = $id;\\n        $result[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n        $this->success(\'success\', $result);\\n    }\\n    private function chooseSchool($input)\\n    {\\n        if (empty($input[\'school_attr\'])) {\\n            $input[\'school_attr\'] = \'\';\\n        }\\n        if (empty($input[\'math_status\'])) {\\n            $input[\'math_status\'] = 0;\\n        }\\n        if (empty($input[\'school_grades\'])) {\\n            $input[\'school_grades\'] = 0;\\n        }\\n        if (in_array($input[\'cet\'], [3, 4]) || ($input[\'math_status\'] == 2) || ($input[\'diff_major\'] == 3) || ($input[\'school_grades\'] == 4) || ($input[\'determination\'] == 1)) {\\n            $f = -1;\\n        } else {\\n            $f = 0;\\n        }\\n        if ($input[\'exam_year\'] == \'其他\') {\\n            $q = 1;\\n        } else {\\n            $chooseYear = strtotime(((int)$input[\'exam_year\']) . \'-12-25\');\\n            $preChooseYear = strtotime(\'-1 yaar\', $chooseYear);\\n            $nowYear = strtotime(date(\'Y\') . \'-12-25\');\\n            if ($preChooseYear > $nowYear) {\\n                $q = 1;\\n            } else {\\n                $q = 0;\\n            }\\n        }\\n        if (($input[\'school_grades\'] == 1) || ($input[\'determination\'] == 5) || in_array($input[\'now_standing\'], [1, 2, 3, 4, 5]) || $q == 1) {\\n            $k = 1;\\n        } else {\\n            $k = 0;\\n        }\\n        switch ($input[\'education_stading\']) {\\n            case 1:\\n                $k = 5;\\n                break;\\n            case 2:\\n                $k = 4;\\n                break;\\n            case 3:\\n                $k = 3;\\n                break;\\n            case 4:\\n                $k = 2;\\n                break;\\n            case 5:\\n                $k = 1;\\n                break;\\n            case 6:\\n                $k = 1;\\n                break;\\n            case 7:\\n                $k = 1;\\n                break;\\n        }\\n        $r = $f + $q + $k;\\n        if ($r < 1) {\\n            $r = 1;\\n        }\\n        if ($r > 5) {\\n            $r = 5;\\n        }\\n        $topWhere = $middleWhereMix = $middleWhereMajor = $lowerWhereMix = $lowerWhereMajor = [];\\n        $menlei = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n            ->join(\'t_cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n            ->where(\'a.id\', $input[\'major_id\'])\\n            ->value(\'b.menlei\');\\n        $schoolModel = new \\\\app\\\\admin\\\\model\\\\School();\\n        $typeToMenlei = $schoolModel->typeToMenlei();\\n        foreach ($typeToMenlei as $k => $v) {\\n            if (in_array($menlei, $v)) {\\n                $type = $k;\\n            }\\n        }\\n        $diffMajor = $input[\'diff_major\'];\\n        if ($diffMajor > 1) {\\n            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->join(\'cl_major_school_detail c\', \'b.id=c.major_school_id\', \'left\')\\n                ->where(\'b.major_id\', $input[\'major_id\'])\\n                ->where(\'c.year\', \'2022\')\\n                ->where(\'c.kzybk\', 1)\\n                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n                ->column(\'a.school_attr\', \'a.id\');\\n        } else {\\n            $schoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->whereIn(\'a.area_id\', $input[\'area_id\'])\\n                ->where(\'b.major_id\', $input[\'major_id\'])\\n                ->column(\'a.school_attr\', \'a.id\');\\n        }\\n        $nomalSchoolId = [];\\n        $schoolId985 = [];\\n        $schoolId211 = [];\\n        $schoolIdone = [];\\n        $expSchoolId = [];\\n        $assessmentSchoolList = Db::connect(\'database.yx_db_config\')->name(\'cl_school_yjxk\')\\n            ->field(\'school_id,min(subject_assessment) subject_assessment\')\\n            ->group(\'school_id\')\\n            ->select();\\n        $lowAssessment = [];\\n        $lowAssessment1 = [];\\n        foreach ($assessmentSchoolList as $k => $v) {\\n            if ($v[\'subject_assessment\'] > 3 || $v[\'subject_assessment\'] == 0) {\\n                $lowAssessment[] = $v[\'school_id\'];\\n            }\\n            if ($v[\'subject_assessment\'] > 1 || $v[\'subject_assessment\'] == 0) {\\n                $lowAssessment1[] = $v[\'school_id\'];\\n            }\\n        }\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $attrList = $model->getSchoolAttr();\\n        $schoolAttrChoose = $attrList[$input[\'school_attr\']] ?? \'\';\\n        foreach ($schoolList as $k => $v) {\\n            $schoolAttr = explode(\',\', $v);\\n            if ($v == \'普通院校\') {\\n                $nomalSchoolId[] = $k;\\n            }\\n            if (in_array(\'985\', $schoolAttr)) {\\n                $schoolId985[] = $k;\\n            }\\n            if (in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n                $schoolId211[] = $k;\\n            }\\n            if (in_array(\'双一流\', $schoolAttr) && !in_array(\'211\', $schoolAttr) && !in_array(\'985\', $schoolAttr)) {\\n                $schoolIdone[] = $k;\\n            }\\n            if (in_array($schoolAttrChoose, $schoolAttr)) {\\n                $expSchoolId[] = $k;\\n            }\\n        }\\n        if(empty($input[\'school_id\'])){\\n            $selfMajorSort = 1000000;\\n            $selfComprehensiveRanking = 10000;\\n        }else{\\n            $selfMajorSort = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->where(\'school_id\', $input[\'school_id\'])\\n                ->where(\'major_id\', $input[\'major_id\'])\\n                ->value(\'sort\');\\n            $selfComprehensiveRanking = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->where(\'id\', $input[\'school_id\'])\\n                ->value(\'comprehensive_ranking\');\\n        }\\n        $V = 0;\\n        if (!empty($input[\'school_attr\'])) {\\n            switch ($input[\'school_attr\']) {\\n                case 1:\\n                    $s = 5;\\n                    break;\\n                case 2:\\n                    $s = 4;\\n                    break;\\n                case 3:\\n                    $s = 3;\\n                    break;\\n                case 4:\\n                    $s = 2;\\n                    break;\\n            }\\n            $V = $s - $r;\\n        }\\n        \\/\\/综合推荐\\n        switch ($r) {\\n            case 1:\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n                $middleWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                if (!empty($type)) {\\n                    $middleWhereMix[\'type\'] = $type;\\n                }\\n                $topSort = \'desc\';\\n                $middleMajorSort = \'asc\';\\n                $middleMixSort = \'asc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'desc\';\\n                $expSort = \'desc\';\\n                $topStar = 2;\\n                $middleMajorStar = 3;\\n                $middleMixStar = 3;\\n                $lowerMajorStar = 4;\\n                $lowerMixStar = 4;\\n                $expStar = 5 - $V;\\n                break;\\n            case 2:\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment);\\n                $topWhere[\'id\'] = [\'in\', $schoolId211];\\n                $schoolId = array_unique(array_merge($schoolId211, $schoolIdone));\\n                $schoolId = array_intersect($schoolId, $lowAssessment);\\n                $nomalSchoolId = array_intersect($nomalSchoolId, $lowAssessment);\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                $lowerWhereMix[\'id\'] = [\'in\', $nomalSchoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $nomalSchoolId];\\n                if (!empty($type)) {\\n                    $topWhere[\'type\'] = $type;\\n                    $lowerWhereMajor[\'type\'] = $type;\\n                }\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'asc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V > 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 2;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                if ($V == 3) {\\n                    $expStar = 2;\\n                } else {\\n                    $expStar = 4;\\n                }\\n                break;\\n            case 3:\\n                $schoolId985 = array_intersect($schoolId985, $lowAssessment1);\\n                $topWhere[\'id\'] = [\'in\', $schoolId985];\\n                $schoolId211 = array_intersect($schoolId211, $lowAssessment1);\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId211];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n                $schoolId = array_unique(array_merge($nomalSchoolId, $schoolIdone));\\n                $schoolId = array_intersect($schoolId, $lowAssessment1);\\n                $lowerWhereMix[\'id\'] = [\'in\', $schoolId];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                if (!empty($type)) {\\n                    $lowerWhereMajor[\'type\'] = $type;\\n                }\\n                $topSort = \'desc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'asc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V > 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 3;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                if ($V == 2) {\\n                    $expStar = 3;\\n                } else {\\n                    $expStar = 4;\\n                }\\n                break;\\n            case 4:\\n                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n                $topWhere[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId985];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId211];\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'desc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V >= 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 2;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 3;\\n                $lowerMixStar = 3;\\n                $expStar = 4;\\n                break;\\n            case 5:\\n                $schoolId = array_unique(array_merge($schoolId985, $schoolId211));\\n                $topWhere[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                $middleWhereMix[\'id\'] = [\'in\', $schoolId985];\\n                $lowerWhereMajor[\'id\'] = [\'in\', $schoolId];\\n                if (!empty($type)) {\\n                    $topWhere[\'type\'] = $type;\\n                }\\n                $topSort = \'asc\';\\n                $middleMajorSort = \'asc\';\\n                $middleMixSort = \'desc\';\\n                $lowerMajorSort = \'desc\';\\n                $lowerMixSort = \'asc\';\\n                if ($V >= 0) {\\n                    $expSort = \'desc\';\\n                } else {\\n                    $expSort = \'asc\';\\n                }\\n                $topStar = 3;\\n                $middleMajorStar = 4;\\n                $middleMixStar = 4;\\n                $lowerMajorStar = 4;\\n                $lowerMixStar = 4;\\n                $expStar = 4;\\n                break;\\n        }\\n        if (!empty($input[\'school_attr\'])) {\\n            $expSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n                ->join(\'t_cl_school b\', \'a.school_id=b.id\', \'left\')\\n                ->whereIn(\'a.school_id\', $expSchoolId)\\n                ->where(\'a.major_id\', $input[\'major_id\'])\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $expSort)\\n                ->value(\'a.school_Id\');\\n        }\\n        $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($topWhere)\\n            ->column(\'id\');\\n        if ($r == 2) {\\n            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->whereIn(\'id\', $topSchoolId)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $topSort)\\n                ->value(\'id\');\\n        } else {\\n            $topSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->whereIn(\'school_id\', $topSchoolId)\\n                ->where(\'sort\', \'<\', $selfMajorSort)\\n                ->order(\'sort\', $topSort)\\n                ->value(\'school_id\');\\n        }\\n        $middleSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($middleWhereMajor)\\n            ->column(\'id\');\\n        $middleMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n            ->whereIn(\'school_id\', $middleSchoolIdMajor)\\n            ->where(\'sort\', \'<\', $selfMajorSort)\\n            ->order(\'sort\', $middleMajorSort)\\n            ->value(\'school_id\');\\n\\n        $middleSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($middleWhereMix)\\n            ->column(\'id\');\\n        $middleMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->whereIn(\'id\', $middleSchoolIdMix)\\n            ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n            ->order(\'comprehensive_ranking\', $middleMixSort)\\n            ->value(\'id\');\\n\\n        $lowerSchoolIdMajor = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n            ->where($lowerWhereMajor)\\n            ->column(\'id\');\\n        $lowerMajorSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n            ->whereIn(\'school_id\', $lowerSchoolIdMajor)\\n            ->where(\'sort\', \'<\', $selfMajorSort)\\n            ->order(\'sort\', $lowerMajorSort)\\n            ->value(\'school_id\');\\n        \\/\\/判断就读院校有没有期望专业信息\\n        if(empty($input[\'school_id\'])){\\n            $hasInfo = false;\\n        }else{\\n            $hasInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->where(\'school_id\', $input[\'school_id\'])\\n                ->where(\'major_id\', $input[\'major_id\'])\\n                ->count();\\n        }\\n\\n        if (in_array($r, [4, 5])) {\\n            if ($hasInfo) {\\n                $lowerMixSchoolId = $input[\'school_id\'];\\n            } else {\\n                $lowerMixSchoolId = [];\\n            }\\n        } else {\\n            $lowerSchoolIdMix = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->where($lowerWhereMix)\\n                ->column(\'id\');\\n            $lowerMixSchoolId = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                ->whereIn(\'id\', $lowerSchoolIdMix)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'comprehensive_ranking\', $lowerMixSort)\\n                ->value(\'id\');\\n        }\\n        $recommend = [];\\n        $recommend[\'mix\'][\'top\'][\'school_id\'] = (int)$topSchoolId;\\n        $recommend[\'mix\'][\'top\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'top\'][\'star\'] = (int)$topStar;\\n        $recommend[\'mix\'][\'midMajor\'][\'school_id\'] = (int)$middleMajorSchoolId;\\n        $recommend[\'mix\'][\'midMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'midMajor\'][\'star\'] = (int)$middleMajorStar;\\n        $recommend[\'mix\'][\'midMix\'][\'school_id\'] = (int)$middleMixSchoolId;\\n        $recommend[\'mix\'][\'midMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'midMix\'][\'star\'] = $middleMixStar;\\n        $recommend[\'mix\'][\'lowMajor\'][\'school_id\'] = (int)$lowerMajorSchoolId;\\n        $recommend[\'mix\'][\'lowMajor\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'lowMajor\'][\'star\'] = (int)$lowerMajorStar;\\n        $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$lowerMixSchoolId;\\n        $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n        $recommend[\'mix\'][\'lowMix\'][\'star\'] = (int)$lowerMixStar;\\n        if (!empty($topSchoolId)) {\\n            if ($topSchoolId == $middleMajorSchoolId || $topSchoolId == $middleMixSchoolId || $topSchoolId == $lowerMajorSchoolId || $topSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'top\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'top\'] = [];\\n        }\\n        if (!empty($middleMajorSchoolId)) {\\n            if ($middleMajorSchoolId == $middleMixSchoolId || $middleMajorSchoolId == $lowerMajorSchoolId || $middleMajorSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'midMajor\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'midMajor\'] = [];\\n        }\\n        if (!empty($middleMixSchoolId)) {\\n            if ($middleMixSchoolId == $lowerMajorSchoolId || $middleMixSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'midMix\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'midMix\'] = [];\\n        }\\n        if (!empty($lowerMajorSchoolId)) {\\n            if ($lowerMajorSchoolId == $lowerMixSchoolId) {\\n                $recommend[\'mix\'][\'lowMajor\'] = [];\\n            }\\n        } else {\\n            $recommend[\'mix\'][\'lowMajor\'] = [];\\n        }\\n        if (empty($lowerMixSchoolId)) {\\n            $recommend[\'mix\'][\'lowMix\'] = [];\\n        }\\n        if (empty($topSchoolId) && empty($middleMajorSchoolId) && empty($middleMixSchoolId) && empty($lowerMajorSchoolId) && empty($lowerMixSchoolId)) {\\n            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, 1);\\n            if ($school_id) {\\n                $recommend[\'mix\'][\'lowMix\'][\'school_id\'] = (int)$school_id;\\n                $recommend[\'mix\'][\'lowMix\'][\'major_id\'] = (int)$input[\'major_id\'];\\n                $recommend[\'mix\'][\'lowMix\'][\'star\'] = 3;\\n            } else {\\n                $recommend[\'mix\'][\'lowMix\'] = [];\\n            }\\n        }\\n        \\/\\/期望推荐\\n        if (!empty($expSchoolId)) {\\n            $recommend[\'exp\'][\'school_id\'] = $expSchoolId;\\n            $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n            $recommend[\'exp\'][\'star\'] = $expStar;\\n        } else {\\n            $school_id = $this->baodi($input, $schoolAttrChoose, $selfComprehensiveRanking);\\n            if ($school_id) {\\n                $recommend[\'exp\'][\'school_id\'] = $school_id;\\n                $recommend[\'exp\'][\'major_id\'] = $input[\'major_id\'];\\n                $recommend[\'exp\'][\'star\'] = 3;\\n            } else {\\n                $recommend[\'exp\'] = [];\\n            }\\n        }\\n        return $recommend;\\n    }\\n    \\/**\\n     * desc:保底推荐规则\\n     * author:hufangfang\\n     * data:2023\\/1\\/7 15:09\\n     * @param $input\\n     * @param $schoolAttrChoose\\n     * @param $selfComprehensiveRanking\\n     * @return float|int|mixed|string\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    private function baodi($input, $schoolAttrChoose, $selfComprehensiveRanking, $type = 0)\\n    {\\n        $school_id = 0;\\n        $where[\'a.area_id\'] = [\'in\', $input[\'area_id\']];\\n        $where[\'b.major_id\'] = $input[\'major_id\'];\\n        $where[\'a.id\'] = [\'<>\', $input[\'school_id\']];\\n        if ($type) {\\n            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->where($where)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'a.comprehensive_ranking\', \'desc\')\\n                ->value(\'a.id\');\\n            if (empty($school_id)) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                    ->where($where)\\n                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n                    ->value(\'a.id\');\\n            }\\n            return $school_id;\\n        }\\n        $baodiSchool = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n            ->where($where)\\n            ->field(\'a.id,a.school_attr,a.comprehensive_ranking\')\\n            ->select();\\n        if (empty($baodiSchool)) {\\n            return $school_id;\\n        }\\n        $attrSchoolList = [];\\n        foreach ($baodiSchool as $school) {\\n            $attr = explode(\',\', $school[\'school_attr\']);\\n            if (!empty($attr)) {\\n                foreach ($attr as $k => $v) {\\n                    $attrSchoolList[$v][] = $school[\'id\'];\\n                }\\n            }\\n        }\\n        if (!empty($schoolAttrChoose)) {\\n            if (!empty($attrSchoolList[$schoolAttrChoose])) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                    ->whereIn(\'id\', $attrSchoolList[$schoolAttrChoose])\\n                    ->order(\'comprehensive_ranking\', \'asc\')\\n                    ->value(\'id\');\\n            } else {\\n                switch ($schoolAttrChoose) {\\n                    case \'985\':\\n                        if (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'211\':\\n                        if (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'双一流\':\\n                        if (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'普通院校\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'普通院校\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                    case \'普通院校\':\\n                        if (!empty($attrSchoolList[\'双一流\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'双一流\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'211\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'211\'])\\n                                ->order(\'comprehensive_ranking\', \'desc\')\\n                                ->value(\'id\');\\n                        } elseif (!empty($attrSchoolList[\'985\'])) {\\n                            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n                                ->whereIn(\'id\', $attrSchoolList[\'985\'])\\n                                ->order(\'comprehensive_ranking\', \'asc\')\\n                                ->value(\'id\');\\n                        }\\n                        break;\\n                }\\n            }\\n        } else {\\n            $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                ->where($where)\\n                ->where(\'comprehensive_ranking\', \'<\', $selfComprehensiveRanking)\\n                ->order(\'a.comprehensive_ranking\', \'desc\')\\n                ->value(\'a.id\');\\n            if (empty($school_id)) {\\n                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n                    ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n                    ->where($where)\\n                    ->where(\'comprehensive_ranking\', \'>\', $selfComprehensiveRanking)\\n                    ->order(\'a.comprehensive_ranking\', \'asc\')\\n                    ->value(\'a.id\');\\n            }\\n        }\\n        return $school_id;\\n    }\\n    \\/**\\n     * desc:择校选项列表\\n     * author:hufangfang\\n     * data:2022\\/12\\/6 17:51\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function getSelect()\\n    {\\n        $list = [];\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $nowStanding = $model->getNowStanding();\\n        $data = [];\\n        foreach ($nowStanding as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'now_standing\'] = $data;\\n        $educationStading = $model->getEducationStading();\\n        $data = [];\\n        foreach ($educationStading as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'education_stading\'] = $data;\\n\\n        $cet = $model->getCet();\\n        $data = [];\\n        foreach ($cet as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'cet\'] = $data;\\n        $diff_major = $model->getDiffMajor();\\n        $data = [];\\n        foreach ($diff_major as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'diff_major\'] = $data;\\n        $school_attr = $model->getSchoolAttr();\\n        $data = [];\\n        foreach ($school_attr as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            if ($v === \'普通院校\') {\\n                $item[\'value\'] = $v;\\n            } else {\\n                $item[\'value\'] = $v . \'院校\';\\n            }\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'school_attr\'] = $data;\\n        $school_grades = $model->getSchoolGrades();\\n        $data = [];\\n        foreach ($school_grades as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'school_grades\'] = $data;\\n        $math_status = $model->getMathStatus();\\n        $data = [];\\n        foreach ($math_status as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'math_status\'] = $data;\\n        $exam_year = $model->getExamYear();\\n        $data = [];\\n        foreach ($exam_year as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'exam_year\'] = $data;\\n        $determination = $model->getDetermination();\\n        $data = [];\\n        foreach ($determination as $k => $v) {\\n            $item = [];\\n            $item[\'key\'] = $k;\\n            $item[\'value\'] = $v;\\n            $ps = \'\';\\n            switch (intval($v)){\\n                case 1:\\n                    $ps = \'随缘考试\';\\n                    break;\\n                case 2:\\n                    $ps = \'稍稍准备\';\\n                    break;\\n                case 3:\\n                    $ps = \'严肃对待\';\\n                    break;\\n                case 4:\\n                    $ps = \'全力备考\';\\n                    break;\\n                case 5:\\n                    $ps = \'势必成硕\';\\n                    break;\\n            }\\n            $item[\'ps\'] = $ps;\\n            $data[] = $item;\\n        }\\n        array_shift($data);\\n        $list[\'determination\'] = $data;\\n        $area = Db::connect(\'database.yx_db_config\')\\n            ->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->field(\'id as `key`,name as value\')\\n            ->select();\\n        $list[\'area\'] = $area;\\n        $this->success(\'success\', $list);\\n    }\\n    \\/**\\n     * desc:学校列表\\n     * author:hufangfang\\n     * data:2022\\/12\\/6 17:51\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function schoolList()\\n    {\\n        $schoolName = input(\'school_name\', \'\');\\n        $isApp = input(\'is_app\', 0);\\n        $where = [];\\n        $where[\'a.is_hidden\'] = 0;\\n        if (!empty($schoolName)) {\\n            $where[\'a.school_name\'] = [\'like\', $schoolName . \'%\'];\\n        }\\n        $schoolList = Db::connect(\'database.uc_db_config\')\\n            ->name(\'school\')->alias(\'a\')\\n            ->join(\'cl_area b\', \'a.province_id=b.id\')\\n            ->where($where)\\n            ->field(\'a.school_id as id,a.school_name as name,a.first_pinyin,b.name as province_name\')\\n            ->order(\'first_pinyin asc,name asc\')\\n            ->select();\\n        $data = [];\\n        foreach ($schoolList as $k => $v) {\\n            $item[\'id\'] = $v[\'id\'];\\n            $item[\'name\'] = $v[\'name\'];\\n            $item[\'area_name\'] = $v[\'province_name\'];\\n            if (!empty($schoolName)) {\\n                $data[] = $item;\\n            } else {\\n                $data[$v[\'first_pinyin\']][] = $item;\\n            }\\n        }\\n        if ($isApp && empty($schoolName)) {\\n            $return = [];\\n            foreach ($data as $k => $v) {\\n                $item = [];\\n                $item[\'key\'] = (string)$k;\\n                $item[\'list\'] = $v;\\n                $return[] = $item;\\n            }\\n            $data = $return;\\n        }\\n        $this->success(\'success\', $data);\\n    }\\n    \\/**\\n     * desc:择校档案列表\\n     * author:hufangfang\\n     * data:2022\\/12\\/26 19:45\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function history()\\n    {\\n        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'uid\', session(\'uid\'))\\n            ->order(\'createtime\', \'desc\')\\n            ->limit(10)\\n            ->select();\\n        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n            ->column(\'name\', \'id\');\\n        $return = [];\\n        if (!empty($list)) {\\n            $item = [];\\n            foreach ($list as $k => $v) {\\n                $item[\'area\'] = explode(\',\', $v[\'area_id\']);\\n                foreach ($item[\'area\'] as $kk => $vv) {\\n                    $item[\'area\'][$kk] = $areaList[$vv] ?? \'\';\\n                }\\n                $item[\'id\'] = $v[\'id\'];\\n                $item[\'area\'] = implode(\',\', $item[\'area\']);\\n                $item[\'major_name\'] = $majorList[$v[\'major_id\']] ?? \'\';\\n                $item[\'createtime\'] = date(\'Y-m-d H:i:s\', $v[\'createtime\']);\\n                $return[$k] = $item;\\n            }\\n        }\\n        $this->success(\'success\', $return);\\n    }\\n    \\/**\\n     * desc:档案详情\\n     * author:hufangfang\\n     * data:2022\\/12\\/26 19:52\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function recordDetail()\\n    {\\n        $id = input(\'id\', 0);\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->order(\'createtime\', \'desc\')\\n            ->find();\\n        if (!empty($record)) {\\n            $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n            $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n                ->where(\'pid\', \'>\', 0)\\n                ->column(\'name\', \'id\');\\n            $majorList = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n                ->column(\'name\', \'id\');\\n            $schoolList = Db::connect(\'database.uc_db_config\')->name(\'school\')\\n                ->where(\'is_hidden\', 0)\\n                ->column(\'school_name\', \'school_id\');\\n            $nowStanding = $model->getNowStanding();\\n            $educationStading = $model->getEducationStading();\\n            $cet = $model->getCet();\\n            $diff_major = $model->getDiffMajor();\\n            $school_attr = $model->getSchoolAttr();\\n            $school_grades = $model->getSchoolGrades();\\n            $math_status = $model->getMathStatus();\\n            $determination = $model->getDetermination();\\n            $record[\'area\'] = explode(\',\', $record[\'area_id\']);\\n            $record[\'area_id\'] = [];\\n            foreach ($record[\'area\'] as $kk => $vv) {\\n                $record[\'area_id\'][] = $areaList[$vv] ?? \'\';\\n            }\\n            unset($record[\'area\']);\\n            $record[\'area_id\'] = implode(\',\', $record[\'area_id\']);\\n            $record[\'now_standing\'] = $nowStanding[$record[\'now_standing\']] ?? \'\';\\n            $record[\'school_id\'] = $schoolList[$record[\'school_id\']] ?? \'\';\\n            $record[\'diff_major\'] = $diff_major[$record[\'diff_major\']] ?? \'\';\\n\\n            if (empty($record[\'school_attr\'])) {\\n                $record[\'school_attr\'] = \'\';\\n            } else {\\n                $record[\'school_attr\'] = $school_attr[$record[\'school_attr\']] ?? \'\';\\n            }\\n            if (empty($record[\'school_grades\'])) {\\n                $record[\'school_grades\'] = \'\';\\n            } else {\\n                $record[\'school_grades\'] = $school_grades[$record[\'school_grades\']] ?? \'\';\\n            }\\n            $record[\'cet\'] = $cet[$record[\'cet\']] ?? \'\';\\n            if (empty($record[\'cet\'])) {\\n                $record[\'cet\'] = \'\';\\n            }\\n            if (empty($record[\'math_status\'])) {\\n                $record[\'math_status\'] = \'\';\\n            } else {\\n                $record[\'math_status\'] = $math_status[$record[\'math_status\']] ?? \'\';\\n            }\\n            $record[\'major_id\'] = $majorList[$record[\'major_id\']] ?? \'\';\\n            $record[\'determination\'] = $determination[$record[\'determination\']] ?? \'\';\\n            $record[\'createtime\'] = date(\'Y-m-d H:i:s\', $record[\'createtime\']);\\n            $record[\'education_stading\'] = $educationStading[$record[\'education_stading\']] ?? \'\';\\n        } else {\\n            $record = [];\\n        }\\n        $uid = $record[\'uid\'];\\n        $userInfo = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $uid)\\n            ->field(\'uid,username,mobile\')\\n            ->find();\\n        $userInfo[\'createtime\'] = $record[\'createtime\'];\\n        $return = [];\\n        $return[\'userInfo\'] = $userInfo;\\n        $return[\'detail\'] = $record;\\n        $return[\'url\'] = config(\'ai_url\') . \\\"?id=\\\" . $id;\\n        $this->success(\'success\', $return);\\n    }\\n    \\/**\\n     * desc:\\n     * author:hufangfang\\n     * data:2022\\/12\\/8 16:03\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function info()\\n    {\\n        $id = input(\'id\', 0);\\n        $type = input(\'type\', 0);\\n        $isfeishu = input(\'isfeishu\', 0);\\n        $info = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->find();\\n        $result = $info[\'result\'];\\n        $return = [];\\n        $intentMajorInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n            ->join(\'cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n            ->where(\'a.id\', $info[\'major_id\'])\\n            ->field(\'a.name,a.code,b.menlei,b.type\')\\n            ->find();\\n        $area = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $intent[\'major_name\'] = $intentMajorInfo[\'name\'] ?? \'\';\\n        $intent[\'major_code\'] = $intentMajorInfo[\'code\'] ?? \'\';\\n        $intent[\'major_id\'] = $info[\'major_id\'];\\n        $intent[\'menlei\'] = $intentMajorInfo[\'menlei\'];\\n        $intent[\'type\'] = $intentMajorInfo[\'type\'];\\n        $intentAreaId = $info[\'area_id\'];\\n        $areaName = [];\\n        if (!empty($intentAreaId)) {\\n            $intentAreaId = explode(\',\', $intentAreaId);\\n            foreach ($intentAreaId as $K => $v) {\\n                $areaName[] = $area[$v] ?? \'\';\\n            }\\n        }\\n        $intent[\'area\'] = implode(\'、\', $areaName);\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $school_attr = $model->getSchoolAttr();\\n        if (!empty($info[\'school_attr\'])) {\\n            $intent[\'school_attr\'] = $school_attr[$info[\'school_attr\']] ?? \'\';\\n        } else {\\n            $intent[\'school_attr\'] = \'\';\\n        }\\n        $where = [];\\n        $where[\'a.area_id\'] = [\'in\', $info[\'area_id\']];\\n        $where[\'b.major_id\'] = $info[\'major_id\'];\\n        $schoolNum = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')->alias(\'a\')\\n            ->join(\'cl_major_school b\', \'a.id=b.school_id\', \'left\')\\n            ->where($where)\\n            ->group(\'a.id\')\\n            ->count();\\n        $area_school_info = \'当前地区符合您意向专业的院校共有\' . $schoolNum . \'所\';\\n        $intent[\'area_school_info\'] = $area_school_info;\\n        $return[\'intent\'] = $intent;\\n        $result = json_decode($result, \'true\');\\n        $return[\'ai_result\'] = $result;\\n        $majorInfo = $this->getMajorInfo($result, $type, $info[\'uid\'], $isfeishu, $area);\\n        $status = accessControl(1,$majorInfo[\'major_school_id\']);\\n        if(!$status){\\n            if($status===0){\\n                $this->error(\'您操作过于频繁，请稍后再试\');\\n            }else{\\n                $this->error(\'您的账号存在异常，请联系客服\');\\n            }\\n        }\\n        if (empty($majorInfo)) {\\n            $this->success(\'success\', $return);\\n        }\\n        \\/\\/综合推荐\\n        $return[\'mix\'] = $majorInfo;\\n        \\/\\/期望院校推荐\\n        if (!empty($result[\'exp\'])) {\\n            $majorId = $result[\'exp\'][\'major_id\'] ?? 0;\\n            $schoolId = $result[\'exp\'][\'school_id\'] ?? 0;\\n            $star = $result[\'exp\'][\'star\'] ?? 0;\\n            $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n                ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n                ->where(\'a.major_id\', $majorId)\\n                ->where(\'a.school_id\', $schoolId)\\n                ->order(\'b.first_pinyin\', \'asc\')\\n                ->value(\'a.id\');\\n            $majorInfo = $this->majorSchoolModel\\n                ->alias(\'ms\')\\n                ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n                ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n                ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n                ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n                ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n                ->field(\'sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n                ->where(\'ms.id\', $majorSchoolId)\\n                ->find();\\n            if (!empty($majorInfo)) {\\n                $adminSchoolMajor = new SchoolMajor();\\n                $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n                $majorInfo[\'star\'] = $star;\\n                $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n                $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n                $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n                $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n                if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n                    $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n                }\\n                $return[\'exp\'] = $majorInfo;\\n            } else {\\n                $return[\'exp\'] = [];\\n            }\\n        } else {\\n            $return[\'exp\'] = [];\\n        }\\n        $this->success(\'success\', $return);\\n    }\\n    \\/**\\n     * desc:综合推荐专业详情\\n     * author:hufangfang\\n     * data:2022\\/12\\/21 11:25\\n     * @param $result\\n     * @param $type\\n     * @param $isfeishu\\n     * @return mixed\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    private function getMajorInfo($result, $type, $uid, $isfeishu, $area)\\n    {\\n        $majorId = 0;\\n        $schoolId = 0;\\n        $star = 0;\\n        if (empty($result)) {\\n            return false;\\n        }\\n        if (empty($type)) {\\n            foreach ($result[\'mix\'] as $k => $v) {\\n                $majorId = $v[\'major_id\'] ?? 0;\\n                $schoolId = $v[\'school_id\'] ?? 0;\\n                $star = $v[\'star\'] ?? 0;\\n                if ($k == \'midMajor\' && !empty($v)) {\\n                    $type = 1;\\n                    break;\\n                }\\n                if ($k == \'midMix\' && !empty($v)) {\\n                    $type = 2;\\n                    break;\\n                }\\n                if ($k == \'top\' && !empty($v)) {\\n                    $type = 3;\\n                    break;\\n                }\\n                if ($k == \'lowMajor\' && !empty($v)) {\\n                    $type = 4;\\n                    break;\\n                }\\n                if ($k == \'lowMix\' && !empty($v)) {\\n                    $type = 5;\\n                    break;\\n                }\\n            }\\n        } else {\\n            switch ($type) {\\n                case 1:\\n                    $majorId = $result[\'mix\'][\'midMajor\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'midMajor\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'midMajor\'][\'star\'] ?? 0;\\n                    break;\\n                case 2:\\n                    $majorId = $result[\'mix\'][\'midMix\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'midMix\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'midMix\'][\'star\'] ?? 0;\\n                    break;\\n                case 3:\\n                    $majorId = $result[\'mix\'][\'top\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'top\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'top\'][\'star\'] ?? 0;\\n                    break;\\n                case 4:\\n                    $majorId = $result[\'mix\'][\'lowMajor\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'lowMajor\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'lowMajor\'][\'star\'] ?? 0;\\n                    break;\\n                case 5:\\n                    $majorId = $result[\'mix\'][\'lowMix\'][\'major_id\'] ?? 0;\\n                    $schoolId = $result[\'mix\'][\'lowMix\'][\'school_id\'] ?? 0;\\n                    $star = $result[\'mix\'][\'lowMix\'][\'star\'] ?? 0;\\n                    break;\\n            }\\n        }\\n        if (empty($majorId) || empty($schoolId)) {\\n            return false;\\n        }\\n        $majorSchoolId = $this->majorSchoolModel->alias(\'a\')\\n            ->join(\'cl_yuanxi b\', \'a.yuanxi_id=b.id\', \'left\')\\n            ->where(\'a.major_id\', $majorId)\\n            ->where(\'a.school_id\', $schoolId)\\n            ->order(\'b.first_pinyin\', \'asc\')\\n            ->value(\'a.id\');\\n        if (!$majorSchoolId) {\\n            return false;\\n        }\\n        $majorInfo = $this->majorSchoolModel\\n            ->alias(\'ms\')\\n            ->join(\'cl_major m\', \'ms.major_id = m.id\', \'LEFT\')\\n            ->join(\'cl_yuanxi yx\', \'ms.yuanxi_id = yx.id\', \'LEFT\')\\n            ->join(\'cl_yjxk yjxk\', \'m.yjxk_id = yjxk.id\', \'LEFT\')\\n            ->join(\'cl_school sch\', \'ms.school_id = sch.id\', \'LEFT\')\\n            ->join(\'cl_school_yjxk sch_yjxk\', \'m.yjxk_id = sch_yjxk.yjxk_id AND ms.school_id = sch_yjxk.school_id\', \'LEFT\')\\n            ->field(\'yx.intro,sch.comprehensive_ranking,sch.school_attr,sch.area_id, sch.logo as school_logo, sch.name as school_name, m.name as major_name, m.code, ms.is_full, yx.name as yx_name, yjxk.name as yjxk_name, yjxk.type, yjxk.menlei, IFNULL(subject_assessment,100) as subject_assessment, ms.major_id, ms.school_id, ms.yuanxi_id\')\\n            ->where(\'ms.id\', $majorSchoolId)\\n            ->find();\\n        if ($majorInfo[\'comprehensive_ranking\'] == 10000) {\\n            $majorInfo[\'comprehensive_ranking\'] = \'暂无\';\\n        }\\n        $school_name = $majorInfo[\'school_name\'];\\n        $school_attr = $majorInfo[\'school_attr\'];\\n        $majorInfo[\'school_attr\'] = explode(\',\', $majorInfo[\'school_attr\']);\\n        $sort = $majorInfo[\'comprehensive_ranking\'];\\n        $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n        $juge = $subjectAssessMent[$majorInfo[\'subject_assessment\']] ?? \'\';\\n        $xueke = \'\';\\n        if (!empty($juge)) {\\n            $xueke = \'，学科评估为\' . $juge;\\n        }\\n        switch ($type) {\\n            case 1:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，更具有专业竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n                break;\\n            case 2:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，院校更具有竞争力，对未来职业发展帮助更大。经过名师专业指导培训后，您有较高概率通过考试，详细学习计划请微信咨询老师。\';\\n                break;\\n            case 3:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . \'大学，综合排名\' . $sort . $xueke . \'，学历含金量很高，建议尝试报考。虽然面临一定考试难度，相信经过我们的指导后，通过您的100%对学些的投入，还是有机会考取该院校的，联系学习规划老师获取详细方案。\';\\n                break;\\n            case 4:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n                break;\\n            case 5:\\n                $introReason = \'推荐您报考\\\"\' . $school_name . \'\\\"，院校为\' . $school_attr . $xueke . \'，经过学习后，上岸几率比较大\';\\n                break;\\n        }\\n        if ($majorInfo) {\\n            $adminSchoolMajor = new SchoolMajor();\\n            $majorInfo[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($majorInfo[\'subject_assessment\']);\\n            $majorInfo[\'introReason\'] = $introReason;\\n            $majorInfo[\'star\'] = $star;\\n            $majorInfo[\'area\'] = $area[$majorInfo[\'area_id\']] ?? \'\';\\n            if ($uid) {\\n                $teacherInfo = getQrcode($uid, $isfeishu);\\n            }\\n            $lqxx = (new \\\\app\\\\api\\\\logic\\\\Pic())->getLqxx($majorSchoolId, $majorInfo, $uid);\\n            $majorInfo[\'zlrsUrl\'] = $lqxx[\'zlrsUrl\'];\\n            $majorInfo[\'fushi\'] = $lqxx[\'fushi\'];\\n            $majorInfo[\'year_vs_score\'] = $lqxx[\'year_vs_score\'];\\n            $majorInfo[\'has_year_vs_score\'] = $lqxx[\'has_year_vs_score\'];\\n            $majorInfo[\'is_vip\'] = $lqxx[\'is_vip\'];\\n            $majorInfo[\'analysis\'] = $lqxx[\'analysis\'];\\n            if (!empty($teacherInfo)) {\\n                $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n                    ->where(\'uid\', $uid)\\n                    ->value(\'username\');\\n                $teacherInfo[\'nickname\'] = $nickname;\\n                $teacherInfo[\'head_url\'] = Config(\'fc_website_url\') . \'\\/proxy\\/\' . get_avatar_path($uid);\\n            } else {\\n                $teacherInfo = [];\\n            }\\n            $majorInfo[\'teacher\'] = $teacherInfo;\\n            $majorInfo[\'type\'] = $type;\\n            $majorInfo[\'major_school_id\'] = $majorSchoolId;\\n            \\/\\/院校默认图\\n            $majorInfo[\'school_logo\'] = School::schoolLogo($majorInfo[\'school_logo\']);\\n        }\\n        return $majorInfo;\\n    }\\n    \\/**\\n     * desc:根据专业获取学校排名\\n     * author:hufangfang\\n     * data:2022\\/12\\/21 11:26\\n     * @return void\\n     * @throws Exception\\n     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n     * @throws \\\\think\\\\exception\\\\DbException\\n     *\\/\\n    public function schoolOrder()\\n    {\\n        $majorId = input(\'major_id\\/d\', 0);\\n        $p = input(\'p\\/d\', 1);\\n        $limit = input(\'limit\\/d\', 10);\\n        if ($p < 1) {\\n            $p = 1;\\n        }\\n        if ($limit < 1) {\\n            $limit = 10;\\n        }\\n        if (empty($majorId)) {\\n            $this->success(\'success\');\\n        }\\n        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n            ->join(\'cl_school b\', \'a.school_id=b.id\', \'left\')\\n            ->join(\'cl_yuanxi c\', \'a.yuanxi_id=c.id\', \'left\')\\n            ->join(\'cl_major e\', \'a.major_id=e.id\', \'left\')\\n            ->join(\'cl_school_yjxk d\', \'a.school_id=d.school_id and d.yjxk_id=e.yjxk_id\', \'left\')\\n            ->field(\'a.school_id,a.major_id,b.name school_name,e.name major_name,b.area_id,b.school_attr,b.comprehensive_ranking,c.name yuanxi_name,d.subject_assessment,b.logo\')\\n            ->where(\'a.major_id\', $majorId)\\n            ->order(\'comprehensive_ranking,c.first_pinyin\')\\n            ->limit(50)\\n            ->select();\\n        $areaList = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n            ->where(\'pid\', \'>\', 0)\\n            ->column(\'name\', \'id\');\\n        $return = [];\\n        $adminSchoolMajor = new SchoolMajor();\\n        foreach ($list as $k => $v) {\\n            $v[\'area_name\'] = $areaList[$v[\'area_id\']] ?? \'\';\\n            $v[\'subject_assessment\'] = $adminSchoolMajor->getSubjectAssessment($v[\'subject_assessment\']);\\n            if (!empty($v[\'school_attr\'])) {\\n                $v[\'school_attr\'] = explode(\',\', $v[\'school_attr\']);\\n            } else {\\n                $v[\'school_attr\'] = [];\\n            }\\n            $v[\'logo\'] = School::schoolLogo($v[\'logo\']);\\n            if (empty($return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']])) {\\n                $return[$v[\'school_id\'] . \'_\' . $v[\'major_id\']] = $v;\\n            }\\n            if ($v[\'comprehensive_ranking\'] == 10000) {\\n                $v[\'comprehensive_ranking\'] = \'暂无\';\\n            }\\n        }\\n        $this->success(\'success\', array_values($return));\\n    }\\n    \\/\\/发送飞书消息\\n    public function feishuMessage()\\n    {\\n        $tutorId = input(\'tutor_id\', \'\');\\n        $id = input(\'id\', 0);\\n        if (empty($tutorId) || empty($id)) {\\n            $this->error(\'参数错误\');\\n        }\\n        $mobile = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $tutorId)\\n            ->value(\'mobile\');\\n        $record = Db::connect(\'database.yx_db_config\')->name(\'cl_ai_choose_school\')\\n            ->where(\'id\', $id)\\n            ->find();\\n        if (empty($record)) {\\n            $this->error(\'id错误\');\\n        }\\n        $key = \'yuanxiao:feishu:tutor:notice:\' . $tutorId . \':\' . $id;\\n        $cache = redis()->get($key);\\n        if ($cache) {\\n            $this->success(\'success\', []);\\n        }\\n        $uid = $record[\'uid\'];\\n        $nickname = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n            ->where(\'uid\', $uid)\\n            ->value(\'username\');\\n        $url = config(\'feishu_jump_url\') . \'?refresh=1&refer=\' . urlencode(\'https:\\/\\/wxapp.orangevip.com\\/choice-record?id=\' . $id . \'&isfeishu=1\');\\n        $message = \'您的学员\' . $nickname . \'，进行了AI择校。点击连接，查看学生择校信息：\' . $url;\\n        $data[\'type\'] = \'post\';\\n        $data[\'message\'][\'title\'] = \\\"AI择校消息通知\\\";\\n        $text1 = $message;\\n        $content1[] = [\'tag\' => \'text\', \'un_escape\' => true, \'text\' => $text1];\\n        $data[\'message\'][\'content\'][] = $content1;\\n        $data[\'mobile\'] = $mobile;\\n        $res = Helpers::clphpCurl($data);\\n        redis()->set($key, 1);\\n        $this->success(\'success\', $res);\\n    }\\n    \\/**\\n     * desc:判断科目是否考数一数二or数三\\n     * author:hufangfang\\n     * data:2023\\/1\\/4 10:13\\n     * @return void\\n     * @throws Exception\\n     *\\/\\n    public function majorExamSubject()\\n    {\\n        $majorId = input(\'major_id\', 0);\\n        $examSubject = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n            ->where(\'id\', $majorId)\\n            ->value(\'exam_subject\');\\n        $hasMath = false;\\n        if (!empty($examSubject)) {\\n            $examSubject = explode(\',\', $examSubject);\\n            foreach ($examSubject as $k => $v) {\\n                if (in_array($v, [\'数学一\', \'数学二\', \'数学三\'])) {\\n                    $hasMath = true;\\n                    break;\\n                }\\n            }\\n        }\\n        $this->success(\'success\', [\'has_math\' => $hasMath]);\\n    }\\n\\n    public function testQrcode()\\n    {\\n        $res = getQrcode(1, 0);\\n    }\\n}\\n\",\"numLines\":1522,\"startLine\":1,\"totalLines\":1522}}}' , `created_at` = '2026-07-07 21:36:17' [ RunTime:0.007687s ]

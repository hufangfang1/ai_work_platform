[2026-07-08T01:11:20+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 10 , `seq` = 99 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_00_CN8gqWXDupBFJiCpnyBK7781\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n6\\tuse app\\\\common\\\\library\\\\Helpers;\\n7\\tuse org\\\\Es;\\n8\\tuse think\\\\Db;\\n9\\tuse app\\\\admin\\\\model\\\\SchoolMajor;\\n10\\tuse think\\\\Config;\\n11\\tuse PhpOffice\\\\PhpSpreadsheet\\\\IOFactory;\\n12\\tuse PhpOffice\\\\PhpSpreadsheet\\\\Spreadsheet;\\n13\\tuse PhpOffice\\\\PhpSpreadsheet\\\\RichText\\\\RichText;\\n14\\t\\n15\\t\\/**\\n16\\t * 首页接口\\n17\\t *\\/\\n18\\tclass Search extends ApiAuth\\n19\\t{\\n20\\t    protected $noNeedRight = [\'*\'];\\n21\\t    protected $noAuth = [\'getfeedbackselect\', \'fback\', \'webfback\', \'schoollist\', \'majorlist\', \'download\', \'getdownloadids\', \'yuanxilist\', \'learnlist\',\'menlei\',\'majorlistv2\'];\\n22\\t    protected $noNeedLogin = [\'getfeedbackselect\', \'fback\', \'yuanxilist\', \'learnlist\',\'menlei\', \'schoollist\', \'majorlistv2\'];\\n23\\t    protected $needVpn = [\'index\'];\\n24\\t    protected $searchNum = 400;\\n25\\t\\n26\\t    public function _initialize()\\n27\\t    {\\n28\\t        parent::_initialize();\\n29\\t\\n30\\t        $actionname = strtolower($this->request->action());\\n31\\t        $appid = input(\'appid\', \'\');\\n32\\t        if (empty($appid) && !in_array($actionname, $this->noAuth)) {\\n33\\t            $params[\'uid\'] = session(\'uid\');\\n34\\t            $params[\'system_id\'] = 20;\\n35\\t            $result = Helpers::authCurl($params, \'auth_admin_rules\');\\n36\\t            if (!empty($result[\'data\'])) {\\n37\\t                if (array_search(\'search\', $result[\'data\']) === false) {\\n38\\t                    $this->error(\'没有权限\', \'\', 403);\\n39\\t                }\\n40\\t            } else {\\n41\\t                $this->error(\'没有权限\', \'\', 403);\\n42\\t            }\\n43\\t        }\\n44\\t    }\\n45\\t\\n46\\t    \\/**\\n47\\t     * 首页\\n48\\t     *\\n49\\t     *\\/\\n50\\t    public function index()\\n51\\t    {\\n52\\t        try {\\n53\\t            if (empty($id)) {\\n54\\t                \\/\\/记录查询次数\\n55\\t                $catchId = session(\'uid\') . \'-\' . date(\'Y-md\', time());\\n56\\t                $query_times = redis()->get($catchId);\\n57\\t                if ($query_times === false) {\\n58\\t                    redis()->incr($catchId);\\n59\\t                    redis()->expire($catchId, 24 * 60 * 60);\\n60\\t                } elseif ($query_times >= $this->searchNum) {\\n61\\t                    $this->error(\'查询次数已用完\');\\n62\\t                } else {\\n63\\t                    redis()->incr($catchId);\\n64\\t                }\\n65\\t            }\\n66\\t            adminLogRecord(\'院校库内部查询后台\', \'\', 3);\\n67\\t            list($where, $sort) = $this->buildWhere();\\n68\\t            $es = new Es();\\n69\\t            if (empty($sort)) {\\n70\\t                $sort[\'first_pinyin\'] = \'asc\';\\n71\\t                $sort[\'subject_assessment\'] = \'asc\';\\n72\\t                $sort[\'major_code\'] = \'asc\';\\n73\\t                $sort[\'is_full\'] = \'asc\';\\n74\\t            }\\n75\\t            $year = input(\'year\', date(\'Y\', time()));\\n76\\t            $field = [\\n77\\t                \\\"area_id\\\", \\\"year\\\", \\\"area_name\\\", \\\"school_id\\\", \\\"first_pinyin\\\", \\\"school_name\\\", \\\"school_code\\\", \\\"school_type\\\", \\\"school_first_pinyin\\\", \\\"school_attr\\\", \\\"major_id\\\", \\\"major_name\\\", \\\"major_code\\\", \\\"yjxk_id\\\", \\\"yjxk_name\\\", \\\"yjxk_code\\\", \\\"menlei\\\", \\\"yjxk_type\\\", \\\"subject_assessment\\\", \\\"yuanxi_id\\\", \\\"yuanxi_name\\\", \\\"is_full\\\", \\\"jyqj\\\", \\\"bxcc\\\", \\\"exam_subject\\\", \\\"kzybk\\\", \'yjfx\', \'cskm\', \\\"yqgzjy\\\", \\\"same_demand\\\", \\\"major_school_id\\\", \\\"major_school_detail_id\\\", \\\"zongfen\\\", \\\"is_demand\\\", \\\"jyfx\\\", \\\"mid_score\\\", \\\"tags\\\"\\n78\\t            ];\\n79\\t            $res = $es->search($where, [], $sort, \'\', 0, 30, true, implode(\',\', $field));\\n80\\t\\n81\\t            if ($res[\'total\'] > 0) {\\n82\\t                $major_school_id = array_column($res[\'list\'], \'major_school_id\');\\n83\\t                $source = [\'school_id\', \'year\', \'nzrs\', \'tk_nzrs\', \'tmrs\', \'bkrs\', \'lqrs\', \'blb\', \'fsceb\', \'tj_lqrs\', \'tj_flb\', \'tj_source\', \'tj_out\', \'fskm\', \\\"cksm\\\", \\\"retest_demand\\\", \\\"xuefei\\\", \\\"edu_system\\\", \\\"jzxj\\\", \'retest_cksm\'];\\n84\\t                $hits = [\\n85\\t                    \'_source\' => $source,\\n86\\t                    \'sort\' => [\'year\' => [\'order\' => \'desc\']]\\n87\\t                ];\\n88\\t                $map = [];\\n89\\t                $map[] = [\'major_school_id\', \'in\', $major_school_id];\\n90\\t                $map[] = [\'year\', \'in\', [$year, $year - 1, $year - 2]];\\n91\\t                $bill = Db::connect(\'database.yx_db_config\')->name(\'cl_roster\')\\n92\\t                    ->whereIn(\'major_school_id\', $major_school_id)\\n93\\t                    ->field(\'major_school_id,year,type,count(*) num\')\\n94\\t                    ->group(\'major_school_id,year,type\')\\n95\\t                    ->select();\\n96\\t                $billList = [];\\n97\\t                if (!empty($bill)) {\\n98\\t                    foreach ($bill as $k => $v) {\\n99\\t                        $billList[$v[\'major_school_id\'] . \'_\' . $v[\'year\'] . \'_\' . $v[\'type\']] = $v;\\n100\\t                    }\\n101\\t                }\\n102\\t                $group = \'major_school_id\';\\n103\\t                $groupData = $es->search($map, $hits, [], $group);\\n104\\t                $data = [];\\n105\\t                foreach ($groupData[\'group\'][$group][\'buckets\'] as $item) {\\n106\\t                    $data[$item[\'key\']] = array_column($item[\'top\'][\'hits\'][\'hits\'], \'_source\');\\n107\\t                }\\n108\\t                $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n109\\t                $tags = Config::get(\'school_tags\');\\n110\\t                foreach ($res[\'list\'] as $k => $v) {\\n111\\t                    $v[\'is_demand\'] = $v[\'is_demand\'] ?? \'-1\';\\n112\\t                    $admitList = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n113\\t                        ->where(\'major_school_id\', $v[\'major_school_id\'])\\n114\\t                        ->field(\'zongfen,zhengzhi,waiyu,zyk1,zyk2,max_score,min_score,mid_score,tj_maxscore,tj_minscore,tj_midscore\')\\n115\\t                        ->select();\\n116\\t                    $schoolTags = [];\\n117\\t                    if (!empty($v[\'tags\'])) {\\n118\\t                        foreach ($v[\'tags\'] as $tagId) {\\n119\\t                            $schoolTags[] = $tags[$tagId] ?? \'\';\\n120\\t                        }\\n121\\t                    }\\n122\\t                    $v[\'tags\'] = $schoolTags;\\n123\\t                    $hasActual = 0;\\n124\\t                    $hasTj = 0;\\n125\\t                    $hasSingle = 0;\\n126\\t                    foreach ($admitList as $score) {\\n127\\t                        if ($score[\'min_score\'] != -1 || $score[\'max_score\'] != -1 || $score[\'mid_score\'] != -1) {\\n128\\t                            $hasTj = 1;\\n129\\t                        }\\n130\\t                        if ($score[\'tj_maxscore\'] != -1 || $score[\'tj_minscore\'] != -1 || $score[\'tj_midscore\'] != -1) {\\n131\\t                            $hasActual = 1;\\n132\\t                        }\\n133\\t                        if ($score[\'zhengzhi\'] != -1 || $score[\'waiyu\'] != -1 || $score[\'zyk1\'] != -1 || $score[\'zyk2\'] != -1) {\\n134\\t                            $hasSingle = 1;\\n135\\t                        }\\n136\\t                    }\\n137\\t                    $v[\'has_actual\'] = $hasActual;\\n138\\t                    $v[\'has_single\'] = $hasSingle;\\n139\\t                    $v[\'has_tj\'] = $hasTj;\\n140\\t                    $v[\'year_info\'] = $data[$v[\'major_school_id\']] ?? [];\\n141\\t                    if (!empty($v[\'year_info\'])) {\\n142\\t                        foreach ($v[\'year_info\'] as $key => &$item) {\\n143\\t                            $item[\'tj_lqrs\'] = ($item[\'tj_lqrs\'] == -1 || $item[\'tj_lqrs\'] == 0) ? \'\' : $item[\'tj_lqrs\'];\\n144\\t                            $item[\'tj_flb\'] = ($item[\'tj_flb\'] == -1 || $item[\'tj_flb\'] == 0) ? \'\' : $item[\'tj_flb\'];\\n145\\t                            $item[\'fsceb\'] = ($item[\'fsceb\'] == -1 || $item[\'fsceb\'] == 0) ? \'\' : $item[\'fsceb\'];\\n146\\t                            $num = $billList[$v[\'major_school_id\'] . \'_\' . $item[\'year\'] . \'_1\'][\'num\'] ?? 0;\\n147\\t                            $num2 = $billList[$v[\'major_school_id\'] . \'_\' . $item[\'year\'] . \'_2\'][\'num\'] ?? 0;\\n148\\t                            $num3 = $billList[$v[\'major_school_id\'] . \'_\' . $item[\'year\'] . \'_3\'][\'num\'] ?? 0;\\n149\\t                            $item[\'has_bill\'] = 0;\\n150\\t                            if ($num2 > 0) {\\n151\\t                                $item[\'has_bill\'] = 2;\\n152\\t                                continue;\\n153\\t                            }\\n154\\t                            if ($num3 > 0) {\\n155\\t                                $item[\'has_bill\'] = 3;\\n156\\t                                continue;\\n157\\t                            }\\n158\\t                            if ($num > 0) {\\n159\\t                                $item[\'has_bill\'] = 1;\\n160\\t                                continue;\\n161\\t                            }\\n162\\t                        }\\n163\\t                        unset($item);\\n164\\t                        \\/\\/year_info 最多有三年的信息，有可能只有一年或者两年，但是缺少哪一年的信息不知道，所以需要找到缺少哪一年的信息\\n165\\t                        $yearInfo = array_column($v[\'year_info\'], \'year\');\\n166\\t                        if (!in_array($year, $yearInfo)) {\\n167\\t                            $v[\'year_info\'][] = [\'year\' => $year];\\n168\\t                        }\\n169\\t                        if (!in_array($year - 1, $yearInfo)) {\\n170\\t                            $v[\'year_info\'][] = [\'year\' => $year - 1];\\n171\\t                        }\\n172\\t                        if (!in_array($year - 2, $yearInfo)) {\\n173\\t                            $v[\'year_info\'][] = [\'year\' => $year - 2];\\n174\\t                        }\\n175\\t                        \\/\\/按照年份从大到小排序\\n176\\t                        $yearInfo = array_column($v[\'year_info\'], \'year\');\\n177\\t                        array_multisort($yearInfo, SORT_DESC, $v[\'year_info\']);\\n178\\t                    } else {\\n179\\t                        $v[\'year_info\'] = [[\'year\' => $year], [\'year\' => $year - 1], [\'year\' => $year - 2]];\\n180\\t                    }\\n181\\t                    if (!empty($v[\'yjfx\'])) {\\n182\\t                        if (!is_array($v[\'yjfx\'])) {\\n183\\t                            $v[\'yjfx\'] = array($v[\'yjfx\']);\\n184\\t                        }\\n185\\t                        foreach ($v[\'yjfx\'] as &$item1) {\\n186\\t                            $item1 = \'研究方向：\' . $item1;\\n187\\t                        }\\n188\\t                        unset($item1);\\n189\\t                    }\\n190\\t                    if (!empty($v[\'cskm\'])) {\\n191\\t                        if (!is_array($v[\'cskm\'])) {\\n192\\t                            $v[\'cskm\'] = array($v[\'cskm\']);\\n193\\t                        }\\n194\\t                        foreach ($v[\'cskm\'] as &$item1) {\\n195\\t                            $item1 = \'参考科目：\' . $item1;\\n196\\t                        }\\n197\\t                        unset($item1);\\n198\\t                    }\\n199\\t                    $list = [-1 => \'未知\', 0 => \'否\', 1 => \'是\'];\\n200\\t                    $v[\'kzybk\'] = $list[$v[\'kzybk\']] ?? \'未知\';\\n201\\t                    $v[\'yqgzjy\'] = $list[$v[\'yqgzjy\']] ?? \'未知\';\\n202\\t                    $v[\'is_demand\'] = $list[$v[\'is_demand\']] ?? \'未知\';\\n203\\t                    $v[\'same_demand\'] = $v[\'is_demand\'] . \',\' . $v[\'same_demand\'];\\n204\\t                    $v[\'zhx\'] = in_array(\'自划线\', $v[\'school_attr\']) ? \'自划线\' : \'统考\';\\n205\\t                    $v[\'subject_assessment\'] = $subjectAssessMent[$v[\'subject_assessment\']] ?? null;\\n206\\t                    $res[\'list\'][$k] = $v;\\n207\\t                }\\n208\\t                $hits = [];\\n209\\t                $group = \'\';\\n210\\t                $groupData = $es->search($where, $hits, [], $group, 0, 100, true, \'*\', \'school_id\', \'school_id\');\\n211\\t                $res[\'yjxk_num\'] = $groupData[\'group\'][\'count\'][\'value\'] ?? 0;\\n212\\t                if (!empty(input(\'ids\', \'\'))) {\\n213\\t                    return $res;\\n214\\t                }\\n215\\t                $this->success(\'success\', $res);\\n216\\t            } else {\\n217\\t                $res = [];\\n218\\t            }\\n219\\t        } catch (\\\\Exception $e) {\\n220\\t            $this->error($e->getMessage());\\n221\\t        }\\n222\\t\\n223\\t\\n224\\t        $this->success(\'success\', $res);\\n225\\t    }\\n226\\t\\n227\\t    private function buildWhere()\\n228\\t    {\\n229\\t        $schoolId = input(\'school_id\', 0);\\n230\\t        $majorId = input(\'major_id\', 0);\\n231\\t        $areaIds = input(\'area_id\', \'\');\\n232\\t        $nzrs = input(\'nzrs\', 0);\\n233\\t        $yqgzjy = input(\'yqgzjy\', \'\');\\n234\\t        $school_attr = input(\'school_attr\', \'\');\\n235\\t        $type = input(\'type\', \'\');\\n236\\t        $is_full = input(\'is_full\', \'\');\\n237\\t        $kzybk = input(\'kzybk\', \'\');\\n238\\t        $year = input(\'year\', date(\'Y\', time()));\\n239\\t        $exam_subject_english = input(\'exam_subject_english\', \'\');\\n240\\t        $exam_subject_math = input(\'exam_subject_math\', \'\');\\n241\\t        $yjxk_id = input(\'yjxk_id\', \'\');\\n242\\t        $id = input(\'id\', \'\');\\n243\\t        $ids = input(\'ids\', \'\');\\n244\\t        $majorSchoolId = input(\'major_school_id\\/d\', 0);\\n245\\t        \\/\\/排序\\n246\\t        $tmrs = input(\'tmrs\', \'\');\\n247\\t        $nzrs_sort = input(\'nzrs_sort\', \'\');\\n248\\t        $lqrs = input(\'lqrs\', \'\');\\n249\\t        $zongfen = input(\'zongfen\', \'\');\\n250\\t        $subject_assessment = input(\'subject_assessment\', \'\');\\n251\\t        $tags = input(\'tags\', \'\');\\n252\\t        $where = [];\\n253\\t        $sort = [];\\n254\\t        if (!empty($ids)) {\\n255\\t            $ids = $this->getIds();\\n256\\t            $where[] = [\'major_school_id\', \'in\', $ids];\\n257\\t            if (!empty($year)) {\\n258\\t                $where[] = [\'year\', \'=\', $year];\\n259\\t            }\\n260\\t        } elseif (!empty($majorSchoolId)) {\\n261\\t            $where[] = [\'major_school_id\', \'=\', $majorSchoolId];\\n262\\t            if (!empty($year)) {\\n263\\t                $where[] = [\'year\', \'=\', $year];\\n264\\t            }\\n265\\t        } else {\\n266\\t            if (!empty($tmrs)) {\\n267\\t                $sort[\'tmrs\'] = $tmrs;\\n268\\t            }\\n269\\t            if (!empty($nzrs_sort)) {\\n270\\t                $sort[\'nzrs\'] = $nzrs_sort;\\n271\\t            }\\n272\\t            if (!empty($lqrs)) {\\n273\\t                $sort[\'lqrs\'] = $lqrs;\\n274\\t            }\\n275\\t            if (!empty($zongfen)) {\\n276\\t                $sort[\'zongfen\'] = $zongfen;\\n277\\t            }\\n278\\t            if (!empty($subject_assessment)) {\\n279\\t                $sort[\'subject_assessment\'] = $subject_assessment;\\n280\\t            }\\n281\\t            if ($kzybk === 0 || $kzybk === 1 || $kzybk === \'0\' || $kzybk === \'1\') {\\n282\\t                $where[] = [\'kzybk\', \'=\', $kzybk];\\n283\\t            }\\n284\\t            if (!empty($schoolId)) {\\n285\\t                $where[] = [\'school_id\', \'=\', $schoolId];\\n286\\t            }\\n287\\t            if (!empty($year)) {\\n288\\t                $where[] = [\'year\', \'=\', $year];\\n289\\t            }\\n290\\t            if (!empty($majorId)) {\\n291\\t                $where[] = [\'major_id\', \'=\', $majorId];\\n292\\t            }\\n293\\t            if (!empty($areaIds)) {\\n294\\t                $where[] = [\'area_id\', \'in\', explode(\',\', $areaIds)];\\n295\\t            }\\n296\\t            if (!empty($nzrs)) {\\n297\\t                $where[] = [\'nzrs\', \'>=\', 10];\\n298\\t            }\\n299\\t            if (!empty($yjxk_id)) {\\n300\\t                $where[] = [\'yjxk_id\', \'=\', $yjxk_id];\\n301\\t            }\\n302\\t            if ($yqgzjy !== \'\') {\\n303\\t                $where[] = [\'yqgzjy\', \'=\', $yqgzjy];\\n304\\t            }\\n305\\t            if (!empty($id)) {\\n306\\t                $where = [];\\n307\\t                $where[] = [\'_id\', \'in\', explode(\',\', $id)];\\n308\\t            }\\n309\\t            if (!empty($tags)) {\\n310\\t                $where[] = [\'tags\', \'find_in_set\', [$tags]];\\n311\\t            }\\n312\\t            if (!empty($school_attr)) {\\n313\\t                $where[] = [\'school_attr\', \'find_in_set\', [$school_attr]];\\n314\\t            }\\n315\\t            if (!empty($type)) {\\n316\\t                $where[] = [\'school_type\', \'=\', $type];\\n317\\t            }\\n318\\t            $list = [];\\n319\\t            $list[] = \'全日制\';\\n320\\t            $list[] = \'非全日制\';\\n321\\t            if (!empty($is_full) && in_array($is_full, $list)) {\\n322\\t                $where[] = [\'is_full\', \'=\', $is_full];\\n323\\t            }\\n324\\t            $list = [];\\n325\\t            $list[] = \'英语一\';\\n326\\t            $list[] = \'英语二\';\\n327\\t            $list[] = \'日语\';\\n328\\t            $list[] = \'其他外语\';\\n329\\t            if (!empty($exam_subject_english) && in_array($exam_subject_english, $list)) {\\n330\\t                $where[] = [\'exam_subject\', \'find_in_set\', [$exam_subject_english]];\\n331\\t            }\\n332\\t            $list = [];\\n333\\t            $list[] = \'数学一\';\\n334\\t            $list[] = \'数学二\';\\n335\\t            $list[] = \'数学三\';\\n336\\t            $list[] = \'不考数学\';\\n337\\t            if (!empty($exam_subject_math) && in_array($exam_subject_math, $list)) {\\n338\\t                $where[] = [\'exam_subject\', \'find_in_set\', [$exam_subject_math]];\\n339\\t            }\\n340\\t        }\\n341\\t\\n342\\t        return [$where, $sort];\\n343\\t    }\\n344\\t\\n345\\t    \\/**\\n346\\t     * desc:根据学校名称获取学校列表\\n347\\t     * author:hufangfang\\n348\\t     * data:2022\\/10\\/27 13:58\\n349\\t     * @return void\\n350\\t     * @throws \\\\think\\\\Exception\\n351\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n352\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n353\\t     * @throws \\\\think\\\\exception\\\\DbException\\n354\\t     *\\/\\n355\\t    public function schoolList()\\n356\\t    {\\n357\\t        $name = input(\'school_name\', \'\');\\n358\\t        $limit = input(\'limit\', 6);\\n359\\t        $where = [];\\n360\\t        if (!empty($name)) {\\n361\\t            $where[\'name\'] = [\'like\', $name . \'%\'];\\n362\\t        }\\n363\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n364\\t            ->where($where)\\n365\\t            ->field(\'id,name\')\\n366\\t            ->order(\'code\')\\n367\\t            ->limit($limit)\\n368\\t            ->select();\\n369\\t        if (empty($list)) {\\n370\\t            $list = [];\\n371\\t        }\\n372\\t        $this->success(\'success\', $list);\\n373\\t    }\\n374\\t\\n375\\t    \\/**\\n376\\t     * desc: 通过名称搜索专业列表\\n377\\t     * author:hufangfang\\n378\\t     * data:2022\\/10\\/27 14:03\\n379\\t     * @return void\\n380\\t     * @throws \\\\think\\\\Exception\\n381\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n382\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n383\\t     * @throws \\\\think\\\\exception\\\\DbException\\n384\\t     *\\/\\n385\\t    public function majorList()\\n386\\t    {\\n387\\t        $name = input(\'major_name\', \'\');\\n388\\t        $limit = input(\'limit\', 6);\\n389\\t        $yjxkId = input(\'yjxk_id\', 0);\\n390\\t        $where = [];\\n391\\t        if (!empty($name)) {\\n392\\t            $where[\'name\'] = [\'like\', $name . \'%\'];\\n393\\t        }\\n394\\t        if (!empty($yjxkId)) {\\n395\\t            $where[\'yjxk_id\'] = $yjxkId;\\n396\\t            $limit = 10000;\\n397\\t        }\\n398\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n399\\t            ->where($where)\\n400\\t            ->field(\'id,name,code\')\\n401\\t            ->order(\'code\')\\n402\\t            ->limit($limit)\\n403\\t            ->select();\\n404\\t        if (empty($list)) {\\n405\\t            $list = [];\\n406\\t        }\\n407\\t        $this->success(\'success\', $list);\\n408\\t    }\\n409\\t\\n410\\t    public function majorListV2()\\n411\\t    {\\n412\\t        $name = input(\'major_name\', \'\');\\n413\\t        $limit = input(\'limit\', 6);\\n414\\t        $yjxkId = input(\'yjxk_id\', 0);\\n415\\t        $schoolId = input(\'school_id\', 0);\\n416\\t        $yuanxiId = input(\'yuanxi_id\', 0);\\n417\\t        $where = [];\\n418\\t        if (!empty($name)) {\\n419\\t            $where[\'maj.name\'] = [\'like\', $name . \'%\'];\\n420\\t        }\\n421\\t        if (!empty($yjxkId)) {\\n422\\t            $where[\'maj.yjxk_id\'] = $yjxkId;\\n423\\t        }\\n424\\t        if (!empty($schoolId)) {\\n425\\t            $where[\'majsch.school_id\'] = $schoolId;\\n426\\t        }\\n427\\t        if (!empty($yuanxiId)) {\\n428\\t            $where[\'majsch.yuanxi_id\'] = $yuanxiId;\\n429\\t        }\\n430\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'majsch\')\\n431\\t            ->join(\'cl_major maj\', \'maj.id=majsch.major_id\', \'left\')\\n432\\t            ->where($where)\\n433\\t            ->whereNotNull(\'maj.id\')\\n434\\t            ->field(\'maj.id, maj.name, maj.code\')\\n435\\t            ->order(\'maj.code\')\\n436\\t            ->group(\'majsch.major_id\')\\n437\\t            ->limit($limit)\\n438\\t            ->select();\\n439\\t        if (empty($list)) {\\n440\\t            $list = [];\\n441\\t        }\\n442\\t        $this->success(\'success\', $list);\\n443\\t    }\\n444\\t\\n445\\t    \\/**\\n446\\t     * desc: 门类列表\\n447\\t     * author:hufangfang\\n448\\t     * data:2022\\/10\\/27 14:46\\n449\\t     * @return void\\n450\\t     * @throws \\\\think\\\\Exception\\n451\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n452\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n453\\t     * @throws \\\\think\\\\exception\\\\DbException\\n454\\t     *\\/\\n455\\t    public function menlei()\\n456\\t    {\\n457\\t        $type = input(\'type\', \'学术硕士\');\\n458\\t        $phpId = input(\'phpId\',2);\\n459\\t        if($phpId != 2){\\n460\\t            $this->success(\'success\', []);\\n461\\t        }\\n462\\t        $where = [];\\n463\\t        if (!empty($type)) {\\n464\\t            $where[\'type\'] = $type;\\n465\\t        }\\n466\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_yjxk\')\\n467\\t            ->where($where)\\n468\\t            ->group(\'menlei\')\\n469\\t            ->order(\'id\', \'asc\')\\n470\\t            ->column(\'menlei\');\\n471\\t        if (empty($list)) {\\n472\\t            $list = [];\\n473\\t        }\\n474\\t        $this->success(\'success\', $list);\\n475\\t    }\\n476\\t\\n477\\t    \\/**\\n478\\t     * desc: 一级学科列表\\n479\\t     * author:hufangfang\\n480\\t     * data:2022\\/10\\/27 14:49\\n481\\t     * @return void\\n482\\t     * @throws \\\\think\\\\Exception\\n483\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n484\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n485\\t     * @throws \\\\think\\\\exception\\\\DbException\\n486\\t     *\\/\\n487\\t    public function yjxk()\\n488\\t    {\\n489\\t        $menlei = input(\'menlei\', \'\');\\n490\\t        $type = input(\'type\', \'学术硕士\');\\n491\\t        $where = [];\\n492\\t        if (!empty($menlei)) {\\n493\\t            $where[\'menlei\'] = $menlei;\\n494\\t        }\\n495\\t        if (!empty($menlei)) {\\n496\\t            $where[\'type\'] = $type;\\n497\\t        }\\n498\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_yjxk\')\\n499\\t            ->where($where)\\n500\\t            ->field(\'id,name,code\')\\n501\\t            ->order(\'id\', \'asc\')\\n502\\t            ->select();\\n503\\t        if (empty($list)) {\\n504\\t            $list = [];\\n505\\t        }\\n506\\t        $this->success(\'success\', $list);\\n507\\t    }\\n508\\t\\n509\\t    \\/**\\n510\\t     * desc:区域列表\\n511\\t     * author:hufangfang\\n512\\t     * data:2022\\/10\\/27 15:29\\n513\\t     * @return void\\n514\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n515\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n516\\t     * @throws \\\\think\\\\exception\\\\DbException\\n517\\t     *\\/\\n518\\t    public function area()\\n519\\t    {\\n520\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'area\')\\n521\\t            ->where(\'pid\', \'<>\', 0)\\n522\\t            ->field(\'id,name,ab_type sort\')\\n523\\t            ->select();\\n524\\t        $this->success(\'success\', $list);\\n525\\t    }\\n526\\t\\n527\\t    \\/**\\n528\\t     * desc:前端下拉框列表\\n529\\t     * author:hufangfang\\n530\\t     * data:2022\\/10\\/27 16:11\\n531\\t     * @return void\\n532\\t     *\\/\\n533\\t    public function selectList()\\n534\\t    {\\n535\\t        $return = [];\\n536\\t        $item = [];\\n537\\t        $item[\'type\'] = \'school_attr\';\\n538\\t        $item[\'ps\'] = \'学校属性\';\\n539\\t        $list = (new \\\\app\\\\admin\\\\model\\\\School())->getSchoolAttr();\\n540\\t        $item[\'list\'] = $this->getList($list, 1);\\n541\\t        $return[] = $item;\\n542\\t\\n543\\t        $item = [];\\n544\\t        $item[\'type\'] = \'type\';\\n545\\t        $item[\'ps\'] = \'学校类型\';\\n546\\t        $list = (new \\\\app\\\\admin\\\\model\\\\School())->getType();\\n547\\t        $item[\'list\'] = $this->getList($list);\\n548\\t        $return[] = $item;\\n549\\t\\n550\\t        $list = [];\\n551\\t        $item = [];\\n552\\t        $item[\'type\'] = \'is_full\';\\n553\\t        $item[\'ps\'] = \'培养方式\';\\n554\\t        $list[\'全日制\'] = \'全日制\';\\n555\\t        $list[\'非全日制\'] = \'非全日制\';\\n556\\t        $item[\'list\'] = $this->getList($list);\\n557\\t        $return[] = $item;\\n558\\t\\n559\\t        $list = [];\\n560\\t        $item = [];\\n561\\t        $item[\'type\'] = \'kzybk\';\\n562\\t        $item[\'ps\'] = \'跨专业报考\';\\n563\\t        $list[] = \'不可跨专业报考\';\\n564\\t        $list[] = \'可跨专业报考\';\\n565\\t        $item[\'list\'] = $this->getList($list);\\n566\\t        $return[] = $item;\\n567\\t\\n568\\t        foreach ($return as &$value) {\\n569\\t            array_unshift($value[\'list\'], [\'name\' => \'全部\', \'value\' => \'全部\']);\\n570\\t        }\\n571\\t        $list = [];\\n572\\t        $item = [];\\n573\\t        $item[\'type\'] = \'year\';\\n574\\t        $item[\'ps\'] = \'年份\';\\n575\\t        $maxYear = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_detail\')\\n576\\t            ->order(\'year\', \'desc\')\\n577\\t            ->value(\'year\');\\n578\\t        $maxYear = (string)$maxYear;\\n579\\t        $midYear = date(\'Y\', strtotime(\'-1 year\', strtotime($maxYear . \'-1-1\')));\\n580\\t        $minYear = date(\'Y\', strtotime(\'-2 year\', strtotime($maxYear . \'-1-1\')));\\n581\\t        $list[$maxYear] = $maxYear;\\n582\\t        $list[$midYear] = $midYear;\\n583\\t        $list[$minYear] = $minYear;\\n584\\t        $item[\'list\'] = $this->getList($list, 1);\\n585\\t        $return[] = $item;\\n586\\t\\n587\\t        $item = [];\\n588\\t        $item[\'type\'] = \'tags\';\\n589\\t        $item[\'ps\'] = \'专业标签\';\\n590\\t        $list = Config::get(\'school_tags\');\\n591\\t        $item[\'list\'] = $this->getList($list);\\n592\\t        $return[] = $item;\\n593\\t\\n594\\t        $this->success(\'success\', $return);\\n595\\t    }\\n596\\t\\n597\\t    private function getList($list, $is_string = 0)\\n598\\t    {\\n599\\t        $return = [];\\n600\\t        foreach ($list as $k => $v) {\\n601\\t            $item[\'name\'] = $v;\\n602\\t\\n603\\t            $item[\'value\'] = $k;\\n604\\t            if ($is_string) {\\n605\\t                $item[\'value\'] = (string)$item[\'value\'];\\n606\\t            }\\n607\\t            $return[] = $item;\\n608\\t        }\\n609\\t        return $return;\\n610\\t    }\\n611\\t\\n612\\t    \\/**\\n613\\t     * Function getYear [近五年年份]\\n614\\t     * Auther: Changzd\\n615\\t     * Date: 2019-09-07\\n616\\t     * @return array\\n617\\t     *\\/\\n618\\t    public function getYear($end = 4)\\n619\\t    {\\n620\\t        $year = [];\\n621\\t        $endYear = date(\'Y\');\\n622\\t        $year[] = intval($endYear);\\n623\\t        for ($i = 1; $i <= $end; $i++) {\\n624\\t            $year[] = $endYear - $i;\\n625\\t        }\\n626\\t        return $year;\\n627\\t    }\\n628\\t\\n629\\t    \\/**\\n630\\t     * desc: 实际分数线，单科分数线\\n631\\t     * author:hufangfang\\n632\\t     * data:2022\\/10\\/28 15:51\\n633\\t     * @return void\\n634\\t     * @throws \\\\think\\\\Exception\\n635\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n636\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n637\\t     * @throws \\\\think\\\\exception\\\\DbException\\n638\\t     *\\/\\n639\\t    public function schoolScore()\\n640\\t    {\\n641\\t        $year = $this->getYear(2);\\n642\\t        $where = $map = [];\\n643\\t        $where[\'a.year\'] = [\'in\', $year];\\n644\\t        $where[\'b.school_id\'] = $map[\'school_id\'] = input(\'school_id\', 0);\\n645\\t        $where[\'b.major_id\'] = $map[\'major_id\'] = input(\'major_id\', 0);\\n646\\t        $where[\'b.yuanxi_id\'] = $map[\'yuanxi_id\'] = input(\'yuanxi_id\', 0);\\n647\\t        $where[\'b.is_full\'] = input(\'is_full\', \'全日制\');\\n648\\t        $result = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')->alias(\'a\')\\n649\\t            ->join(\'cl_major_school b\', \'a.major_school_id=b.id\', \'left\')\\n650\\t            ->where($where)\\n651\\t            ->group(\'a.year, b.yuanxi_id,b.major_id,b.is_full\')\\n652\\t            ->order(\'year desc\')\\n653\\t            ->field(\'b.school_id, b.yuanxi_id, b.major_id, b.is_full, a.year, a.zhengzhi retest_km1, a.waiyu retest_km2, a.zyk1 retest_km3, a.zyk2 retest_km4, a.max_score, a.min_score, a.mid_score, a.tj_maxscore, a.tj_minscore, a.tj_midscore\')\\n654\\t            ->select();\\n655\\t        \\/\\/ 实际录取分数线\\n656\\t        $actualTitle = [\'招生年份\', \'录取最高分\', \'录取最低分\', \'录取中位分\'];\\n657\\t        \\/\\/ 复试单科分数\\n658\\t        $singleTitle = [\'招生年份\', \'政治\', \'外语\', \'专业课1\', \'专业课2\'];\\n659\\t        $actual = $single = $firstSingle = [];\\n660\\t        $actual[\'title\'] = $actualTitle;\\n661\\t        $single[\'title\'] = $singleTitle;\\n662\\t        $firstSingle[\'title\'] = $singleTitle;\\n663\\t        $tj[\'title\'] = $actualTitle;\\n664\\t        if ($result) {\\n665\\t            foreach ($result as $row) {\\n666\\t                if ($row[\'max_score\'] != -1 || $row[\'min_score\'] != -1 || $row[\'mid_score\']) {\\n667\\t                    $actual[\'list\'][] = [\\n668\\t                        $row[\'year\'],\\n669\\t                        $row[\'max_score\'] != -1 ? $row[\'max_score\'] : \'--\',\\n670\\t                        $row[\'min_score\'] != -1 ? $row[\'min_score\'] : \'--\',\\n671\\t                        $row[\'mid_score\'] != -1 ? floatval($row[\'mid_score\']) : \'--\',\\n672\\t                    ];\\n673\\t                }\\n674\\t                if ($row[\'tj_maxscore\'] != -1 || $row[\'tj_minscore\'] != -1 || $row[\'tj_midscore\']) {\\n675\\t                    $tj[\'list\'][] = [\\n676\\t                        $row[\'year\'],\\n677\\t                        $row[\'tj_maxscore\'] != -1 ? floatval($row[\'tj_maxscore\']) : \'--\',\\n678\\t                        $row[\'tj_minscore\'] != -1 ? floatval($row[\'tj_minscore\']) : \'--\',\\n679\\t                        $row[\'tj_midscore\'] != -1 ? floatval($row[\'tj_midscore\']) : \'--\',\\n680\\t                    ];\\n681\\t                }\\n682\\t\\n683\\t                if ($row[\'retest_km1\'] != -1 || $row[\'retest_km2\'] != -1 || $row[\'retest_km3\'] != -1 || $row[\'retest_km4\'] != -1) {\\n684\\t                    $single[\'list\'][] = [\\n685\\t                        $row[\'year\'],\\n686\\t                        $row[\'retest_km1\'] != -1 ? $row[\'retest_km1\'] : \'--\',\\n687\\t                        $row[\'retest_km2\'] != -1 ? $row[\'retest_km2\'] : \'--\',\\n688\\t                        $row[\'retest_km3\'] != -1 ? $row[\'retest_km3\'] : \'--\',\\n689\\t                        $row[\'retest_km4\'] != -1 ? $row[\'retest_km4\'] : \'--\',\\n690\\t                    ];\\n691\\t                }\\n692\\t            }\\n693\\t        }\\n694\\t        foreach ($year as $y) {\\n695\\t            \\/\\/ 查询是否自划线\\n696\\t            $scribing = Db::connect(\'database.yx_db_config\')->name(\'yx_scribing\')\\n697\\t                ->where($map)\\n698\\t                ->where(\'year\', $y)\\n699\\t                ->field(\'year, total_score as zongfen, politics_score as zhengzhi, foreign_lang_score as yingyu, specialized_one_score as zyk1,specialized_two_score as zyk2\')\\n700\\t                ->find();\\n701\\t            if ($scribing) {\\n702\\t                $firstSingle[\'list\'][] = [\\n703\\t                    $scribing[\'year\'],\\n704\\t                    $scribing[\'zhengzhi\'] != 0 ? $scribing[\'zhengzhi\'] : \'--\',\\n705\\t                    $scribing[\'yingyu\'] != 0 ? $scribing[\'yingyu\'] : \'--\',\\n706\\t                    $scribing[\'zyk1\'] != 0 ? $scribing[\'zyk1\'] : \'--\',\\n707\\t                    $scribing[\'zyk2\'] != 0 ? $scribing[\'zyk2\'] : \'--\',\\n708\\t                ];\\n709\\t                continue;\\n710\\t            }\\n711\\t            $area_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n712\\t                ->where(\'id\', $map[\'school_id\'])\\n713\\t                ->value(\'area_id\');\\n714\\t            $national = (new \\\\app\\\\common\\\\model\\\\MajorSchool())->getNationalForSingle($area_id, $map[\'major_id\'], $y);\\n715\\t            if ($national) {\\n716\\t                $firstScore[$y] = [\\n717\\t                    \'year\' => $y,\\n718\\t                    \'zhengzhi\' => $national[\'eq100\'],\\n719\\t                    \'yingyu\' => $national[\'eq100\'],\\n720\\t                    \'zyk1\' => $national[\'gt100\'],\\n721\\t                    \'zyk2\' => $national[\'gt100\'],\\n722\\t                ];\\n723\\t                $firstSingle[\'list\'][] = [\\n724\\t                    $y,\\n725\\t                    $national[\'eq100\'] != 0 ? $national[\'eq100\'] : \'--\',\\n726\\t                    $national[\'eq100\'] != 0 ? $national[\'eq100\'] : \'--\',\\n727\\t                    $national[\'gt100\'] != 0 ? $national[\'gt100\'] : \'--\',\\n728\\t                    $national[\'gt100\'] != 0 ? $national[\'gt100\'] : \'--\',\\n729\\t                ];\\n730\\t            }\\n731\\t        }\\n732\\t        $return[\'actual\'] = $actual;\\n733\\t        $return[\'single\'] = $single;\\n734\\t        $return[\'firstSingle\'] = $firstSingle;\\n735\\t        $return[\'tj\'] = $tj;\\n736\\t        $this->success(\'success\', $return);\\n737\\t    }\\n738\\t\\n739\\t    \\/**\\n740\\t     * Function webfback [内部调用意见反馈]\\n741\\t     * Auther: Changzd\\n742\\t     * Date: 2023-01-31\\n743\\t     * @throws \\\\think\\\\Exception\\n744\\t     *\\/\\n745\\t    public function webfback()\\n746\\t    {\\n747\\t        $this->feedback();\\n748\\t    }\\n749\\t\\n750\\t    \\/**\\n751\\t     * Function fback [内部调用意见反馈]\\n752\\t     * Auther: Changzd\\n753\\t     * Date: 2023-01-31\\n754\\t     * @throws \\\\think\\\\Exception\\n755\\t     *\\/\\n756\\t    public function fback()\\n757\\t    {\\n758\\t        $uid = input(\'uid\', 0);\\n759\\t        if (empty($uid)) {\\n760\\t            $this->error(\'参数错误\');\\n761\\t        }\\n762\\t        $this->feedback($uid);\\n763\\t    }\\n764\\t\\n765\\t    \\/**\\n766\\t     * desc: 问题反馈\\n767\\t     * author:hufangfang\\n768\\t     * data:2022\\/10\\/28 18:39\\n769\\t     * @return void\\n770\\t     * @throws \\\\think\\\\Exception\\n771\\t     *\\/\\n772\\t    public function feedback($uid = 0)\\n773\\t    {\\n774\\t        $schoolId = input(\'school_id\\/d\', 0);\\n775\\t        $majorId = input(\'major_id\\/d\', 0);\\n776\\t        $school_name = input(\'school_name\\/s\', \'\');\\n777\\t        $major_name = input(\'major_name\\/s\', \'\');\\n778\\t        $content = input(\'content\', \'\');\\n779\\t        $origin_type = input(\'origin_type\', 3);\\n780\\t        $question_type = input(\'question_type\', 2);\\n781\\t        $img_list = input(\'img_list\\/a\', []);\\n782\\t        $type = input(\'type\', 1);\\n783\\t        $tabType = input(\'tab_type\\/d\', 0);\\n784\\t        if ($question_type == 2) {\\n785\\t            if (empty($school_name)) {\\n786\\t                $this->error(\'学校不能为空\');\\n787\\t            }\\n788\\t            if ($origin_type != 2) {\\n789\\t                if (empty($major_name)) {\\n790\\t                    $this->error(\'专业不能为空\');\\n791\\t                }\\n792\\t                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n793\\t                    ->where(\'name\', $school_name)\\n794\\t                    ->value(\'id\');\\n795\\t                $major_id = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n796\\t                    ->where(\'name\', $major_name)\\n797\\t                    ->value(\'id\');\\n798\\t                if (empty($school_id)) {\\n799\\t                    $this->error(\'未找到对应学校\');\\n800\\t                }\\n801\\t                if (empty($major_id)) {\\n802\\t                    $this->error(\'未找到对应专业\');\\n803\\t                }\\n804\\t            } else {\\n805\\t                $school_id = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n806\\t                    ->where(\'name\', $school_name)\\n807\\t                    ->value(\'id\');\\n808\\t                if (empty($school_id)) {\\n809\\t                    $this->error(\'未找到对应学校\');\\n810\\t                }\\n811\\t                if (!empty($major_name)) {\\n812\\t                    $major_id = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n813\\t                        ->where(\'name\', $major_name)\\n814\\t                        ->value(\'id\');\\n815\\t                    if (empty($major_id)) {\\n816\\t                        $major_id = 0;\\n817\\t                    }\\n818\\t                } else {\\n819\\t                    $major_name = \'\';\\n820\\t                    $major_id = 0;\\n821\\t                }\\n822\\t            }\\n823\\t\\n824\\t            if (empty($content)) {\\n825\\t                $this->error(\'反馈内容不能为空\');\\n826\\t            }\\n827\\t\\n828\\t            $insert[\'school_id\'] = $school_id;\\n829\\t            $insert[\'major_id\'] = $major_id;\\n830\\t            $insert[\'school_name\'] = $school_name;\\n831\\t            $insert[\'major_name\'] = $major_name;\\n832\\t        } elseif (in_array($question_type, [3, 6])) {\\n833\\t            \\/*if (empty($school_name)) {\\n834\\t                $this->error(\'学校不能为空\');\\n835\\t            }*\\/\\n836\\t            $insert[\'school_id\'] = 0;\\n837\\t            $insert[\'major_id\'] = 0;\\n838\\t            $insert[\'school_name\'] = $school_name;\\n839\\t            $insert[\'major_name\'] = \'\';\\n840\\t        } else {\\n841\\t            if ($tabType > 0 && $type = 5) {\\n842\\t                if (!$schoolId || !$majorId) {\\n843\\t                    $this->error(\'院校和专业不能为空\');\\n844\\t                }\\n845\\t                $school_name = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n846\\t                    ->where(\'id\', $schoolId)\\n847\\t                    ->value(\'name\');\\n848\\t                if (empty($school_name)) {\\n849\\t                    $this->error(\'未找到相关院校\');\\n850\\t                }\\n851\\t                $major_name = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n852\\t                    ->where(\'id\', $majorId)\\n853\\t                    ->value(\'name\');\\n854\\t                if (empty($major_name)) {\\n855\\t                    $this->error(\'未找到相关专业\');\\n856\\t                }\\n857\\t            }\\n858\\t            $insert[\'school_id\'] = $schoolId;\\n859\\t            $insert[\'major_id\'] = $majorId;\\n860\\t            $insert[\'school_name\'] = $school_name;\\n861\\t            $insert[\'major_name\'] = $major_name;\\n862\\t            if (!empty($img_list)) {\\n863\\t                if (count($img_list) > 3) {\\n864\\t                    $this->error(\'图片不能超过3张\');\\n865\\t                }\\n866\\t                $insert[\'img_list\'] = implode(\',\', $img_list);\\n867\\t            }\\n868\\t        }\\n869\\t        $insert[\'content\'] = $content;\\n870\\t        $insert[\'user_id\'] = $uid ? $uid : session(\'uid\');\\n871\\t        $insert[\'origin_type\'] = $origin_type;\\n872\\t        $insert[\'type\'] = $type;\\n873\\t        $insert[\'question_type\'] = $question_type;\\n874\\t        $insert[\'tab_type\'] = $tabType;\\n875\\t        $insert[\'create_time\'] = time();\\n876\\t        $insert[\'update_time\'] = time();\\n877\\t        Db::connect(\'database.yx_db_config\')->name(\'feedback\')->insert($insert);\\n878\\t        $this->success(\'success\');\\n879\\t    }\\n880\\t\\n881\\t    \\/**\\n882\\t     * desc:复试调剂名单列表\\n883\\t     * author:hufangfang\\n884\\t     * data:2023\\/3\\/23 14:39\\n885\\t     * @return void\\n886\\t     * @throws \\\\think\\\\Exception\\n887\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n888\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n889\\t     * @throws \\\\think\\\\exception\\\\DbException\\n890\\t     *\\/\\n891\\t    public function billList()\\n892\\t    {\\n893\\t        $majorSchoolId = input(\'major_school_id\', 0);\\n894\\t        $year = input(\'year\', \'\');\\n895\\t        $type = input(\'type\', 1);\\n896\\t        $p = input(\'p\', 1);\\n897\\t        $row = input(\'row\', 10);\\n898\\t        $where = [];\\n899\\t        $where[\'major_school_id\'] = $majorSchoolId;\\n900\\t        $where[\'year\'] = $year;\\n901\\t        $where[\'type\'] = $type;\\n902\\t        $tabel = Db::connect(\'database.yx_db_config\')->name(\'cl_roster\');\\n903\\t        $total = $tabel->where($where)->count();\\n904\\t        if ($total > 0) {\\n905\\t            $list = $tabel->where($where)\\n906\\t                ->field(\'st_number,st_name,result_one,result_two,result_three,result_four,cs_all_result,fs_result,all_result\')\\n907\\t                ->limit(($p - 1) * $row, $row)\\n908\\t                ->select();\\n909\\t        } else {\\n910\\t            $list = [];\\n911\\t        }\\n912\\t        $return[\'total\'] = $total;\\n913\\t        $return[\'list\'] = $list;\\n914\\t        $this->success(\'success\', $return);\\n915\\t    }\\n916\\t\\n917\\t    public function getDownloadIds()\\n918\\t    {\\n919\\t        $uid = session(\'uid\');\\n920\\t        $key = \'yuanxiao_download_ids_day\' . date(\\\"Y-m-d\\\") . \'_uid_\' . $uid;\\n921\\t        $ids = redis()->get($key);\\n922\\t        if (empty($ids)) {\\n923\\t            $ids = [];\\n924\\t        } else {\\n925\\t            $ids = json_decode($ids, true);\\n926\\t        }\\n927\\t        $this->success(\'success\', $ids);\\n928\\t    }\\n929\\t\\n930\\t    private function getIds()\\n931\\t    {\\n932\\t        $uid = session(\'uid\');\\n933\\t        $downloadNum = 30;\\n934\\t        $key = \'yuanxiao_download_ids_day\' . date(\\\"Y-m-d\\\") . \'_uid_\' . $uid;\\n935\\t        $ids = redis()->get($key);\\n936\\t        $inputIds = input(\'ids\', []);\\n937\\t        if (is_string($inputIds)) {\\n938\\t            $inputIds = explode(\',\', $inputIds);\\n939\\t        }\\n940\\t        if (empty($ids)) {\\n941\\t            if (count($inputIds) > $downloadNum) {\\n942\\t                $this->error(\'最多只能下载\' . $downloadNum . \'个\');\\n943\\t            }\\n944\\t            $ids = $inputIds;\\n945\\t            redis()->setex($key, 24 * 3600, json_encode($ids));\\n946\\t        } else {\\n947\\t            if (count($inputIds) > $downloadNum) {\\n948\\t                $this->error(\'最多只能下载\' . $downloadNum . \'个\');\\n949\\t            }\\n950\\t            $ids = json_decode($ids, true);\\n951\\t            $insepct_ids = array_intersect($ids, $inputIds);\\n952\\t            $diff_ids = array_diff($inputIds, $ids);\\n953\\t            if (count($ids) >= $downloadNum) {\\n954\\t                if (empty($insepct_ids)) {\\n955\\t                    $this->error(\'最多只能下载\' . $downloadNum . \'个\');\\n956\\t                }\\n957\\t            }\\n958\\t            $has_ids_num = count($ids);\\n959\\t            $left_num = $downloadNum - $has_ids_num;\\n960\\t            if (!empty($diff_ids)) {\\n961\\t                $add_ids = array_slice($diff_ids, 0, $left_num);\\n962\\t                redis()->setex($key, 24 * 3600, json_encode(array_merge($ids, $add_ids)));\\n963\\t                $ids = array_values(array_merge($insepct_ids, $add_ids));\\n964\\t            } else {\\n965\\t                $ids = array_values($insepct_ids);\\n966\\t            }\\n967\\t        }\\n968\\t        return $ids;\\n969\\t    }\\n970\\t\\n971\\t    public function download()\\n972\\t    {\\n973\\t        if (!empty(input(\'ids\'))) {\\n974\\t            list($where, $sort) = $this->buildWhere();\\n975\\t            $es = new Es();\\n976\\t            if (empty($sort)) {\\n977\\t                $sort[\'first_pinyin\'] = \'asc\';\\n978\\t                $sort[\'subject_assessment\'] = \'asc\';\\n979\\t                $sort[\'major_code\'] = \'asc\';\\n980\\t                $sort[\'is_full\'] = \'asc\';\\n981\\t            }\\n982\\t            $list = $es->search($where, [], $sort, \'\', 0, 30);\\n983\\t            $year = input(\'year\', date(\'Y\', time()));\\n984\\t            $data = [];\\n985\\t            $title = [\\n986\\t                [\\n987\\t                    \'学校名称\',\\n988\\t                    \'所属院系\',\\n989\\t                    \'专业名称\',\\n990\\t                    \'专业代码\',\\n991\\t                    \'培养方式\',\\n992\\t                    \'地区\',\\n993\\t                    \'学校属性\',\\n994\\t                    \'学科排名\',\\n995\\t                    \'年份\',\\n996\\t                    \'拟招人数\',\\n997\\t                    \'一志愿录取人数\',\\n998\\t                    \'一志愿录取最低分\',\\n999\\t                    \'一志愿录取最高分\',\\n1000\\t                    \'复试分数线\',\\n1001\\t                    \'研究方向及初试科目\',\\n1002\\t                    \'初试参考书\',\\n1003\\t                    \'是否可以跨考\',\\n1004\\t                    \'同等学历要求\',\\n1005\\t                    \'是否要求工作经验\'\\n1006\\t                ]\\n1007\\t            ];\\n1008\\t            $attr = [-1 => \'未知\', 0 => \'否\', 1 => \'是\'];\\n1009\\t            $subjectAssessMent = (new SchoolMajor())->getSubjectAssessment();\\n1010\\t            if (!empty($list[\'list\'])) {\\n1011\\t                $majorSchoolIds = array_column($list[\'list\'], \'major_school_id\');\\n1012\\t                $admitInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n1013\\t                    ->where(\'major_school_id\', \'in\', $majorSchoolIds)\\n1014\\t                    ->where(\'year\', \'=\', $year)\\n1015\\t                    ->column(\'zongfen,min_score,max_score\', \'major_school_id\');\\n1016\\t                foreach ($list[\'list\'] as $k => $v) {\\n1017\\t                    $item = [];\\n1018\\t                    $v[\'kzybk\'] = $attr[$v[\'kzybk\']] ?? \'未知\';\\n1019\\t                    $v[\'yqgzjy\'] = $attr[$v[\'yqgzjy\']] ?? \'未知\';\\n1020\\t                    $v[\'is_demand\'] = $attr[$v[\'is_demand\']] ?? \'未知\';\\n1021\\t                    $item[] = $v[\'school_name\'];\\n1022\\t                    $item[] = $v[\'yuanxi_name\'];\\n1023\\t                    $item[] = $v[\'major_name\'];\\n1024\\t                    $item[] = $v[\'major_code\'];\\n1025\\t                    $item[] = $v[\'is_full\'];\\n1026\\t                    $item[] = $v[\'area_name\'];\\n1027\\t                    if (!empty($v[\'school_attr\'])) {\\n1028\\t                        $item[] = implode(\'；\', $v[\'school_attr\']);\\n1029\\t                    } else {\\n1030\\t                        $item[] = \'\';\\n1031\\t                    }\\n1032\\t                    $v[\'subject_assessment\'] = $subjectAssessMent[$v[\'subject_assessment\']] ?? null;\\n1033\\t                    $item[] = $v[\'subject_assessment\'];\\n1034\\t                    $item[] = $v[\'year\'];\\n1035\\t                    if ($v[\'nzrs\'] == -1) {\\n1036\\t                        $item[] = \'--\';\\n1037\\t                    } else {\\n1038\\t                        $item[] = $v[\'nzrs\'] . \'人\';\\n1039\\t                    }\\n1040\\t                    if ($v[\'lqrs\'] == -1) {\\n1041\\t                        $item[] = \'--\';\\n1042\\t                    } else {\\n1043\\t                        $item[] = $v[\'lqrs\'] . \'人\';\\n1044\\t                    }\\n1045\\t                    if(isset($admitInfo[$v[\'major_school_id\']])){\\n1046\\t                        $item[] = $admitInfo[$v[\'major_school_id\']][\'min_score\'] == -1 ? \'--\' : $admitInfo[$v[\'major_school_id\']][\'min_score\'];\\n1047\\t                        $item[] = $admitInfo[$v[\'major_school_id\']][\'max_score\'] == -1 ? \'--\' : $admitInfo[$v[\'major_school_id\']][\'max_score\'];\\n1048\\t                        $item[] = $admitInfo[$v[\'major_school_id\']][\'zongfen\'] == -1 ? \'--\' : $admitInfo[$v[\'major_school_id\']][\'zongfen\'];\\n1049\\t                    }else{\\n1050\\t                        $item[] = \'--\';\\n1051\\t                        $item[] = \'--\';\\n1052\\t                        $item[] = \'--\';\\n1053\\t                    }\\n1054\\t                    if (!empty($v[\'yjfx\'])) {\\n1055\\t                        if (!is_array($v[\'yjfx\'])) {\\n1056\\t                            $v[\'yjfx\'] = array($v[\'yjfx\']);\\n1057\\t                        }\\n1058\\t                        foreach ($v[\'yjfx\'] as &$item1) {\\n1059\\t                            $item1 = \'研究方向：\' . $item1;\\n1060\\t                        }\\n1061\\t                        unset($item1);\\n1062\\t                    }\\n1063\\t                    if (!empty($v[\'cskm\'])) {\\n1064\\t                        if (!is_array($v[\'cskm\'])) {\\n1065\\t                            $v[\'cskm\'] = array($v[\'cskm\']);\\n1066\\t                        }\\n1067\\t                        foreach ($v[\'cskm\'] as &$item1) {\\n1068\\t                            $item1 = \'参考科目：\' . $item1;\\n1069\\t                        }\\n1070\\t                        unset($item1);\\n1071\\t                    }\\n1072\\t                    $yjkm = \'\';\\n1073\\t                    foreach ($v[\'yjfx\'] as $kk => $vv) {\\n1074\\t                        $yjkm .= $vv . \\\"\\\\n\\\" . $v[\'cskm\'][$kk] . \\\"；\\\\n\\\";\\n1075\\t                    }\\n1076\\t                    $item[] = $yjkm;\\n1077\\t                    $item[] = $v[\'retest_cksm\'];\\n1078\\t                    $item[] = $v[\'kzybk\'];\\n1079\\t                    $v[\'same_demand\'] = $v[\'is_demand\'] . \',\' . $v[\'same_demand\'];\\n1080\\t                    $item[] = $v[\'same_demand\'];\\n1081\\t                    $item[] = $v[\'yqgzjy\'];\\n1082\\t                    $data[] = $item;\\n1083\\t                }\\n1084\\t            }\\n1085\\t            $data = array_merge($title, $data);\\n1086\\t            \\/\\/ 创建一个新的电子表格对象\\n1087\\t            $spreadsheet = new Spreadsheet();\\n1088\\t            $worksheet = $spreadsheet->getActiveSheet();\\n1089\\t            \\/\\/ 将数据写入工作表\\n1090\\t            $worksheet->fromArray($data);\\n1091\\t\\n1092\\t            $writer = IOFactory::createWriter($spreadsheet, \'Xlsx\');\\n1093\\t            $name = \'院校查询数据_\' . date(\\\"y-m-d H:i:s\\\", time()) . \'.xlsx\';\\n1094\\t            $savePath = \'\\/tmp\\/\' . $name;\\n1095\\t            $writer->save($savePath);\\n1096\\t            $uid = session(\'uid\');\\n1097\\t            $email = Db::connect(\'database.cl_php_db_config\')->name(\'feishu_user\')\\n1098\\t                ->where(\'cl_uid\', $uid)\\n1099\\t                ->value(\'email\');\\n1100\\t            $to = [$email];\\n1101\\t            $subject = \'院校查询数据\';\\n1102\\t            send_mail($to, $subject, $subject, \'\', false, \'\', \'\', \'\', $savePath);\\n1103\\t            @unlink($savePath);\\n1104\\t            $this->success(\'导出成功\');\\n1105\\t        }\\n1106\\t    }\\n1107\\t\\n1108\\t    \\/**\\n1109\\t     * Function yuanxiList [根据院校ID和专业ID获取院系列表\\n1110\\t     * Auther: Changzd\\n1111\\t     * Date: 2023\\/11\\/20\\n1112\\t     * @throws \\\\think\\\\Exception\\n1113\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1114\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1115\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1116\\t     *\\/\\n1117\\t    public function yuanxiList()\\n1118\\t    {\\n1119\\t        $schoolId = input(\'school_id\', 0);\\n1120\\t        $yuanxiName = input(\'yuanxi_name\', \\\"\\\");\\n1121\\t        $majorId = input(\'major_id\', 0);\\n1122\\t        $limit = input(\'limit\\/d\', 0);\\n1123\\t        if (empty($schoolId) && empty($majorId)) {\\n1124\\t            $list = [];\\n1125\\t        } else {\\n1126\\t            $where = [];\\n1127\\t            if (!empty($schoolId)) {\\n1128\\t                $where[\'ms.school_id\'] = $schoolId;\\n1129\\t            }\\n1130\\t            if (!empty($majorId)) {\\n1131\\t                $where[\'ms.major_id\'] = $majorId;\\n1132\\t            }\\n1133\\t            if (!empty($yuanxiName)) {\\n1134\\t                $where[\'yx.name\'] = [\'like\', $yuanxiName . \'%\'];\\n1135\\t            }\\n1136\\t\\n1137\\t            $query = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'ms\')\\n1138\\t                ->join(\'cl_yuanxi yx\', \'yx.id=ms.yuanxi_id\', \'left\')\\n1139\\t                ->where($where)\\n1140\\t                ->field(\'yx.id, yx.name\')\\n1141\\t                ->group(\'yx.id\')\\n1142\\t                ->order(\'yx.first_pinyin\');\\n1143\\t            if ($limit > 0) {\\n1144\\t                $query = $query->limit($limit);\\n1145\\t            }\\n1146\\t            $list = $query->select();\\n1147\\t            if (empty($list)) {\\n1148\\t                $list = [];\\n1149\\t            }\\n1150\\t        }\\n1151\\t\\n1152\\t        $this->success(\'success\', $list);\\n1153\\t    }\\n1154\\t\\n1155\\t    \\/**\\n1156\\t     * Function learnList [获取培养方式列表]\\n1157\\t     * Auther: Changzd\\n1158\\t     * Date: 2023\\/11\\/21\\n1159\\t     * @throws \\\\think\\\\Exception\\n1160\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n1161\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n1162\\t     * @throws \\\\think\\\\exception\\\\DbException\\n1163\\t     *\\/\\n1164\\t    public function learnList()\\n1165\\t    {\\n1166\\t        $schoolId = input(\'school_id\', 0);\\n1167\\t        $yuanxiId = input(\'yuanxi_id\', 0);\\n1168\\t        $majorId = input(\'major_id\', 0);\\n1169\\t        if (empty($schoolId) || empty($majorId) || empty($yuanxiId)) {\\n1170\\t            $list = [];\\n1171\\t        } else {\\n1172\\t            $where = [];\\n1173\\t            if (!empty($schoolId)) {\\n1174\\t                $where[\'school_id\'] = $schoolId;\\n1175\\t            }\\n1176\\t            if (!empty($yuanxiId)) {\\n1177\\t                $where[\'yuanxi_id\'] = $yuanxiId;\\n1178\\t            }\\n1179\\t            if (!empty($majorId)) {\\n1180\\t                $where[\'major_id\'] = $majorId;\\n1181\\t            }\\n1182\\t\\n1183\\t            $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n1184\\t                ->where($where)\\n1185\\t                ->field(\'id as major_school_id,is_full as id, is_full as name\')\\n1186\\t                ->select();\\n1187\\t            if (empty($list)) {\\n1188\\t                $list = [];\\n1189\\t            }else{\\n1190\\t                foreach ($list as &$value){\\n1191\\t                    list($score,$type) = (new \\\\app\\\\api\\\\logic\\\\Common())->getRecormentScore($value[\'major_school_id\']);\\n1192\\t                    switch($type){\\n1193\\t                        case 1:\\n1194\\t                            $value[\'subject_num\'] = 4;\\n1195\\t                            break;\\n1196\\t                        case 2:\\n1197\\t                            $value[\'subject_num\'] = 3;\\n1198\\t                            break;\\n1199\\t                        default:\\n1200\\t                            $value[\'subject_num\'] = 2;\\n1201\\t                            break;\\n1202\\t                    }\\n1203\\t                }\\n1204\\t            }\\n1205\\t        }\\n1206\\t\\n1207\\t        $this->success(\'success\', $list);\\n1208\\t    }\\n1209\\t\\n1210\\t    public function getFeedBackSelect()\\n1211\\t    {\\n1212\\t        $list = [\\n1213\\t            [\\n1214\\t                \'name\' => \'报考要求\', \'id\' => 1, \'checked\' => false,\\n1215\\t                \'list\' => [\\n1216\\t                    [\'name\' => \'信息不准\', \'id\' => 13, \'checked\' => false],\\n1217\\t                    [\'name\' => \'信息不全\', \'id\' => 14, \'checked\' => false],\\n1218\\t                    [\'name\' => \'信息布局\\/展示不合理\', \'id\' => 15, \'checked\' => false],\\n1219\\t                    [\'name\' => \'估分不准\', \'id\' => 18, \'checked\' => false],\\n1220\\t                    [\'name\' => \'其他\', \'id\' => 19, \'checked\' => false],\\n1221\\t                ]\\n1222\\t            ],\\n1223\\t            [\\n1224\\t                \'name\' => \'院校信息\', \'id\' => 2,\\n1225\\t                \'list\' => [\\n1226\\t                    [\'name\' => \'信息不准\', \'id\' => 13, \'checked\' => false],\\n1227\\t                    [\'name\' => \'信息不全\', \'id\' => 14, \'checked\' => false],\\n1228\\t                    [\'name\' => \'信息布局\\/展示不合理\', \'id\' => 15, \'checked\' => false],\\n1229\\t                    [\'name\' => \'估分不准\', \'id\' => 18, \'checked\' => false],\\n1230\\t                    [\'name\' => \'其他\', \'id\' => 19, \'checked\' => false],\\n1231\\t                ]\\n1232\\t            ],\\n1233\\t            [\\n1234\\t                \'name\' => \'竞争难度\', \'id\' => 3,\\n1235\\t                \'list\' => [\\n1236\\t                    [\'name\' => \'信息不准\', \'id\' => 13, \'checked\' => false],\\n1237\\t                    [\'name\' => \'信息不全\', \'id\' => 14, \'checked\' => false],\\n1238\\t                    [\'name\' => \'信息布局\\/展示不合理\', \'id\' => 15, \'checked\' => false],\\n1239\\t                    [\'name\' => \'估分不准\', \'id\' => 18, \'checked\' => false],\\n1240\\t                    [\'name\' => \'其他\', \'id\' => 19, \'checked\' => false],\\n1241\\t                ]\\n1242\\t            ],\\n1243\\t            [\\n1244\\t                \'name\' => \'考试资料\', \'id\' => 4,\\n1245\\t                \'list\' => [\\n1246\\t                    [\'name\' => \'信息不准\', \'id\' => 13, \'checked\' => false],\\n1247\\t                    [\'name\' => \'信息不全\', \'id\' => 14, \'checked\' => false],\\n1248\\t                    [\'name\' => \'信息布局\\/展示不合理\', \'id\' => 15, \'checked\' => false],\\n1249\\t                    [\'name\' => \'资料不全\', \'id\' => 16, \'checked\' => false],\\n1250\\t                    [\'name\' => \'资料质量不佳\', \'id\' => 17, \'checked\' => false],\\n1251\\t                    [\'name\' => \'估分不准\', \'id\' => 18, \'checked\' => false],\\n1252\\t                    [\'name\' => \'其他\', \'id\' => 19, \'checked\' => false],\\n1253\\t                ]\\n1254\\t            ],\\n1255\\t            [\\n1256\\t                \'name\' => \'学长带学\', \'id\' => 5,\\n1257\\t                \'list\' => [\\n1258\\t                    [\'name\' => \'信息不准\', \'id\' => 13, \'checked\' => false],\\n1259\\t                    [\'name\' => \'信息不全\', \'id\' => 14, \'checked\' => false],\\n1260\\t                    [\'name\' => \'信息布局\\/展示不合理\', \'id\' => 15, \'checked\' => false],\\n1261\\t                    [\'name
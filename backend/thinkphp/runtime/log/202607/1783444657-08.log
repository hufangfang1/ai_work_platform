[2026-07-08T01:10:55+08:00][sql] INSERT INTO `ai_dev_run_logs` SET `run_id` = 10 , `seq` = 51 , `event_type` = 'user' , `content` = '{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_01_z31WQirqG288zW3Xqtcu5900\",\"type\":\"tool_result\",\"content\":\"1\\t<?php\\n2\\t\\n3\\tnamespace app\\\\api\\\\controller;\\n4\\t\\n5\\tuse app\\\\api\\\\logic\\\\PlanLogic;\\n6\\tuse app\\\\common\\\\controller\\\\ApiAuth;\\n7\\tuse app\\\\common\\\\model\\\\Config as ConfigModel;\\n8\\tuse think\\\\Db;\\n9\\t\\n10\\t\\/**\\n11\\t * Class Base [基础数据 接口]\\n12\\t * Auther Changzd\\n13\\t * @package app\\\\api\\\\controller\\n14\\t *\\/\\n15\\tclass Base extends ApiAuth\\n16\\t{\\n17\\t    protected $noNeedRight = [\'getconfig\', \'majors\',\'getcompanywechat\'];\\n18\\t    protected $noNeedLogin = [\'getconfig\', \'majors\',\'getcompanywechat\'];\\n19\\t\\n20\\t    public function getConfig()\\n21\\t    {\\n22\\t        $this->auth->isLogin();\\n23\\t        $key = input(\'key\', \'\');\\n24\\t        $uid = session(\'uid\');\\n25\\t        if ($key == \'ky_time_line\' && !empty($uid)) {\\n26\\t            $guanzongCode = [\'125100\', \'125101\', \'125102\', \'125601\', \'125602\'];\\n27\\t            $intentSchoolInfo = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n28\\t                ->where(\'uid\', $uid)\\n29\\t                ->field(\'selected_school school_id,selected_yuanxi yuanxi_id,selected_major major_id,selected_full is_full\')\\n30\\t                ->find();\\n31\\t            $examSubjectIds = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n32\\t                ->where($intentSchoolInfo)\\n33\\t                ->column(\'exam_subject_ids\');\\n34\\t            if (!empty($examSubjectIds)) {\\n35\\t                $examSubjectIds = array_unique(explode(\',\', implode(\',\', $examSubjectIds)));\\n36\\t                $examSubjectCodes = Db::connect(\'database.yx_db_config\')->name(\'cl_exam_subject\')\\n37\\t                    ->where(\'id\', \'in\', $examSubjectIds)\\n38\\t                    ->column(\'subject_code\');\\n39\\t                if (in_array(\'199\', $examSubjectCodes)) {\\n40\\t                    $key = \'ky_time_line_guanzong\';\\n41\\t                }\\n42\\t            } else {\\n43\\t                $intentMajorId = $intentSchoolInfo[\'major_id\'];\\n44\\t                $code = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n45\\t                    ->where(\'id\', $intentMajorId)\\n46\\t                    ->value(\'code\');\\n47\\t                if (in_array($code, $guanzongCode)) {\\n48\\t                    $key = \'ky_time_line_guanzong\';\\n49\\t                }\\n50\\t            }\\n51\\t        }\\n52\\t        if ($key == \'ky_ad_img\') {\\n53\\t            $unionId = input(\'union_id\\/s\', \'\');\\n54\\t            if (empty($unionId)) {\\n55\\t                $unionId = cookie(\'CL_unionId\');\\n56\\t            }\\n57\\t            $bathId = input(\'batch_id\\/d\', \'\');\\n58\\t            $service = new PlanLogic();\\n59\\t            $redisKey = \'v1_exam_time_\' . $uid . \'_\' . $unionId . \'_\' . $bathId;\\n60\\t            $redisKey = getCacheKey($redisKey);\\n61\\t            $examTime = get_cache_data(function ()use($service,$uid, $unionId, $bathId){\\n62\\t                return $service->getExamTime($uid, $unionId, $bathId);\\n63\\t            },$redisKey);\\n64\\t            if ($examTime == \'2025\') {\\n65\\t                $key = \'ky_ad_img_\' . $examTime;\\n66\\t            }\\n67\\t        }\\n68\\t        if (!empty($key)) {\\n69\\t            $data = (new ConfigModel())->getVal($key);\\n70\\t            if (!empty($data) && $this->is_json($data)) {\\n71\\t                $data = json_decode($data, true);\\n72\\t            }\\n73\\t        }\\n74\\t        $this->success(\'成功\', $data);\\n75\\t    }\\n76\\t\\n77\\t    \\/\\/判断字符串是否为json格式\\n78\\t    public function is_json($string)\\n79\\t    {\\n80\\t        json_decode($string);\\n81\\t        return (json_last_error() == JSON_ERROR_NONE);\\n82\\t    }\\n83\\t    public function getCompanyWechat()\\n84\\t    {\\n85\\t        $data = [\\n86\\t            \'company_wechat_url\' => \'https:\\/\\/work.weixin.qq.com\\/kfid\\/kfcb25f76b35a0b7e30\',\\n87\\t            \'company_wechat_id\' => \'ww19500e35b479ad66\',\\n88\\t        ];\\n89\\t        $this->success(\'成功\', $data);\\n90\\t    }\\n91\\t\\n92\\t}\"}]},\"parent_tool_use_id\":null,\"session_id\":\"709785dc-e16e-484f-9922-07c4f799ccb4\",\"uuid\":\"87da1604-b2a5-468e-b37f-9680646e9d76\",\"timestamp\":\"2026-07-07T17:10:55.313Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"\\/Users\\/hufangfang\\/www\\/local\\/yuanxiao\\/application\\/api\\/controller\\/Base.php\",\"content\":\"<?php\\n\\nnamespace app\\\\api\\\\controller;\\n\\nuse app\\\\api\\\\logic\\\\PlanLogic;\\nuse app\\\\common\\\\controller\\\\ApiAuth;\\nuse app\\\\common\\\\model\\\\Config as ConfigModel;\\nuse think\\\\Db;\\n\\n\\/**\\n * Class Base [基础数据 接口]\\n * Auther Changzd\\n * @package app\\\\api\\\\controller\\n *\\/\\nclass Base extends ApiAuth\\n{\\n    protected $noNeedRight = [\'getconfig\', \'majors\',\'getcompanywechat\'];\\n    protected $noNeedLogin = [\'getconfig\', \'majors\',\'getcompanywechat\'];\\n\\n    public function getConfig()\\n    {\\n        $this->auth->isLogin();\\n        $key = input(\'key\', \'\');\\n        $uid = session(\'uid\');\\n        if ($key == \'ky_time_line\' && !empty($uid)) {\\n            $guanzongCode = [\'125100\', \'125101\', \'125102\', \'125601\', \'125602\'];\\n            $intentSchoolInfo = Db::connect(\'database.yx_db_config\')->name(\'user_extend\')\\n                ->where(\'uid\', $uid)\\n                ->field(\'selected_school school_id,selected_yuanxi yuanxi_id,selected_major major_id,selected_full is_full\')\\n                ->find();\\n            $examSubjectIds = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n                ->where($intentSchoolInfo)\\n                ->column(\'exam_subject_ids\');\\n            if (!empty($examSubjectIds)) {\\n                $examSubjectIds = array_unique(explode(\',\', implode(\',\', $examSubjectIds)));\\n                $examSubjectCodes = Db::connect(\'database.yx_db_config\')->name(\'cl_exam_subject\')\\n                    ->where(\'id\', \'in\', $examSubjectIds)\\n                    ->column(\'subject_code\');\\n                if (in_array(\'199\', $examSubjectCodes)) {\\n                    $key = \'ky_time_line_guanzong\';\\n                }\\n            } else {\\n                $intentMajorId = $intentSchoolInfo[\'major_id\'];\\n                $code = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n                    ->where(\'id\', $intentMajorId)\\n                    ->value(\'code\');\\n                if (in_array($code, $guanzongCode)) {\\n                    $key = \'ky_time_line_guanzong\';\\n                }\\n            }\\n        }\\n        if ($key == \'ky_ad_img\') {\\n            $unionId = input(\'union_id\\/s\', \'\');\\n            if (empty($unionId)) {\\n                $unionId = cookie(\'CL_unionId\');\\n            }\\n            $bathId = input(\'batch_id\\/d\', \'\');\\n            $service = new PlanLogic();\\n            $redisKey = \'v1_exam_time_\' . $uid . \'_\' . $unionId . \'_\' . $bathId;\\n            $redisKey = getCacheKey($redisKey);\\n            $examTime = get_cache_data(function ()use($service,$uid, $unionId, $bathId){\\n                return $service->getExamTime($uid, $unionId, $bathId);\\n            },$redisKey);\\n            if ($examTime == \'2025\') {\\n                $key = \'ky_ad_img_\' . $examTime;\\n            }\\n        }\\n        if (!empty($key)) {\\n            $data = (new ConfigModel())->getVal($key);\\n            if (!empty($data) && $this->is_json($data)) {\\n                $data = json_decode($data, true);\\n            }\\n        }\\n        $this->success(\'成功\', $data);\\n    }\\n\\n    \\/\\/判断字符串是否为json格式\\n    public function is_json($string)\\n    {\\n        json_decode($string);\\n        return (json_last_error() == JSON_ERROR_NONE);\\n    }\\n    public function getCompanyWechat()\\n    {\\n        $data = [\\n            \'company_wechat_url\' => \'https:\\/\\/work.weixin.qq.com\\/kfid\\/kfcb25f76b35a0b7e30\',\\n            \'company_wechat_id\' => \'ww19500e35b479ad66\',\\n        ];\\n        $this->success(\'成功\', $data);\\n    }\\n\\n}\",\"numLines\":92,\"startLine\":1,\"totalLines\":92}}}' , `created_at` = '2026-07-08 01:10:55' [ RunTime:0.002642s ]

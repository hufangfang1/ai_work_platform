ading\'   => \'require|checkEducationStading\',\\n        \'cet\'     => \'require|checkCet\',\\n        \'area_id\'     => \'require\',\\n        \'major_id\'      => \'require\',\\n        \'diff_major\'      => \'require|checkDiffMajor\',\\n        \'exam_year\'      => \'require|checkExamYear\',\\n        \'determination\'      => \'require|checkDetermination\',\\n    ];\\n\\n    protected $message = [\\n        \'now_standing\'  => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'您的身份\',\\n        \'school_id\'     => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'就读院校\',\\n        \'education_stading\'     => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'学历层次\',\\n        \'cet\'   => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'四六级学习情况\',\\n        \'area_id\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'期望报考地区\',\\n        \'major_id\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'期望报考专业\',\\n        \'diff_major\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'是否跨专业考研\',\\n        \'exam_year\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'报考年份\',\\n        \'determination\'      => ComErrorDescs::EC_MISSING_PARAM.\',\'.\'考研决心\',\\n    ];\\n    public function checkNowStanding($value){\\n        return $this->checkParam($value,\'getNowStanding\',\'您的身份\');\\n    }\\n    public function checkEducationStading($value){\\n        return $this->checkParam($value,\'getEducationStading\',\'学历层次\');\\n    }\\n    public function checkCet($value){\\n        return $this->checkParam($value,\'getCet\',\'四六级学习情况\');\\n    }\\n    public function checkDiffMajor($value){\\n        return $this->checkParam($value,\'getDiffMajor\',\'是否跨专业考研\');\\n    }\\n    public function checkExamYear($value){\\n        return $this->checkParam($value,\'getExamYear\',\'报考年份\');\\n    }\\n    public function checkDetermination($value){\\n        return $this->checkParam($value,\'getDetermination\',\'考研决心\');\\n    }\\n    private function checkParam($value,$action,$word){\\n        $model = new \\\\app\\\\admin\\\\model\\\\AiChoose();\\n        $list = $model->$action();\\n        if(in_array($value,array_keys($list))){\\n            return true;\\n        }\\n        return ComErrorDescs::EC_INVALID_PARAM . \',\'.$word;\\n    }\\n\\n}\",\"numLines\":64,\"startLine\":1,\"totalLines\":64}}}' , `created_at` = '2026-07-07 22:25:06' [ RunTime:0.001911s ]

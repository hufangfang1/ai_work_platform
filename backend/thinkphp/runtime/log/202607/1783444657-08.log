cl_yuanxi d\', \'a.yuanxi_id=d.id\', \'left\')\\n182\\t                ->where($where)\\n183\\t                ->field(\'c.name area_name,a.id,b.name school_name,b.logo,d.name yuanxi_name,a.is_full\')\\n184\\t                ->select();\\n185\\t        }\\n186\\t\\n187\\t        foreach ($list as $k => $v) {\\n188\\t            $list[$k][\'logo\'] = School::schoolLogo($v[\'logo\']);\\n189\\t            $list[$k][\'first_pinyin\'] = getFirstCharter($v[\'area_name\']);\\n190\\t            if ($v[\'area_name\'] == \'重庆\') {\\n191\\t                $list[$k][\'first_pinyin\'] = \\\"C\\\";\\n192\\t            }\\n193\\t        }\\n194\\t        $order = array_column($list, \'first_pinyin\');\\n195\\t        array_multisort($order, SORT_ASC, $list);\\n196\\t        $return[\'all\'][\'num\'] = count($list);\\n197\\t        $return[\'all\'][\'list\'] = $list;\\n198\\t        $return[\'area\'] = listToTree($list, [\'area_name\', \'school_name\']);\\n199\\t\\n200\\t        foreach ($return as $k => $v) {\\n201\\t            if ($k == \'area\') {\\n202\\t                foreach ($v as $kk => $vv) {\\n203\\t                    $v[$kk][\'num\'] = count($vv[\'list\']);\\n204\\t                }\\n205\\t            }\\n206\\t            $return[$k] = $v;\\n207\\t        }\\n208\\t        $this->success(\'success\', $return);\\n209\\t    }\\n210\\t\\n211\\t    \\/**\\n212\\t     * desc:搜索学校\\n213\\t     * author:hufangfang\\n214\\t     * data:2023\\/1\\/13 14:24\\n215\\t     * @return void\\n216\\t     * @throws Exception\\n217\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n218\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n219\\t     * @throws \\\\think\\\\exception\\\\DbException\\n220\\t     *\\/\\n221\\t    public function searchSchool()\\n222\\t    {\\n223\\t        $keyWord = input(\'key_word\', \'\');\\n224\\t        $majorId = input(\'major_id\\/d\', 0);\\n225\\t        if (!empty($keyWord)) {\\n226\\t            $where = [];\\n227\\t            $where[\'b.name\'] = [\'like\', \'%\' . $keyWord . \'%\'];\\n228\\t            if (!empty($majorId)) {\\n229\\t                $where[\'a.major_id\'] = $majorId;\\n230\\t            }\\n231\\t            $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')->alias(\'a\')\\n232\\t                ->join(\'t_cl_school b\', \'a.school_id=b.id\', \'left\')\\n233\\t                ->join(\'t_cl_yuanxi c\', \'a.yuanxi_id=c.id\', \'left\')\\n234\\t                ->where($where)\\n235\\t                ->field(\'a.id,b.name school_name,c.name yuanxi_name,a.is_full\')\\n236\\t                ->select();\\n237\\t        } else {\\n238\\t            $list = [];\\n239\\t        }\\n240\\t        $this->success(\'success\', $list);\\n241\\t    }\\n242\\t\\n243\\t    \\/**\\n244\\t     * desc:搜索专业\\n245\\t     * author:hufangfang\\n246\\t     * data:2023\\/1\\/13 14:26\\n247\\t     * @return void\\n248\\t     * @throws Exception\\n249\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n250\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n251\\t     * @throws \\\\think\\\\exception\\\\DbException\\n252\\t     *\\/\\n253\\t    public function searchMajor()\\n254\\t    {\\n255\\t        $keyWord = input(\'key_word\', \'\');\\n256\\t        if (!empty($keyWord)) {\\n257\\t            $where[\'a.name\'] = [\'like\', \'%\' . $keyWord . \'%\'];\\n258\\t            $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')->alias(\'a\')\\n259\\t                ->join(\'t_cl_yjxk b\', \'a.yjxk_id=b.id\', \'left\')\\n260\\t                ->where($where)\\n261\\t                ->field(\'a.id,a.name major_name,a.code,b.type\')\\n262\\t                ->select();\\n263\\t        } else {\\n264\\t            $list = [];\\n265\\t        }\\n266\\t        $this->success(\'success\', $list);\\n267\\t    }\\n268\\t\\n269\\t    public function doCompair()\\n270\\t    {\\n271\\t        $majorSchoolIds = input(\'major_school_id\\/s\', \'\');\\n272\\t        $majorSchoolIds = explode(\',\', $majorSchoolIds);\\n273\\t        $is_coin_pay = input(\'is_coin_pay\\/d\', 0);\\n274\\t        if (count($majorSchoolIds) <= 1) {\\n275\\t            $this->error(\'至少选择两个学校进行对比\');\\n276\\t        }\\n277\\t        if (count($majorSchoolIds) > 3) {\\n278\\t            $this->error(\'最多选择三个学校进行对比\');\\n279\\t        }\\n280\\t        $return = [];\\n281\\t        $uid = session(\'uid\');\\n282\\t        if (!get_redis_lock(\'do_compair_lock_key_\' . $uid, 10)) {\\n283\\t            $this->error(\'您操作过于频繁，请稍后再试\');\\n284\\t        }\\n285\\t        $res = (new \\\\app\\\\api\\\\logic\\\\Common())->getLeftScanNum($uid, 2, $majorSchoolIds, $is_coin_pay);\\n286\\t        $data = $res[\'data\'];\\n287\\t        $pass = false;\\n288\\t        if($data[\'left_num\'] > 0 || ($data[\'coin_left_num\'] > 0 && $is_coin_pay == 1)){\\n289\\t            $pass = true;\\n290\\t            $status = accessControl(2, $majorSchoolIds ,!$data[\'direct_scan\']);\\n291\\t            if (!$status) {\\n292\\t                if ($status === 0) {\\n293\\t                    $this->error(\'您操作过于频繁，请稍后再试\');\\n294\\t                } else {\\n295\\t                    $this->error(\'您的账号存在异常，请联系客服\');\\n296\\t                }\\n297\\t            }else{\\n298\\t                if (!$data[\'direct_scan\']) {\\n299\\t                    $data[\'left_num\'] -= 1;\\n300\\t                }\\n301\\t            }\\n302\\t        }\\n303\\t        get_redis_lock(\'do_compair_lock_key_\' . $uid, 10, true);\\n304\\t        $coin_pay_price = $data[\'coin_pay_price\'];\\n305\\t        $coin = $data[\'coin\'];\\n306\\t        if ($is_coin_pay) {\\n307\\t            if ($res[\'errno\'] > 0) {\\n308\\t                $this->error($res[\'msg\']);\\n309\\t            }\\n310\\t        }\\n311\\t        $latestYear = config(\'latest_year\');\\n312\\t        $scoreInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n313\\t            ->whereIn(\'major_school_id\', $majorSchoolIds)\\n314\\t            ->where(\'year\', $latestYear)\\n315\\t            ->field(\'major_school_id,lqrs,jrfsrs,fsceb,zongfen,max_score,min_score,year\')\\n316\\t            ->select();\\n317\\t        $nzrs = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_detail\')\\n318\\t            ->whereIn(\'major_school_id\', $majorSchoolIds)\\n319\\t            ->where(\'year\', $latestYear)\\n320\\t            ->field(\'id,major_school_id,nzrs,year\')\\n321\\t            ->select();\\n322\\t        $avgScore = Db::name(\'major_school_ranking\')\\n323\\t            ->whereIn(\'major_school_id\', $majorSchoolIds)\\n324\\t            ->where(\'year\', $latestYear)\\n325\\t            ->select();\\n326\\t        $majorSchoolDetailIds = array_column($nzrs, \'id\');\\n327\\t        $detailIdToMajorSchoolId = array_column($nzrs, \'major_school_id\', \'id\');\\n328\\t        if (!empty($majorSchoolDetailIds)) {\\n329\\t            $yjfx = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_research\')\\n330\\t                ->whereIn(\'major_school_detail_id\', $majorSchoolDetailIds)\\n331\\t                ->field(\'major_school_detail_id,yjfx\')\\n332\\t                ->select();\\n333\\t            $item = [];\\n334\\t            foreach ($yjfx as $k => $v) {\\n335\\t                $item[$detailIdToMajorSchoolId[$v[\'major_school_detail_id\']]][] = $v[\'yjfx\'];\\n336\\t            }\\n337\\t            $yjfx = $item;\\n338\\t        }\\n339\\t        $scoreInfo = array_column($scoreInfo, null, \'major_school_id\');\\n340\\t        $nzrs = array_column($nzrs, null, \'major_school_id\');\\n341\\t        $avgScore = array_column($avgScore, null, \'major_school_id\');\\n342\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school\')\\n343\\t            ->whereIn(\'id\', $majorSchoolIds)\\n344\\t            ->select();\\n345\\t        if (count($list) <= 1) {\\n346\\t            $this->error(\'至少选择两个学校进行对比\');\\n347\\t        }\\n348\\t        $majorInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n349\\t            ->whereIn(\'id\', array_column($list, \'major_id\'))\\n350\\t            ->field(\'id,name,yjxk_id,code\')\\n351\\t            ->select();\\n352\\t        $schoolInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n353\\t            ->whereIn(\'id\', array_column($list, \'school_id\'))\\n354\\t            ->field(\'id,name,area_id,school_attr\')\\n355\\t            ->select();\\n356\\t        $yuanxiInfo = Db::connect(\'database.yx_db_config\')->name(\'cl_yuanxi\')\\n357\\t            ->whereIn(\'id\', array_column($list, \'yuanxi_id\'))\\n358\\t            ->field(\'id,name\')\\n359\\t            ->select();\\n360\\t        $yjxkIds = array_column($majorInfo, \'yjxk_id\');\\n361\\t        $yjxkInfo = Db::connect((\'database.yx_db_config\'))->name(\'cl_yjxk\')\\n362\\t            ->whereIn(\'id\', $yjxkIds)\\n363\\t            ->select();\\n364\\t        $arreaName = Db::connect(\'database.yx_db_config\')\\n365\\t            ->name(\'area\')\\n366\\t            ->column(\'name\', \'id\');\\n367\\t        $ping = Db::connect(\'database.yx_db_config\')->name(\'cl_school_yjxk\')\\n368\\t            ->whereIn(\'school_id\', array_column($list, \'school_id\'))\\n369\\t            ->select();\\n370\\t        $subjectAssessment = [];\\n371\\t        foreach ($ping as $k => $v) {\\n372\\t            $subjectAssessment[$v[\'school_id\'] . \'_\' . $v[\'yjxk_id\']] = $v[\'subject_assessment\'];\\n373\\t        }\\n374\\t        $subjectAssessmentList = (new \\\\app\\\\admin\\\\model\\\\SchoolMajor())->getSubjectAssessment();\\n375\\t        $yjxkInfo = array_column($yjxkInfo, null, \'id\');\\n376\\t        $majorInfo = array_column($majorInfo, null, \'id\');\\n377\\t        $schoolInfo = array_column($schoolInfo, null, \'id\');\\n378\\t        $yuanxiInfo = array_column($yuanxiInfo, null, \'id\');\\n379\\t        $years = ModelMajor::getYear(3);\\n380\\t        $tagslist = Config::get(\'school_tags\');\\n381\\t        foreach ($list as $k => $v) {\\n382\\t            $yjxkId = $majorInfo[$v[\'major_id\']][\'yjxk_id\'] ?? 0;\\n383\\t            $subject_assessment = $subjectAssessment[$v[\'school_id\'] . \'_\' . $yjxkId] ?? 99;\\n384\\t            $list[$k][\'subject_assessment\'] = $subject_assessment;\\n385\\t        }\\n386\\t        $sort = array_column($list, \'subject_assessment\');\\n387\\t        array_multisort($sort, SORT_ASC, $list);\\n388\\t        foreach ($list as $k => $v) {\\n389\\t            $yjxkId = $majorInfo[$v[\'major_id\']][\'yjxk_id\'] ?? 0;\\n390\\t            $code = $majorInfo[$v[\'major_id\']][\'code\'] ?? \'\';\\n391\\t            if (!empty($majorInfo[$v[\'major_id\']])) {\\n392\\t                $return[\'major_name\'] = $majorInfo[$v[\'major_id\']][\'name\'];\\n393\\t                $return[\'menlei\'] = $yjxkInfo[$yjxkId][\'menlei\'];\\n394\\t                $return[\'yjxk_name\'] = $yjxkInfo[$yjxkId][\'name\'];\\n395\\t                $return[\'code\'] = $code;\\n396\\t            } else {\\n397\\t                $return[\'major_name\'] = \'\';\\n398\\t                $return[\'menlei\'] = \'\';\\n399\\t                $return[\'yjxk_name\'] = \'\';\\n400\\t                $return[\'code\'] = \'\';\\n401\\t            }\\n402\\t            $return[\'school_name\'][] = $schoolInfo[$v[\'school_id\']][\'name\'] ?? \'\';\\n403\\t            $return[\'school_attr\'][] = $schoolInfo[$v[\'school_id\']][\'school_attr\'] ?? \'\';\\n404\\t            $return[\'is_full\'][] = $v[\'is_full\'] ?? \'\';\\n405\\t            $return[\'yuanxi_name\'][] = $yuanxiInfo[$v[\'yuanxi_id\']][\'name\'] ?? \'\';\\n406\\t            $subject_assessment = $v[\'subject_assessment\'];\\n407\\t            $element = [];\\n408\\t            if ($subject_assessment != 99) {\\n409\\t                $element[\'value\'] = $subject_assessment;\\n410\\t                $element[\'value_name\'] = $subjectAssessmentList[$subject_assessment] ?? \'\';\\n411\\t                $element[\'high_light\'] = false;\\n412\\t            } else {\\n413\\t                $element[\'value\'] = \'-\';\\n414\\t                $element[\'value_name\'] = \'-\';\\n415\\t                $element[\'high_light\'] = false;\\n416\\t            }\\n417\\t            $return[\'subject_assessment\'][] = $element;\\n418\\t            $return[\'kskm\'][] = explode(\',\', $v[\'kskm\']);\\n419\\t            $return[\'area_name\'][] = $arreaName[$schoolInfo[$v[\'school_id\']][\'area_id\']] ?? \'\';\\n420\\t            $nzrsNum = $nzrs[$v[\'id\']][\'nzrs\'] ?? 0;\\n421\\t            $element = [];\\n422\\t            $element[\'value\'] = $nzrsNum;\\n423\\t            $element[\'high_light\'] = false;\\n424\\t            $return[\'nzrs\'][] = $element;\\n425\\t            $jrfsrsNum = $scoreInfo[$v[\'id\']][\'jrfsrs\'] ?? 0;\\n426\\t            $lqrsNum = $scoreInfo[$v[\'id\']][\'lqrs\'] ?? 0;\\n427\\t            $element = [];\\n428\\t            $element[\'value\'] = $lqrsNum;\\n429\\t            $element[\'high_light\'] = false;\\n430\\t            $return[\'lqrs\'][] = $element;\\n431\\t            if ($jrfsrsNum == -1) {\\n432\\t                $return[\'jrfsrs\'][] = \'待整理\';\\n433\\t            } elseif ($jrfsrsNum == -1) {\\n434\\t                $return[\'jrfsrs\'][] = \'未公布\';\\n435\\t            } else {\\n436\\t                $return[\'jrfsrs\'][] = $jrfsrsNum;\\n437\\t            }\\n438\\t            $element = [];\\n439\\t            if ($lqrsNum > 0 && $jrfsrsNum >= 0) {\\n440\\t                \\/\\/计算$jrfsrs和$lqrs的比值并保留一位小数\\n441\\t                $flb = sprintf(\'%.1f\', $jrfsrsNum \\/ $lqrsNum);\\n442\\t                $element[\'value\'] = $flb;\\n443\\t                $element[\'high_light\'] = false;\\n444\\t            } else {\\n445\\t                $element[\'value\'] = \'-\';\\n446\\t                $element[\'high_light\'] = false;\\n447\\t            }\\n448\\t            $return[\'flb\'][] = $element;\\n449\\t            $return[\'is_vip\'] = $data[\'isvip\'];\\n450\\t            $return[\'yjfx\'][] = $yjfx[$v[\'id\']] ?? [];\\n451\\t            if ($pass) {\\n452\\t                if (isset($scoreInfo[$v[\'id\']])) {\\n453\\t                    $yearScore = array_column($scoreInfo[$v[\'id\']], null, \'year\');\\n454\\t                } else {\\n455\\t                    $yearScore = [];\\n456\\t                }\\n457\\t\\n458\\t                $rand = \'\';\\n459\\t                foreach ($years as $year) {\\n460\\t                    $rand .= empty($yearScore[$year]) ? \'-\' : $yearScore[$year][\'max_score\'] . $yearScore[$year][\'min_score\'] . $yearScore[$year][\'zongfen\'];\\n461\\t                    $national = (new MajorSchool())->getNationalForSingle($schoolInfo[$v[\'school_id\']][\'area_id\'], $v[\'major_id\'], $year);\\n462\\t                    $rand .= $national[\'total_score\'] ?? \'-\';\\n463\\t                }\\n464\\t                $rand = md5($rand);\\n465\\t                $return[\'year_vs_score\'][] = config(\'cdn_self_website_url\') . \'\\/static\\/yxkpic\\/1\\/\' . $v[\'id\'] . \'\\/\' . $rand;\\n466\\t                $element = [];\\n467\\t                if (isset($avgScore[$v[\'id\']][\'score_zh\']) && !empty(floatval($avgScore[$v[\'id\']][\'score_zh\']))) {\\n468\\t                    $element[\'value\'] = floatval($avgScore[$v[\'id\']][\'score_zh\']);\\n469\\t                    $element[\'high_light\'] = false;\\n470\\t                } else {\\n471\\t                    $element[\'value\'] = \'-\';\\n472\\t                    $element[\'high_light\'] = false;\\n473\\t                }\\n474\\t                $return[\'score_zh\'][] = $element;\\n475\\t                $element = [];\\n476\\t                if (isset($avgScore[$v[\'id\']][\'score_en\']) && !empty(floatval($avgScore[$v[\'id\']][\'score_en\']))) {\\n477\\t                    $element[\'value\'] = floatval($avgScore[$v[\'id\']][\'score_en\']);\\n478\\t                    $element[\'high_light\'] = false;\\n479\\t                } else {\\n480\\t                    $element[\'value\'] = \'-\';\\n481\\t                    $element[\'high_light\'] = false;\\n482\\t                }\\n483\\t                $return[\'score_en\'][] = $element;\\n484\\t                $element = [];\\n485\\t                if (isset($avgScore[$v[\'id\']][\'score_one\']) && !empty(floatval($avgScore[$v[\'id\']][\'score_one\']))) {\\n486\\t                    $element[\'value\'] = floatval($avgScore[$v[\'id\']][\'score_one\']);\\n487\\t                    $element[\'high_light\'] = false;\\n488\\t                } else {\\n489\\t                    $element[\'value\'] = \'-\';\\n490\\t                    $element[\'high_light\'] = false;\\n491\\t                }\\n492\\t                $return[\'score_one\'][] = $element;\\n493\\t                $element = [];\\n494\\t                if (isset($avgScore[$v[\'id\']][\'score_two\']) && !empty(floatval($avgScore[$v[\'id\']][\'score_two\']))) {\\n495\\t                    $element[\'value\'] = floatval($avgScore[$v[\'id\']][\'score_two\']);\\n496\\t                    $element[\'high_light\'] = false;\\n497\\t                } else {\\n498\\t                    $element[\'value\'] = \'-\';\\n499\\t                    $element[\'high_light\'] = false;\\n500\\t                }\\n501\\t                $return[\'score_two\'][] = $element;\\n502\\t                if (!empty($v[\'tags\'])) {\\n503\\t                    $tags = explode(\',\', $v[\'tags\']);\\n504\\t                    $tags = array_filter($tags);\\n505\\t                    $tags = array_unique($tags);\\n506\\t                    $tags = array_values($tags);\\n507\\t                    $tags = array_map(function ($v) use ($tagslist) {\\n508\\t                        return $tagslist[$v] ?? \'\';\\n509\\t                    }, $tags);\\n510\\t                    $return[\'tags\'][] = $tags;\\n511\\t                } else {\\n512\\t                    $return[\'tags\'][] = [];\\n513\\t                }\\n514\\t            } else {\\n515\\t                $return[\'year_vs_score\'] = [];\\n516\\t                $return[\'score_zh\'] = [];\\n517\\t                $return[\'score_en\'] = [];\\n518\\t                $return[\'score_one\'] = [];\\n519\\t                $return[\'score_two\'] = [];\\n520\\t                $return[\'tags\'] = [];\\n521\\t            }\\n522\\t        }\\n523\\t        adjustHighlighting($return[\'subject_assessment\'], false);\\n524\\t        adjustHighlighting($return[\'nzrs\']);\\n525\\t        adjustHighlighting($return[\'lqrs\']);\\n526\\t        adjustHighlighting($return[\'flb\'], false);\\n527\\t        adjustHighlighting($return[\'score_zh\'], false);\\n528\\t        adjustHighlighting($return[\'score_en\'], false);\\n529\\t        adjustHighlighting($return[\'score_one\'], false);\\n530\\t        adjustHighlighting($return[\'score_two\'], false);\\n531\\t        if ($pass) {\\n532\\t            if (empty(array_filter($return[\'tags\']))) {\\n533\\t                unset($return[\'tags\']);\\n534\\t            }\\n535\\t            \\/\\/判断 score_zh 的 value是不是全是\'-\'\\n536\\t            $score_zh = array_column($return[\'score_zh\'], \'value\');\\n537\\t            $score_zh = array_filter($score_zh, function ($v) {\\n538\\t                return $v != \'-\';\\n539\\t            });\\n540\\t            $score_en = array_column($return[\'score_en\'], \'value\');\\n541\\t            $score_en = array_filter($score_en, function ($v) {\\n542\\t                return $v != \'-\';\\n543\\t            });\\n544\\t            \\/\\/判断 score_one 的 value是不是全是\'-\'\\n545\\t            $score_one = array_column($return[\'score_one\'], \'value\');\\n546\\t            $score_one = array_filter($score_one, function ($v) {\\n547\\t                return $v != \'-\';\\n548\\t            });\\n549\\t            \\/\\/判断 score_two 的 value是不是全是\'-\'\\n550\\t            $score_two = array_column($return[\'score_two\'], \'value\');\\n551\\t            $score_two = array_filter($score_two, function ($v) {\\n552\\t                return $v != \'-\';\\n553\\t            });\\n554\\t            if (empty($score_zh)) {\\n555\\t                unset($return[\'score_zh\']);\\n556\\t            }\\n557\\t            if (empty($score_en)) {\\n558\\t                unset($return[\'score_en\']);\\n559\\t            }\\n560\\t            if (empty($score_one)) {\\n561\\t                unset($return[\'score_one\']);\\n562\\t            }\\n563\\t            if (empty($score_two)) {\\n564\\t                unset($return[\'score_two\']);\\n565\\t            }\\n566\\t        }\\n567\\t        $subject_assessment = array_column($return[\'subject_assessment\'], \'value\');\\n568\\t        $subject_assessment = array_filter($subject_assessment, function ($v) {\\n569\\t            return $v != \'-\';\\n570\\t        });\\n571\\t        $flb = array_column($return[\'flb\'], \'value\');\\n572\\t        $flb = array_filter($flb, function ($v) {\\n573\\t            return $v != \'-\';\\n574\\t        });\\n575\\t\\n576\\t        if (empty($subject_assessment)) {\\n577\\t            unset($return[\'subject_assessment\']);\\n578\\t        }\\n579\\t        if (empty($flb)) {\\n580\\t            unset($return[\'flb\']);\\n581\\t        }\\n582\\t        if (!empty($return[\'nzrs\'])) {\\n583\\t            foreach ($return[\'nzrs\'] as $k => $v) {\\n584\\t                if ($v[\'value\'] == -1) {\\n585\\t                    $return[\'nzrs\'][$k][\'value\'] = \'待整理\';\\n586\\t                }\\n587\\t                if ($v[\'value\'] == -2) {\\n588\\t                    $return[\'nzrs\'][$k][\'value\'] = \'未发布\';\\n589\\t                }\\n590\\t            }\\n591\\t        }\\n592\\t        if (!empty($return[\'lqrs\'])) {\\n593\\t            foreach ($return[\'lqrs\'] as $k => $v) {\\n594\\t                if ($v[\'value\'] == -1) {\\n595\\t                    $return[\'lqrs\'][$k][\'value\'] = \'待整理\';\\n596\\t                }\\n597\\t                if ($v[\'value\'] == -2) {\\n598\\t                    $return[\'lqrs\'][$k][\'value\'] = \'未发布\';\\n599\\t                }\\n600\\t            }\\n601\\t        }\\n602\\t        $return[\'year\'] = $latestYear;\\n603\\t        $teacherInfo = [];\\n604\\t        if ($uid) {\\n605\\t            $teacherInfo = getQrcodeNew(session(\'uid\'), false);\\n606\\t        }\\n607\\t        if (empty($teacherInfo)) {\\n608\\t            $teacherInfo = [];\\n609\\t        } else {\\n610\\t            $teacherInfo = $teacherInfo[\'data\'] ?? [];\\n611\\t        }\\n612\\t        $return[\'teacherInfo\'] = $teacherInfo;\\n613\\t        $return[\'left_num\'] = $data[\'left_num\'];\\n614\\t        $return[\'total_num\'] = $data[\'total_num\'];\\n615\\t        $return[\'coin_total_num\'] = $data[\'coin_total_num\'];\\n616\\t        $return[\'coin_left_num\'] = $data[\'coin_left_num\'];\\n617\\t        $return[\'coin_pay_price\'] = $coin_pay_price;\\n618\\t        $return[\'my_coin\'] = $coin;\\n619\\t        $this->success(\'success\', $return);\\n620\\t    }\\n621\\t\\n622\\t    public function getPic()\\n623\\t    {\\n624\\t        $type = input(\'type\', 1);\\n625\\t        \\/\\/\\n626\\t        if ($type == 5 || $type == 6 || $type == 7) {\\n627\\t            (new \\\\app\\\\api\\\\logic\\\\Pic())->createPicDetail($type);\\n628\\t        } elseif(in_array($type,[8,9,10,11,12,13,14,15])) {\\n629\\t            (new \\\\app\\\\api\\\\logic\\\\Pic())->createCompair($type);\\n630\\t        } else {\\n631\\t            (new \\\\app\\\\api\\\\logic\\\\Pic())->createPic($type);\\n632\\t        }\\n633\\t        exit;\\n634\\t    }\\n635\\t\\n636\\t    public function getFushiPic()\\n637\\t    {\\n638\\t        $id = input(\'id\', 0);\\n639\\t        $type = input(\'type\', 1);\\n640\\t        $year = input(\'year\', 0);\\n641\\t        if (empty($id) || empty($year)) {\\n642\\t            return false;\\n643\\t        }\\n644\\t        $imageBuild = new ImageBuild();\\n645\\t        if ($type == 1) {\\n646\\t            $admitinfo = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n647\\t                ->where(\'major_school_id\', $id)\\n648\\t                ->where(\'year\', \'=\', $year)\\n649\\t                ->field(\'year,lqrs,max_score,mid_score,min_score,zongfen,tj_source,tj_out\')\\n650\\t                ->find();\\n651\\t            $lqrs = floatval($admitinfo[\'lqrs\']);\\n652\\t            $max_score = floatval($admitinfo[\'max_score\']);\\n653\\t            $mid_score = floatval($admitinfo[\'mid_score\']);\\n654\\t            $min_score = floatval($admitinfo[\'min_score\']);\\n655\\t            $zongfen = floatval($admitinfo[\'zongfen\']);\\n656\\t            if ($lqrs <= 0) {\\n657\\t                $lqrs = \'--\';\\n658\\t            }\\n659\\t            if ($max_score <= 0) {\\n660\\t                $max_score = \'--\';\\n661\\t            }\\n662\\t            if ($mid_score <= 0) {\\n663\\t                $mid_score = \'--\';\\n664\\t            }\\n665\\t            if ($min_score <= 0) {\\n666\\t                $min_score = \'--\';\\n667\\t            }\\n668\\t            if ($zongfen <= 0) {\\n669\\t                $zongfen = \'--\';\\n670\\t            }\\n671\\t            $line = [\\n672\\t                [[\'一志愿录取人数：\', $lqrs], [\'\', \'\']],\\n673\\t                [[\'\', \'\'], [\'\', \'\']],\\n674\\t                [[\'录取最高分：\', $max_score], [\'\', \'\']],\\n675\\t                [[\'录取中位分：\', $mid_score], [\'\', \'\']],\\n676\\t                [[\'录取最低分：\', $min_score], [\'\', \'\']],\\n677\\t                [[\'      复试线：\', $zongfen], [\'\', \'\']],\\n678\\t            ];\\n679\\t            $imageBuild->tableNotSaveTj($line, 303, $type);\\n680\\t            exit;\\n681\\t        } elseif ($type == 2) {\\n682\\t            $tj_info = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n683\\t                ->where(\'major_school_id\', $id)\\n684\\t                ->where(\'year\', \'=\', $year)\\n685\\t                ->field(\'year,tj_fsrs,tj_lqrs,tj_maxscore,tj_minscore,tj_midscore\')\\n686\\t                ->find();\\n687\\t            $tj_fsrs = floatval($tj_info[\'tj_fsrs\']);\\n688\\t            $tj_lqrs = floatval($tj_info[\'tj_lqrs\']);\\n689\\t            $tj_maxscore = floatval($tj_info[\'tj_maxscore\']);\\n690\\t            $tj_midscore = floatval($tj_info[\'tj_midscore\']);\\n691\\t            $tj_minscore = floatval($tj_info[\'tj_minscore\']);\\n692\\t            if ($tj_fsrs <= 0) {\\n693\\t                $tj_fsrs = \'--\';\\n694\\t            }\\n695\\t            if ($tj_lqrs <= 0) {\\n696\\t                $tj_lqrs = \'--\';\\n697\\t            }\\n698\\t            if ($tj_maxscore <= 0) {\\n699\\t                $tj_maxscore = \'--\';\\n700\\t            }\\n701\\t            if ($tj_midscore <= 0) {\\n702\\t                $tj_midscore = \'--\';\\n703\\t            }\\n704\\t            if ($tj_minscore <= 0) {\\n705\\t                $tj_minscore = \'--\';\\n706\\t            }\\n707\\t            $line = [\\n708\\t                [[\'调剂复试人数：\', $tj_fsrs], [\'调剂录取人数：  \', $tj_lqrs]],\\n709\\t                [[\'\', \'\'], [\'\', \'\']],\\n710\\t                [[\'录取最高分：\', $tj_maxscore], [\'\', \'\']],\\n711\\t                [[\'录取中位分：\', $tj_midscore], [\'\', \'\']],\\n712\\t                [[\'录取最低分：\', $tj_minscore], [\'\', \'\']],\\n713\\t            ];\\n714\\t            $imageBuild->tableNotSaveTj($line, 303, $type);\\n715\\t            exit;\\n716\\t        } elseif ($type == 3) {\\n717\\t            $tj_source = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n718\\t                ->where(\'major_school_id\', $id)\\n719\\t                ->where(\'year\', \'=\', $year)\\n720\\t                ->value(\'tj_source\');\\n721\\t            $imageBuild->textNotSave($tj_source, 323);\\n722\\t            exit;\\n723\\t        } elseif ($type == 4) {\\n724\\t            $tj_out = Db::connect(\'database.yx_db_config\')->name(\'cl_major_school_admit\')\\n725\\t                ->where(\'major_school_id\', $id)\\n726\\t                ->where(\'year\', \'=\', $year)\\n727\\t                ->value(\'tj_out\');\\n728\\t            $imageBuild->textNotSave($tj_out, 323);\\n729\\t            exit;\\n730\\t        } elseif ($type == 5) {\\n731\\t            $line = [];\\n732\\t            $lineTitle = [\'序号\', \'学校\', \'初试总分\'];\\n733\\t            $p = input(\'p\', 1);\\n734\\t            if (($p - 1) <= 0) {\\n735\\t                $start = 0;\\n736\\t            } else {\\n737\\t                $start = ($p - 1) * 10;\\n738\\t            }\\n739\\t\\n740\\t            $list = Db::connect(\'database.yx_db_config\')->name(\'cl_source_school\')\\n741\\t                ->where(\'major_school_id\', $id)\\n742\\t                ->where(\'year\', \'=\', $year)\\n743\\t                ->limit($start, 10)\\n744\\t                ->select();\\n745\\t            if (!empty($list)) {\\n746\\t                foreach ($list as $k => $v) {\\n747\\t                    $item = [];\\n748\\t                    $item[] = $k + 1;\\n749\\t                    $item[] = $v[\'school_name\'];\\n750\\t                    $item[] = $v[\'total_score\'];\\n751\\t                    $line[] = $item;\\n752\\t                }\\n753\\t            }\\n754\\t            array_unshift($line, $lineTitle);\\n755\\t            $imageBuild->tableNotSaveSource($line, 323);\\n756\\t            exit;\\n757\\t        } elseif ($type == 8 || $type == 11) {\\n758\\t            if ($type == 8) {\\n759\\t                $where = [];\\n760\\t                $where[\'major_school_id\'] = $id;\\n761\\t                $where[\'qx_major_school_id\'] = [\'>\', 0];\\n762\\t            } else {\\n763\\t                $where = [];\\n764\\t                $where[\'qx_major_school_id\'] = $id;\\n765\\t                $where[\'major_school_id\'] = [\'>\', 0];\\n766\\t            }\\n767\\t            $minYear = config(\'latest_year\') - 2;\\n768\\t            $page = input(\'page\', 1);\\n769\\t            $lqList = Db::connect(\'database.yx_db_config\')->name(\'cl_roster\')\\n770\\t                ->where($where)\\n771\\t                ->where(\'year\', \'>=\', $minYear)\\n772\\t                ->where(\'type\', 1)\\n773\\t                ->where(\'istonic_id\', 2)\\n774\\t                ->field(\'year,qx_school_id,qx_major_id,st_name,cs_all_result,school_id,major_id\')\\n775\\t                ->limit(($page - 1) * 10, 10)\\n776\\t                ->order([\'year\' => \'desc\', \'id\' => \'asc\'])\\n777\\t                ->select();\\n778\\t            $school = Db::connect(\'database.yx_db_config\')->name(\'cl_school\')\\n779\\t                ->column(\'name\', \'id\');\\n780\\t            $major = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n781\\t                ->column(\'name\', \'id\');\\n782\\t            if ($type == 8) {\\n783\\t                $lineTitle = [\'年份\', \'调剂来源学校\', \'调剂来源专业\', \'学生\', \'初试总分\'];\\n784\\t            } else {\\n785\\t                $lineTitle = [\'年份\', \'调剂去向学校\', \'调剂去向专业\', \'学生\', \'初试总分\'];\\n786\\t            }\\n787\\t\\n788\\t            $line[] = $lineTitle;\\n789\\t            foreach ($lqList as $key => $value) {\\n790\\t                \\/\\/只保留名字的第一个字后面的用*代替\\n791\\t                if ($type == 8) {\\n792\\t                    $value[\'school_name\'] = $school[$value[\'qx_school_id\']] ?? \'\';\\n793\\t                } else {\\n794\\t                    $value[\'school_name\'] = $school[$value[\'school_id\']] ?? \'\';\\n795\\t                }\\n796\\t                if ($type == 8) {\\n797\\t                    $value[\'major_name\'] = $major[$value[\'qx_major_id\']] ?? \'\';\\n798\\t                } else {\\n799\\t                    $value[\'major_name\'] = $major[$value[\'major_id\']] ?? \'\';\\n800\\t                }\\n801\\t                if (!empty($value[\'school_name\'])) {\\n802\\t                    if (mb_strlen($value[\'school_name\'], \'utf-8\') > 7) {\\n803\\t                        $value[\'school_name\'] = mb_substr($value[\'school_name\'], 0, 7, \'utf-8\') . \'...\';\\n804\\t                    }\\n805\\t                } else {\\n806\\t                    $value[\'school_name\'] = \'\';\\n807\\t                }\\n808\\t                if (!empty($value[\'major_name\'])) {\\n809\\t                    if (mb_strlen($value[\'major_name\'], \'utf-8\') > 7) {\\n810\\t                        $value[\'major_name\'] = mb_substr($value[\'major_name\'], 0, 7, \'utf-8\') . \'...\';\\n811\\t                    }\\n812\\t                } else {\\n813\\t                    $value[\'major_name\'] = \'\';\\n814\\t                }\\n815\\t                if (!empty($value[\'st_name\'])) {\\n816\\t                    $value[\'st_name\'] = mb_substr($value[\'st_name\'], 0, 1, \'utf-8\') . str_repeat(\'*\', mb_strlen($value[\'st_name\'], \'utf-8\') - 1);\\n817\\t                } else {\\n818\\t                    $value[\'st_name\'] = \'***\';\\n819\\t                }\\n820\\t                $value[\'cs_all_result\'] = floatval($value[\'cs_all_result\']);\\n821\\t                $line1 = [$value[\'year\'], $value[\'school_name\'], $value[\'major_name\'], $value[\'st_name\'], $value[\'cs_all_result\']];\\n822\\t                $line[] = $line1;\\n823\\t            }\\n824\\t            $num = 11 - count($line);\\n825\\t            if ($num > 0) {\\n826\\t                for ($i = 0; $i < $num; $i++) {\\n827\\t                    $line[] = [\'\', \'\', \'\', \'\', \'\'];\\n828\\t                }\\n829\\t            }\\n830\\t            $imageBuild->tableNotSave1($line, 650);\\n831\\t            exit;\\n832\\t        } elseif ($type == 9 || $type == 10) {\\n833\\t            $minYear = config(\'latest_year\') - 2;\\n834\\t            $where[\'major_school_id\'] = $id;\\n835\\t            if ($type == 9) {\\n836\\t                $where[\'retest_number\'] = [\'>\', 0];\\n837\\t            } else {\\n838\\t                $where[\'out_number\'] = [\'>\', 0];\\n839\\t            }\\n840\\t            $tongji = Db::connect(\'database.yx_db_config\')->name(\'cl_roster_adjust_stat\')\\n841\\t                ->where($where)\\n842\\t                ->where(\'year\', \'>=\', $minYear)\\n843\\t                ->group(\'year\')\\n844\\t                ->order(\'year\', \'desc\')\\n845\\t                ->select();\\n846\\t            if ($type == 9) {\\n847\\t                $row = 5;\\n848\\t                $special = true;\\n849\\t                $lineTitle = [\'年份\', \\\"调剂\\\\n复试人数\\\", \\\"调剂\\\\n录取人数\\\", \'分数范围\', \'复录比\'];\\n850\\t            } else {\\n851\\t                $row = 3;\\n852\\t                $special = false;\\n853\\t                $lineTitle = [\'年份\', \'调剂出去数量\', \'分数范围\'];\\n854\\t            }\\n855\\t\\n856\\t            $line[] = $lineTitle;\\n857\\t\\n858\\t            foreach ($tongji as $k => $v) {\\n859\\t                if ($type == 9) {\\n860\\t                    if ($v[\'admission_number\'] > 0) {\\n861\\t                        $flb = floatval(sprintf(\'%.1f\', $v[\'retest_number\'] \\/ $v[\'admission_number\'])) . \\\":1\\\";\\n862\\t                    } else {\\n863\\t                        $flb = $v[\'retest_number\'] . \':0\';\\n864\\t                    }\\n865\\t                    $range = floatval($v[\'admission_min_result\']) . \'-\' . floatval($v[\'admission_max_result\']);\\n866\\t                    $line1 = [$v[\'year\'], $v[\'retest_number\'], $v[\'admission_number\'], $range, $flb];\\n867\\t                } else {\\n868\\t                    $range = floatval($v[\'out_min_result\']) . \'-\' . floatval($v[\'out_max_result\']);\\n869\\t                    $line1 = [$v[\'year\'], $v[\'out_number\'], $range];\\n870\\t                }\\n871\\t                $line[] = $line1;\\n872\\t            }\\n873\\t            $imageBuild->tableNotSave1($line, 650, $row, false, $special);\\n874\\t        }\\n875\\t    }\\n876\\t\\n877\\t    \\/**\\n878\\t     * Function majorFilter [专业筛选]\\n879\\t     * Auther: Changzd\\n880\\t     * Date: 2023\\/7\\/25\\n881\\t     *\\/\\n882\\t    public function majorFilter()\\n883\\t    {\\n884\\t        $majors = [];\\n885\\t        do {\\n886\\t            \\/\\/ 专业分类 1 容易考上 2就业公务员 3 就业前景好 0 相近专业\\n887\\t            $majorClass = input(\'major_class\', 0);\\n888\\t            if (!in_array($majorClass, [-1,0, 1, 2, 3])) {\\n889\\t                break;\\n890\\t            }\\n891\\t\\n892\\t            $choose = new \\\\app\\\\api\\\\logic\\\\ChooseSchoolV3();\\n893\\t            if (!$majorClass) {\\n894\\t                $majorType = input(\'major_type\', 0);\\n895\\t                $majorCode = input(\'major_code\', 0);\\n896\\t                if (empty($majorType) || empty($majorCode)) {\\n897\\t                    break;\\n898\\t                }\\n899\\t                $majors = $choose->similarMajor($majorType, $majorCode);\\n900\\t            } else {\\n901\\t                $majors = $choose->majorFilter($majorClass);\\n902\\t            }\\n903\\t        } while (false);\\n904\\t\\n905\\t        $this->success(\'success\', $majors);\\n906\\t    }\\n907\\t\\n908\\t    \\/**\\n909\\t     * desc:学科门类专业列表\\n910\\t     * author:hufangfang\\n911\\t     * data:2023\\/1\\/12 14:35\\n912\\t     * @return void\\n913\\t     * @throws Exception\\n914\\t     * @throws \\\\think\\\\db\\\\exception\\\\DataNotFoundException\\n915\\t     * @throws \\\\think\\\\db\\\\exception\\\\ModelNotFoundException\\n916\\t     * @throws \\\\think\\\\exception\\\\DbException\\n917\\t     *\\/\\n918\\t    public function majorMenleiNew()\\n919\\t    {\\n920\\t        $type = input(\'type\', \'\');\\n921\\t        $where = [];\\n922\\t        if (!empty($type)) {\\n923\\t            $where[\'type\'] = $type;\\n924\\t        }\\n925\\t        $list = Db::connect(\'database.yx_db_config\')->name(\'cl_yjxk\')\\n926\\t            ->where($where)\\n927\\t            ->group(\'menlei,name\')\\n928\\t            ->select();\\n929\\t        $sort = [\\n930\\t            \'哲学\',\\n931\\t            \'经济学\',\\n932\\t            \'法学\',\\n933\\t            \'教育学\',\\n934\\t            \'文学\',\\n935\\t            \'历史学\',\\n936\\t            \'理学\',\\n937\\t            \'工学\',\\n938\\t            \'农学\',\\n939\\t            \'医学\',\\n940\\t            \'军事学\',\\n941\\t            \'管理学\',\\n942\\t            \'艺术学\',\\n943\\t            \'交叉学科\'\\n944\\t        ];\\n945\\t        $list = listToTree($list, [\'menlei\', \'name\']);\\n946\\t        $sortList = [];\\n947\\t        foreach ($sort as $k => $v) {\\n948\\t            foreach ($list as $kk => $vv) {\\n949\\t                if ($v == $vv[\'name\']) {\\n950\\t                    $sortList[] = $vv;\\n951\\t                }\\n952\\t            }\\n953\\t        }\\n954\\t        $list = $sortList;\\n955\\t        $newList = [];\\n956\\t        foreach ($list as $k => $v) {\\n957\\t            $item = [];\\n958\\t            foreach ($v[\'list\'] as $kk => $vv) {\\n959\\t                $item[$vv[\'type\']][\'name\'] = $vv[\'menlei\'];\\n960\\t                $item[$vv[\'type\']][\'list\'][] = $vv;\\n961\\t            }\\n962\\t            $newList[\'学术硕士\'][\'name\'] = \'学术硕士\';\\n963\\t            if (isset($item[\'学术硕士\'])) {\\n964\\t                $newList[\'学术硕士\'][\'list\'][] = $item[\'学术硕士\'] ?? [];\\n965\\t            }\\n966\\t            $newList[\'专业硕士\'][\'name\'] = \'专业硕士\';\\n967\\t            if (isset($item[\'专业硕士\'])) {\\n968\\t                $newList[\'专业硕士\'][\'list\'][] = $item[\'专业硕士\'] ?? [];\\n969\\t            }\\n970\\t        }\\n971\\t        $list = array_values($newList);\\n972\\t\\n973\\t        $majorlist = Db::connect(\'database.yx_db_config\')->name(\'cl_major\')\\n974\\t            ->order(\'code\')\\n975\\t            ->column(\'id,name,code,yjxk_id\');\\n976\\t        foreach ($list as $k1 => &$v1) {\\n977\\t            foreach ($v1[\'list\'] as $k => $v) {\\n978\\t                foreach ($v[\'list\'] as $kk => $vv) {\\n979\\t                    $item = [];\\n980\\t                    $vv[\'list\'] = [];\\n981\\t                    foreach ($majorlist as $kkk => $vvv) {\\n982\\t                        $item[\'name\'] = $vvv[\'name\'];\\n983\\t                        $item[\'code\'] = $vvv[\'code\'];\\n984\\t                        $item[\'value\'] = $vvv[\'id\'];\\n985\\t                        if ($vvv[\'yjxk_id\'] == $vv[\'value\']) {\\n986\\t                            $vv[\'list\'][$vvv[\'yjxk_id\']][] = $item;\\n987\\t                        }\\n988\\t                    }\\n989\\t                    $v[\'list\'][$kk] = $vv;\\n990\\t                }\\n991\\t                $v1[\'list\'][$k] = $v;\\n992\\t            }\\n993\\t        }\\n994\\t        unset($v1);\\n995\\t        foreach ($list as $k1 => &$v1) {\\n996\\t            foreach ($v1[\'list\'] as $k => $v) {\\n997\\t                foreach ($v[\'list\'] as $kk => $vv) {\\n998\\t                    $v1[\'list\'][$k][\'list\'][$kk][\'list\'] = array_values($vv[\'list\'])[0] ?? [];\\n999\\t                    if (empty($v1[\'list\'][$k][\'list\'][$kk][\'list\'])) {\\n1000\\t                        unset($v1[\'list\'][$k][\'list\'][$kk]);\\n1001\\t                    }\\n1002\\t                    if (empty($v1[\'list\'][$k][\'list\'])) {\\n1003\\t                        unset($v1[\'list\'][$k]);\\n1004\\t                    }\\n1005\\t                }\\n1006\\t                if (!empty($v1[\'list\'][$k][\'list\'])) {\\n1007\\t                    $v1[\'list\'][$k][\'list\'] = array_values($v1[\'list\'][$k][\'list\']);\\n1008\\t                }\\n1009\\t            }\\n1010\\t        }\\n1011\\t        unset($v1);\\n1012\\t\\n1013\\t        $this->success(\'success\', array_values($list));\\n1014\\t    }\\n1015\\t}\\n1016\\t\"}]},\"parent_tool_use_id\":\"call_00_PIw8yQqGecc9OjEQ4yQK7431\",\"session_id\":\"eedec3bf-a4f2-4c62-9cdd-51437516f832\",\"uuid\":\"f7d20a45-1487-4258-9c3f-8a7b450b5190\",\"timestamp\":\"2026-07-07T17:13:51.315Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Explore project structure\"}' , `created_at` = '2026-07-08 01:13:51' [ RunTime:0.009521s ]

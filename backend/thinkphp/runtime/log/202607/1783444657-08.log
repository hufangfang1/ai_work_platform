S = 160016;\\n51\\t    \\/** 只支持命令行模式 *\\/\\n52\\t    const EC_CLI_ONLY = 160017;\\n53\\t    \\/** 请求签名时间超时 *\\/\\n54\\t    const EC_TIMEOUT_SIGN_TIME = 160018;\\n55\\t    \\/** 未查询到数据 *\\/\\n56\\t    const EC_NO_QUERY_RESULT = 160019;\\n57\\t    \\/** 非法操作 *\\/\\n58\\t    const EC_WRONG_METHOD = 160020;\\n59\\t\\n60\\t\\n61\\t    \\/** 系统服务错误 100-200 *\\/\\n62\\t    \\/** DB失败 **\\/\\n63\\t    const EC_DB_FAILURE = 100;\\n64\\t    \\/** REDIS失败 **\\/\\n65\\t    const EC_REDIS_FAILURE = 101;\\n66\\t    \\/** REDIS没有配置 **\\/\\n67\\t    const EC_REDIS_NOT_CONFIG = 102;\\n68\\t    \\/** 频繁访问 **\\/\\n69\\t    const EC_TOO_MANY_ACCESS = 103;\\n70\\t\\n71\\t    \\/** HTTP错误 **\\/\\n72\\t    const EC_PAGE_NOT_FOUND = 404;\\n73\\t    \\/** 重定向url **\\/\\n74\\t    const EC_REDIRECT_URL   = -1;\\n75\\t    const APP_LOGIN_INVALID = 4000;\\n76\\t    \\/** 自定义提示语 **\\/\\n77\\t    const EC_CUSTOM_MESSAGE = 2000;\\n78\\t\\n79\\t    \\/** Api **\\/\\n80\\t    const EC_GET_ACTION_WRONG = 10001;\\n81\\t    const EC_GET_DATA_LIMIT = 10002;\\n82\\t\\n83\\t    \\/** 用户相关 **\\/\\n84\\t    const EC_USER_UNAPPLY = 20002;\\n85\\t    const EC_USER_ATTACH_UNAUTH = 20003;\\n86\\t    const VIP_REPEAT_GET = 200004;\\n87\\t    const EC_REPORT_LIMIT = 200005;\\n88\\t\\n89\\t    \\/** 资料相关 **\\/\\n90\\t    const EC_DOC_UNEXISTS = 30001;\\n91\\t    const EC_DOC_NOTBUY = 30002;\\n92\\t    const EC_DOC_UNORIGINAL = 30003;\\n93\\t\\n94\\t\\n95\\t    \\/**\\n96\\t     * 错误码对应的错误信息数组\\n97\\t     *\\n98\\t     * @var array\\n99\\t     *\\/\\n100\\t    public static $arrErrorDescs = array(\\n101\\t        self::EC_SUCCESS                   => \'成功\',\\n102\\t        self::EC_UNKNOWN                   => \'未知错误，请重试\',\\n103\\t        self::EC_API_METHOD                => \'API方法不存在\',\\n104\\t        self::EC_NO_WHITE_APPID            => \'API请求appid不在白名单中\',\\n105\\t        self::EC_PERMISSION                => \'无权限\',\\n106\\t        self::EC_INVALID_PARAM             => \'无效参数 [%s]\',\\n107\\t        se
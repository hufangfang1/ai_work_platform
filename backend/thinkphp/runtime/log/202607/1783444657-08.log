 0; $i < $rows; $i++) {\\n47\\t            for ($j = 0; $j < $columns; $j++) {\\n48\\t                if (isset($data[\'list\'][$i][$j])) { \\/\\/ && !is_null($data[$i][$j])\\n49\\t                    $obj->setActiveSheetIndex(0)->getColumnDimension($cell_name[$j])->setWidth($width);\\n50\\t                    $obj->setActiveSheetIndex(0)->getStyle($cell_name[$j] . ($i + 1))->getAlignment()->setWrapText(true);\\n51\\t                    \\/\\/水平居中\\n52\\t                    $obj->setActiveSheetIndex(0)->getStyle($cell_name[$j] . ($i + 1))->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);\\n53\\t                    \\/\\/垂直居中\\n54\\t                    $obj->setActiveSheetIndex(0)->getStyle($cell_name[$j] . ($i + 1))->getAlignment()->setVertical(PHPExcel_Style_Alignment::VERTICAL_CENTER);\\n55\\t                    $obj->setActiveSheetIndex(0)->setCellValue($cell_name[$j] . ($i + 1), $data[\'list\'][$i][$j]);\\n56\\t                }\\n57\\t            }\\n58\\t        }\\n59\\t\\n60\\t        $obj->getActiveSheet()->setTitle($data[\'title\']);\\n61\\t\\n62\\t        foreach ($datas as $ind => $data) {\\n63\\t            if ($ind < 1) {\\n64\\t                continue;\\n65\\t            }\\n66\\t            $rows = count($data[\'list\']);\\n67\\t            $cell_name = array();\\n68\\t            $columns = count($data[\'list\'][0]);\\n69\\t            for ($i = 0; $i < $columns; $i++) {\\n70\\t                if ($i < 26) {\\n71\\t                    $cell_name[$i] = chr($i + 65);\\n72\\t                } else {\\n73\\t                    $cell_name[$i] = chr(intval($i \\/ 26) + 64) . chr($i % 26 + 65);\\n74\\t                }\\n75\\t            }\\n76\\t\\n77\\t            $obj->createSheet();\\n78\\t            $obj->setactivesheetindex($ind);\\n79\\t\\n80\\t            for ($i = 0; $i < $rows; $i++) {\"}]},\"parent_tool_use_id\":\"call_00_PIw8yQqGecc9OjEQ4yQK7431\",\"session_id\":\"eedec3bf-a4f2-4c62-9cdd-51437516f832\",\"uuid\":\"77
>signTime = $signTime;\\n120\\t\\n121\\t            $platform = $this->request->param(\'platform\');\\n122\\t            if (empty($platform)) {\\n123\\t                $platform = $this->request->header(\'platform\');\\n124\\t            }\\n125\\t            $this->auth->platform = $platform;\\n126\\t\\n127\\t            $version = $this->request->param(\'version\');\\n128\\t            if (empty($version)) {\\n129\\t                $version = $this->request->header(\'version\');\\n130\\t            }\\n131\\t            $this->auth->version = $version;\\n132\\t\\n133\\t            $nonce = $this->request->param(\'nonce\');\\n134\\t            if (empty($nonce)) {\\n135\\t                $nonce = $this->request->header(\'nonce\');\\n136\\t            }\\n137\\t            $this->auth->nonce = $nonce;\\n138\\t\\n139\\t            $appId = $this->request->param(\'appId\\/d\', 0);\\n140\\t            if (empty($appId)) {\\n141\\t                $appId = $this->request->header(\'appId\');\\n142\\t            }\\n143\\t            $this->auth->appId = $appId;\\n144\\t\\n145\\t            \\/\\/ 参数校验\\n146\\t            $result = $this->auth->checkAuth();\\n147\\t            if (true !== $result) {\\n148\\t                $this->error($result[\'msg\'], [], $result[\'errno\']);\\n149\\t            }\\n150\\t        }\\n151\\t        $token = $this->request->server(\'HTTP_TOKEN\', $this->request->request(\'token\', \\\\think\\\\Cookie::get(\'token\')));\\n152\\t        if ($ifLogin) {\\n153\\t            $result = $this->auth->isLogin();\\n154\\t            if (true !== $result) {\\n155\\t                $this->error($result[\'msg\'], [], $result[\'errno\']);\\n156\\t            }\\n157\\t        } else {\\n158\\t            $this->auth->isLogin();\\n159\\t        }\\n160\\t        if($ifNeedVpn){\\n161\\t            if (config(\'admin_white\')) {\\n162\\t                \\/*if (!\\\\think\\\\WhiteList::getInstance()->check(session(\'uid\'))) {\\n163\\t                    $this->error(\'无访问权限\', [], 160003);\\n164\\t                }*\\/\\n165\\t            }\\n166\\t        }\\n167\\t    }\\n168\\t\\n169\\t    \\/**\\n170\\t     * 操作成功返回的数据\\n171\\t     * @param string $msg 提示信息\\n172\\t     * @param mixed $data 要返回的数据\\n173\\t     * @param int $code 错误码，默认为1\\n174\\t     * @param string $type 输出类型\\n175\\t     * @param array $header 发送的 Header 信息\\n176\\t     *\\/\\n177\\t    protected function success($msg = \'\', $data = [], $code = 0, $type = null, array $header = [])\\n178\\t    {\\n179\\t        $this->result($msg, $data, $code, $type, $header);\\n180\\t    }\\n181\\t\\n182\\t    \\/**\\n183\\t     * 操作失败返回的数据\\n184\\t     * @param string $msg 提示信息\\n185\\t     * @param mixed $data 要返回的数据\\n186\\t     * @param int $code 错误码，默认为0\\n187\\t     * @param string $type 输出类型\\n188\\t     * @param array $header 发送的 Header 信息\\n189\\t     *\\/\\n190\\t    protected function error($msg = \'\', $data = [], $code = 10001, $type = null, array $header = [])\\n191\\t    {\\n192\\t        $this->result($msg, $data, (int)$code, $type, $header);\\n193\\t    }\\n194\\t\\n195\\t    \\/**\\n196\\t     * 返回封装后的 API 数据到客户端\\n197\\t     * @access protected\\n198\\t     * @param mixed $msg 提示信息\\n199\\t     * @param mixed $data 要返回的数据\\n200\\t     * @param int $code 错误码，默认为0\\n201\\t     * @param string $type 输出类型，支持json\\/xml\\/jsonp\\n202\\t     * @param array $header 发送的 Header 信息\\n203\\t     * @return void\\n204\\t     * @throws HttpResponseException\\n205\\t     *\\/\\n206\\t    protected function result($msg, $data = [], $code = 0, $type = null, array $header = [])\\n207\\t    {\\n208\\t        $result = [\\n209\\t            \'errno\' => $code,\\n210\\t            \'success\' => $code ? $code : 1000,\\n211\\t            \'data\' => $data,\\n212\\t            \'msg\' => $msg,\\n213\\t        ];\\n214\\t\\n215\\t        header(\'content-type:application\\/json;charset=utf8\');\\n216\\t        exit(json_encode_cus($result));\\n217\\t    }\\n218\
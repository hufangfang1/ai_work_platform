et\'][\'school_id\']) ? 1 : 0;\\n45\\t        $data[\'is_set_fix\'] = !empty($data[\'target\']) && !empty($data[\'target\'][\'exam_period\']) ? 1 : 0;\\n46\\t        \\/\\/ 长难句二维码路径\\n47\\t        $data[\'sentence_qrcode\'] = \'https:\\/\\/fc.orangevip.com\\/qrcode\\/202311\\/28\\/1044529zi2n0ekms6e1ufo.png\';\\n48\\t        \\/\\/ 赠送橙币数量\\n49\\t        $data[\'give_cb_num\'] = \\\\app\\\\api\\\\logic\\\\User::KY_TARGET_GIVE_CB;\\n50\\t        \\/\\/ 赠送资料券数量\\n51\\t        $data[\'give_doccoupon_num\'] = \\\\app\\\\api\\\\logic\\\\User::KY_TARGET_GIVE_DOCCOUPON;\\n52\\t        \\/\\/ spa全科规划\\n53\\t        $data[\'spa_all_subject\'] = ($data[\'is_set_fix\']) ? (new Course)->getSpaAllSubject($uid) : [];\\n54\\t        $document = (new Document())->docIndexV40();\\n55\\t        \\/\\/ 学长带学\\n56\\t        $data[\'senior_teach\'] = $document[\'senior\'] ?? [];\\n57\\t        \\/\\/ 备考经验\\n58\\t        $data[\'experience\'] = $document[\'experience\'] ?? [];\\n59\\t        $data[\'exam_subject_id\'] = 0;\\n60\\t        $data[\'exam_subject_name\'] = \'\';\\n61\\t        if(!empty($data[\'target\'][\'major_code\'])){\\n62\\t            $data[\'exam_subject_id\'] = (new Course)->getExamSubject($data[\'target\'][\'major_code\']);\\n63\\t            if(!empty($data[\'exam_subject_id\'])){\\n64\\t                $data[\'exam_subject_name\'] = (new Course)->getExamSubjectName($data[\'exam_subject_id\']);\\n65\\t            }\\n66\\t        }\\n67\\t        trace(\\\"indexV40:---{$uid}---end\\\", \\\"info\\\");\\n68\\t        $this->success(\'success\', $data);\\n69\\t    }\\n70\\t\\n71\\t    \\/**\\n72\\t     * 首页\\n73\\t     *\\n74\\t     *\\/\\n75\\t    public function index()\\n76\\t    {\\n77\\t        $orders = Db::connect(\'database.cl_db_config\')->name(\'otm_order\')->alias(\'a\')\\n78\\t            ->join(\'otm_order_detail b\', \'a.main_order_no=b.main_order_no\', \'left\')\\n79\\t            ->join(\'otm_course_model_extend e\', \'b.course_model_id=e.course_model_id\', \'left\')\\n80\\t            ->whereIn(\'b.user_id\', [1, 2])\\n81\\t            ->whereIn(\'b.order_stauts\', [\'2\', \'11\'])\\n82\\t            ->where(\'a.pay_price\', \'>\', 9.9)\\n83\\t            ->where(\'e.first_subject\', 1)\\n84\\t            ->field(\'b.user_id,sum(a.pay_price) as price\')\\n85\\t            ->group(\'b.user_id\')->buildSql();\\n86\\t        ddp($orders, 1);\\n87\\t\\n88\\t        $str = \',  ,2\';\\n89\\t        ddp(explode(\',\', $str));\\n90\\t        $uidArr = array_filter(explode(\',\', $str), function ($a) {\\n91\\t            return empty(trim($a)) ? false : true;\\n92\\t        });\\n93\\t        ddp($uidArr);\\n94\\t        $res = array_chunk($uidArr, 3);\\n95\\t        ddp(array_unique($uidArr));\\n96\\t        ddp($res, 1);\\n97\\t        $chooseSchoolLogic = new \\\\app\\\\api\\\\logic\\\\ChooseSchool();\\n98\\t        $res = $chooseSchoolLogic->getUserLevelScore(\\n99\\t            \'大学数学优秀（80以上）\',\\n100\\t            \'排名前10%\',\\n101\\t            \'一年以上\',\\n102\\t            \'未过四级\',\\n103\\t            \'否\',\\n104\\t            \'否\',\\n105\\t            \'数学一\',\\n106\\t            \'1\'\\n107\\t\\n108\\t        );\\n109\\t        dd($res);\\n110\\t        $this->success(\'Welcome to 橙啦！\');\\n111\\t    }\\n112\\t\\n113\\t    \\/**\\n114\\t     * desc:获取小程序滚动提示语\\n115\\t     * author:hufangfang\\n116\\t     * data:2023\\/2\\/10 14:12\\n117\\t     * @return void\\n118\\t     *\\/\\n119\\t    public function getNotice()\\n120\\t    {\\n121\\t        $key = \\\"yxk:wxmini:index:notice:\\\" . date(\'Ymd\', time());\\n122\\t        $val = redis()->get($key);\\n123\\t        $notice = [];\\n124\\t        if (!$val) {\\n125\\t            $randUid = mt_rand(100000, 12785000);\\n126\\t            $userInfo = Db::connect(\'database.uc_db_config\')->name(\'members\')\\n127\\t                ->where(\'uid\', \'>\', $randUid)\\n128\\t                ->whereNotLike(\'username\', \'小橙子%\')\\n129\\t                ->limit(7)\\n130\\t                ->column(\'username\');\\n131\\t            foreach ($userInfo as $k => $username) {\\n132\\t                $username = mb_substr($username, 0, 1);\\n133\\t                $username = $username . \'**\';\\n134\\t                $notice[] = $username . \'刚开通了择校VIP\';\\n135\\t            }\\n136\\t            $now = time();\\n137\\t            $h = intval(date(\'H\', $now));\\n138\\t            $diff = $now - strtotime(date(\'Y-m-d\', $now) . \\\" 00:00:00\\\");\\n139\\t            $diff = empty($diff) ? 1 : $diff;\\n140\\t            if ($h <= 7) {\\n141\\t                $inItMinNum = ceil($diff \\/ 10);\\n142\\t                $inItMaxNum = 4 * ceil($diff \\/ 10);\\n143\\t                $addMinNum = 1;\\n144\\t                $addMaxNum = 4;\\n145\\t                $del = 100;\\n146\\t            } else {\\n147\\t                $inItMinNum = ceil($diff \\/ 10);\\n148\\t                $inItMaxNum = 4 * ceil($diff \\/ 15);\\n149\\t                $addMinNum = 3;\\n150\\t                $addMaxNum = 12;\\n151\\t                $del = 100;\\n152\\t            }\\n153\\t            $num = $this->getRandNum(\'xxx\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n154\\t            $notice[] = \'今天有\' . $num . \'人使用院校库功能\';\\n155\\t            \\/\\/            $notice[] = \'今天有\' . $num . \'人使用院校库功能\';\\n156\\t            if ($h <= 7) {\\n157\\t                $inItMinNum = 0;\\n158\\t                $inItMaxNum = 50;\\n159\\t                $addMinNum = 3;\\n160\\t                $addMaxNum = 15;\\n161\\t                $del = 1000;\\n162\\t            } else {\\n163\\t                $inItMinNum = 50;\\n164\\t                $inItMaxNum = 500;\\n165\\t                $addMinNum = 60;\\n166\\t                $addMaxNum = 300;\\n167\\t                $del = 10000;\\n168\\t            }\\n169\\t            $num = $this->getRandNum(\'yyy\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n170\\t            $notice[] = \'今天有\' . $num . \'人兑换了资料库内容\';\\n171\\t            \\/\\/            $notice[] = \'今天有\' . $num . \'人兑换了资料库内容\';\\n172\\t            if ($h <= 7) {\\n173\\t                $inItMinNum = 0;\\n174\\t                $inItMaxNum = 100;\\n175\\t                $addMinNum = 3;\\n176\\t                $addMaxNum = 15;\\n177\\t                $del = 1000;\\n178\\t            } else {\\n179\\t                $inItMinNum = 100;\\n180\\t                $inItMaxNum = 500;\\n181\\t                $addMinNum = 60;\\n182\\t                $addMaxNum = 300;\\n183\\t                $del = 10000;\\n184\\t            }\\n185\\t            $num = $this->getRandNum(\'zzz\', [5, 5], [$addMinNum, $addMaxNum], [$inItMinNum, $inItMaxNum], $del);\\n186\\t            $notice[] = \'今天新增了\' . $num . \'份真题资料\';\\n187\\t            redis()->setex($key, 5 * 60, json_encode_cus($notice));\\n188\\t        } else {\\n189\\t            $notice = json_decode($val, true);\\n190\\t        }\\n191\\t        shuffle($notice);\\n192\\t        $this->success(\'success\', $notice);\\n193\\t    }\\n194\\t\\n195\\t    private function getRandNum($type, $diffTime = [], $addNum = [], $initNum = [], $del = 1)\\n196\\t    {\\n197\\t        $randTimekey = \\\"yxk:wxmini:index:notice:rand:time:\\\" . date(\'Ymd\', time()) . \\\":\\\" . $type;\\n198\\t        $randval = redis()->get($randTimekey);\\n199\\t        $randDiffTime = mt_rand($diffTime[0], $diffTime[1]);\\n200\\t        if (!empty($randval)) {\\n201\\t            $randval = json_decode($randval, true);\\n202\\t            $time = $randval[\'time\'] ?? \'\';\\n203\\t            $lastTime = $randval[\'lastTime\'] ?? time();\\n204\\t            $num = $randval[\'num\'] ?? 0;\\n205\\t            $now = time();\\n206\\t            $diffTime = floor(($now - $lastTime) \\/ 60);\\n207\\t            if ($diffTime > $time) {\\n208\\t                $randval[\'time\'] = $randDiffTime;\\n209\\t                $randval[\'lastTime\'] = time();\\n210\\t                $num += ceil((mt_rand($addNum[0], $addNum[1]) \\/ $del) * $diffTime);\\n211\\t                $randval[\'num\'] = $num;\\n212\\t            }\\n213\\t        } else {\\n214\\t            $randval = [];\\n215\\t            $randval[\'time\'] = $randDiffTime;\\n216\\t            $randval[\'lastTime\'] = time();\\n217\\t            $num = mt_rand($initNum[0], $initNum[1]);\\n218\\t            $randval[\'num\'] = $num;\\n219\\t        }\\n220\\t        redis()->setex($randTimekey, 3600 * 24, json_encode_cus($randval));\\n221\\t        return $num;\\n222\\t    }\\n223\\t\\n224\\t    public function applyPage()\\n225\\t    {\\n226\\t        $type = input(\'type\', 1);\\n227\\t        if ($type == 1) {\\n228\\t            $img = [\\n229\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_1.png\',\\n230\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_2.png\',\\n231\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nmain_3.png\'\\n232\\t                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/20261.png\',\\n233\\t                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/2.png\',\\n234\\t                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/3.png\'\\n235\\t            ];\\n236\\t        } else {\\n237\\t            $img = [\\n238\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_1.png\',\\n239\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_2.png\',\\n240\\t                \\/\\/ \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/chooseSchool\\/go_ashore\\/nend_3.png\',\\n241\\t                \'https:\\/\\/cdn.orangevip.com\\/2022clwxapp\\/student_share\\/20261.png\',\\n242\\t                \'https:\\/\\/cdn.orangevip.com\\/